	# ---- earning money: Tía Paca after the debt, and the saffron sellers (fondo_casa.gd _curro_talk, azafran.gd; the user, 23 Nov 2026) ----
	"casa_curro": {
		"es": ["Y otra cosa, que te lo veo en la cara: estás pelao de pasta, ¿a que sí?",
			"Pues lo que tiés que hacer es doblar el lomo. Tu generación está mu acostumbrá a las paguitas y a las ayudas, pero de currar sabéis mu poquito.",
			"El azafrán que te encuentres por el pueblo, ni te se ocurra tirarlo. En estos sitios te lo compran: te los he apuntao en el mapa.",
			"Luego están los recaos de los vecinos. El Henry, en su cocina, siempre anda con pedidos pa llevar.",
			"Y el Javi, el de los pollos asaos, también te manda con sus pollos los martes y los domingos.",
			"Y en la plaza del Ayuntamiento tiés al de las faenas, que tiene trabajo pa quien lo quiera: repartos, el campo...",
			"Y si no, siempre te queda vender droga: en este pueblo la mitad trafica y la otra mitad consume. Economía circular, lo llaman.",
			"Conque arrea y ponte a trabajar, que el dinero no cae del cielo. Y la Eufrasia no te va a pagar la deuda desde allí arriba."],
		"en": ["And another thing, I can see it in your face: you’re skint, aren’t you?",
			"Well, what you need is to put your back into it. Your generation is far too used to handouts and benefits, but you don’t know the first thing about graft.",
			"Any saffron you find about the town, don’t you dare throw it away. These places buy it: I’ve marked them on your map.",
			"Then there are the neighbours’ errands. Henry, in his kitchen, always has orders to take round.",
			"And Javi, the roast chicken man, sends you out with his chickens on Tuesdays and Sundays.",
			"And on the Plaza del Ayuntamiento there’s the odd-jobs man, with work for whoever wants it: deliveries, the fields...",
			"And failing that, you can always sell drugs: in this town half of them deal and the other half use. The circular economy, they call it.",
			"So get a move on and go and work: money doesn’t fall from the sky. And Eufrasia isn’t paying the debt from up there."]},
	"t_curro": {"es": "Ya puedes ganarte el jornal: vende el azafrán (círculos en el mapa), haz recaos y busca faenas en la plaza.", "en": "You can earn your keep now: sell saffron (circles on the map), run errands and look for odd jobs on the square."},
	"n_azafran_1": {"es": "Vendedor Azafrán 1", "en": "Saffron dealer 1"},
	"n_azafran_2": {"es": "Vendedor Azafrán 2", "en": "Saffron dealer 2"},
	"n_azafran_3": {"es": "Vendedor Azafrán 3", "en": "Saffron dealer 3"},
	"n_azafran_4": {"es": "Vendedor Azafrán 4", "en": "Saffron dealer 4"},
	"azafran_nada": {"es": ["¿Azafrán? Tráeme azafrán y hablamos, que yo de palique no vivo.", "Cuando tengas azafrán, aquí estoy. Las rosas, enteras y sin pisar.", "Sin azafrán no hay trato. Vuelve cuando lleves algo."],
		"en": ["Saffron? Bring me saffron and we’ll talk: I don’t live on chit-chat.", "When you’ve got saffron, I’m here. The flowers whole and not trodden on.", "No saffron, no deal. Come back when you’ve got some."]},
	"azafran_venta": {"es": ["%d rosas de azafrán... A ver, a ver. Buen género. Toma, %d euros, y ni una palabra.", "Te lo quedo tó: %d rosas, %d euros. Y no me regatees, que te veo venir.", "%d rosas. Pues %d euros, que hoy estoy espléndido."],
		"en": ["%d saffron flowers... Let’s see. Good stuff. Here, %d euros, and not a word.", "I’ll take the lot: %d flowers, %d euros. And don’t haggle, I can see you coming.", "%d flowers. %d euros then, I’m feeling generous today."]},
	"azafran_pregon": {"es": ["¡Azafrán de La Mancha, el oro rojo!", "¡Se compra azafrán, se compra!", "¿Traes azafrán? Aquí se paga bien."],
		"en": ["La Mancha saffron, red gold!", "Saffron bought here, saffron bought!", "Got saffron? It pays well here."]},
	"josefa_vizum_call": {
		"es": ["¿{Hijo|Hija}? Soy la Josefa. Que ya me he enterao de lo de la casa y Hacienda: yo me entero de tó.",
			"Y de tus pintas también. Mira, ya sé que eres un pobre. Pero una cosa es serlo y otra paecerlo.",
			"Te acabo de hacer un Vizum de veinte euros, que me enseñó el muchacho del V.I.P. a darle al botón. Más de tres mil pesetas, que se dice pronto.",
			"Pa que te compres algo de ropa decente. Que en los negocios lo primero que se mira es la pinta, y con esa no te fían ni una peseta."],
		"en": ["Ay, {lad|lass}, is that you? It’s Josefa. Heard all about the house and the tax man—nowt gets past me.",
			"An’ about the state you’re knockin’ about in, an’ all. Look, I know you’re skint, love, but bein’ skint’s one thing and lookin’ like a scarecrow’s another.",
			"Just pinged you a Vizum for twenty euros—the lad at V.I.P. showed me which button to prod. Over three thousand pesetas, mind, no small brass.",
			"Get yourself some proper clothes. First thing folks clock in business is how you turn up—lookin’ like that, nobody’ll lend you a penny."]},
	"t_vizum": {"es": "Vizum de la Josefa: +%d €. Las tiendas de ropa ya te abren: búscalas en el mapa por la peseta.",
		"en": "A Vizum from Josefa: +%d €. The clothes shops are open to you now: look for the peseta on the map."},
	"n_koke": {"es": "Koke el Kokas", "en": "Koke el Kokas"},
	"koke_call": {
		"es": ["¿Qué pasa, {chaval|chavala}? Koke el Kokas al aparato, el de los taxis. Tu número me lo ha dao la Josefa, que esa mujer lo sabe tó.",
			"Te cuento: mi último compañero está en coma. Se ostió con el taxi a ciento cuarenta contra la fachada de un colegio. Menos mal que era domingo.",
			"Total, que me falta un piloto. Y tú tiés pinta de no tener ná que perder.",
			"Es mu fácil: te subes a la amarilla, la de las llamas y el nitro, y a por clientes. Cuanto más lejos los lleves y más rápido, más pasta. Cada uno que dejes, medio minuto más de turno.",
			"La furgoneta no se rompe, no sufras. Y de los Pitufos y los Tricornios ni te preocupes: a mí me dejan en paz, que les paso hierba de la buena.",
			"La flota la tengo en el recinto ferial. Una vez al día, que tampoco quiero que me la quemes entera. ¡Venga, a quemar rueda!"],
		"en": ["Wotcher, {mate|love}? Koke el Kokas ’ere, off the cabs. Got your number off Josefa—that old girl knows everybody’s business.",
			"Listen up: my last driver’s in a coma. Wrapped his cab round a school wall doin’ a hundred and forty. Lucky it were a Sunday.",
			"So I’m a wheelman short. And you look like you’ve got nowt left to lose, eh?",
			"Dead simple: hop in the yellow motor—flames on the bonnet, nitro in the boot—and pick up punters. Further and faster you run ’em, heavier the wedge. Every drop gets you half a minute extra on the clock.",
			"Van’s built like a brick, don’t fret. As for the Smurfs and the Tricornios, they leave me well alone—I sort ’em out with the good herb.",
			"Fleet’s parked down the fairground. Once a day, mind—don’t fancy you torchin’ the whole lot. Enga, go burn some rubber!"]},
	"t_koke_new": {"es": "Nuevo trabajo: el taxi del Kokas, en el recinto ferial. Una vez al día: súbete a la Z15 amarilla.",
		"en": "New job: Kokas’s taxi, at the fairground. Once a day: get into the yellow Z15."},
	"koke_stranger": {"es": ["¿Y tú quién eres? Bah, da igual: a estas horas yo no reconozco ni a mi madre.", "Estas Z15 son mías, ¿eh? Ni te se ocurra tocarlas.", "Anoche salí a tomar una y me he levantao hoy. En Albacete. No me preguntes cómo."],
		"en": ["And who’re you meant to be? Bah, never mind: at this hour I wouldn’t clock me own mum.", "Hands off the Z15s, alright? Mine, those are. Don’t even think about touchin’ ’em.", "Went out for a quick pint last night and woke up this mornin’ in Albacete. Don’t ask."]},
	"koke_busy": {"es": ["¿Qué haces aquí parao? ¡Que corre el reloj!"], "en": ["What you standin’ about for? Clock’s tickin’, mate!"]},
	"koke_hello": {"es": ["¡Ey, mi piloto! La amarilla está ahí, con el depósito lleno y el nitro cargao.", "Súbete y a por clientes. Y si te pregunta alguien, tú no me conoces."],
		"en": ["Oi, my wheelman! The yellow motor’s waitin’, brimmed tank and nitro ready to blow.", "Jump in and grab some punters. And if anyone asks, you never seen me."]},
	"koke_done_today": {"es": ["Por hoy ya está, {chaval|chavala}. La amarilla tiene que descansar, y yo también.", "Bueno, yo no descanso. Pero tú me entiendes. Vuelve mañana."],
		"en": ["That’s your lot for today, {mate|love}. Yellow one needs a breather, and so do I.", "Well, I don’t sleep. You catch my drift. Come back tomorrow."]},
	"koke_chat": {"es": [["Tengo cuarenta y siete años y el cuerpo de uno de veinte. De uno de veinte que ha salío tos los findes desde los catorce."],
			["Mi médico dice que tengo que bajar el ritmo. Le he cambiao de médico."],
			["Las Z15 son el mejor coche del mundo. Les metes nitro y vuelan. Una voló de verdad: por eso está mi compañero como está."],
			["Yo no me drogo, ¿eh? Yo me medico. Que es distinto."],
			["El otro día me pararon pa soplar. El aparato se puso a pitar, pero de envidia."]],
		"en": [["Forty-seven with the body of a twenty-year-old, mate. A twenty-year-old who’s been out on the lash every weekend since fourteen."],
			["Doctor told me to take it easy. So I nicked off and got meself a new doctor."],
			["Z15s are the finest motors on Earth. Stick nitro in ’em and they fly. One proper flew—that’s why my mate’s in traction."],
			["I don’t do drugs, alright? I self-medicate. Big difference."],
			["Old Bill pulled me over for the breathalyser the other day. Machine started screamin’—pure envy, mate."]]},
	"koke_mine": {"es": ["¡Eh, eh! Que esa es mía. ¿Tú quién eres?"], "en": ["Oi, oi! Hands off my motor! Who are you?"]},
	"koke_tomorrow": {"es": ["¡Quieto! Por hoy ya has currao. Mañana más."], "en": ["Hold up! You’ve done your shift today, mate. More tomorrow."]},
	"t_koke_busy": {"es": "Termina primero lo que tiés entre manos.", "en": "Finish what you’re doing first."},
	"faena_title_kokas": {"es": "Taxi del Kokas", "en": "Kokas’s taxi"},
	"t_kokas_start": {"es": "¡Al lío! Sigue la flecha hasta el primer cliente. El reloj corre: cada cliente que dejes, +%d s.",
		"en": "Off you go! Follow the arrow to the first fare. The clock is running: every fare you drop off, +%d s."},
	"obj_kokas_cliente": {"es": "Para al lado de un cliente (rojo: cerca · amarillo: más lejos · verde: la otra punta) · Caja: %s",
		"en": "Stop beside a fare (red: near · yellow: further · green: across town) · Takings: %s"},
	"obj_kokas_coche": {"es": "Vuelve a la Z15 amarilla, que corre el reloj.", "en": "Back into the yellow Z15: the clock is running."},
	"obj_kokas_viaje": {"es": "Lleva al cliente a {calle} · le quedan %s · Caja: %s", "en": "Take the fare to {calle} · %s left · Takings: %s"},
	"kokas_rate": {"es": ["¡Como un cohete!", "Ni tan mal", "A paso de burra"], "en": ["Like a rocket!", "Not bad", "At a donkey’s pace"]},
	"t_kokas_fare": {"es": "%s  +%s (carrera %s + propina por rapidez %s) · +%d s", "en": "%s  +%s (fare %s + tip for speed %s) · +%d s"},
	"t_kokas_jump": {"es": "¡El cliente se ha bajao sin pagar! Se le acabó la paciencia.", "en": "The fare got out without paying! They ran out of patience."},
	"t_kokas_over": {"es": "Se acabó el turno: %d clientes, %s pa ti.", "en": "Shift over: %d fares, %s for you."},
	"t_kokas_none": {"es": "Se acabó el turno sin un solo cliente. El Kokas se va a reír de ti.", "en": "Shift over without a single fare. Kokas is going to laugh at you."},
	"kokas_to": {"es": ["A {calle}, y rapidito.", "Llévame a {calle}, que llego tarde.", "¡A {calle}! ¡Y pisa, que pa eso es el taxi del Kokas!", "A {calle}. Y no me des vueltas, que me conozco el pueblo."],
		"en": ["{calle}, and step on it.", "Drop us at {calle}, running late.", "{calle}! Put your foot down—ain’t that why it’s Kokas’s cab?!", "{calle}. And skip the scenic route, I know every lane ’ere."]},
	"kokas_thanks": {"es": ["Toma, y que no se entere el Kokas de que me has traío [[entero|entera]].", "Pues mira, has llegao. No sé cómo, pero has llegao.", "Gracias, {majo|maja}. Si me muero de un infarto, que sepas que ha sío culpa tuya.", "Quédate con la vuelta. Bueno, no."],
		"en": ["Here, and keep schtum to Kokas you got me back in one piece.", "Blimey, we made it. God knows how, still made it.", "Cheers, {mate|love}. If me ticker packs in later, that’s on your head.", "Keep the change. Actually, pass it back."]},
	"kokas_angry": {"es": ["¡Pa esto me voy andando!", "¡Menudo taxista! ¡Ni un euro te doy!", "¡Me bajo, que se me hace de noche!", "¡Se lo vía decir al Kokas, que eres más lento que el caballo del malo!"],
		"en": ["May as well walked it!", "Call yourself a cabbie?! Not seeing a penny!", "I’m hopping out, be pitch black afore we arrive!", "Telling Kokas you’re slower than a bloody funeral cortege!"]},
	"kokas_fast": {"es": ["¡Frena, frena, que me meo!", "¡Que esto no es el Dakar, animal!", "¡Ay, mi madre, que nos matamos!", "¿Pero tú tiés carné o te lo ha dao el Kokas?", "¡Más despacio, que llevo huevos!", "¡Me cago en la leche, que se me sale el corazón por la boca!"],
		"en": ["Brake, brake, I’m gonna wet meself!", "Ain’t the bloody Dakar Rally, you maniac!", "Oh mother, we’re all going in a box!", "Got an actual licence or did Kokas doodle one for you?", "Ease off, I’ve got fresh eggs in this bag!", "Bloody ’ell, me heart’s hammering straight through me ribs!"]},
	"kokas_slow": {"es": ["¿Esto es un taxi o un coche fúnebre?", "Mi abuela corre más, y está muerta.", "¡Dale, que llego tarde!", "¡Venga, que no tengo tó el día!", "A este paso llego pa la jubilación."],
		"en": ["Is this a minicab or a bleedin’ hearse?", "Me nan shifts faster, and she’s six feet under.", "Put some welly in, I’m late!", "Shift it, haven’t got all day!", "At this crawl I’ll arrive in time for me pension."]},
	"kokas_crash": {"es": ["¡Ay! ¡Que me he dao en la cabeza!", "¡Pero bueno! ¿Tú miras pa delante o qué?", "¡Hostia! ¡Eso lo pagas tú, eh!", "¡Que me has descolocao la dentadura!", "¡Me cago en tus muertos, la farola!", "¡Como me hayas roto algo te denuncio, que tengo un primo abogao!"],
		"en": ["Ow! Clumped me noggin on the roof!", "Steady on! Got your eyes shut or what?!", "Bloody ’ell! Coughing up for that one, mate!", "Rattled me false teeth straight out me gums!", "Sod it, mind the lamppost!", "Broke owt in me back and I’m suing—me cousin’s a solicitor!"]},
	"kokas_look": {"es": ["Oye, ¿y esas pintas? ¿Te vistes a oscuras?", "Tú eres {el|la} de la Eufrasia, ¿verdad? Si es que tiés la misma cara de mala leche que ella.", "¿Tú no eres {el|la} que ha heredao la casa? ¿La de la Eufrasia? Menuda pájara era tu tía.", "Esa ropa es del MaxiPrecio, ¿a que sí? Se nota a la legua.", "Hueles a Z15. Y no en el buen sentío.", "¿Tú trabajas pa el Kokas? Pues sí que andaba mal de gente."],
		"en": ["Oi, state of that clobber—getting dressed in the dark?", "You’re Eufrasia’s {lad|lass}, aren’t you? Spit of her sour mug, you have.", "Aren’t you the one landed Eufrasia’s cottage? Right old handful, your aunt was.", "Clobber’s off MaxiPrecio’s bargain rail, bet you? Spots a mile off.", "You pong of Z15 diesel. Not in a charming way neither.", "Pulling shifts for Kokas? Must be dead desperate for drivers."]},
	"kokas_life": {"es": ["Que sepas que estoy pasando por un divorcio mu difícil.", "Mis hijos no me quieren. Me lo dijeron en Nochebuena, delante del cordero.", "Mi [[mujer|marido]] me ha puesto los cuernos con [[el del butano|la de la panadería]]. Y encima [[me sigue trayendo la bombona|le sigo comprando el pan]].", "Se ha quedao con la casa, con el perro y con el Panda. A mí me ha dejao la suegra.", "Llevo tres semanas sin dormir. El médico dice que es estrés. Yo digo que es mi cuñao.", "Mis hijos solo me llaman pa que les cuide a los nietos."],
		"en": ["Fair warning, I’m knee-deep in a proper messy divorce.", "Kids can’t stand the sight of me. Told me straight Christmas Eve over the roast lamb.", "Me [[wife|husband]]’s been carrying on with [[the gas-bottle bloke|that woman at the baker’s]]. Worse part is [[he still drops our gas canisters|I still buy her bloomin’ loaves]].", "Walked off with the house, the dog and the Panda. Left me stuck with the mother-in-law.", "Haven’t kiped in three weeks. GP blames stress. I blame me brother-in-law.", "Kids only bell me when they want free babysitting."]},
	"kokas_any": {"es": ["¿Tú sabes lo que vale la luz? Pues eso.", "Esto antes era tó campo.", "¿Es verdad que el Kokas se metió una raya en la boda de su hermano? Digo, lo comentan.", "Pon la radio, que estoy de bajón.", "Si ves a mi [[mujer|marido]], tú no me has visto."],
		"en": ["Seen the leccy bills lately? Daylight robbery, that’s what.", "Used to be all green fields round ’ere once.", "True Kokas hoovered a line at his brother’s wedding? Just saying, folks natter.", "Stick the radio on, feeling right glum.", "Spot me [[wife|husband]] out the window, you never clapped eyes on me."]},
	"casa_paca_call": {
		"es": ["¿Ya has terminao con el puente? Pues ven a verme, ande siempre, al lao de casa.",
			"No, por teléfono no, que es un asunto delicao. Y los teléfonos escuchan. ¡Arreando!"],
		"en": ["Wrapped up that bridge business, love? Nip over and see me—same corner by the house.",
			"Not over the blower, no—delicate business, and walls have ears. Hop to it!"]},
	"casa_paca": {
		"es": ["Siéntate. Bueno, no te sientes, que no hay sillas. Escucha.",
			"La Eufrasia, que en paz descanse, tenía dos aficiones en la vida: gritar y defraudar a Hacienda.",
			"Y la segunda le gustaba más. Lo de gritar era pa entrenar.",
			"Total, que la casa no es tuya del tó. Tiene una carga de diez mil euros con Hacienda.",
			"O los pagas, quieras o no, o la casa se la queda el Estao. Y el Estao no te va a hacer la cena, te lo digo yo.",
			"Se paga en el cajero, el que hay delante del Banco Cantabria. Poco a poco, lo que vayas juntando.",
			"Y no me pongas esa cara, que la herencia también trae cosas buenas. La pared del fondo, por ejemplo. Sigue de pie."],
		"en": ["Take a pew. Well, stand—ain’t got no chairs. Listen up, love.",
			"Our Eufrasia, God rest her soul, had two hobbies in life: hollering and fiddling the taxman.",
			"And she fancied the fiddling best. Hollering was just warm-ups.",
			"Long and short, cottage ain’t clean yours yet. Carries a ten-thousand-euro charge from the tax office.",
			"Either you stump it up, like it or lump it, or the State nabs the roof over your head. Taxman won’t dish up your supper neither.",
			"You pay it through the cashpoint outside Banco Cantabria. Bit by bit, as you scrape the brass together.",
			"Don’t pull that miserable face—inheritance has its bright side too. Back wall, for one. Still upright."]},
	"casa_e0": {"es": "la casa hecha un asco", "en": "the house in a state"},
	"casa_e1": {"es": "la casa arreglada", "en": "the house done up"},
	"casa_e2": {"es": "la fachada nueva y más sitio dentro", "en": "a new front and more room inside"},
	"casa_e3": {"es": "un cuarto más a la izquierda", "en": "an extra room on the left"},
	"casa_e4": {"es": "un cuarto más a la derecha", "en": "an extra room on the right"},
	"casa_e5": {"es": "el segundo piso", "en": "the upper floor"},
	"t_casa_obra_hecha": {"es": "Ya han terminao la obra: %s.", "en": "The work is finished: %s."},
	"t_casa_tuya": {"es": "¡La cá la Eufrasia ya es tuya! Hacienda te deja en paz. De momento.", "en": "Eufrasia’s house is yours! The tax office leaves you alone. For now."},
	"t_casa_obra_pagada": {"es": "Obra pagada: %s. No le debes ná al banco.", "en": "Work paid for: %s. You owe the bank nothing."},
	"casa_obra_card": {"es": "Obra contratada: %s", "en": "Work contracted: %s"},
	"casa_obra_card_sub": {"es": "Debes %s al banco", "en": "You owe the bank %s"},
	"cajero_q": {"es": "%s: debes %s. Llevas %s encima. ¿Cuánto metes?", "en": "%s: you owe %s. You have %s on you. How much do you put in?"},
	"cajero_hacienda": {"es": "Deuda con Hacienda", "en": "Tax debt"},
	"cajero_obra": {"es": "Obra de la casa (%s)", "en": "Work on the house (%s)"},
	"cajero_todo": {"es": "Tó lo que llevo (%s)", "en": "All I have (%s)"},
	"cajero_salir": {"es": "Salir", "en": "Leave"},
	"cajero_nada": {"es": "No debes ná. Llevas %s encima. El cajero te desea un buen día. Bueno, el cajero no desea ná.", "en": "You owe nothing. You have %s on you. The cash machine wishes you a good day. Well, it wishes nothing."},
	"t_cajero_pago": {"es": "Metes %s. Te quedan %s por pagar.", "en": "You pay in %s. %s still to pay."},
	"log_bg_title": {"es": "MISIONES DE FONDO", "en": "BACKGROUND MISSIONS"},
	"log_bg_none": {"es": "Ná de momento. Ya irán saliendo.", "en": "Nothing yet. They’ll turn up."},
	"log_bg_how": {"es": "Van a su aire mientras juegas: no te quitan de ninguna otra.", "en": "They run alongside the game: they never get in the way of another one."},
	"log_casa_paca": {"es": "la Paca quiere hablar contigo: ande siempre, al lao de casa", "en": "Tía Paca wants a word: where she always is, by the house"},
	"log_casa_deuda": {"es": "debes a Hacienda %s de %s · se paga en el cajero", "en": "you owe the tax office %s of %s · paid at the cash machine"},
	"log_casa_obra": {"es": "obra: %s, pa mañana por la mañana · debes %s", "en": "work: %s, by tomorrow morning · you owe %s"},
	"log_casa_debe": {"es": "tuya: %s · debes %s al banco", "en": "yours: %s · you owe the bank %s"},
	"log_casa_propia": {"es": "tuya: %s · Edmundo Monedero tiene más obras", "en": "yours: %s · Edmundo Monedero has more work to sell"},
	"log_casa_top": {"es": "tuya, con su segundo piso: no hay más obras", "en": "yours, upper floor and all: no more work to do"},
	"log_chiki_walls": {"es": "tuyas %d de %d paredes", "en": "%d of %d walls yours"},
	"log_saffron_title": {"es": "El azafrán", "en": "The saffron"},
	"log_saffron_hidden": {"es": "escondías %d de %d", "en": "%d of %d hidden ones"},
	"t_saffron_hidden": {"es": "¡Azafrán escondío! Llevas %d de %d.", "en": "Hidden saffron! %d of %d found."},
	"log_saffron": {"es": "%d rosas cogidas", "en": "%d flowers picked"},
	"casa_edm_call": {
		"es": ["¿Diga? Ah, no, que llamo yo. Edmundo Monedero, director de la sucursal del Banco Cantabria. Enhorabuena: ha liquidao usted su deuda con Hacienda.",
			"Ahora, entre usted y yo: ¿va a vivir en esa casa así? Pásese por la sucursal, que tengo un producto que le va a cambiar la vida. ((Y la cuenta corriente.))"],
		"en": ["Hello? Oh no, I’m the one calling. Edmundo Monedero, manager of the Banco Cantabria branch. Congratulations: you’ve settled your debt with the tax office.",
			"Now, between you and me: are you going to live in that house like that? Drop by the branch, I have a product that will change your life. ((And your bank balance.))"]},
	"casa_edm_call_next": {
		"es": ["Edmundo Monedero, del Banco Cantabria. Me consta que ha terminao de pagar la obra. Qué gusto da un cliente cumplidor. ((Y qué poco dura.))",
			"Pásese por la sucursal, que le tengo preparada la siguiente. Sin compromiso. ((Con mucho compromiso.))"],
		"en": ["Edmundo Monedero, Banco Cantabria. I see you’ve finished paying for the work. What a pleasure, a client who pays. ((And how briefly.))",
			"Drop by the branch, I have the next one ready for you. No obligation. ((Plenty of obligation.))"]},
	"casa_edm_offer_1": {
		"es": ["Pase, pase. Su casa, con tó el respeto, es un corral con tejao. ¿Y si se la dejamos decente?",
			"Pintura, tejas, ventanas que cierran. Lo normal. Lo que tiene tó el mundo menos usted.",
			"Por {precio}, y lo paga cómodamente en el cajero, a su ritmo. ((Mientras haya ritmo, hay intereses.))",
			"Mañana por la mañana tiene usted a los albañiles terminando. Son rápidos. ((Y caros.))"],
		"en": ["Come in, come in. Your house, with all due respect, is a pen with a roof. Shall we make it decent?",
			"Paint, tiles, windows that shut. The usual. What everybody has except you.",
			"For {precio}, paid comfortably at the cash machine, at your own pace. ((As long as there’s a pace, there’s interest.))",
			"By tomorrow morning the builders will be finishing. They’re quick. ((And dear.))"]},
	"casa_edm_offer_2": {
		"es": ["Ya tiene usted una casa decente. Decente. ¿Y por qué conformarse con decente?",
			"Fachada nueva, de revista, y por dentro más grande. No me pregunte cómo, que eso es cosa de los albañiles. ((Ni ellos lo saben.))",
			"Por {precio}. Un regalo. ((Pa mí.))"],
		"en": ["You have a decent house now. Decent. And why settle for decent?",
			"A new front, straight out of a magazine, and bigger inside. Don’t ask me how, that’s the builders’ business. ((They don’t know either.))",
			"For {precio}. A gift. ((To me.))"]},
	"casa_edm_offer_3": {
		"es": ["Le noto apretao. En la casa, digo. ¿Un cuarto más, a la izquierda? Pa las visitas, pa la suegra, pa lo que surja.",
			"Por {precio}, con la financiación más baja de la comarca. ((Bueno, la única.))"],
		"en": ["You look cramped. In the house, I mean. An extra room, on the left? For visitors, for the mother-in-law, for whatever comes up.",
			"For {precio}, with the lowest financing in the district. ((Well, the only one.))"]},
	"casa_edm_offer_4": {
		"es": ["La izquierda ya la tiene. ¿Y la derecha? Una casa equilibrada es una casa feliz. Lo dice la ciencia.",
			"Por {precio}. ((Menudo prigao. Si es que se lo pongo a huevo y lo coge.))"],
		"en": ["You’ve got the left. And the right? A balanced house is a happy house. Science says so.",
			"For {precio}. ((What a mug. I hand it to him on a plate and he takes it.))"]},
	"casa_edm_offer_5": {
		"es": ["El último paso, y el más bonito: un segundo piso. Con su puerta por detrás, pa entrar como un señor.",
			"Por {precio}. Después de esto la casa es de usted y yo me jubilo. ((Con su dinero.))"],
		"en": ["The last step, and the finest: an upper floor. With its own door at the back, to come in like a gentleman.",
			"For {precio}. After this the house is all yours and I retire. ((On your money.))"]},
	"casa_edm_q": {"es": "¿Contrata usted %s por %s?", "en": "Will you take %s for %s?"},
	"casa_edm_yes": {"es": "Venga, firmo", "en": "Go on, I’ll sign"},
	"casa_edm_no": {"es": "Ahora no, gracias", "en": "Not now, thanks"},
	"casa_edm_refused": {
		"es": [["Ná, ná, sin prisa. La oferta sigue en pie. Yo también. ((Esperando.))"],
			["Lo entiendo, lo entiendo. Ya volverá. Tos vuelven. ((Con las orejas gachas.))"],
			["Piénselo. Pero no mucho, que pensar sale caro. ((Lo sé porque lo cobro yo.))"]],
		"en": [["No hurry, no hurry. The offer stands. So do I. ((Waiting.))"],
			["I understand, I understand. You’ll be back. They all come back. ((Tail between their legs.))"],
			["Think it over. But not too much: thinking is expensive. ((I know, I charge for it.))"]]},
	"casa_edm_signed": {
		"es": ["Firme aquí. Y aquí. Y aquí. Y esta letra pequeña no la lea, que cansa la vista.",
			"Enhorabuena: mañana por la mañana está hecha. Y la deuda, en el cajero, cuando usted quiera. ((Mejor pronto. Que va a perder hasta los calzoncillos.))"],
		"en": ["Sign here. And here. And here. And don’t read the small print, it strains the eyes.",
			"Congratulations: it’ll be done by tomorrow morning. And the debt, at the cash machine, whenever you like. ((Sooner is better. He’ll lose his very underpants.))"]},
	"casa_edm_patter": {
		"es": [["Buenas. Edmundo Monedero, pa servirle. ¿Conoce usted nuestro Plan Pensión Botijo? Rentabilidad garantizada. ((Pa el banco.))"],
			["Tenemos préstamos al interés más bajo de La Mancha. ((Más bajo que el de Hacienda, que ya es decir.))"],
			["¿Una tarjeta de crédito? Con ella se compra usted lo que quiera. ((Y me lo paga dos veces.))"],
			["Aquí, en el Banco Cantabria, el cliente es lo primero. ((Lo primero que se exprime.))"],
			["Le veo cara de ahorrador. ¿Un depósito? Usted me deja el dinero y yo se lo cuido. ((Mu bien cuidao. En mi casa.))"],
			["Nuevo producto: el Préstamo Vendimia. Lo pide en septiembre y lo siguen pagando sus nietos. ((Cómo se la vía colar a este.))"]],
		"en": [["Good day. Edmundo Monedero, at your service. Have you heard of our Water-Jug Pension Plan? Guaranteed returns. ((For the bank.))"],
			["We have loans at the lowest interest in La Mancha. ((Lower than the tax office’s, which is saying something.))"],
			["A credit card? Buy whatever you like with it. ((And pay me for it twice.))"],
			["Here at the Banco Cantabria, the customer comes first. ((First to be squeezed.))"],
			["You look like a saver. A deposit? You leave me the money and I look after it. ((Very well looked after. At my place.))"],
			["New product: the Grape-Harvest Loan. Take it out in September and your grandchildren are still paying. ((I’m going to slip this one right past him.))"]]},
	"casa_edm_deuda": {
		"es": [["Ah, la deuda de la Eufrasia. Una mujer de carácter. Y de pocas facturas.", "Puede ir pagándola en el cajero de aquí fuera. Y si no llega, aquí estoy yo: un préstamo pa pagar a Hacienda. ((Y otro pa pagarme a mí.))"],
			["Le quedan {debe} con Hacienda. Poca cosa. ((Pa mí.))"]],
		"en": [["Ah, Eufrasia’s debt. A woman of character. And of very few invoices.", "You can pay it off at the cash machine outside. And if you can’t manage, here I am: a loan to pay the tax office. ((And another to pay me.))"],
			["You still owe the tax office {debe}. A trifle. ((For me.))"]]},
	"casa_edm_debe": {
		"es": [["Le quedan {debe} por pagar de la obra. Sin agobios, que el cajero no cierra. ((Yo tampoco.))"],
			["¿Qué tal la casa? Preciosa, seguro. Pues le quedan {debe}. ((Preciosa y mía, de momento.))"]],
		"en": [["You have {debe} left to pay on the work. No stress, the cash machine never closes. ((Nor do I.))"],
			["How’s the house? Lovely, I’m sure. Well, {debe} still to go. ((Lovely, and mine for now.))"]]},
	"casa_edm_obra": {
		"es": [["Los albañiles ya están con {obra}. Mañana por la mañana la tiene. ((Hoy, el recibo.))"]],
		"en": [["The builders are already on {obra}. You’ll have it tomorrow morning. ((The bill, today.))"]]},
	"casa_edm_top": {
		"es": [["Su casa ya no admite más mejoras. Es usted propietario de pleno derecho. Qué pena. ((Pa mí.))", "Si algún día quiere una piscina, ya sabe ande estoy."]],
		"en": [["Your house can’t take any more improvements. You are its owner, outright. What a shame. ((For me.))", "If you ever want a swimming pool, you know where I am."]]},
	"inv_n_tabaco": {"es": "Paquete de tabaco", "en": "Pack of cigarettes"},
	"inv_d_tabaco": {"es": "Comprao en los chinos del Arroyuelo pa Tomasa Malvora. Seis euros el vicio.", "en": "Bought at the Arroyuelo grocer’s for Tomasa Malvora. Six euros a pack."},
	"tomasa_title": {"es": "Un paquete pa la Tomasa", "en": "A pack for Tomasa"},
	"obj_tomasa_buy": {"es": "Entra en los chinos del Arroyuelo y compra tabaco (%d €).", "en": "Go into the Arroyuelo grocer’s and buy tobacco (%d €)."},
	"obj_tomasa_give": {"es": "Llévale el tabaco a Tomasa Malvora, fuera de los chinos.", "en": "Bring the tobacco to Tomasa Malvora outside the grocer’s."},
	"tomasa_tag_buy": {"es": "Comprar · %d €", "en": "Buy · %d €"},
	"p_buy_tobacco": {"es": "<interact> Comprar tabaco (%d €)", "en": "<interact> Buy tobacco (%d €)"},
	"tomasa_no_money": {"es": "No tiés %d € pa pagar el tabaco.", "en": "You don’t have %d € for the tobacco."},
	"tomasa_ask": {
		"es": ["¡Eh, {hijo|hija}, ven pacá! ¿Me haces un favorcico?",
			"Es que me apetece un cigarrico y no puedo entrar a los chinos del Arroyuelo… Si me pillan mis hijos me arman un pollo.",
			"¿Me entras tú a comprar un paquete de *tabaco*? Te espero aquí mismo."],
		"en": ["Oi, {lad|love}, come ’ere a tick! Do an old woman a little favour, would you?",
			"I’m gasping for a ciggie and I daren’t step foot inside the Arroyuelo grocer’s… kids catch wind they’ll raise bloody Cain.",
			"Pop inside and grab us a pack of *tobacco*? I’ll hang on right ’ere."]},
	"tomasa_ask_q": {"es": "¿Me compras el *tabaco* en los chinos del Arroyuelo?", "en": "Fetch me the *tobacco* from the Arroyuelo grocer’s?"},
	"tomasa_opt_yes": {"es": "Sí, ahora te lo traigo", "en": "Aye, back in a tick"},
	"tomasa_opt_no": {"es": "No, paso", "en": "Nah, leave it"},
	"tomasa_yes": {
		"es": ["¡Ay, qué {majo|maja}! Entra ahí mismo, a los chinos del Arroyuelo, que el *tabaco* está en el pasillo de la derecha. Aquí te espero."],
		"en": ["Oh, bless you, {pet|sweetheart}! Nip straight into the Arroyuelo grocer’s—*tobacco*’s down the right-hand aisle. Waiting right ’ere."]},
	"tomasa_no": {
		"es": ["¡Menuda juventud! ¡Ni un recaíco a una mujer mayor! ¡Enga, tira pa'llá, {desagradecío|desagradecía}!"],
		"en": ["Young ’uns today! Won’t even run one errand for an old bird! Jog on then, ungrateful little sod!"]},
	"tomasa_wait": {
		"es": ["Aquí sigo esperando, {hijo|hija}. Entra a los chinos del Arroyuelo y tráeme el *tabaco*, que cuesta seis euros."],
		"en": ["Still stood ’ere waiting, {lad|love}. Nip in the Arroyuelo grocer’s for that *tobacco*—six euros it is."]},
	"tomasa_done": {
		"es": ["¡Ay, {bendito|bendita} seas! ¡Dame ese *tabaco*, que me tiemblan hasta las pestañas!",
			"Es que mis hijos me vigilan el dinero al céntimo pa que no gaste en vicios, ¿sabes?",
			"Pero yo no tengo ningún problema, ¿eh? ¡Ni gota! Yo controlo. Lo dejo cuando quiera… mañana si eso.",
			"Toma diez euricos a escondías, y chitón."],
		"en": ["Oh, God bless you! Hand over that *tobacco*, me very eyelashes are rattling!",
			"Kids count every blooming penny I spend so I don’t blow it on vices, see.",
			"Not that I’ve got a habit, mind! Not one bit! Total control. Pack it in tomorrow if I fancied… maybe tomorrow.",
			"Take this cheeky tenner on the hush, and not a dickie bird."]},
	"tomasa_after": {
		"es": [["No le digas ná a mis hijos, ¿eh? Que yo controlo de sobra."],
			["Un cigarrico al sol en el Arroyuelo alarga la vida, digan lo que digan los médicos."]],
		"en": [["Keep schtum to me kids, alright? Got it sorted, no bother."],
			["Quick puff in the sun outside Arroyuelo puts years on you, whatever them doctors waffle."]]},
	"tomasa_busy": {
		"es": ["Cuando acabes lo que llevas entre manos, acércate por aquí que te quería pedir un favorcico."],
		"en": ["Once you’ve wrapped up whatever you’re at, wander back over—wanted a quick favour."]},
	"chino_enter": {
		"es": ["¡Hola, pasar! Pero no robar nada, ¿eh? ¡Yo vigilar!",
			"¡Buenas! Mirar con ojo, no tocar bolsillo. ¡Yo vigilar todo!"],
		"en": ["Hello, come in! But no steal anything, eh? I watch!",
			"Hello! Look with eye, no put in pocket. I watch everything!"]},
	"chino_paid": {"es": "¡Gracias! Pagar bien, así gustar. ¡Volver pronto!", "en": "Thank you! Pay good, I like. Come back soon!"},
	# the pitillo (the user, 21 Nov 2026): Tomasa's smoke the first time, three to keep, more at the chinos (fumar.gd)
	"tomasa_cig_q": {"es": "Y ahora que tengo mi *tabaco*… ¿te echas un *pitillo* conmigo?", "en": "Now I’ve got me *tobacco*… fancy sharing a quick *smoke*, love?"},
	"tomasa_cig_opt_yes": {"es": "Venga, uno", "en": "Go on, just one"},
	"tomasa_cig_opt_no": {"es": "No, que yo no fumo", "en": "Nah, I don’t smoke"},
	"tomasa_cig_yes": {
		"es": ["¡Eso es! Que fumando una sola es vicio, pero fumando dos ya es tertulia.",
			"Y además, a medias se reparte la culpa… y el cáncer, ¿eh? Al cincuenta por ciento cada uno. Eso son matemáticas."],
		"en": ["Proper job! Sparking up solo is a bad habit; two together’s a natter.",
			"Besides, halving it splits the guilt… and the cancer, eh? Fifty-fifty down the middle. Pure maths, that."]},
	"tomasa_cig_no": {
		"es": ["¿Que no fumas? Anda, anda, que por uno no pasa ná. Toma, cógelo, que me haces un favor.",
			"Si me lo fumo con alguien me siento menos culpable, ¿sabes? Es como si el cáncer se partiera a medias: al cincuenta por ciento. Ciencia."],
		"en": ["Don’t smoke? Oh, give over—one puff never hurt nobody. Take one, do an old dear a turn.",
			"Sparking up with company halves the guilt, see? Like slicing the cancer clean in two: fifty per cent each. Science."]},
	"tomasa_cig_pack": {
		"es": ["¿Has visto? Un pitillo y te se va la mitad del día mirando el cielo. Así se pasa el rato en este pueblo.",
			"Quédate estos tres *pitillos* pa cuando te haga falta matar el tiempo. Y si te se acaban, en los chinos hay más."],
		"en": ["See that? One fag and half the afternoon drifts away staring at the clouds. How time flies round ’ere.",
			"Pocket these three *smokes* for when you need to kill an hour or two. Run out, grocer’s sells more."]},
	"t_pitillos": {"es": "Objeto clave: Pitillo ×%d", "en": "Key item: Smoke ×%d"},
	"inv_n_pitillo": {"es": "Pitillo", "en": "Smoke"},
	"inv_d_pitillo": {"es": "De los de la Tomasa. Te fumas uno y te se van seis horas mirando el cielo.", "en": "Tomasa’s sort. Spark one and six hours drift by staring at the clouds."},
	"pitillos_tag_buy": {"es": "Pitillos ×%d · %d €", "en": "Smokes ×%d · %d €"},
	"p_buy_pitillos": {"es": "<interact> Comprar pitillos ×%d (%d €)", "en": "<interact> Buy smokes ×%d (%d €)"},
	"pitillos_no_money": {"es": "No tiés %d € pa los pitillos.", "en": "You haven’t got %d € for the smokes."},
	"fumar_none": {"es": "No te quedan pitillos. En los chinos hay más.", "en": "Clean out of smokes. Grocer’s has plenty more."},
	"fumar_day": {"es": "Ya llevas tres pitillos hoy. Mañana más, que tampoco es plan.", "en": "That’s three smokes today already. Save some for tomorrow, steady on."},
	"fumar_car": {"es": "Aquí dentro no, que se llena el coche de humo. Bájate primero.", "en": "Not in here, the car fills with smoke. Get out first."},
	"fumar_now": {"es": "Ahora no es momento de echarse un pitillo.", "en": "Now’s not the time for a smoke."},
	"fumar_busy": {"es": "Ahora no, que tiés faena. Acaba lo que llevas entre manos.", "en": "Not now, you’ve got things to do. Finish what you’re on first."},
	"fumar_after": {"es": "Te se han ido %d horas en humo.", "en": "%d hours gone up in smoke."},
	"chino_buy": {
		"es": ["¿Buscar tabaco? Estar en pasillo de derecha, seis euros.",
			"Coger, pagar y no robar nada. Yo mirar por cámara y por ojo, ¿eh?"],
		"en": ["Look for tobacco? Be in right aisle, six euros.",
			"Take, pay and no steal anything. I watch by camera and by eye, eh?"]},
	"chino_idle": {
		"es": [["Hola, pasar, pasar. Pero tú no robar nada, ¿eh? Yo vigilar todo el rato."],
			["Si querer comprar, pagar aquí en caja. No meter cosas en bolsillo, que yo ver todo."],
			["Tener bebida fría, chuches, bazar y tabaco. Mirar tranquilo, pero no robar nada. ¡Yo vigilar!"]],
		"en": [["Hello, come in, come in. But you no steal anything, eh? I watch all the time."],
			["If want buy, pay here at till. No put things in pocket, I see everything."],
			["Have cold drink, sweets, bazar and tobacco. Look quiet, but no steal anything. I watch!"]]},
	"firma_si_tomasa": {"es": "Trae pacá, que te firmo. Por ese puente pasaba yo de moza a esconderme pa fumar el primero.", "en": "Pass it ’ere, I’ll put me scribble on it. Used to sneak under that bridge as a young lass for me first sly fag."},
	"firma_no_tomasa": {"es": "Ahora no puedo firmar ná, {hijo|hija}, que me ven mis hijos con un boli y piensan que estoy gastando en vicios.", "en": "Can’t sign owt right now, {lad|love}—me kids clock me holding a biro they’ll swear I’m buying baccy."},
	"firma_si_chino": {"es": "Vale, firmar aquí. Puente viejo ser bonito, pero tú no robar boli del mostrador, ¿eh?", "en": "Okay, sign here. Old bridge be nice, but you no steal pen from counter, eh?"},
	"firma_no_chino": {"es": "No poder firmar ahora, estar vigilar tienda y cámara. Volver otro día y comprar algo.", "en": "No can sign now, be watching shop and camera. Come back other day and buy something."},
	# ---- La Pili and her bacaladitos (pili.gd; the user, 25 Nov 2026) ----
	"n_pili": {"es": "La Pili", "en": "La Pili"},
	"n_pescadera": {"es": "La Pescadera", "en": "La Pescadera"},
	"pescadera_hola": {
		"es": ["¡Buenas! Hoy me tienen en la caja, que la pescadería está cerrá.", "¡Buenas! Si buscas boquerones, hoy no hay. Ni panga, gracias a Dios.", "¡Buenas! Pasa, pasa, que aquí no muerde nadie. Bueno, los centollos."],
		"en": ["Alright, duck! Stuck me on the till today—fish counter’s bolted shut.", "Morning, love! No anchovies today. No panga neither, praise the Lord.", "Morning! Step right in, nobody bites ’ere. Bar the spider crabs."]},
	"pescadera_idle": {
		"es": [["Yo soy la pescadera, ¿eh? Lo de la caja es de prestao. Desde lo de la Pili tengo la pescadería cerrá por luto."],
			["Treinta años limpiando pescao y ahora me ponen a pasar yogures por el lector. La vida."],
			["Tú hueles a pescao frito. No es un reproche, ¿eh? Aquí es un piropo."]],
		"en": [["Proper fishmonger by trade, mind! Till duty’s strictly temporary. Ever since that Pili carry-on the ice counter’s shut in mourning."],
			["Thirty bloomin’ years gutting hake and now I’m bleeping yoghurt pots across a scanner. Bloody life."],
			["You pong of fried fish, love. Ain’t an insult neither—round ’ere that’s high praise."]]},
	"pescadera_fetch": {
		"es": ["Si vienes por lo de la Pili, está ahí, en la primera caja.", "Cógelo y llévatelo, por lo que más quieras, que me mira desde la cinta."],
		"en": ["If you’re collecting Pili’s parcel, it’s sat over yonder at till one.", "Scoop it up and get it out me sight, for pity’s sake—keeps staring at me off the belt."]},
	"pescadera_pili": {
		"es": ["La Pili te ha dicho eso, ¿verdad? Le tenemos prohibida la entrada.",
			"¿Que por qué? Pues porque la semana pasá empezó a darle el pésame a toa la sección de congelaos…",
			"…y se llevó una panga pa darle cristiana sepultura. De mi pescadería, que lo sepas. Y yo tuve que ir al entierro."],
		"en": ["Pili spun you that yarn, didn’t she? Barred from the premises, she is.",
			"Why? Last Tuesday she marched down the freezer aisle offering her condolences to every fish finger…",
			"…then tucked a frozen panga under her coat to give it a Christian burial! Off my own ice slab, mind. And I had to attend the service."]},
	"pescadera_pili_after": {
		"es": ["Tú no has visto a la Pili por aquí, ¿verdad? Pues eso. Ni la has visto ni la vas a ver.", "Y si te pregunta, la panga estaba fresquísima."],
		"en": ["You never clapped eyes on Pili round ’ere, alright? Sorted. Never saw her, never will.", "Oh, and if she asks, that panga was fresh as a daisy."]},
	"firma_si_pescadera": {"es": "Venga, firmo, pero rápido, que se me junta la cola y me huelen las manos a merluza.", "en": "Go on, chuck us the clipboard—sharpish though, queue’s backing up and me mitts reek of hake."},
	"firma_no_pescadera": {"es": "Con estas manos no firmo yo ná, que te dejo el papel oliendo a sardina.", "en": "Not touching paper with these mitts, love—leave your petition reeking of pilchards."},
	"pili_title": {"es": "Los bacaladitos de la Pili", "en": "Pili’s little cod bites"},
	"inv_n_bacaladitos": {"es": "Bacaladitos", "en": "Little cod bites"},
	"pili_cartel": {"es": "PROHIBIDA LA ENTRADA", "en": "NO ENTRY"},
	"obj_pili_fetch": {"es": "Recoge los bacaladitos de la Pili en la primera caja del Merkocarry", "en": "Pick up Pili’s little cod bites at the Merkocarry’s first till"},
	"obj_pili_give": {"es": "Llévale los bacaladitos a la Pili, que vive por la Magdalena", "en": "Take the little cod bites to Pili, who lives up by the Magdalena"},
	"pili_chase": {
		"es": ["¡Oye, tú!", "¡Eh, tú, {el|la} de ahí!", "Espérate, que tengo que hablar contigo…", "¡Oye! ¡Que no corras, que te tengo que contar una cosa!",
			"Psss, psss… ¡tú!", "¡Que te estoy hablando, ¿eh?!", "Ay, qué prisas tié la juventú…", "¡Oye, tú, que es un momentico ná más!"],
		"en": ["Oi, you there!", "Ey up, you across the road!", "Hold your horses, need a quick word…", "Oi! Stop leg-ging it, got summat to tell you!",
			"Psst, psst… you!", "Talking to you, aren’t I?!", "Bloomin’ ’eck, young’uns tearing about like headless chickens…", "Oi, you, only takes half a tick!"]},
	"pili_intro": {
		"es": ["¡Hay que ver qué caro está el bacalao!",
			"Ya les he dicho a mis dos hijos, que tienen treinta años, que está mu caro tó, que se tienen que ir de la casa ya, que tó está mu caro y yo no los puedo mantener, ¿sabes?",
			"Por cierto, ¿sabes que se murió ayer la Laura la mamporrera?",
			"Sí, sí, hombre, la de los mamporreros. Su padre era José Julián el mamporrero.",
			"¿Cómo no vas a saber quién es? Anda con Dios…"],
		"en": ["State of the price of salt cod nowadays, blooming daylight robbery!",
			"Told me two lads—thirty years old, both of ’em!—everything’s sky-high, pack your bags and shift out ’cause I can’t keep feeding you lot, you know?",
			"Speaking of, hear Laura la Mamporrera pegged it yesterday?",
			"Aye, course you know ’er—one of the Mamporreros. Her dad was José Julián the Mamporrero.",
			"How d’you not know who she is?! Lord give me strength…"]},
	"pili_ask": {
		"es": ["Ay, {hermoso|hermosa}, creo que me he dejao los bacaladitos en la caja del Merkocarry.",
			"Anda, ¿puedes ir a por ellos, que tengo a los muchachos esperando la comida?"],
		"en": ["Ooh, {pet|love}, reckon I left me little cod bites behind by the till in Merkocarry.",
			"Be a sweetheart and nip fetch ’em—got the lads sat waiting on their tea."]},
	"pili_ask_q": {"es": "¿Le traes los bacaladitos a la Pili?", "en": "Fetch Pili’s little cod bites?"},
	"pili_opt_yes": {"es": "Venga, voy", "en": "Go on, I’m off"},
	"pili_opt_no": {"es": "Ni de coña", "en": "No blooming chance"},
	"pili_yes": {
		"es": ["¡Ay, qué rico! En la primera caja, la del rincón. Yo me voy pa casa, por la Magdalena, que los muchachos se me comen las patas de la mesa.",
			"Y no tardes, que luego se me ponen tontos. Bueno, más tontos."],
		"en": ["Oh, proper angel! Till number one, tucked in the corner. I’m toddling back up Magdalena way afore the lads gnaw the table legs off.",
			"Don’t dawdle neither—turn proper daft when their bellies rumble. Well, dafter."]},
	"pili_no": {
		"es": ["¡Pues vaya! Con lo {majo|maja} que paecías. Ya se lo diré a tu madre.",
			"Bueno, a tu madre no, que no sé quién es. Pero a alguien se lo digo, ¿eh? A alguien se lo digo."],
		"en": ["Charming! Look butter wouldn’t melt too. Having a word with your mam, I am.",
			"Well, not your mam, haven’t a clue who she is. Still telling someone, mind! Wait and see."]},
	"pili_busy": {
		"es": ["Uy, que vas {liao|liá}. Bueno, pues luego te cuento lo de la Laura la mamporrera, que tiene miga. Y lo de mi juanete."],
		"en": ["Ooh, got your hands full, love. Catch you later then—still owe you the tale of Laura la Mamporrera. And me bunion."]},
	"pili_wait": {
		"es": ["¿Y los bacaladitos? Que los muchachos ya están royendo el mantel.", "En la caja del Merkocarry, {hermoso|hermosa}. ¡La primera!"],
		"en": ["Where’s me cod bites then? Lads are chewing the tablecloth by now.", "By the till inside Merkocarry, {lad|love}. First one on the left!"]},
	"pili_done": {
		"es": ["¿Me has traío los bacaladitos? Bendito seas.", "….", "¿Esto es una puta panga?",
			"¿Qué te crees, que por vivir en la Magdalena comemos carroña? ¡Anda y veste a tomar por culo!"],
		"en": ["Fetched me little cod bites? Bless your cotton socks.", "….", "Is this a fucking panga?!",
			"What, reckon ’cause we live up the Magdalena we dine on bin scraps?! Jog right off and boil your head!"]},
	"pili_after": {
		"es": [["¿Tú tiés novio o novia? Porque a tu edad yo ya había enterrao a uno.", "Es broma. Bueno, medio broma. Del susto se murió, eso sí."],
			["Me ha salío un bulto en la ingle que paece un garbanzo. ¿Quiés verlo?", "¡Pues tú te lo pierdes!"],
			["¿Cuánto cobras tú? Porque tiés cara de no llegar a fin de mes.", "No te ofendas, que yo tampoco llego. Llego al día quince y de ahí pa allá rezo."],
			["Mis muchachos siguen en casa. Treinta años y la ropa se la lava su madre.", "Ayer le planché los calzoncillos al mayor y lloré. De pena, no de emoción."],
			["¿Tú vas bien de vientre? Yo desde lo de la panga no.", "Ni me la menciones, que me sube la bilis. ¡La panga!"],
			["Yo voy al médico tos los martes, aunque no me pase ná. Pa que me tomen la tensión y pa enterarme de quién está malo.", "Que una tiene que estar informá."],
			["Oye, ¿y tú por qué no te casas? ¿Es que no te quiere nadie? Es normal, no te preocupes.", "Yo me casé con el primero que me sacó a bailar. Y mira, ni bailaba."],
			["Mi marido, que en paz descanse, roncaba como un tractor. Ahora duermo con la radio puesta pa no echarlo de menos.", "Bueno, de menos no. Pa no echar de menos el ruido."],
			["¿Esa camiseta es nueva? Te hace más {gordo|gorda}. Pero bien, ¿eh? Saludable.", "Yo tengo una igual, pero me la pongo pa fregar."]],
		"en": [["Got a sweetheart yet? By your age I’d already put one in the churchyard.", "Only kidding. Half kidding anyway—fella keeled over from fright, mind."],
			["Sprouted a lump down me groin big as a chickpea. Fancy a gander?", "Your bloomin’ loss then!"],
			["What’s your wage packet like? Got the mug of someone who runs skint before payday.", "No offence, love—same boat. Make it to the fifteenth then live on prayers."],
			["Me lads are still parked under me roof. Thirty years old and their mam still scrubs their smalls.", "Ironed the eldest’s kecks yesterday and burst into tears. Out of sheer despair, not pride."],
			["Staying regular, are you? Me bowels’ve packed up since that panga business.", "Don’t whisper the word—turns me stomach clean over. Bloody panga!"],
			["Pop down the surgery every Tuesday, fit as a fiddle or not. Get me pressure done and catch up on who’s poorly.", "Woman’s gotta stay abreast of the village news."],
			["Tell us, why ain’t you wed? Nobody fancy you? Fair enough, wouldn’t fret.", "Took the first bloke asked me for a waltz. Turned out he had two left feet too."],
			["Me husband, God rest him, snored loud as a combine harvester. Leave the wireless on all night now so I don’t miss him.", "Well, not him. Miss the racket."],
			["New top, is it? Makes you look proper chunky. In a nice way, mind—bonny.", "Got the exact same rag meself. Keep it for scrubbing the scullery."]]},
	"firma_si_pili": {"es": "¡Trae, que firmo! Por ese puente pasaba yo con mi novio a escondías. Con el que no me casé, digo.", "en": "Chuck it ’ere, I’ll sign! Used to creep across that bridge with me fella on the sly. Not the one I married, mind."},
	"firma_no_pili": {"es": "¿Firmar yo? Que la última vez que firmé algo me casé. Ni hablar.", "en": "Me put pen to paper? Last time I signed a form I wound up wed. Jog on."},
	# ---- Tía Paca rings when you have been idle (fondo_casa.gd _ocio; the user, 25 Nov 2026) ----
	"paca_ocio": {
		"es": ["¡Hola, prenda! Que soy la tía Paca.", "¿Se pué saber qué haces tan {ocioso|ociosa}? Que no paras de dar vueltas como un pato mareao.",
			"Si no tiés ná que hacer, igual alguien tiene algún recado pa ti en %s.", "Arrea pa allá, que la ociosidá es la madre de tos los vicios. Y de alguna multa."],
		"en": ["Ey up, {lad|pet}! Tía Paca on the blower.", "Mind telling us why you’re mooching about so bone-idle? Spinning circles like a dizzy duck, you are.",
			"If you’re twiddling your thumbs, somebody’s bound to need an errand round %s.", "Get shifting—idle hands are the devil’s workshop. And the Coppers’ fine-book."]},
	"ocio_pueblo": {"es": "el pueblo", "en": "town"},
	"firma_si_maxi": {"es": "¡Maxifirma! Trae, que pa salvar el puente echo la firma más grande que haya visto el pueblo.", "en": "Maxi-autograph! Pass it over—for our bridge I’ll slap the biggest signature this village ever clocked."},
	"firma_no_maxi": {"es": "Ahora no, que estoy con el maxiinventario y como pierda la cuenta empiezo otra vez desde los calcetines.", "en": "Not now, love—knee-deep in the maxi-stocktake, lose count and I’m back down at the socks."},
	"firma_si_manuela": {"es": "¡Pisafirma! Trae, que por ese puente he pisao yo más que por la tienda.", "en": "Tread-signature! Pass it ’ere—trod more miles over that bridge than round me own stockroom."},
	"firma_no_manuela": {"es": "Ahora no puedo, {hermoso|hermosa}, que tengo el boli pa los recibos y como se me vaya la tinta no cobro.", "en": "Can’t spare the biro right now, {lad|love}—me till pen runs dry, nobody pays for their boots."},
	"firma_si_pochi": {"es": "Trae, pesao. Firmo pa que me dejes en paz, no por el puente, que me la suda.", "en": "Chuck it ’ere, you melt. Signing to get shot of you, couldn’t give a toss about the bridge."},
	"firma_no_pochi": {"es": "Que no firmo ná, plasta. Vuelve cuando hayas visto un anime entero.", "en": "Ain’t signing jack, bore off. Come back once you’ve finished one proper anime series."},
	"firma_si_angelus": {"es": "Trae. Un puente no es de aquí ni de allí, tío… como yo. Firmo.", "en": "Pass it ’ere, mate. A bridge belongs neither ’ere nor there… bit like meself. I’ll sign."},
	"firma_no_angelus": {"es": "Ahora no, tío, que estoy pensando en una cosa mu gorda. Luego.", "en": "Not right now, mate—head’s wrapped round summat proper deep. Catch us later."},
	"firma_si_foski": {"es": "Trae, hostia, que firmo. Un puente viejo, feo y hecho polvo: es como yo, cómo no lo vía defender.", "en": "Pass it over, bloody ’ell, I’ll sign. Knackered old battered bridge—spitting image of me, gotta back it up."},
	"firma_no_foski": {"es": "Ahora no, coño, que me tiemblan las manos del café. Luego te firmo eso y lo que haga falta.", "en": "Not right now, mate, me mitts are jittering off three coffees. Catch me later and I’ll sign the lot."},
	"firma_si_ezequiel": {"es": "Trae. He firmao cosas peores a las cinco de la mañana, y esta por lo menos la vía leer.", "en": "Stick it ’ere. Signed dodgier paperwork than this at five in the morning—least I’ll read this one first."},
	"firma_no_ezequiel": {"es": "Yo detrás de la barra no firmo ná. La última vez acabé avalando un tractor.", "en": "Never sign owt behind this bar, mate. Last time I wound up guarantor on someone’s tractor."},
	"firma_si_frank": {"es": "¡Un autógrafo de Frank Málaga pa el puente! Guárdalo, que cualquier día vale dinero.", "en": "Exclusive Frank Málaga autograph for the bridge! Frame it, mate—worth serious brass one day."},
	"firma_no_frank": {"es": "Ahora no, que estoy en mitad de una mezcla. Si suelto los cascos se me va la sala.", "en": "Can’t now, mid-transition ’ere. Take me cans off and I’ll trainwreck the whole floor."},
	"firma_si_fatima": {"es": "Firmo, que lé leío bien, que pa eso tengo la vista graduá.", "en": "I’ll sign, read every word crystal clear—that’s what twenty-twenty specs are for."},
	"firma_no_fatima": {"es": "Ahora no, {hermoso|hermosa}, que sin leerme la letra pequeña yo no firmo ná.", "en": "Not just now, {lad|love}—never sign owt without inspecting the small print first."},
	"firma_si_koke": {"es": "Trae, trae. Ese puente me l'he pasao yo a ciento veinte con el taxi y ni se ha quejao. Hay que cuidarlo.", "en": "Pass it ’ere, pass it ’ere. I’ve belted over that bridge at a hundred and twenty in the cab and it never made a peep. Proper solid, needs lookin’ after."},
	"firma_no_koke": {"es": "Uf, ahora no, que me tiembla el pulso y me sale una firma que paece un electrocardiograma.", "en": "Oof, not right now, mate—me hands are shakin’ so bad me signature’ll look like a heart monitor." },
	# ---- Xandro and Street Races (xandro.gd) ----
	"n_xandro": {"es": "Xandro", "en": "Xandro"},
	"xandro_call": {
		"es": ["¿Oye, tú eres el puto loco que he visto conduciendo a toa leche por el pueblo atropellando a tó lo que se mueve?",
			"Soy Xandro, el del taller de la carretera de Villacañas, Talleres Xandro.",
			"Tengo un trabajito que igual te interesa. Pásate por mi taller cuando puedas y hablamos."],
		"en": ["Oi, are you the bloody nutter I clocked tearin’ through town flat out mowin’ down everything on two legs?",
			"It’s Xandro ’ere, from the garage out on the Villacañas road—Talleres Xandro.",
			"Got a little earner might suit you. Pop down my gaff when you’ve got a minute and we’ll ’ave a word."]},
	"t_xandro_call": {"es": "Nuevo contacto: Xandro te espera en Talleres Xandro (Ctra. de Villacañas) pa hablarte de carreras callejeras.",
		"en": "New contact: Xandro is waiting at Talleres Xandro (Villacañas road) to tell you about street racing."},
	"xandro_intro": {
		"es": ["Mira que hay que estar mu loco, mu drogao o ser de Camuñas pa conducir así por medio del pueblo… En cualquier caso, eso yo lo respeto.",
			"Aquí en el pueblo ya sabes que hay cierta tradición de no respetar demasiao las normas de circulación: gente andando por mitad de la calle, límites de velocidá más bien «opinables» u «orientativos», coches aparcaos en la acera o en mitad de una rotonda, tractores sin ITV desde la época de Franco…",
			"Total, que a algunos les gusta echar una carrerita de vez en cuando por las noches, y yo hago algo así como de «mánager» entre corredores. Igual te interesa, porque hay dinero por medio.",
			"La primera carrera es aquí mismo, esta noche, de principiantes: ocho Setas Panda de distintos colores saliendo desde mi taller.",
			"Si no tiés Seta propio ahora mismo, yo te «alquilo» uno a cambio de una comisión del 10 % sobre lo que ganes. Si traes tu propio Seta, te lo llevas limpio.",
			"La inscripción son 100 €. El primero se lleva 500 €, el segundo 200 € y el tercero 100 €. Con quedar entre los tres primeros me demuestras lo que vales, y si pinchas hoy podrás repetir hasta que hagas podio sin volver a pagar."],
		"en": ["Look, you’ve gotta be proper mental, off your head, or from Camuñas to drive like that round town… Either way, fair play, I respect it.",
			"Round ’ere, see, we’ve got a proud tradition of treatin’ the Highway Code as… shall we say, «open to debate» or «roughly advisory»: punters strollin’ down the middle of the tarmac, motors dumped on the pavement or smack in a roundabout, tractors that ain’t seen an MOT since Franco’s days…",
			"Long and short, a few of the lads fancy a cheeky late-night tear-up now and then, and I sort of «manage» the runners. Might be right up your street—there’s proper wedge on the table.",
			"First run’s tonight right outside me garage, rookies’ heat: eight Seta Pandas in different colours off the line together.",
			"If you ain’t got your own Seta motor right now, I’ll «lend» you one for a 10% cut of whatever you bag. Turn up in your own Seta and you keep the lot.",
			"Stake’s 100 €. First pockets 500 €, second 200 €, third gets their 100 € back. Crack the top three to show me what you’re made of—bottle it tonight and you can line back up free till you make the podium."]},
	"xandro_retry": {
		"es": ["¿Qué pasa, {socio|socia}? ¿Ya venías con ganas de revancha en {ruta}?",
			"Como toavía no has hecho podio conmigo, esta corre por mi cuenta: 0 € de entrada. {nota}"],
		"en": ["Alright, {mate|love}? Back for another crack at {ruta}?",
			"Since you ain’t made the podium for me yet, your spot’s on the house: 0 € stake. {nota}"]},
	"xandro_daily": {
		"es": ["¿Qué hay, piloto? Esta noche toca correr en {ruta}.",
			"Ocho Setas Panda en parrilla, 100 € de entrada —y si quedas cuarto o peor, los pierdes—. Premios: 500 € / 200 € / 100 €. {nota}"],
		"en": ["Wotcher, wheelman! Tonight’s run is {ruta}.",
			"Eight Seta Pandas on the grid, 100 € stake—4th or worse and your brass is gone—. Purse: 500 € / 200 € / 100 €. {nota}"]},
	"xandro_loan_note": {"es": "Te presto un Seta Panda mío (me llevo un 10 % de comisión del premio).",
		"en": "I’ll lend you one of my Seta Pandas (I take a 10% cut of the pot)."},
	"xandro_own_note": {"es": "Vienes con tu propio Seta Panda: sin comisión, el premio íntegro es tuyo.",
		"en": "You brought your own Seta Panda: 0% cut, the whole pot’s yours."},
	"xandro_q_mission": {"es": "¿Pagas 100 € y corremos esta noche el {ruta}?", "en": "Drop 100 € and line up tonight on {ruta}?"},
	"xandro_q_retry": {"es": "¿Volvemos a tirar esta noche en el {ruta}?", "en": "Want another go tonight on {ruta}?"},
	"xandro_q_daily": {"es": "¿Te apuntas a la carrera de hoy ({ruta}) por 100 €?", "en": "In for tonight’s run ({ruta}) at 100 €?"},
	"xandro_opt_yes_paid": {"es": "Vamos allá (−%d €)", "en": "Count me in (−%d €)"},
	"xandro_opt_yes_free": {"es": "Vamos allá (reintento gratis)", "en": "Count me in (free retry)"},
	"xandro_opt_no": {"es": "Ahora no", "en": "Not now"},
	"xandro_decline": {"es": ["Tú mismo, aquí estoy cuando te piquen las manos al volante."],
		"en": ["Suit yourself, {mate|love}. You know where I am when your hands get itchy on the wheel."]},
	"xandro_poor": {"es": ["Te faltan cuartos, {campeón|campeona}: necesitas %d € pa entrar en parrilla."],
		"en": ["You’re skint, {mate|love}: need %d € to buy your spot on the grid."]},
	"xandro_busy": {"es": ["¡Deja de charlar y pisa a fondo, que los otros siete no esperan!"],
		"en": ["Quit yapping and stick your boot down—the other seven ain’t waitin’!"]},
	"xandro_done_today": {
		"es": [["Por hoy ya hemos quemao bastante rueda. Mañana montamos otra ruta."],
			["Los Pitufos ya están mirando de reojo por la carretera de Villacañas. Vuelve mañana."]],
		"en": [["Burnt enough rubber for one night, mate. Come back tomorrow for a fresh route."],
			["The Smurfs are already nosin’ up the Villacañas road. Try again tomorrow."]]},
	"xandro_other_job": {"es": ["Acaba primero lo que tiés entre manos y luego vienes a correr."],
		"en": ["Wrap up whatever job you’re on first, then come back for a race."]},
	"xandro_route_0": {"es": "Circuito de las Rondas", "en": "Ring Road Circuit"},
	"xandro_route_1": {"es": "Las Avenidas", "en": "The Avenues"},
	"xandro_route_2": {"es": "Sprint al Ferial", "en": "Fairground Sprint"},
	"faena_title_xandro": {"es": "Carreras Callejeras", "en": "Street Racing"},
	"xandro_go": {"es": "¡ARREA!", "en": "GO!"},
	"xandro_lap": {"es": "Vuelta", "en": "Lap"},
	"xandro_cp": {"es": "Punto", "en": "Check"},
	"xandro_wait_light": {"es": "Espera al semáforo en parrilla…", "en": "Hold on the grid for the light…"},
	"obj_xandro": {"es": "%s · Punto %d/%d", "en": "%s · Check %d/%d"},
	"t_xandro_launch": {"es": "¡Salida lanzada!", "en": "Rocket launch!"},
	"t_xandro_lap2": {"es": "¡Última vuelta!", "en": "Final lap!"},
	"t_xandro_won_mission": {"es": "¡%d.º puesto! Cobras %s. Ya eres corredor habitual: vuelve cada día por una ruta nueva.",
		"en": "%d place! Won %s. You’re in the circuit now: come back each day for a new route."},
	"t_xandro_won_comm": {"es": "¡%d.º puesto! Cobras %s (−%s de comisión de Xandro). ¡Carreras diarias desbloqueadas!",
		"en": "%d place! Won %s (−%s Xandro’s cut). Daily races unlocked!"},
	"t_xandro_won_daily": {"es": "¡%d.º puesto! Premio íntegro pa ti: +%s.",
		"en": "%d place! Full prize is yours: +%s."},
	"t_xandro_won_daily_comm": {"es": "¡%d.º puesto! Cobras %s (−%s de comisión por el coche prestao).",
		"en": "%d place! Won %s (−%s cut for the loaner car)."},
	"t_xandro_lost_mission": {"es": "Has quedao %d.º… Vuelve a hablar con Xandro pa repetir gratis hasta entrar en podio.",
		"en": "Finished %d… Talk to Xandro again to retry for free until you make the podium."},
	"t_xandro_lost_daily": {"es": "Has quedao %d.º y pierdes los 100 € de entrada. Mañana tendrás revancha en otra ruta.",
		"en": "Finished %d and lost your 100 € buy-in. New route tomorrow."},
	"t_xandro_aborted": {"es": "Carrera abandonada.", "en": "Race abandoned."},
	"firma_si_xandro": {"es": "Trae ese papel, hombre. Por ese puente pasamos a fuego cuando no miran los Pitufos. Firmao.",
		"en": "Pass it ’ere, mate. We fly over that bridge flat out whenever the Smurfs aren’t lookin’. Signed."},
	"firma_no_xandro": {"es": "Ahora estoy cuadrando las apuestas de esta noche, luego te echo la firma.",
		"en": "Up to me neck sortin’ tonight’s odds right now, mate—catch me later for the autograph."},
}
