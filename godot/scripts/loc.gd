	"dlg_next": {"es": "<interact>", "en": "<interact>"},
	"tow_call": {"es": ["¿Grúas El Enganche? Que se me ha quedao el coche tirao. Sí, otra vez. Sí, el mismo.",
			"Mándame la grúa y espáchate, que estoy aquí al ventestate.",
			"¿Cuánto dices que tarda? ¿Y si te digo que al almuerzo invito yo?",
			"Que no, que no es la batería. …Bueno, igual es la batería. Tú ven."],
		"en": ["Grúas El Enganche? My car’s died on me. Yes, again. Yes, the same one.",
			"Send the tow truck and get a move on, I’m standing out here in the weather.",
			"How long did you say? And what if I told you lunch is on me?",
			"No, it’s not the battery. …All right, it might be the battery. Just come."]},
