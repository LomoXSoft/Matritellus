	"kata_tk_won": {"es": ["…ha sío el mando. Este mando está cascao.", "No vale. Estaba calentando.", "¿Otra? Otra. Ahora en serio.", "Eso no me lo haces tú en el foro."],
		"en": ["…it was the stick. This stick's knackered.", "Doesn't count. I was warming up.", "Another? Another. For real this time.", "You wouldn't pull that on me on the forum."]},
	"kata_tk_lost": {"es": ["Frame data, {amigo|amiga}. Frame data.", "Ni el alcalde me dura tanto.", "Buen intento. Ya casi me rozas.", "Eso te pasa por no cancelar."],
		"en": ["Frame data, my friend. Frame data.", "Even the mayor doesn't last me that long.", "Good try. You nearly touched me.", "That's what you get for not cancelling."]},
