	"aj_lost": {"es": "Jaque mate. Ha ganao el alcalde.", "en": "Checkmate. The mayor wins."},
	"aj_draw": {"es": "Tablas.", "en": "A draw."},
	"aj_thinking": {"es": "El alcalde está pensando…", "en": "The mayor is thinking…"},
