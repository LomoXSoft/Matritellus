	# ---------- mission dialogue ----------
	"paca_intro": {
		"es": ["¡Ay, {hermoso|hermosa}! Tiés cara de calcetín hervío. Enga, por lo menos estás {despierto|despierta}.",
			"Al bar de tu primo Eusebio se l'á acabao el aceite. Y un bar en La Mancha sin aceite es un cuarto ande los hombres esperan a morirse.",
			"Tira pa la Cooperativa, por la carretera de arriba. La Loli te tiene apartás seis botellas.",
			"Aluego las llevas al kiosco de la Plaza del Ayuntamiento. En cuanto las cargues tiés DOS minutos, que los del almuerzo se amotinan.",
			"La última vez se comieron una silla. Coge mi furgoneta, la Z15 blanca. Tiene velocidad insistida: hay que insistirle pa que acelere."],
		"en": ["Ay, {niño|niña}. You look like a boiled sock. Good, you’re awake.",
			"Your cousin Eusebio’s bar has run out of olive oil. A bar in La Mancha with no oil is just a room where men wait to die.",
			"Drive to the Cooperativa, up the north-east road. Loli has six bottles for you.",
			"Then take them to the kiosk in the Plaza del Ayuntamiento. Once they’re loaded you have TWO minutes before the breakfast crowd riots.",
			"Last time they ate a chair. Take my van — the white Z15. It has “insisted speed”: you have to insist before it speeds up."]},
	"paca_coop": {"es": ["¿Entoavía estás aquí, bacín? ¡A la Cooperativa! Sigue la raya amarilla del mapa, lumbrera."],
		"en": ["Why are you still here? The Cooperativa. Follow the yellow line on your little map, genius."]},
	"paca_kiosk": {"es": ["¡A LA PLAZA, criatura! Que te quito de la herencia. Es una herencia corta: es un jamón."],
		"en": ["THE PLAZA, criatura! I will write you out of the will. It’s a short will. It’s a ham."]},
	"paca_idle": {"es": ["No lo estás haciendo mal del to. No te lo creas mucho, que en esa cabeza hay sitio de sobra."],
		"en": ["You’re not doing badly. Don’t let it go to your head, there’s plenty of room in there."]},
	"paca_night": {
		"es": ["¡Vaya horas, {galán|reina}! Ni que vinieras de la vendimia.",
			"Has traío el aceite, has llevao a la Maruja al velatorio y no has matao a nadie. Que yo sepa.",
			"Enga, a la cama. Mañana me hace falta un favor en el cementerio. Ponte algo oscuro."],
		"en": ["Look at the time, {galán|reina}. Anyone would think you’d been at the grape harvest.",
			"You fetched the oil, you drove Maruja to the wake and you killed nobody. That I know of.",
			"Enga, off to bed. Tomorrow I need a favour at the cemetery. Wear something dark."]},
	"loli_load": {
		"es": ["¿Tú eres {el sobrino|la sobrina} de la Paca? Me dijo que tenías cara de decepción. Lo ha clavao.",
			"Te abro el portón. Pasa con el coche hasta el palé, que las botellas no andan solas.",
			"Seis del bueno, en la baca. Sí, en el techo. Es tradición y además hemos perdío las cajas.",
			"Cada porrazo, una botella menos. Y en cuanto cargues, dos minutos y medio hasta la Plaza del Ayuntamiento. ¡Arreando!"],
		"en": ["You’re Paca’s {nephew|niece}? She said you’d have a disappointed face. Nailed it.",
			"I’ll open the gate. Drive in as far as the pallet — the bottles won’t walk out on their own.",
			"Six bottles of the good stuff, on the roof rack. Yes, the roof. It’s tradition, and we lost the boxes.",
			"Every bump, one bottle less. Once you’re loaded: two and a half minutes to Plaza del Ayuntamiento. Go, ¡arreando!"]},
	"loli_busy": {"es": ["¡Tira, TIRA! Cada segundo que pierdes aquí se seca una tostá y un viejo pierde la esperanza."],
		"en": ["Go, GO. Every second you stand here, a tostada goes dry and an old man loses hope."]},
	"loli_idle": {"es": ["Bienvenío a la Cooperativa. Virgen extra. No como medio pueblo.", "Aquí prensamos la aceituna hasta que confiesa."],
		"en": ["Welcome to the Cooperativa. Extra virgin. Unlike most of this town.", "We press the olives until they confess."]},
	"eusebio_wait": {"es": ["Sin aceite no hay tostás, y sin tostás no hay paz.", "Esta mañana uno me ha pedío MANTEQUILLA. He avisao a la Guardia Civil."],
		"en": ["No oil, no tostadas, no peace.", "A man asked for BUTTER this morning. I have called the Guardia Civil."]},
	"eusebio_6": {"es": "¡¿Seis de seis?! Te daba un abrazo, pero he visto cómo conduces.", "en": "Six out of six?! I’d hug you, but I’ve seen how you drive."},
	"eusebio_mid": {"es": "%d botellas. Las otras estarán con Dios, digo yo. Enga. ENGA.", "en": "%d bottles. The rest are “with God”, I assume. Fine. FINE."},
	"eusebio_low": {"es": "%d na más. A tostá por cabeza y a rezar.", "en": "Just %d. One tostada per customer and we pray."},
	"eusebio_thanks": {"es": "Has salvao el almuerzo. En este pueblo eso es casi ser santo. De los baratos, pero santo.",
		"en": "You saved breakfast. In this town that makes you basically a saint. A cheap one, but still."},
	"eusebio_done": {"es": ["Ya hay paz. Nadie se ha comío los muebles. Lloraría, pero estoy de turno."],
		"en": ["Peace is restored. Nobody ate furniture. I may cry, but I’m on shift."]},
	"maruja_m2": {
		"es": ["¡Macho, qué bien que te veo! Tú que tiés coche: llévame al tanatorio, que hay velatorio.",
			"Al muerto no lo conozco de na. Pero me han dicho que ponen pastas y que la viuda ha venío mu pintá.",
			"Yo no cotilleo, {hermoso|hermosa}. Yo archivo. Enga, arrea, y no corras, que el muerto no se va a ir."],
		"en": ["Macho, just the person! You’ve got a car: drive me to the funeral home, there’s a wake.",
			"I never met the deceased. But I hear there are biscuits and the widow turned up in full make-up.",
			"I don’t gossip, cariño. I archive. Off we go, and no speeding, the dead man isn’t going anywhere."]},
	"venancio_m2": {
		"es": ["¡Hombre, la Maruja! Pasa, pasa, que has llegao antes que la familia. Como siempre.",
			"Y tú, {el|la} chófer. Conduces mu alegre. Toma una tarjeta. También vale de cupón.",
			"Anda, tira pa casa, que ya oscurece y tu tía es de las que cuentan los minutos."],
		"en": ["Maruja! Come in, come in, you beat the family here. As always.",
			"And you, the chauffeur. Cheerful driving. Have my card. It’s also a coupon.",
			"Go on home, it’s getting dark and your aunt counts the minutes."]},

	# ---------- idle chatter ----------
	"anselmo": {
		"es": [["Dios te bendiga, {hijo|hija}. Se confiesa los jueves. Tráete merienda, que lo tuyo va pa largo."],
			["Tengo enterrao a medio pueblo.", "El otro medio me debe dinero."],
			["Dios lo ve to.", "Menos mal que no está en el grupo de guasap de las vecinas."]],
		"en": [["Bless you, my child. Confession is on Thursdays. Bring snacks — yours tend to run long."],
			["I have buried half this town.", "The other half owes me money."],
			["God sees everything.", "Luckily He’s not in the neighbourhood WhatsApp group."]]},
	"ramirez": {
		"es": [["El cinturón, {ciudadano|ciudadana}. No es por su seguridad.", "Es pa que el cuerpo no se desparrame, que aluego el papeleo es mu malo."],
			["Paré un tractor que iba a 12 por zona de 50. El conductor iba borracho.", "El tractor también."],
			["Si tiés que atropellar a alguien, que sea a uno que me caiga mal.", "Te paso una lista. Va por orden alfabético."],
			["Me jubilé hace dos años. Aquí sigo.", "Por amor al arte. El tricornio no se jubila, se jubila uno."],
			["Yo no soy de aquí, ¿eh? Pero Madridejos me necesita.", "Nadie me ha dicho que me vaya. Será por algo."]],
		"en": [["Seatbelt, citizen. It’s not for your safety.", "It keeps the body in one place for the paperwork."],
			["I pulled over a tractor doing 12 in a 50. The driver was drunk.", "So was the tractor."],
			["If you must run somebody over, pick somebody I dislike.", "I’ll send you a list. It’s alphabetical."],
			["I retired two years ago. Still here.", "For the love of it. The tricorn doesn’t retire: the man does."],
			["I’m not from here, you know. But Madridejos needs me.", "Nobody’s told me to go. There must be a reason."]]},
	# Dolores, forever up and down the Calle de la Amargura, complaining of its name (the user, 16 November 2026: not
	# a word about her own)
	"dolores": {
		"es": [["¡Ay, {hijo|hija}! ¿Tú sabes cómo se llama esta calle? ¡La Amargura!", "¿A quién se le ocurre? ¿Al concejal de los disgustos?", "Le das las señas al del butano y se te pone a llorar el hombre."],
			["Cuarenta años viviendo aquí y entoavía me da apuro decirlo.", "«¿Ande vive usté, señora?» «En la Amargura.» Y te miran con una pena…", "Podían haberle puesto la calle de la Alegría. O del Chorizo. Algo que dé gusto."],
			["Yo doy vueltas por aquí a ver si la calle se anima, ¿sabes?", "Pero na. Ni un geranio en flor. Con ese nombre, ¿qué quieres?", "Hasta los gatos van cabizbajos."],
			["Le he pedío al alcalde que le cambie el nombre.", "Dice que eso cuesta dinero, que hay que cambiar las placas.", "¡Pues que les dé la vuelta y escriba por detrás, que es gratis!"],
			["Mi hermana vive en la calle de la Paz. ¡La de la Paz!", "Y aquí una, en la Amargura, como si hubiera hecho algo.", "Desde que me lo dijo, ni la felicito por su santo."]],
		"en": [["Oh, {hijo|hija}! Do you know what this street is called? Bitterness Street! La Amargura!", "Who thinks of these things? The councillor for misery?", "You give the gas man your address and the poor man bursts into tears."],
			["Forty years living here and I still go red saying it.", "“Where do you live, señora?” “On the Amargura.” And they look at you so sorry…", "They could have called it Joy Street. Or Chorizo Street. Something nice."],
			["I walk up and down to see if the street cheers up, you know?", "Nothing. Not one geranium in flower. With a name like that, what do you expect?", "Even the cats walk with their heads down."],
			["I asked the mayor to change its name.", "He says that costs money, the signs have to be changed.", "Then turn them round and write on the back, that’s free!"],
			["My sister lives on Calle de la Paz. Peace Street!", "And here’s me on the Amargura, as if I’d done something.", "Since she told me, I don’t even wish her a happy saint’s day."]]},
	# Niño Negro Gordo de Pueblo, by the square's playground (the user, 16 Nov 2026): he only talks about going to the pool
	# to eat salchipapas, his bike all day, the sandwiches he likes and why each one; and once, that he is fed up with his
	# mother telling him how fat he is
	"feliciano_dia": {"es": "un día", "en": "one day"},
	"feliciano_dias": {"es": "%d días", "en": "%d days"},
	"feliciano_jueves": {
		"es": [["¡Jueves! ¡Hoy es jueves, criatura!", "Hoy el Henry saca el jamón asao. Llevo desde el viernes pasao contando las horas.", "Tú vente pa la puerta de la Cocina, que hoy hay jamón pa quien quede en pie."],
			["¿Hueles eso? Eso es el jamón del Henry, que ya está en el horno.", "Me he levantao a las seis pa estar el primero. Bueno, a las cinco. Bueno, no he dormío."],
			["Hoy no hay campana que me amargue, ni monjas, ni na.", "Hoy es jueves. Y el jueves, jamón asao. Es la ley de Dios y la del Henry."],
			["Jamón asao, jamón asao, jamón asao…", "Perdona, es que me lo repito pa que no se me olvide lo feliz que soy."]],
		"en": [["Thursday! It's Thursday today, my lad!", "Today Henry brings out the roast ham. I've been counting the hours since last Friday.", "You come to the door of the Cocina, today there's ham for whoever is left standing."],
			["Can you smell that? That's Henry's ham, already in the oven.", "I got up at six to be the first. Well, at five. Well, I didn't sleep."],
			["No bell to sour me today, no nuns, nothing.", "Today is Thursday. And Thursday means roast ham. It's God's law and Henry's."],
			["Roast ham, roast ham, roast ham…", "Sorry, I keep saying it so I don't forget how happy I am."]]},
	"feliciano_semana": {
		"es": [["Ay… Entoavía quedan {dias} pa'l jueves.", "Y yo aquí, con el estómago esperando como un perro a la puerta."],
			["¿Sabes lo que es esperar una semana entera por un jamón?", "Pues yo lo sé. Lo sé cincuenta y dos veces al año."],
			["Faltan {dias} pa'l jueves.", "Lé contao en el calendario de la cocina. Lé tachao con boli rojo. Lé vuelto a contar. Siguen faltando {dias}."],
			["Esta noche he soñao con el jamón del Henry.", "Me he despertao con la almohada mordía."],
			["Mi mujer dice que tengo un problema con el jamón asao.", "Yo le digo que el problema es que solo lo hacen los jueves."]],
		"en": [["Oh… There's still {dias} to go until Thursday.", "And here I am, my stomach waiting like a dog at the door."],
			["Do you know what it is to wait a whole week for a ham?", "Well, I do. I know it fifty-two times a year."],
			["{dias} to go until Thursday.", "I've counted them on the kitchen calendar. Crossed them out in red. Counted them again. Still {dias}."],
			["Last night I dreamt of Henry's ham.", "I woke up with the pillow bitten."],
			["My wife says I have a problem with roast ham.", "I tell her the problem is they only make it on Thursdays."]]},
	"feliciano_campana": {
		"es": [["¿Lo oyes? ¡Talán, talán! La campana de las monjas.", "Toas las horas, tos los días, a toas horas. Ni el Henry es tan puntual. Y mira que lo es con el jamón."],
			["Esa campana me tiene frito. Cada hora en punto: ¡dong!", "Y yo cada vez pienso: una hora menos pa'l jueves. Es lo único bueno que tiene."],
			["Las clarisas tocan la campana cada hora. A las tres de la mañana también, ¿eh?", "Si la tocaran los jueves cuando sale el jamón, pase. Pero a las tres de la mañana…"]],
		"en": [["Hear that? Ding, dong! The nuns' bell.", "Every hour, every day, at all hours. Not even Henry is that punctual. And he is, with the ham."],
			["That bell has me worn out. Every hour on the hour: dong!", "And every time I think: one hour less to Thursday. It's the only good thing about it."],
			["The Poor Clares ring the bell every hour. At three in the morning too, you know?", "If they rang it on Thursdays when the ham comes out, fair enough. But at three in the morning…"]]},
	"nino_negro": {
		"es": [["¿Vas a ir a la piscina? Yo voy tos los días que abren, a las doce en punto, el primero.", "Me tiro de bomba y salpico hasta al socorrista. Dice que hago olas.",
				"Y luego al chiringuito: un plato de salchipapas con kétchup y mayonesa, mitad y mitad. Es lo mejor del verano. Y de to la vida."],
			["Tengo una bici de montaña con dieciocho cambios. Yo uso dos.", "Me paso el día entero con ella: a la piscina, a la panadería, al parque, a dar vueltas a la plaza…",
				"Cuando bajo una cuesta sin frenar parece que vuelo. Bueno, vuelo un poco, y luego me caigo. Pero vuelo."],
			["El bocadillo de panceta es el rey de los bocadillos.", "Tiene que estar churruscaíta, que cruja, y que el aceite empape el pan por dentro.",
				"Si el pan no se queda transparente de la grasa, no es un bocadillo de panceta: es un bocadillo de pena."],
			["El de tortilla me gusta frío, del día de antes, que está más bueno.", "Con cebolla. Mi abuela la hace sin cebolla y me la como, pero sufriendo.",
				"Y gorda, que el pan no cierre. Si el pan cierra es que te han engañao."],
			["El de crema de cacao, pa merendar. Con pan blandito, del de molde no, del de la panadería.", "Lo bueno es que se sale por los laos y te tiés que chupar los dedos, y eso también es merienda.",
				"Si le pones una onza de chocolate dentro es un bocadillo doble. Lé inventao yo."],
			["El de chopped me lo como cuando no hay otra cosa. Y no hay otra cosa casi nunca, así que me lo como mucho.", "Me gusta porque tiene trocitos y no sabes de qué son. Es un misterio, pero rico.",
				"Con tomate restregao. El chopped sin tomate está triste."],
			["Mi madre está tol día con que si estoy gordo, que si estoy gordo, que mira qué barriga.", "¡Que no estoy gordo, que estoy hermoso! Lo dice mi abuela, y mi abuela sabe más que mi madre, que pa eso es su madre.",
				"Y si estoy tan gordo, ¿quién me hace los bocadillos? Ella. Pues ya está. Estoy harto."]],
		"en": [["Are you going to the pool? I go every day it’s open, at twelve on the dot, first in.", "I do bombs and splash even the lifeguard. He says I make waves.",
				"And then to the snack bar: a plate of salchipapas with ketchup and mayo, half and half. Best thing about summer. And about life."],
			["I’ve got a mountain bike with eighteen gears. I use two.", "I spend all day on it: to the pool, to the bakery, to the park, round and round the square…",
				"When I go down a hill without braking it’s like flying. Well, I fly a bit, then I fall off. But I fly."],
			["The bacon sandwich is the king of sandwiches.", "It’s got to be crispy, so it crunches, and the fat has to soak into the bread.",
				"If the bread doesn’t go see-through with the grease, it’s not a bacon sandwich: it’s a sad sandwich."],
			["I like the omelette one cold, from the day before, it’s nicer.", "With onion. My gran makes it without onion and I eat it, but suffering.",
				"And fat, so the bread won’t close. If the bread closes, they’ve conned you."],
			["The chocolate spread one, for tea. With soft bread, not sliced, from the bakery.", "The best bit is it comes out the sides and you have to lick your fingers, and that’s tea too.",
				"If you put a square of chocolate in it, it’s a double sandwich. I invented that."],
			["I have the chopped pork one when there’s nothing else. And there’s nothing else nearly always, so I have it a lot.", "I like it because it’s got little bits in and you don’t know what they are. It’s a mystery, but tasty.",
				"With tomato rubbed on. Chopped pork without tomato is sad."],
			["My mum goes on all day about how I’m fat, how I’m fat, look at that belly.", "I’m not fat, I’m bonny! My gran says so, and my gran knows more than my mum, she’s her mum.",
				"And if I’m so fat, who makes my sandwiches? She does. So there. I’m fed up with it."]]},
	# ...and at a hundred of trust, once, where her surname came from (the user: she never sees what is funny about the old
	# one; all that troubles her is that it was French)
	"dolores_delanno": {
		"es": ["Mira, {hijo|hija}, a ti te lo vía contar porque eres de confianza.", "Yo no siempre me he llamao así. Me cambié el apellido hace ya muchos años.",
			"Cogí el de mi abuelo, el de Navarra: D'Varriga. Gente seria, de monte, de las de antes.",
			"El de antes era francés. ¡Francés! Dolores Fuertes Delanno, me llamaba yo.", "¡Yo, un apellido francés, habrase visto!",
			"Que a mí los franceses ni en pintura. Vinieron aquí con el Napoleón y se llevaron hasta las gallinas.",
			"Así que ya lo sabes. Y de esto, ni media palabra por la calle, ¿eh?"],
		"en": ["Look, {hijo|hija}, I’ll tell you because you’re someone I can trust.", "I haven’t always been called this. I changed my surname many years ago.",
			"I took my grandfather’s, the one from Navarre: D'Varriga. Serious people, mountain people, the old kind.",
			"The one before was French. French! Dolores Fuertes Delanno, my name was.", "Me, with a French surname, can you imagine!",
			"I can’t stand the French. They came here with Napoleon and took everything, even the hens.",
			"So now you know. And not a word of this in the street, eh?"]},
	"maruja": {
		"es": [["Yo no cotilleo, {hermoso|hermosa}. Yo archivo."],
			["Tu madre dice que te estás «buscando a ti mismo».", "A tu edad tu padre ya se había perdío dos veces."],
			["¿Ves a la panadera? Va por el tercer marido. Los otros dos están «en Cuenca».", "Nadie se va a Cuenca tanto tiempo."]],
		"en": [["I don’t gossip, cariño. I archive."],
			["Your mother says you’re “finding yourself”.", "At your age your father had already lost himself twice."],
			["See the baker? Third husband. The first two are “in Cuenca”.", "Nobody goes to Cuenca for that long."]]},
	"venancio": {
		"es": [["¿Hoy con prisa? Qué bien. Toma una tarjeta.", "También vale de cupón."],
			["El negocio está flojo. Aquí la gente es mu cabezona pa morirse."],
			["Yo a la gente le tomo medidas a ojo. Tú eres una mediana.", "No te lo tomes a mal. Tómatelo con tiempo."]],
		"en": [["Driving fast today? Lovely. Here’s my card.", "It’s also a coupon."],
			["Business is slow. Everybody here is too stubborn to die."],
			["I measure people with my eyes. You’re a medium.", "Don’t take it personally. Take it eventually."]]},
	"genaro": {
		"es": [["Sí, es un molino. No, no se le puede pegar.", "Uno de fuera lo intentó una vez. Entoavía salen cachos de lanza."],
			["El aire es gratis.", "Porque Hacienda no ha dao entoavía con ande vive."],
			["Coge el tractor si quieres. Va despacio, pero no se ha equivocao en la vida."]],
		"en": [["Yes, it’s a windmill. No, you can’t fight it.", "A gentleman from out of town tried once. We still find bits of lance."],
			["The wind is free.", "That’s only because the government hasn’t found where it lives."],
			["Take the tractor if you like. She’s slow, but she’s never been wrong."]]},
	"kevin": {
		"es": [["No me he perdío. Estoy sin vigilar. No es lo mismo y es legal."],
			["Mi abuelo dice que el azafrán vale más que yo.", "Lo ha pesao. Dos veces."],
			["De mayor quiero ser notario.", "Son los únicos que ganan en los entierros."]],
		"en": [["I’m not lost. I’m unsupervised. It’s different and it’s legal."],
			["My abuelo says the saffron is worth more than me.", "He checked. Twice."],
			["When I grow up I want to be a notary.", "They’re the only ones who win at funerals."]]},
	"goat": {
		"es": [["Beeeh."], ["Beeeeeh."], ["…las cosas que he visto yo de noche por esas viñas, {hermoso|hermosa}.", "Beeeh."]],
		"en": [["Beeeh."], ["Beeeeeh."], ["…the things I have seen in those fields at night, hombre.", "Beeeh."]]},
	"generic": {
		"es": [["Buena mañana hace. Por estadística, hoy se muere alguien. ¡Yo no me la pido!"],
			["El médico me ha quitao la sal, el vino y [[la mujer|el marido]].", "He empezao por [[la mujer|el marido]]."],
			["Dicen que el dinero no da la felicidad.", "Pues que me expliquen lo del azafrán. Enga."],
			["Yo no digo que el alcalde robe.", "Digo que su perro tiene piscina."],
			["Conduces como mi tío, que en paz descanse.", "Por eso descansa."],
			["Cuarenta años en esta calle.", "Sé cuálas son rubias de verdad y cuálas no."],
			["El pueblo tiene dos marchas: siesta y entierro.", "En las dos dan de merendar, eso sí."],
			["Una vez dejé de beber por Cuaresma.", "Los peores cuarenta minutos de mi vida."],
			["Mi nieto es «inflúencer».", "En mis tiempos a eso se le decía estar parao, pero con un flexo."],
			["Si ves a mi [[mujer|marido]], dile que se cena a las nueve.", "Si ves [[al querido|a la querida]], dile que a las ocho. Por ver qué pasa."],
			["Esta tarde, a la ruta del colesterol, que el médico me ha dicho que ande.", "Una hora pa'llá, una hora pa'cá, y a la vuelta, un bocadillo de panceta. Pa recuperar."],
			["En cuanto sale el sol, la ruta del colesterol se pone como la Gran Vía.", "Tos en chándal, tos con el perro, y tos hablando de lo que han comío."]],
		"en": [["Lovely morning. Statistically somebody dies today. Not it!"],
			["My doctor said to cut out salt, wine and my [[wife|husband]].", "I’m starting with the [[wife|husband]]."],
			["They say money can’t buy happiness.", "Then explain saffron. Checkmate."],
			["I’m not saying the mayor is corrupt.", "I’m saying his dog has a pool."],
			["You drive like my late uncle.", "That’s why he’s late."],
			["Forty years I’ve lived on this street.", "I know which of you are natural blondes."],
			["The village has two speeds: siesta and funeral.", "Both have snacks, to be fair."],
			["I gave up drinking for Lent once.", "Worst forty minutes of my life."],
			["My grandson is an “influencer”.", "In my day we called that unemployed with a ring light."],
			["If you see my [[wife|husband]], tell [[her|him]] dinner’s at nine.", "If you see [[her boyfriend|his girlfriend]], tell [[him|her]] it’s at eight. I’m curious."],
			["This afternoon, off to the cholesterol route, the doctor says I’ve got to walk.", "An hour out, an hour back, and on the way home a bacon sandwich. To get my strength back."],
			["As soon as the sun’s out, the cholesterol route’s busier than the Gran Vía.", "Everyone in tracksuits, everyone with the dog, and everyone talking about what they’ve eaten."]]},
	"generic_kid": {
		"es": [["Mi madre dice que no hable con desconocíos.", "Pero tú eres desconocío del to, así que no cuentas."],
			["¿Me das un euro? Es pa una cosa.", "La cosa es otro euro."],
			["De mayor vía tener un Z15 con alerón."],
			["Mi abuela dice que tiés cara de no haber cogío una azá en tu vida."],
			# (the user, 16 Nov 2026: things of a village child, "con alguna salvajada extrema que solo un niño que no sabe bien
			# lo que dice es capaz de decir")
			["Mi abuelo dice que cuando se muera me deja la mula.", "Yo le digo que se dé prisa, que la mula también está mu vieja."],
			["Mi padre dice que el alcalde es un hijoputa.", "No sé lo que es, pero se lé dicho al alcalde y se ha puesto colorao. Debe de ser verdad."],
			["Ayer mi primo se comió una lagartija viva por un euro.", "Yo me como dos por un euro cincuenta. Es una oferta."],
			["Mi padre se bebe ocho cervezas y luego conduce.", "Es el mejor conductor del pueblo: conduce hasta borracho."],
			["De mayor quiero ser tricornio, pa poder dar hostias y que no me castiguen."],
			["Mi abuela tiene un pelo en la barbilla más largo que los míos de la cabeza.", "Se lo quería arrancar mientras dormía, pero se ha despertao y me ha dao con la zapatilla."],
			["En el tanatorio había un muerto y le toqué la nariz.", "Estaba fría como un polo de limón. Mi madre me dio una colleja, pero valió la pena."],
			["Mi hermano chico se comió una pila.", "Ahora mi madre le mira la caca tos los días con una linterna, a ver si sale."],
			["Si me muero quiero que me entierren con la Play y con el perro.", "El perro vivo no, ¿eh? Bueno… si él quiere, sí."],
			["Mi abuelo tiene una escopeta y dice que el día que se harte va a por los del ayuntamiento.", "Le he dicho que me avise, que quiero verlo."],
			["En mi casa hay un fantasma.", "Mi padre dice que es la humedad, pero la humedad no se come las galletas."],
			["He meao en la piscina.", "Dicen que se pone el agua roja. Mentira: lé hecho mil veces y na."],
			["Mi tío estuvo en la cárcel.", "Dice que se come mejor que en casa y que te dejan ver la tele. Yo de mayor quiero ir."],
			["¿Tú tiés novio o novia?", "Mi tita tiene dos, pero uno no lo sabe."],
			["Mi abuela va por la ruta del colesterol con pesas en las manos.", "Son dos botellas de agua. Dice que pesan lo mismo y no hay que comprarlas."]],
		"en": [["My mum says not to talk to strangers.", "But you’re so strange you don’t count."],
			["Can I have a euro? It’s for a thing.", "The thing is another euro."],
			["When I grow up I’m having a Z15 with a spoiler."],
			["My gran says you look like you’ve never held a hoe in your life."],
			["My grandad says when he dies he’s leaving me the mule.", "I tell him to hurry up, the mule’s really old too."],
			["My dad says the mayor’s a son of a bitch.", "I don’t know what that is, but I told the mayor and he went red. Must be true."],
			["Yesterday my cousin ate a live lizard for a euro.", "I’ll eat two for one fifty. It’s a deal."],
			["My dad drinks eight beers and then drives.", "He’s the best driver in town: he can drive even when he’s drunk."],
			["When I grow up I want to be a Tricornio, so I can thump people and not get punished."],
			["My gran’s got a hair on her chin longer than the ones on my head.", "I wanted to pull it out while she was asleep, but she woke up and got me with her slipper."],
			["There was a dead man at the funeral home and I touched his nose.", "It was cold like a lemon ice lolly. My mum smacked me, but it was worth it."],
			["My little brother swallowed a battery.", "Now my mum checks his poo every day with a torch, to see if it’s come out."],
			["If I die I want to be buried with my PlayStation and the dog.", "Not the dog alive, eh? Well… if he wants to, yes."],
			["My grandad’s got a shotgun and says the day he’s had enough he’s going after the council.", "I told him to let me know, I want to watch."],
			["There’s a ghost in my house.", "My dad says it’s the damp, but damp doesn’t eat biscuits."],
			["I’ve peed in the swimming pool.", "They say the water goes red. Lies: I’ve done it a thousand times and nothing."],
			["My uncle was in prison.", "He says the food’s better than at home and they let you watch telly. I want to go when I grow up."],
			["Have you got a boyfriend or a girlfriend?", "My auntie’s got two, but one of them doesn’t know."],
			["My gran walks the cholesterol route with weights in her hands.", "They’re two bottles of water. She says they weigh the same and you don’t have to buy them."]]},
	# What the town says about a mission you have finished (chismes.gd; the user, 16 Nov 2026): each neighbour as they
	# are -- glad of it (bien), against it (mal), or not caring either way (igual). Keys chisme_<mission>_<character>.
	"chisme_aceite_bien": {
		"es": [["Me han dicho que fuiste tú quien le llevó el aceite al Eusebio.", "¡Gracias a ti ha habío tostás! Mi cuñao ya tenía la silla en la mano pa comérsela."],
			["¡Qué carrera con la furgoneta de la Paca! Te vieron pasar por la carretera de arriba con las botellas.", "Y ni una rota, dicen. Eso es tener mano."]],
		"en": [["They tell me it was you who took Eusebio his oil.", "Thanks to you there was toast! My brother-in-law already had the chair in his hands to eat it."],
			["What a run in Paca’s van! They saw you go by on the top road with the bottles.", "And not one broken, they say. That’s a steady hand."]]},
	"chisme_aceite_mal": {
		"es": [["Ya me he enterao de lo del aceite. Por poco me atropellas con la furgoneta, que iba yo pa la panadería.", "Tanto correr pa unas tostás. En mis tiempos se mojaba el pan en vino y a callar."],
			["Mucho aceite pal Eusebio y aquí la gente sin. A mí la Loli no me aparta seis botellas ni de rodillas.", "Enchufaos. Eso es lo que hay en este pueblo."]],
		"en": [["I’ve heard about the oil. You nearly ran me over with that van, and me on my way to the bakery.", "All that rushing for some toast. In my day you dipped your bread in wine and kept quiet."],
			["Plenty of oil for Eusebio and the rest of us go without. Loli wouldn’t put six bottles aside for me if I begged on my knees.", "It’s who you know. That’s this town for you."]]},
	"chisme_aceite_igual": {
		"es": [["Dicen que llevaste aceite al kiosco. Bueno. Yo desayuno en casa.", "Si hay tostás, hay tostás. Si no, también se vive."],
			["Algo he oío del aceite y de unas prisas.", "Yo no me meto. Ni en el aceite ni en na."]],
		"en": [["They say you took oil to the kiosk. Fine. I have breakfast at home.", "If there’s toast, there’s toast. If not, you live anyway."],
			["I heard something about oil and a hurry.", "I keep out of it. Out of the oil and out of everything."]]},
	"chisme_velatorio_bien": {
		"es": [["Llevaste a la Maruja al velatorio, ¿no? Qué {majo|maja}. Dice que las pastas estaban de muerte.", "Bueno, de muerte… ya me entiendes."],
			["La Maruja va contando que tiés un coche mu cómodo y que conduces como un ángel.", "Viniendo de ella, que no la contenta nadie, eso es una medalla."]],
		"en": [["You took Maruja to the wake, didn’t you? How kind. She says the pastries were to die for.", "Well, to die for… you know what I mean."],
			["Maruja’s telling everyone you’ve got a very comfy car and you drive like an angel.", "Coming from her, and nobody ever pleases her, that’s a medal."]]},
	"chisme_velatorio_mal": {
		"es": [["¿Tú {eres el que|eres la que} llevó a la Maruja al tanatorio? ¡Si no conocía al muerto de na!", "Fue a por las pastas y a ver a la viuda. Y tú de chófer. Qué vergüenza, por Dios."],
			["Desde que la llevaste al velatorio, la Maruja va diciendo que la viuda iba pintá como una puerta.", "Ya tiene tema pa un mes. Gracias, {majo|maja}, muchas gracias."]],
		"en": [["Are you the one who took Maruja to the funeral home? She didn’t even know the dead man!", "She went for the pastries and to look at the widow. And you as her chauffeur. For shame."],
			["Since you took her to the wake, Maruja’s been saying the widow was painted like a front door.", "That’s her talk sorted for a month. Thanks, love, thanks a lot."]]},
	"chisme_velatorio_igual": {
		"es": [["Algo de un velatorio, ¿no? Tos los días se muere alguien.", "Yo a los velatorios no voy. Ya iré al mío."],
			["Me han dicho que hiciste de taxi pa la Maruja.", "Allá cada uno con sus muertos."]],
		"en": [["Something about a wake, wasn’t it? Somebody dies every day.", "I don’t go to wakes. I’ll go to mine."],
			["They tell me you played taxi for Maruja.", "Each to their own dead."]]},
	"chisme_movil_bien": {
		"es": [["¡Ya sé que le arreglaste el teléfono a la Josefa! Ahora me llama a tos horas, pero oye, funciona.", "Antes le salía un chino dando el tiempo. Ahora sale ella. No sé qué es peor."],
			["La Josefa dice que eres {un manitas|una manitas} con los cacharros.", "Pásate por casa un día, que tengo la tele que se ve en verde."]],
		"en": [["I know you got Josefa’s phone fixed! Now she rings me at all hours, but hey, it works.", "Before, a Chinese man came on giving the weather. Now it’s her. Not sure which is worse."],
			["Josefa says you’re handy with gadgets.", "Come round one day, my telly’s showing everything green."]]},
	"chisme_movil_mal": {
		"es": [["¿Que fuiste al V.I.P. con el móvil de la Josefa? ¡Si ese cobra por mirar!", "Seiscientos cinco euros por darle a un botón. Así se hacen ricos los de los ordenadores."],
			["Ahora la Josefa tiene el teléfono bien y llama a to el pueblo pa contar lo que pasa.", "Antes por lo menos se enteraba la mitad. Muchas gracias, ¿eh?"]],
		"en": [["You took Josefa’s phone to the V.I.P.? He charges you for looking!", "Six hundred and five euros for pressing a button. That’s how the computer lot get rich."],
			["Now Josefa’s phone works and she rings the whole town to tell them what’s going on.", "Before, at least only half of them found out. Thanks a lot, eh?"]]},
	"chisme_movil_igual": {
		"es": [["Lo del teléfono de la Josefa… ¿qué le pasaba?", "Bah. Yo tengo el de tapa y ese no se rompe."],
			["Dicen que la Josefa te pagó en pesetas.", "Normal. Ella entoavía va con pesetas a por el pan."]],
		"en": [["That business with Josefa’s phone… what was wrong with it?", "Bah. I’ve got a flip phone, and those don’t break."],
			["They say Josefa paid you in pesetas.", "Of course. She still takes pesetas for her bread."]]},
	"chisme_firmas_bien": {
		"es": [["¡Que has juntao las firmas pa salvar el puente! Eso es tener pueblo.", "Ciento y pico años tiene. Que lo tire el alcalde con sus manos, si se atreve."],
			["Mi firma la tiés, ¿eh? Bueno, no la tiés porque no me la pediste. Pero la tendrías.", "El puente no se toca. Lo pone hasta en las pancartas."]],
		"en": [["You got the signatures to save the bridge! That’s caring for your town.", "It’s a hundred and something years old. Let the mayor pull it down with his own hands, if he dares."],
			["You’ve got my signature, eh? Well, you haven’t, because you didn’t ask me. But you would have.", "Hands off the bridge. It even says so on the banners."]]},
	"chisme_firmas_mal": {
		"es": [["¿Firmas pal puente? ¡Si ese puente no lo cruza nadie más que los gatos!", "Que lo tiren y hagan aparcamiento, que no hay ande dejar el coche."],
			["El Alberto, que vive en Madrid, viene a decirnos lo que hay que salvar en el pueblo.", "Y tú detrás de él con la hojita de las firmas."]],
		"en": [["Signatures for the bridge? Nobody crosses that bridge but the cats!", "Pull it down and make a car park, there’s nowhere to leave the car."],
			["Alberto, who lives in Madrid, comes here to tell us what needs saving in our town.", "And you behind him with his little sheet of signatures."]]},
	"chisme_firmas_igual": {
		"es": [["Lo del puente… Yo ni firmo ni dejo de firmar.", "Que hagan lo que quieran, que al final lo hacen igual."],
			["Me pidieron firma pal puente. O pa no sé qué.", "Firmé por si acaso. Yo firmo to."]],
		"en": [["The bridge business… I neither sign nor don’t sign.", "Let them do what they like, they’ll do it anyway."],
			["Somebody asked me to sign for the bridge. Or for something.", "I signed just in case. I sign everything."]]},
	"chisme_puente_bien": {
		"es": [["¡Ya se puede pasar por el puente otra vez! Esta mañana lé cruzao tres veces, por gusto.", "Abajo el agua, arriba la gente. Como tiene que ser."],
			["Han quitao la cinta del Ayuntamiento del puente. Dicen que fue cosa tuya.", "Cuando se entere el alcalde, se le cae el bigote."]],
		"en": [["You can cross the bridge again! I crossed it three times this morning, just because.", "Water underneath, people on top. As it should be."],
			["They’ve taken the council’s tape off the bridge. They say that was you.", "When the mayor hears, his moustache’ll fall off."]]},
	"chisme_puente_mal": {
		"es": [["Ya han abierto el puente. Ahora pasan los chiquillos con las bicis a to meter.", "Un día se mata uno y entonces a ver quién tiene la culpa."],
			["To el lío del puente pa un puente que mide cuatro pasos.", "Con lo que se ha gastao en cinta y carteles se hacía uno nuevo."]],
		"en": [["They’ve opened the bridge. Now the kids race over it on their bikes.", "One day one of them gets killed and then we’ll see whose fault it is."],
			["All that fuss for a bridge four steps long.", "With what they spent on tape and notices they could have built a new one."]]},
	"chisme_puente_igual": {
		"es": [["El puente está abierto, dicen.", "Yo voy por la Matías Pérez, que es lo mismo y más ancho."],
			["Puente abierto, puente cerrao… El arroyo sigue ahí, que es lo que importa.", "Bueno, el arroyo seco. Pero ahí sigue."]],
		"en": [["The bridge is open, they say.", "I go along the Matías Pérez, it’s the same and wider."],
			["Bridge open, bridge shut… The stream’s still there, that’s what matters.", "Well, the dry stream. But it’s still there."]]},
	"chisme_menu_bien": {
		"es": [["¡Te vi salir de lo del Henry con el jamón asao, abriéndote paso con el bate!", "Como un torero. Pero con jamón."],
			["La Josefa va diciendo que le llevaste el jamón calentico.", "Eso en este pueblo vale más que un título."]],
		"en": [["I saw you coming out of Henry’s with the roast ham, clearing the way with that bat!", "Like a bullfighter. But with ham."],
			["Josefa’s saying you brought her the ham nice and hot.", "In this town that’s worth more than a degree."]]},
	"chisme_menu_mal": {
		"es": [["Ya me han contao lo del jamón del Henry. A mi primo le diste con el bate.", "Bueno, él también te quería quitar el jamón. Pero con el bate no, hombre."],
			["Tanto jaleo por un jamón asao, que el Henry lo calienta en el microondas.", "Y luego la gente se pega en la puerta como si regalaran algo."]],
		"en": [["I’ve heard about Henry’s ham. You hit my cousin with the bat.", "Well, he was trying to take the ham off you too. But not with the bat, come on."],
			["All that fuss over a roast ham Henry heats up in the microwave.", "And then people fight at the door as if it were free."]]},
	"chisme_menu_igual": {
		"es": [["Lo del jamón de los jueves… Yo soy más de pollo.", "Pero vamos, que cada uno se pegue por lo que quiera."],
			["Dicen que hubo tortas en la puerta del Henry.", "Como tos los jueves. Ya ni lo miro."]],
		"en": [["The Thursday ham business… I’m more of a chicken person.", "But each to their own, fight over what you like."],
			["They say there was a punch-up at Henry’s door.", "Like every Thursday. I don’t even look any more."]]},
	"chisme_pintadas_bien": {
		"es": [["¡To el pueblo lleno de pintadas de tu peña! Así se defienden los colores.", "En fiestas os vais a hartar de beber, que pa eso se pinta."],
			["La Chiki va diciendo que no ha visto a nadie pintar tan rápido.", "Dice que pareces de las de antes, de cuando las peñas eran peñas."]],
		"en": [["The whole town covered in your peña’s tags! That’s how you stand up for your colours.", "You’ll drink yourselves silly at the fiestas, that’s what the painting’s for."],
			["La Chiki says she’s never seen anyone paint so fast.", "She says you’re like the old ones, from when peñas were peñas."]]},
	"chisme_pintadas_mal": {
		"es": [["¿Has sío tú el de las pintadas? ¡Me has pintao la tapia del corral!", "Ahora tengo una cosa ahí que no sé ni lo que pone."],
			["Pintarrajear el pueblo entero por una peña. Si eso es pa emborracharse en fiestas y ya.", "En mis tiempos íbamos a la peña con el vino y sin espray."]],
		"en": [["Was it you with the graffiti? You’ve painted my yard wall!", "Now I’ve got something on it and I don’t even know what it says."],
			["Daubing the whole town for a peña. It’s only for getting drunk at the fiestas.", "In my day we went to the peña with wine and no spray."]]},
	"chisme_pintadas_igual": {
		"es": [["Pintadas hay en tos laos desde que tengo memoria.", "Una más, una menos…"],
			["¿Tu peña ha pintao el pueblo? Bueno.", "Yo de las peñas solo sé que hacen ruido en agosto."]],
		"en": [["There’s been graffiti everywhere as long as I can remember.", "One more, one less…"],
			["Your peña has painted the town? Right.", "All I know about peñas is they make a racket in August."]]},
	"chisme_recress_bien": {
		"es": [["¡Han vuelto a abrir los Galaxy Recress! Yo me pasaba ahí las tardes cuando era chico.", "Y el alcalde perdiendo al Tokken delante de to el pueblo. Eso no lo pagan ni las fiestas."],
			["Me dicen que el torneo de los recreativos fue cosa tuya.", "Hacía veinte años que no se veía tanta gente junta sin un muerto de por medio."]],
		"en": [["They’ve reopened the Galaxy Recress! I spent my afternoons there as a kid.", "And the mayor losing at Tokken in front of the whole town. Even the fiestas can’t beat that."],
			["They tell me the tournament at the arcade was your doing.", "Twenty years since we saw so many people together without a dead man involved."]]},
	"chisme_recress_mal": {
		"es": [["Ahora con los recreativos abiertos, los chiquillos se dejan ahí la paga entera.", "Y el ruido de las maquinitas se oye hasta en mi casa."],
			["Un torneo de maquinitas. Con lo que hay que hacer en este pueblo.", "Y el alcalde jugando en vez de arreglar las farolas."]],
		"en": [["Now the arcade’s open the kids leave all their pocket money there.", "And you can hear those machines from my house."],
			["A tournament of video games. With everything that needs doing in this town.", "And the mayor playing instead of fixing the street lights."]]},
	"chisme_recress_igual": {
		"es": [["Algo de un torneo de videojuegos, ¿no?", "Yo esas cosas no las entiendo. Ni ganas."],
			["Que han abierto los recreativos. Bueno, pues ya está.", "Ya los cerrarán otra vez."]],
		"en": [["Something about a video game tournament, wasn’t it?", "I don’t understand those things. Don’t want to."],
			["So they’ve opened the arcade. Well, that’s that.", "They’ll shut it again."]]},
	"chisme_sabotaje_bien": {
		"es": [["¿Te has enterao? En los otros kebabs ha pasao de to: un moco en la salsa, y lo demás no te lo digo.", "Yo ya solo voy al de Don Luis. Ese por lo menos es limpio."],
			["Dicen que alguien les ha hecho una faena a los kebabs nuevos.", "Pues bien hecho. Kebab de toa la vida, el de Don Luis, y lo demás son modernidades."]],
		"en": [["Have you heard? All sorts at the other kebab places: a bogey in the sauce, and I won’t tell you the rest.", "I only go to Don Luis’s now. At least his is clean."],
			["They say somebody’s played a dirty trick on the new kebab places.", "Good. The proper kebab is Don Luis’s, the rest is newfangled stuff."]]},
	"chisme_sabotaje_mal": {
		"es": [["Lo de los kebabs es una guarrería. ¡Un moco! ¡Una meada!", "Y nadie ha visto na. Este pueblo es pa echarse a temblar."],
			["Yo me comí un dürum el martes. Desde que sé lo que pasó, no duermo.", "Si me entero de quién ha sío, se lo hago comer."]],
		"en": [["That kebab business is disgusting. A bogey! A wee!", "And nobody saw a thing. This town makes you shudder."],
			["I had a dürum on Tuesday. Since I found out what happened, I can’t sleep.", "If I find out who did it, I’ll make them eat it."]]},
	"chisme_sabotaje_igual": {
		"es": [["Algo ha pasao en los kebabs, dicen.", "Yo no como esas cosas. Me repiten."],
			["¿Un moco en la salsa? Bah. En la salsa de mi suegra ha habío cosas peores.", "Y aquí estamos tos."]],
		"en": [["Something’s happened at the kebab places, they say.", "I don’t eat that stuff. It repeats on me."],
			["A bogey in the sauce? Bah. There’s been worse in my mother-in-law’s sauce.", "And here we all are."]]},
	"chisme_ajedrez_bien": {
		"es": [["El alcalde dice que ve a la gente del pueblo como piezas de ajedrez. ¡A mí me ha puesto de alfil!", "Alfil, que es de los que van de lao. Me gusta."],
			["Que hay ajedrez en la plaza con el alcalde. ¡Por fin algo pa los que no jugamos al Tokken!", "Yo ya me he apuntao. Pierdo siempre, pero me apunto."]],
		"en": [["The mayor says he sees the townsfolk as chess pieces. He’s made me a bishop!", "A bishop, the ones that go sideways. I like it."],
			["There’s chess in the square with the mayor now. At last something for those of us who don’t play Tokken!", "I’ve signed up already. I always lose, but I sign up."]]},
	"chisme_ajedrez_mal": {
		"es": [["El alcalde va diciendo que semos piezas de su ajedrez. ¡Yo de peón, dice! ¡Un peón, yo!", "Ese hombre está como una puñetera regadera."],
			["Mientras el alcalde juega al ajedrez en la cabeza, el pueblo lleno de baches.", "Que mueva las piezas del Ayuntamiento, que también tiene."]],
		"en": [["The mayor goes around saying we’re pieces in his chess game. Me, a pawn, he says! A pawn, me!", "That man is as mad as a bloody watering can."],
			["While the mayor plays chess in his head, the town’s full of potholes.", "Let him move the pieces at the town hall, he’s got those too."]]},
	"chisme_ajedrez_igual": {
		"es": [["Lo del ajedrez del alcalde… Yo no sé ni cómo se mueve el caballo.", "Ni el caballo ni na."],
			["Dicen que el alcalde ve piezas de ajedrez por la ventana.", "Hay quien ve a la Virgen en una tostá. Cada uno ve lo que quiere."]],
		"en": [["The mayor’s chess thing… I don’t even know how the knight moves.", "Not the knight, not anything."],
			["They say the mayor sees chess pieces out of his window.", "Some people see the Virgin in a slice of toast. Everyone sees what they want."]]},
