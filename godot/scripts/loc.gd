	# once the town knows your name (padron.gd: half the story's missions done), behind your back
	"whisper_nombre": {
		"es": ["Ahí va %s. Ya es del pueblo, como quien dice.", "{Ese|Esa} es %s. Buena gente, dicen.", "%s… Ya no es {forastero|forastera}: ya es de aquí.", "Mira, %s. Saluda, que es de casa."],
		"en": ["There goes %s. Practically one of our own now.", "That’s %s. Decent sort, folk reckon.", "%s… proper local now, no outsider any more.", "Oh look, %s. Give a nod—one of the family now."]},
	# ...and, once each mission is over, one more thing muttered behind your back (game.whisper_pool; the user, 16 Nov 2026)
	"murmullo_aceite": {"es": "{Ese|Esa} es {el|la} que le llevó el aceite al Eusebio. A tó meter.", "en": "That’s the {lad|lass} who belted Eusebio’s oil over. Proper tearaway."},
	"murmullo_velatorio": {"es": "Mira, {el|la} que hizo de taxi pa la Maruja al tanatorio.", "en": "Look—the {bloke|lass} who played cabbie for Maruja down the funeral parlour."},
	"murmullo_movil": {"es": "{Ese|Esa} le arregló el teléfono a la Josefa. Ahora llama a tó el pueblo.", "en": "That {one|lass} sorted Josefa’s mobile out. Rings the whole street non-stop now."},
	"murmullo_firmas": {"es": "Por ahí va {el|la} de las firmas del puente.", "en": "There goes the {lad|lass} with the bridge petition."},
	"murmullo_puente": {"es": "{Ese|Esa} es {el|la} que abrió el puente. Ya verás el alcalde.", "en": "That’s the {one|lass} who reopened the bridge. Mayor’ll blow a gasket."},
	"murmullo_menu": {"es": "Cuidao, que {ese|esa} va con el bate del Henry.", "en": "Mind yourself—that {bloke|lass} packs Henry’s bat."},
	"murmullo_pintadas": {"es": "{Ese|Esa} es {el|la} que nos ha llenao el pueblo de pintadas.", "en": "That’s the {tearaway|lass} who tagged half the village."},
	"murmullo_recress": {"es": "Mira, {el|la} que abrió otra vez los recreativos.", "en": "Look, the {one|lass} who got the arcade back open."},
	"murmullo_sabotaje": {"es": "Desde que {ese|esa} anda por aquí, pasan cosas raras en los kebabs.", "en": "Ever since that {lad|lass} rocked up, dodgy things keep hitting the kebab shops."},
	"murmullo_ajedrez": {"es": "{Ese|Esa} juega al ajedrez con el alcalde. Pa mí que están tos locos.", "en": "That {bloke|lass} plays chess with the mayor. Whole lot’s round the bend, I reckon."},
	# what the children shout to each other while they play (ninos.gd: when you are near)
	"crio_grito": {
