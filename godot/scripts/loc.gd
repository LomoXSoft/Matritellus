	"alcalde_raya_gana": {"es": ["Tres en raya. Ya se lo advertí: siempre tres movimientos por delante.", "He ganado yo. Que conste en acta.", "Gano yo. La experiencia de gobierno, que se nota."],
		"en": ["Three in a row. I did warn you: always three moves ahead.", "I win. Let it be minuted.", "I win. Experience in government shows."]},
	"alcalde_raya_pierde": {"es": ["Me ha ganado. Lo achacaré a que estaba pensando en los presupuestos.", "Enhorabuena. No se lo diga a mi mujer.", "Bien jugado. Exijo la revancha, por supuesto."],
		"en": ["You beat me. I shall put it down to the budget on my mind.", "Congratulations. Do not tell my wife.", "Well played. I demand a rematch, naturally."]},
