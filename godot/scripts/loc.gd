	# ---------- mission dialogue ----------
	"paca_intro": {
		"es": ["¡Ay, {hermoso|hermosa}! Tiés cara de calcetín hervío. Enga, por lo menos estás {despierto|despierta}.",
			"Al bar de tu primo Eusebio se l'á acabao el aceite. Y un bar en La Mancha sin aceite es un cuarto ande los hombres esperan a morirse.",
			"Tira pa la Cooperativa, por la carretera de arriba. La Loli te tiene apartás seis botellas.",
			"Aluego las llevas al kiosco de la Plaza del Ayuntamiento. En cuanto las cargues tiés DOS minutos, que los del almuerzo se amotinan.",
			"La última vez se comieron una silla. Coge mi furgoneta, la Z15 blanca. Tiene velocidad insistida: hay que insistirle pa que acelere."],
		"en": ["Ay, {niño|niña}. You look like a boiled sock. Good, you’re awake.",
			"Your cousin Eusebio’s bar has run out of olive oil. A bar in La Mancha with no oil is just a room where men wait to die.",
			"Drive to the Cooperativa, up the north-east road. Loli has six bottles for you.",
			"Then take them to the kiosk in the Plaza del Ayuntamiento. Once they’re loaded you have TWO minutes before the breakfast crowd riots.",
			"Last time they ate a chair. Take my van — the white Z15. It has “insisted speed”: you have to insist before it speeds up."]},
	"paca_coop": {"es": ["¿Entoavía estás aquí, bacín? ¡A la Cooperativa! Sigue la raya amarilla del mapa, lumbrera."],
		"en": ["Why are you still here? The Cooperativa. Follow the yellow line on your little map, genius."]},
	"paca_kiosk": {"es": ["¡A LA PLAZA, criatura! Que te quito de la herencia. Es una herencia corta: es un jamón."],
		"en": ["THE PLAZA, criatura! I will write you out of the will. It’s a short will. It’s a ham."]},
	"paca_idle": {"es": ["No lo estás haciendo mal del to. No te lo creas mucho, que en esa cabeza hay sitio de sobra."],
		"en": ["You’re not doing badly. Don’t let it go to your head, there’s plenty of room in there."]},
	"paca_night": {
		"es": ["¡Vaya horas, {galán|reina}! Ni que vinieras de la vendimia.",
			"Has traío el aceite, has llevao a la Maruja al velatorio y no has matao a nadie. Que yo sepa.",
			"Enga, a la cama. Mañana me hace falta un favor en el cementerio. Ponte algo oscuro."],
		"en": ["Look at the time, {galán|reina}. Anyone would think you’d been at the grape harvest.",
			"You fetched the oil, you drove Maruja to the wake and you killed nobody. That I know of.",
			"Enga, off to bed. Tomorrow I need a favour at the cemetery. Wear something dark."]},
	"loli_load": {
		"es": ["¿Tú eres {el sobrino|la sobrina} de la Paca? Me dijo que tenías cara de decepción. Lo ha clavao.",
			"Te abro el portón. Pasa con el coche hasta el palé, que las botellas no andan solas.",
			"Seis del bueno, en la baca. Sí, en el techo. Es tradición y además hemos perdío las cajas.",
			"Cada porrazo, una botella menos. Y en cuanto cargues, dos minutos y medio hasta la Plaza del Ayuntamiento. ¡Arreando!"],
		"en": ["You’re Paca’s {nephew|niece}? She said you’d have a disappointed face. Nailed it.",
			"I’ll open the gate. Drive in as far as the pallet — the bottles won’t walk out on their own.",
			"Six bottles of the good stuff, on the roof rack. Yes, the roof. It’s tradition, and we lost the boxes.",
			"Every bump, one bottle less. Once you’re loaded: two and a half minutes to Plaza del Ayuntamiento. Go, ¡arreando!"]},
	"loli_busy": {"es": ["¡Tira, TIRA! Cada segundo que pierdes aquí se seca una tostá y un viejo pierde la esperanza."],
		"en": ["Go, GO. Every second you stand here, a tostada goes dry and an old man loses hope."]},
	"loli_idle": {"es": ["Bienvenío a la Cooperativa. Virgen extra. No como medio pueblo.", "Aquí prensamos la aceituna hasta que confiesa."],
		"en": ["Welcome to the Cooperativa. Extra virgin. Unlike most of this town.", "We press the olives until they confess."]},
	"eusebio_wait": {"es": ["Sin aceite no hay tostás, y sin tostás no hay paz.", "Esta mañana uno me ha pedío MANTEQUILLA. He avisao a la Guardia Civil."],
		"en": ["No oil, no tostadas, no peace.", "A man asked for BUTTER this morning. I have called the Guardia Civil."]},
	"eusebio_6": {"es": "¡¿Seis de seis?! Te daba un abrazo, pero he visto cómo conduces.", "en": "Six out of six?! I’d hug you, but I’ve seen how you drive."},
	"eusebio_mid": {"es": "%d botellas. Las otras estarán con Dios, digo yo. Enga. ENGA.", "en": "%d bottles. The rest are “with God”, I assume. Fine. FINE."},
	"eusebio_low": {"es": "%d na más. A tostá por cabeza y a rezar.", "en": "Just %d. One tostada per customer and we pray."},
	"eusebio_thanks": {"es": "Has salvao el almuerzo. En este pueblo eso es casi ser santo. De los baratos, pero santo.",
		"en": "You saved breakfast. In this town that makes you basically a saint. A cheap one, but still."},
	"eusebio_done": {"es": ["Ya hay paz. Nadie se ha comío los muebles. Lloraría, pero estoy de turno."],
		"en": ["Peace is restored. Nobody ate furniture. I may cry, but I’m on shift."]},
	"maruja_m2": {
		"es": ["¡Macho, qué bien que te veo! Tú que tiés coche: llévame al tanatorio, que hay velatorio.",
			"Al muerto no lo conozco de na. Pero me han dicho que ponen pastas y que la viuda ha venío mu pintá.",
			"Yo no cotilleo, {hermoso|hermosa}. Yo archivo. Enga, arrea, y no corras, que el muerto no se va a ir."],
		"en": ["Macho, just the person! You’ve got a car: drive me to the funeral home, there’s a wake.",
			"I never met the deceased. But I hear there are biscuits and the widow turned up in full make-up.",
			"I don’t gossip, cariño. I archive. Off we go, and no speeding, the dead man isn’t going anywhere."]},
	"venancio_m2": {
		"es": ["¡Hombre, la Maruja! Pasa, pasa, que has llegao antes que la familia. Como siempre.",
			"Y tú, {el|la} chófer. Conduces mu alegre. Toma una tarjeta. También vale de cupón.",
			"Anda, tira pa casa, que ya oscurece y tu tía es de las que cuentan los minutos."],
		"en": ["Maruja! Come in, come in, you beat the family here. As always.",
			"And you, the chauffeur. Cheerful driving. Have my card. It’s also a coupon.",
			"Go on home, it’s getting dark and your aunt counts the minutes."]},

	# ---------- idle chatter ----------
	"anselmo": {
		"es": [["Dios te bendiga, {hijo|hija}. Se confiesa los jueves. Tráete merienda, que lo tuyo va pa largo."],
			["Tengo enterrao a medio pueblo.", "El otro medio me debe dinero."],
			["Dios lo ve to.", "Menos mal que no está en el grupo de guasap de las vecinas."]],
		"en": [["Bless you, my child. Confession is on Thursdays. Bring snacks — yours tend to run long."],
			["I have buried half this town.", "The other half owes me money."],
			["God sees everything.", "Luckily He’s not in the neighbourhood WhatsApp group."]]},
	"ramirez": {
		"es": [["El cinturón, {ciudadano|ciudadana}. No es por su seguridad.", "Es pa que el cuerpo no se desparrame, que aluego el papeleo es mu malo."],
			["Paré un tractor que iba a 12 por zona de 50. El conductor iba borracho.", "El tractor también."],
			["Si tiés que atropellar a alguien, que sea a uno que me caiga mal.", "Te paso una lista. Va por orden alfabético."],
			["Me jubilé hace dos años. Aquí sigo.", "Por amor al arte. El tricornio no se jubila, se jubila uno."],
			["Yo no soy de aquí, ¿eh? Pero Madridejos me necesita.", "Nadie me ha dicho que me vaya. Será por algo."]],
		"en": [["Seatbelt, citizen. It’s not for your safety.", "It keeps the body in one place for the paperwork."],
			["I pulled over a tractor doing 12 in a 50. The driver was drunk.", "So was the tractor."],
			["If you must run somebody over, pick somebody I dislike.", "I’ll send you a list. It’s alphabetical."],
			["I retired two years ago. Still here.", "For the love of it. The tricorn doesn’t retire: the man does."],
			["I’m not from here, you know. But Madridejos needs me.", "Nobody’s told me to go. There must be a reason."]]},
	"maruja": {
		"es": [["Yo no cotilleo, {hermoso|hermosa}. Yo archivo."],
			["Tu madre dice que te estás «buscando a ti mismo».", "A tu edad tu padre ya se había perdío dos veces."],
			["¿Ves a la panadera? Va por el tercer marido. Los otros dos están «en Cuenca».", "Nadie se va a Cuenca tanto tiempo."]],
		"en": [["I don’t gossip, cariño. I archive."],
			["Your mother says you’re “finding yourself”.", "At your age your father had already lost himself twice."],
			["See the baker? Third husband. The first two are “in Cuenca”.", "Nobody goes to Cuenca for that long."]]},
	"venancio": {
		"es": [["¿Hoy con prisa? Qué bien. Toma una tarjeta.", "También vale de cupón."],
			["El negocio está flojo. Aquí la gente es mu cabezona pa morirse."],
			["Yo a la gente le tomo medidas a ojo. Tú eres una mediana.", "No te lo tomes a mal. Tómatelo con tiempo."]],
		"en": [["Driving fast today? Lovely. Here’s my card.", "It’s also a coupon."],
			["Business is slow. Everybody here is too stubborn to die."],
			["I measure people with my eyes. You’re a medium.", "Don’t take it personally. Take it eventually."]]},
	"genaro": {
		"es": [["Sí, es un molino. No, no se le puede pegar.", "Uno de fuera lo intentó una vez. Entoavía salen cachos de lanza."],
			["El aire es gratis.", "Porque Hacienda no ha dao entoavía con ande vive."],
			["Coge el tractor si quieres. Va despacio, pero no se ha equivocao en la vida."]],
		"en": [["Yes, it’s a windmill. No, you can’t fight it.", "A gentleman from out of town tried once. We still find bits of lance."],
			["The wind is free.", "That’s only because the government hasn’t found where it lives."],
			["Take the tractor if you like. She’s slow, but she’s never been wrong."]]},
	"kevin": {
		"es": [["No me he perdío. Estoy sin vigilar. No es lo mismo y es legal."],
			["Mi abuelo dice que el azafrán vale más que yo.", "Lo ha pesao. Dos veces."],
			["De mayor quiero ser notario.", "Son los únicos que ganan en los entierros."]],
		"en": [["I’m not lost. I’m unsupervised. It’s different and it’s legal."],
			["My abuelo says the saffron is worth more than me.", "He checked. Twice."],
			["When I grow up I want to be a notary.", "They’re the only ones who win at funerals."]]},
	"goat": {
		"es": [["Beeeh."], ["Beeeeeh."], ["…las cosas que he visto yo de noche por esas viñas, {hermoso|hermosa}.", "Beeeh."]],
		"en": [["Beeeh."], ["Beeeeeh."], ["…the things I have seen in those fields at night, hombre.", "Beeeh."]]},
	"generic": {
		"es": [["Buena mañana hace. Por estadística, hoy se muere alguien. ¡Yo no me la pido!"],
			["El médico me ha quitao la sal, el vino y [[la mujer|el marido]].", "He empezao por [[la mujer|el marido]]."],
			["Dicen que el dinero no da la felicidad.", "Pues que me expliquen lo del azafrán. Enga."],
			["Yo no digo que el alcalde robe.", "Digo que su perro tiene piscina."],
			["Conduces como mi tío, que en paz descanse.", "Por eso descansa."],
			["Cuarenta años en esta calle.", "Sé cuálas son rubias de verdad y cuálas no."],
			["El pueblo tiene dos marchas: siesta y entierro.", "En las dos dan de merendar, eso sí."],
			["Una vez dejé de beber por Cuaresma.", "Los peores cuarenta minutos de mi vida."],
			["Mi nieto es «inflúencer».", "En mis tiempos a eso se le decía estar parao, pero con un flexo."],
			["Si ves a mi [[mujer|marido]], dile que se cena a las nueve.", "Si ves [[al querido|a la querida]], dile que a las ocho. Por ver qué pasa."]],
		"en": [["Lovely morning. Statistically somebody dies today. Not it!"],
			["My doctor said to cut out salt, wine and my [[wife|husband]].", "I’m starting with the [[wife|husband]]."],
			["They say money can’t buy happiness.", "Then explain saffron. Checkmate."],
			["I’m not saying the mayor is corrupt.", "I’m saying his dog has a pool."],
			["You drive like my late uncle.", "That’s why he’s late."],
			["Forty years I’ve lived on this street.", "I know which of you are natural blondes."],
			["The village has two speeds: siesta and funeral.", "Both have snacks, to be fair."],
			["I gave up drinking for Lent once.", "Worst forty minutes of my life."],
			["My grandson is an “influencer”.", "In my day we called that unemployed with a ring light."],
			["If you see my [[wife|husband]], tell [[her|him]] dinner’s at nine.", "If you see [[her boyfriend|his girlfriend]], tell [[him|her]] it’s at eight. I’m curious."]]},
	"generic_kid": {
		"es": [["Mi madre dice que no hable con desconocíos.", "Pero tú eres desconocío del to, así que no cuentas."],
			["¿Me das un euro? Es pa una cosa.", "La cosa es otro euro."],
			["De mayor voy a tener un Z15 con alerón."],
			["Mi abuela dice que tiés cara de no haber cogío una azá en tu vida."]],
		"en": [["My mum says not to talk to strangers.", "But you’re so strange you don’t count."],
			["Can I have a euro? It’s for a thing.", "The thing is another euro."],
			["When I grow up I’m having a Z15 with a spoiler."],
			["My gran says you look like you’ve never held a hoe in your life."]]},
	# The old neighbours' own sayings, in the Manchego of their day (guion/palabros.md, «Cómo hablan los mayores»: the
	# words are from José-María Moreno García's glossary). They say these as well as the "generic" ones (game.gd talk_to).
	"generic_old": {
		"es": [["Me duelen los riñones de estar agachao toa la mañana en el huerto.", "A mi edad, el que se agacha ya no se levanta: se despliega."],
			["¡Adius, qué canina! ¡Cómo apreta el sol!", "Esta tarde, en cachas a la sombra, y que no me hable nadie."],
			["Ven a caquí, que te vea el carácter.", "Pues no me suenas. ¿Tú de quién eres?"],
			["Esta mañana he ido a por la nalis.", "Me han puesto una endición y me han mandao unas cláusulas y unos depositorios.", "Y luego dicen que la medicina está adelantá."],
			["[[Mi mujer|Mi marido]] ha puesto gachas y ya están follando en la sartén.", "No pongas esa cara, que eso es cuando hacen pompas. Arpea pa tu casa, que se enfrían."],
			["Los jóvenes de ahora, con tantos afilotos. ¿Ande vais?", "Yo a tu edad iba a cagaíto y llegaba a tos laos."],
			["Mi vecina es más enterona que la arradio.", "Y más metijona. Echusté lo que sabe de ti, y eso que no te conoce."],
			["El uno de enero, grañones. Por San Antón, a santonear. En Semana Santa, potaje con pellas.", "El año se sabe por lo que se come, no por el almenaque."],
			["¿Migas? Con uvas y una taza de chocolate.", "El que diga que eso no pega es porque no las ha probao."],
			["Endenantes, la noche de San Pedro, los mozos te pintaban enramos en la fachá.", "Ahora os pintáis las peñas. Cambian los tiempos; la pintura, no."],
			["Parece que hay de muda. Me lo dice la rodilla.", "La rodilla no falla. El hombre del tiempo, sí."],
			["Anoche sentí los martinitos otra vez.", "[[Mi mujer|Mi marido]] dice que son las tuberías. ¡Ojooo, las tuberías!"],
			["Hazme rancho en el poyete, que vengo [[renguío|renguía]].", "Ochenta y tres años y tos los dientes. En un vaso, pero tos."],
			["Esa ventana me la puso uno a la medía del tío Sergio.", "Por eso no cierra. Ni abre."],
			["¡Ñalo! Ahí va otro con el amoto a toa mecha.", "Poque llegue. Poque no. Velaí."],
			["Pa merendar, una poza: el cantero hueco, tomate estrujao, aceite, pimentón y sal.", "Lo demás son cosas de capital."],
			["¡No apretes tanto el paso, criatura!", "Que a mi edad, el que corre es porque se le ha olvidao algo."]],
		"en": [["My back’s killing me from bending over the vegetable patch all morning.", "At my age you don’t stand up after bending down: you unfold."],
			["¡Adius!, what a scorcher! How that sun bears down!", "This afternoon I’m squatting in the shade and nobody talks to me."],
			["Come here, let me see that face.", "No, you don’t ring a bell. Whose are you?"],
			["I went to get my ‘nalysis this morning.", "They gave me an injectium and prescribed clauses and depositories.", "And they say medicine’s come a long way."],
			["[[My wife|My husband]]’s put gachas on and they’re already going at it in the pan.", "Don’t make that face, that’s what we call it when they bubble. Hurry home before they go cold."],
			["Young people today, always in such a rush. Where are you all going?", "At your age I went at a snail’s pace and got everywhere."],
			["My neighbour’s nosier than the wireless.", "And more of a busybody. You wouldn’t believe what she knows about you, and she’s never met you."],
			["New Year’s Day, grañones. Saint Anthony’s, round and round with the animals. Holy Week, potaje with pellas.", "You tell the year by what you eat, not by the almanac."],
			["Migas? With grapes and a cup of hot chocolate.", "Anyone who says that doesn’t go together has never tried it."],
			["In my day, on Saint Peter’s night, the lads painted flowers on your front wall.", "Now you lot paint your peñas. Times change; paint doesn’t."],
			["The weather’s on the turn. My knee says so.", "My knee is never wrong. The weatherman, now…"],
			["I heard the martinitos again last night.", "[[My wife|My husband]] says it’s the pipes. The pipes! Give over!"],
			["Shove up on the bench, I’m worn out.", "Eighty-three and all my own teeth. In a glass, but all of them."],
			["The fellow who fitted that window measured it with his hands.", "That’s why it won’t shut. Or open."],
			["Look at that! Another one on a motorbike, full tilt.", "Maybe he’ll get there. Maybe he won’t. There you go."],
			["For tea, a poza: the bread crust hollowed out, a tomato squashed in, oil, paprika and salt.", "Anything else is for city folk."],
			["Don’t walk so fast, child!", "At my age, if you hurry it’s because you’ve forgotten something."]]},
	"whisper_old": {
		"es": ["¡Papo! ¿Y {ese|esa} de quién es?", "Ñalo, {ese|esa} tiene el carácter de la Eufrasia.", "¡Qué {espirituao|espirituá}! En mi casa le ponían gachas tos los días.", "{Ese|Esa} va con afilotos. Algo ha hecho.", "¡No te amuela! Ni dice vis con Dios.", "¿Ande irá {ese|esa} a estas horas?", "Velaí que sea {forastero|forastera}. Tiene andares de capital.", "Mira qué {jaro|jara}. Por lo menos es de Consuegra."],
		"en": ["Well I never! And whose is that one?", "Look, that one’s got Eufrasia’s face.", "So skinny! In my house they’d have fed that one gachas every day.", "That one’s in a hurry. Up to something.", "The nerve! Doesn’t even say good day.", "Where’s that one off to at this hour?", "Maybe from out of town. Walks like the capital.", "Look at that red hair. From Consuegra at least."]},
	"whisper": {
		"es": ["¿Y {ese|esa} de quién es?", "{Ese|Esa} es {forastero|forastera} seguro.", "Con {ese|esa} creo que hice la mili.", "Dicen que es {el|la} de la Eufrasia.", "No saluda. Mala señal.", "Mira qué andares. De capital.", "A {ese|esa} no {lo|la} he visto yo en misa."],
		"en": ["And whose is that one?", "Definitely not from here.", "I think I did my military service with that one.", "They say that’s Eufrasia’s heir.", "Didn’t say hello. Bad sign.", "Look at that walk. City walk.", "Never seen that one at Mass."]},
	"p_push": {"es": "<interact> Empujar %d/3", "en": "<interact> Shove %d/3"},
	"t_flipped": {"es": "Has volcao. Bájate (E) y empújalo.", "en": "You rolled it. Get out (E) and push it back over."},
	"t_righted": {"es": "Arriba. Como nuevo. Bueno, como antes.", "en": "Up it goes. Good as new. Well, as before."},
	"p_paint": {"es": "<interact> Pintar", "en": "<interact> Paint"},
	"t_paint": {"es": ["Pintá. Esta pared ya es de %s.", "Otra pa %s. Tu madre estaría orgullosa. O no.", "%s manda aquí. De momento."],
		"en": ["Tagged. This wall belongs to %s now.", "Another one for %s. Your mother would be proud. Or not.", "%s runs this wall. For now."]},
	"pintadas": {"es": "Pintadas", "en": "Tags"},
	"ouch": {
		"es": ["¡Ay, la caera buena!", "He visto a mis muertos.", "¡En toa la pensión!", "¡Me cago en…! …usté perdone, padre.", "Dile a mi [[mujer|marido]]… na. Ya lo sabe.", "Enga, pues me aparezco en tu casa.", "¡Otra vez no, que es martes!", "Peor he salío de las fiestas.", "Mi abogao es mi primo. Échate a temblar.", "¡Anda y que te den, {bonico|bonica}!"],
		"en": ["¡Ay! My good hip!", "I felt my ancestors.", "Right in the pension!", "¡Me cago en…! …sorry, Father.", "Tell my [[wife|husband]]… nothing. [[She|He]] knows.", "That’s it, I’m haunting you.", "Not again, it’s only Tuesday!", "I’ve had worse at the fiestas.", "My lawyer is my cousin. Be afraid.", "¡Que te den, {guapo|guapa}!"]},
	"ouch_old": {
		"es": ["¡Adius! ¡Que me has dao en to el sentido!", "¡Me has dejao como un ceomo!", "¡Ay, que me ha dao un chabasque la pierna!", "¡Que estoy [[operao|operá]] de la pendi, animal!", "¡Como te coja, te zumbo!", "¡Tarambanas! ¡Tiés menos juicio que un cañamón!", "Pa una vez que voy de mano armá…", "¡Me cago en los martinitos y en tu abuela!"],
		"en": ["¡Adius! Right on my temple!", "You’ve left me like an Ecce Homo!", "Ay, my leg went crack!", "I’ve had my ‘pendix out, you animal!", "If I catch you, I’ll clout you!", "Scatterbrain! You’ve less sense than a hempseed!", "The one time I’m dressed up for a visit…", "Damn the night ghosts, and your grandmother!"]},
	"ouch_duty": {
		"es": ["¡Que voy andando, desgraciao!", "¡Me cago en la grúa y en tu calavera!", "¡Encima que pago la contribución!", "¡Me ha atropellao la autoridad! ¡Que conste!", "¡Ya podías pitar, mamonazo!", "¡Esto lo sabe el alcalde mañana!", "¡Que llevo los huevos en la bolsa!", "Mira, ya no me duele la rodilla. Ahora me duele to."],
		"en": ["I’m walking here, you swine!", "¡Me cago en the tow truck and your skull!", "And I pay my rates!", "Run over by the authorities! Let it be noted!", "You could have honked, mamonazo!", "The mayor hears about this tomorrow!", "I had the eggs in that bag!", "Look, my knee doesn’t hurt any more. Everything else does."]},
	"shove": {
		"es": ["¡Eh! ¡Con tiento!", "Que voy andando. Despacio. Aposta.", "¡Pita como las personas!", "Corre el aire, criatura."],
		"en": ["¡Eh! Easy!", "I’m walking here. Slowly. On purpose.", "Honk like a person!", "Personal space, criatura."]},
	"batted": {
		"es": ["¡Ay, mi madre! ¡Con el bate no!", "¡Animal! ¡Que tengo la cadera de titanio!", "¡Me cago en tus muertos y en el bate!", "¡Esto se lo digo a tu madre!", "¡Bruto, más que bruto!"],
		"en": ["Ow, mother! Not with the bat!", "You animal! I’ve got a titanium hip!", "Curse your dead, and your bat!", "I’m telling your mother!", "Brute, you utter brute!"]},
	"t_bat_kept": {"es": "Henry te deja quedarte el bate. Ahora los golpes son de bate (y los Pitufos lo notan).", "en": "Henry lets you keep the bat. Your hits are bat hits now (and Los Pitufos notice)."},
	"paca_call": {"es": "¡{Chiquillo|Chiquilla}! ¡Ven p’acá!", "en": "¡{Niño|Niña}! Come here!"},
}
