	"com_rec_champion": {"es": ["¡No me lo creo! ¡L'á ganao! ¡Al tricampeón manchego de Tokken 2 de los ochenta!", "¡Al mismísimo alcalde! ¡Tenemos {nuevo campeón|nueva campeona}!"],
