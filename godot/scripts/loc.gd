	"obj_josefa": {"es": "Ve a ver a la Josefa, la vecina de la tía Paca.", "en": "Go and see Josefa, Tía Paca’s neighbour."},
	"obj_vip": {"es": "Lleva el móvil de la Josefa al Fonsi, el del V.I.P., en la calle de Santa Ana, y habla con él.", "en": "Take Josefa’s phone to Fonsi at V.I.P., on Calle de Santa Ana, and talk to him."},
	"obj_josefa_back": {"es": "Llévale el móvil arreglao a la Josefa.", "en": "Take the fixed phone back to Josefa."},
	"n_josefa": {"es": "La Josefa", "en": "Josefa"},
	"n_vip": {"es": "El Fonsi (V.I.P.)", "en": "Fonsi (V.I.P.)"},
	"vip_sign": {"es": "V.I.P.\nInformática y Telefonía", "en": "V.I.P.\nComputers & Phones"},
	"paca_phone": {
		"es": ["¿Sí? ¿Se me oye? Que te llamo por el móvil, ¿eh? Que en La Mancha también tenemos móviles.",
			"Aquí semos mu modernos. Tenemos hasta 3G. Y un centro de internet público, con dos ordenadores. Uno enciende.",
			"A lo que iba: la Josefa, mi vecina, tiene un problema con el teléfono. Anda a verla, que vive aquí al lao.",
			"Y no le cobres, que es viuda. Bueno, cóbrale poco. Enga, cuelgo, que esto gasta."],
		"en": ["Hello? Can you hear me? I’m calling you on the mobile, eh? We’ve got mobiles in La Mancha too.",
			"We’re very modern here. We’ve even got 3G. And a public internet centre, with two computers. One of them turns on.",
			"Anyway: Josefa, my neighbour, has a problem with her phone. Go and see her, she lives right next door.",
			"And don’t charge her, she’s a widow. Well, charge her a little. Enga, I’m hanging up, this costs money."]},
	"josefa_problem": {
		"es": ["¡Ay, {hijo|hija}, menos mal! Que se me ha desconfigurao el teléfono.",
			"Yo le di a un botón. O a dos. Y ahora me habla en inglés y me sale un señor chino dando el tiempo.",
			"Yo de estas cosas no entiendo. Llévalo a la tienda esa de los ordenadores, el V.I.P., que el muchacho sabe.",
			"Y que no te engañe, que ese cobra por mirar."],
		"en": ["Ay, {hijo|hija}, thank goodness! My phone has gone and unconfigured itself.",
			"I pressed a button. Or two. Now it talks to me in English and a Chinese gentleman comes on with the weather.",
			"I don’t understand these things. Take it to that computer shop, V.I.P. — the lad knows.",
			"And don’t let him swindle you. That one charges for looking."]},
	"josefa_idle": {"es": ["Yo antes tenía un teléfono con rueda. Ese no se desconfiguraba. Ese te desconfiguraba el dedo."],
		"en": ["I used to have a phone with a dial. That one never unconfigured itself. It unconfigured your finger."]},
	"vip_fix": {
		"es": ["Bienvenío a V.I.P.: Vendo e Instalo. A ver ese cacharro.",
			"…Ya está. Tenía el idioma en inglés y el brillo al mínimo. Un periquete.",
			"Son 500 euros. Más IVA. Seiscientos cinco."],
		"en": ["Welcome to V.I.P.: Vendo e Instalo. I sell and I install. Let’s see that contraption.",
			"…Done. The language was set to English and the brightness to minimum. Took a jiffy.",
			"That’s 500 euros. Plus VAT. Six hundred and five."]},
	"vip_idle": {"es": ["¿Lo has apagao y lo has vuelto a encender? Son 40 euros."], "en": ["Have you tried turning it off and on again? That’s 40 euros."]},
	"vip_q": {"es": "605 €. ¿QUÉ HACES?", "en": "605 €. WHAT NOW?"},
	"vip_q_again": {"es": "TE MIRA CON GUASA", "en": "HE SMIRKS AT YOU"},
	"ask_vip": {"es": "Seiscientos cinco, IVA incluío. ¿Pagas o qué?", "en": "Six hundred and five, VAT included. Paying or what?"},
	"ask_vip_again": {"es": "Hombre, el de los seiscientos cinco. ¿Traes los cuartos o vienes a por otra?", "en": "Well, look, the six-hundred-and-five one. Brought the cash, or back for another round?"},
	"ask_vip_spar": {"es": "¿Qué? ¿Echamos uno?", "en": "Well? Fancy a round?"},
	"ask_chiki": {"es": "¿Qué pasa? ¿Qué quieres?", "en": "What’s up? What do you want?"},
	"vip_pay": {"es": "Pagarle los 605 €", "en": "Pay him the 605 €"},
	"vip_pay_no": {"es": "Pagarle los 605 € (no te llega: tiés %d €)", "en": "Pay him the 605 € (you can’t: you have %d €)"},
	"vip_fight": {"es": "Retarle a un combate", "en": "Challenge him to a fight"},
	"vip_rematch": {"es": "Pedirle la revancha", "en": "Demand a rematch"},
	"vip_leave": {"es": "Irte a buscar dinero", "en": "Go and find some money"},
	"vip_challenge": {
		"es": ["¿Que no tiés perras? ¿Y encima me retas? ¿A MÍ?",
			"¿Sabes qué es la P de V.I.P.? De Pegar ostias como Panes.",
			"Enga, pasa pa la trastienda, que tengo un ring. No preguntes. Al mejor de tres asaltos.",
			"Si ganas, te lo llevas gratis. Si gano yo… eso es lo que va a pasar."],
		"en": ["No money? And you’re challenging me? ME?",
			"You know what the P in V.I.P. is for? Pegar ostias como Panes. Punches the size of loaves.",
			"Enga, through to the back room, I’ve got a ring. Don’t ask. Best of three rounds.",
			"If you win, it’s free. If I win… which is what’s going to happen."]},
	"vip_again": {"es": ["¿Otra vez? Si es que te gusta cobrar. Enga, pa la trastienda."], "en": ["Again? You must enjoy getting hit. Enga, back room."]},
	"vip_win": {
		"es": ["¡Vale, vale! ¡Pa ti el teléfono! Gratis. Y de esto ni una palabra a nadie.",
			"Me ha zurrao {uno|una} que no sabe ni poner el wifi…"],
		"en": ["All right, all right! The phone’s yours! Free. And not a word of this to anyone.",
			"Beaten up by someone who can’t even set up the wifi…"]},
	"vip_lose": {
		"es": ["¡JA! Como un saco de pienso. Anda, vuelve cuando tengas dinero.",
			"O ganas de cobrar otra vez. Lo que llegue antes."],
		"en": ["HA! Like a sack of feed. Go on, come back when you’ve got money.",
			"Or when you fancy another beating. Whichever comes first."]},
	"vip_paid": {
		"es": ["¿Seiscientos cinco? ¿Así, del tirón? ¿Tú estás {forrao|forrá} o qué?",
			"Oye… ¿tú no querrás casarte con {mi hija|mi hijo}? Que yo también tengo tierras.",
			"Juntamos lo tuyo y lo mío y hacemos un patrimonio que pa qué. Tú piénsatelo."],
		"en": ["Six hundred and five? Just like that? Are you loaded or what?",
			"Listen… you wouldn’t want to marry my {daughter|son}, would you? I’ve got land too.",
			"We put yours and mine together and that’s a proper estate. You think about it."]},
	"josefa_thanks": {
		"es": ["¡Ay, qué apaño! Ya me habla en cristiano.",
			"Toma, {hermoso|hermosa}, que te lo has ganao: DOS MIL QUINIENTAS. Y no me digas que no."],
		"en": ["Ay, what a relief! It talks properly again.",
			"Here, cariño, you’ve earned it: TWO THOUSAND FIVE HUNDRED. And don’t you say no."]},
	"t_pesetas": {"es": "…pesetas. Al cambio: 15 €.", "en": "…pesetas. That comes to 15 €."},
	"josefa_pesetas": {"es": "En pesetas, claro. Que una es viuda, no tonta.", "en": "In pesetas, obviously. I’m a widow, not a fool."},
	"paca_night1": {
		"es": ["¿Ya has apañao lo de la Josefa? Así me gusta. Luego dirán que la juventud no vale pa na.",
			"Enga, a dormir. Que en este pueblo siempre hay alguien con algo roto, y mañana te toca."],
		"en": ["Josefa’s business sorted? Good. And they say young people are good for nothing.",
			"Enga, to bed. There’s always somebody in this town with something broken, and tomorrow it’s your turn."]},
	"day_name_0": {"es": "La ciudad no es para mí", "en": "La ciudad no es para mí"},
	"day_name_1": {"es": "Sin cobertura", "en": "Sin cobertura"},
	"d1_m2": {"es": "El puente de Arroyuelo Medio", "en": "The Arroyuelo Medio Bridge"},
	"obj_bridge": {"es": "Ve a ver al Alberto, el del puente, en la calle del Arroyuelo Medio.", "en": "Go and see Alberto, the bridge one, on Calle del Arroyuelo Medio."},
	"rank_tbc": {"es": "Continuará…", "en": "To be continued…"},
	"end_title_tbc": {"es": "Día %d · a medias", "en": "Day %d · half done"},
	"josefa_bridge": {
		"es": ["En pesetas, claro. Que una es viuda, no tonta.",
			"Oye, y ya que estás {desocupao|desocupá}: el Alberto, el sobrino de mi prima segunda, tiene montá una manifestación.",
			"Que quieren tirar el puente del Arroyuelo Medio. ¡Con más de cien años que tiene! Pa que pasen los coches, dicen. Como si no hubiera calles.",
			"Anda a verle, que es buen muchacho. Un poco pesao, pero buen muchacho.",
			"Y dile que vas de mi parte, a ver si así deja de pedirme firmas a mí. Que ya le he firmao cuatro veces.",
			"Ah, y otra cosa: yo me conozco tos los negocios del pueblo. Si quieres más recados, ven a hablar conmigo."],
		"en": ["In pesetas, obviously. I’m a widow, not a fool.",
			"Listen, since you’ve nothing on: Alberto, my second cousin’s nephew, has got a demonstration going.",
			"They want to pull down the Arroyuelo Medio bridge. Over a hundred years old! So the cars can get through, they say. As if there were no streets.",
			"Go and see him, he’s a good lad. A bit of a bore, but a good lad.",
			"And tell him I sent you. Maybe then he’ll stop asking me to sign. I’ve signed four times already.",
			"Oh, and another thing: I know every business in this town. If you want more errands, come and talk to me."]},
