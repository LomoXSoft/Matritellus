	"log_foot": {"es": "← → pasar página     ↑ ↓ elegir     <ok> aceptar     <esc> volver", "en": "← → turn the page     ↑ ↓ choose     <ok> accept     <esc> back"},
	"log_folk": {"es": "VECINOS", "en": "NEIGHBOURS"},
