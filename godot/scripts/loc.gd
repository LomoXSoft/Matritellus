	"t_bust_count": {"es": "¡Que te trincan! No te pares… %d", "en": "They’ve got you! Don’t stop… %d"},
	"t_busted": {"es": "{TRINCAO|TRINCÁ}. %s se quedan %d € de tus perras.", "en": "BUSTED. %s keep %d € of your cash."},
	"t_repair": {"es": "Coche apañao. Son %d €, sin factura.", "en": "Car patched up. That’s %d €, no receipt."},
	"t_repair_free": {"es": "Coche apañao. Te lo apunto, que no llevas ni pa pipas.", "en": "Car patched up. On the tab — you can’t even afford sunflower seeds."},
	"t_broken": {"es": "El coche ha dicho que hasta aquí. Búscate otro.", "en": "The car says no more. Find another one."},
	"t_jump": {"es": "¡%d metros por el aire! Lo han visto desde Consuegra.", "en": "%d metres of air! They saw that from Consuegra."},
	"t_tree": {"es": ["Ese árbol lo plantó tu bisabuelo. Enga.", "Leña pa'l invierno.", "El de Medio Ambiente te va a poner fino."],
		"en": ["Your great-grandfather planted that tree. Well done.", "Firewood for winter.", "The parks department would like a word."]},
	"t_terraza": {"es": ["¡La terraza! Con lo que cuesta coger mesa.", "Ha volao hasta el vermú.", "El del bar te va a cobrar hasta las servilletas."],
		"en": ["The terrace! Do you know how hard it is to get a table?", "Even the vermouth took flight.", "The bar owner will bill you for the napkins too."]},
	"t_prop": {"es": ["Mobiliario urbano: era.", "Eso lo pagamos entre tos.", "El concejal de obras va a llorar.", "Total, estaba torcío."],
		"en": ["Street furniture: was.", "We all paid for that.", "The works councillor is going to cry.", "It was crooked anyway."]},
	"st_broken": {"es": "Cosas del Ayuntamiento rotas", "en": "Council property destroyed"},
	"st_money": {"es": "Perras", "en": "Cash"},

