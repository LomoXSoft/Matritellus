	"log_radio_how": {"es": "En el coche, %s cambia de emisora. Al final del dial, la radio se apaga.", "en": "In the car, %s changes station. Past the end of the dial, the radio goes off."},
	"log_folk_none": {"es": "No conoces a nadie. Anda, sal y saluda.", "en": "You don’t know anybody. Go on, get out and say hello."},
	"log_folk_how": {"es": "Saludar +3 (una vez al día) · hacerles una misión +10 · un minijuego con ellos +5 la primera vez, luego +1 · no cogerles el teléfono −1 · pegarles o atropellarlos −3 (una vez al día). La confianza no baja de 25, 50 ni 75 una vez alcanzaos; a 100 se queda de oro.",
		"en": "Saying hello +3 (once a day) · a mission for them +10 · a minigame with them +5 the first time, then +1 · not picking up their call −1 · hitting them or running them over −3 (once a day). Trust never drops back below 25, 50 or 75 once reached; at 100 it turns to gold."},
	"log_thu": {"es": "Los jueves por la mañana te llamará algún vecino con hambre. Ten el móvil a mano.", "en": "On Thursday mornings a hungry neighbour will ring you. Keep your phone handy."},
	"log_closed": {"es": "cerrao", "en": "locked"},
