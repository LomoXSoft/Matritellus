	"placards": {"es": ["EL PUENTE NO SE TOCA", "CIEN AÑOS Y NI UNA GRIETA", "PA COCHES, LA MATÍAS PÉREZ", "MI ABUELO SE DECLARÓ AQUÍ", "TIRAR ES DE COBARDES", "YO HE VENÍO A MIRAR"],
		"en": ["EL PUENTE NO SE TOCA", "A HUNDRED YEARS, NOT ONE CRACK", "CARS: USE MATÍAS PÉREZ", "MY GRANDAD PROPOSED HERE", "KNOCKING DOWN IS FOR COWARDS", "I JUST CAME TO LOOK"]},
	"protest_chant": {"es": ["¡El puente no se toca!", "¡Cien años y ni una grieta!", "¡Alcalde, valiente, tírate tú del puente!", "¡Pa los coches, la Matías Pérez!", "¡Menos asfalto y más puente!"],
		"en": ["Hands off the bridge!", "A hundred years, not a single crack!", "Mayor, show some bottle—jump off it yourself!", "Motors can use Matías Pérez!", "Less tarmac, more bridge!"]},
	"protest_serious": {
		"es": [["¡El puente no se toca! Mi abuelo se declaró ahí encima. Le dijeron que no, pero se declaró."],
			["Llevo aquí desde las siete. No he desayunao. Por el puente, lo que haga falta. Menos el almuerzo, que eso es sagrao."],
			["Hoy es el puente y mañana es la ermita. Y pasao, mi cochera. Que te lo digo yo."]],
		"en": [["Hands off the bridge! Me grandad popped the question on top of it. Got turned down flat, mind, still counts."],
			["Been out ’ere since seven. No brekkie. For the bridge, whatever it takes—except elevenses, elevenses are sacred."],
			["Today the bridge, tomorrow the chapel, day after me garage. Mark my words."]]},
	"protest_gossip": {
		"es": [["Yo he venío a ver quién venía. Y ha venío tó el mundo. Ya tengo pa una semana."],
			["¿Tú sabes de qué va esto? Yo tampoco, pero hay ambiente."],
			["A mí el puente me da igual. Yo he bajao a por el pan y me he liao."]],
		"en": [["Only popped down to clock who turned up. Everybody came—got gossip to last a week."],
			["Clue what this row’s over? Me neither, proper lively crowd though."],
			["Couldn’t care less about the bridge, love. Nipped out for a loaf and got roped right in."]]},
	# La Chiki and the walls of the peñas (pintadas.gd). {pena}: your peña; {calle}: a street
	"chiki_intro_same": {"es": ["¡Anda! ¿De los Nietos de Marzo? ¡Haberlo dicho antes, {hermoso|hermosa}!", "Yo también. Desde los pañales. Los pañales también eran de la peña."],
		"en": ["Oi! Nietos de Marzo? Could’ve led with that, {mate|love}!", "Same ’ere—since nappies. Even the nappies had the peña badge on."]},
	"chiki_intro_other": {"es": ["¿De {pena}? Vaya por Dios.", "Yo soy de los Nietos de Marzo. Pero no pasa ná: aquí cabemos tos. Unos más que otros, pero tos."],
		"en": ["{pena}? Blimey, all right.", "I’m Nietos de Marzo meself. No bother though—room for everyone round ’ere. Some more’n others, mind."]},
	"chiki_intro_penas": {"es": ["Una peña es eso: pertenecer a algo. Una comunidad. Ayudarse unos a otros cuando las cosas vienen mal dadas.", "Bueno. Sobre tó es emborracharse juntos.", "Y en la feria, subirse al Toro Loco a ver quién echa la pota antes. Pero con mucho sentimiento."],
		"en": ["A peña’s all about belongin’, mate. Community. Backin’ each other up when life turns dodgy.", "Well. Mostly gettin’ proper plastered together.", "And down the fairground, ridin’ the buckin’ bull to see who chunders first. Dead heartfelt, though."]},
	"chiki_intro_tour": {"es": ["¿Ves esa pintada? Las hay por tó el pueblo. Cada peña tiene su logo.", "El trabajo de una peña es pintar su logo encima del de la peña rival. Pared a pared.", "Es como una guerra de territorios de mafias, pero con menos muertos. Drogas, las mismas."],
		"en": ["See that tag? Splashed all over town. Every peña’s got its own crest.", "Our job’s to paint ours straight over the rival peña’s. Wall by wall.", "Bit like a mafia turf war with fewer stiffs. Roughly the same drugs, mind."]},
	"chiki_intro_spray": {"es": ["¿Tú tiés spray?", "…", "Ya veo que no."], "en": ["Got a spray can on you?", "…", "Clocked that—skint on paint, are we?"]},
	"chiki_spray_same": {"es": ["Toma el mío. Entre marzistas hay que ayudarse.", "Y cuando tapes una de las otras, piensa en mí. Bueno, mejor no pienses en mí: tú tapa."],
		"en": ["Grab mine, mate. Marzistas stick together.", "When you cover a rival wall, think o’ me. Actually no, scrub that—just spray."]},
	"chiki_spray_other": {"es": ["Toma. Está medio vacío, que conste.", "A mí no me gusta ayudar a otras peñas. Pero estoy en control de la ira, por lo del estrés, y dice el psicólogo que ayudar me viene bien.", "(De toas las peñas del pueblo, ha ido a escoger {pena}. La más cutre.)"],
		"en": ["Here—half empty already, mind you.", "Can’t stand helpin’ rival peñas, truth be told. On anger management though, and me shrink reckons pitchin’ in’s good for me.", "(Out of every peña in town, goes and picks {pena}. Saddest lot going.)"]},
	"chiki_q_tag": {"es": "¿Has visto alguna pintada por ahí?", "en": "Spotted any graffiti about?"},
	"chiki_q_chat": {"es": "Ná, charlar un rato.", "en": "Nowt, just fancy a natter."},
	"chiki_hint": {"es": ["Me ha parecío ver una en {calle}. Pero no te lo aseguro, que iba con prisa."], "en": ["Reckon I clocked one down {calle}. Don’t quote me though, I were beltin’ past."]},
	"chiki_somewhere": {"es": "una calle de por ahí", "en": "some lane round ’ere"},
	"chiki_hint_again": {"es": ["Hoy ya te he dicho una. Mañana más, que yo también tengo mi vida."], "en": ["Gave you one today already. Catch me tomorrow—got a life an’ all, mate."]},
	"chiki_hint_none": {"es": ["Pues ahora mismo no se me ocurre ninguna. ¿No las habrás tapao ya toas?"], "en": ["Drawing a blank right now. Ain’t painted over the whole town already, ’ave you?"]},
	"chiki_call_same": {"es": ["¡Las has tapao toas! ¡Toítas!", "Por eso aceptamos forasteros en la peña: luego son los que más se involucran. Los de aquí nos quedamos en la barra."],
		"en": ["Covered every last one! The whole blinkin’ lot!", "Why we let out-o’-towners in the peña—properly get stuck in, while us locals prop up the bar."]},
	"chiki_call_other": {"es": ["Ya me han dicho que has tapao toas las pintadas del pueblo.", "No te vía decir que esté contenta. Pero el que le da vidilla al pueblo, a mí me tiene. Eso lo respeto."],
		"en": ["Word is you’ve tagged over every single wall in town.", "Won’t pretend I’m thrilled, mate. Still, anyone stirrin’ this place up earns my respect. Bang on."]},
	"chiki_maria": {"es": ["Oye, ya que semos de confianza…", "Me llamo María. Lo de La Chiki es de cuando era chica, y ya se quedó.", "¿Conoces a Don Luis, el del Kebab Luis? Es mi hermano.", "Es curioso lo poco que nos paecemos: en lo físico, en lo filosófico, en lo cultural y en las aficiones.", "Y sin embargo, semos mu parecíos. Extraño, ¿no?"],
		"en": ["Listen, seein’ as we’re mates now…", "Real name’s María. La Chiki’s from when I were tiny, and it just stuck.", "Know Don Luis, gaffer at Kebab Luis? Me brother, he is.", "Funny how different we look—physically, philosophically, culturally, hobbies and all.", "Yet deep down we’re dead alike. Mental, innit?"]},
	"chiki_title": {"es": "Las pintadas de las peñas", "en": "The peñas' walls"},
	"log_chiki_open": {"es": "La Chiki te ha dao spray: pídele pistas", "en": "La Chiki gave you a spray: ask her for tips"},
	"t_tags_unlocked": {"es": "Las pintadas: tapa con el logo de tu peña las de las otras. Pregúntale a La Chiki si ha visto alguna.", "en": "The walls: cover the other peñas' logos with yours. Ask La Chiki if she's seen any."},
	"chiki_idle": {
		"es": [["¿Yo? Yo he venío por el Alberto. A mí el puente, la verdad, me da un poco igual. Pero es mono."],
			["Soy artista. Ahora estoy con una serie sobre el vacío. Llevo tres años. No he empezao."],
			["Tengo veintitantos. Veintimuchos. Bueno. La edad da igual, ¿no? Eso decían en Barcelona."],
			["Si no hay plan, yo me apunto a lo que sea. Manifestación, bautizo, vendimia. A un bombardeo me apuntaba."],
			["He vivío en Madrid, en Barcelona y en Berlín. En las tres me decían que hablaba raro. Aquí ya me lo dicen también."]],
		"en": [["Me? I came for Alberto. The bridge, honestly, I’m not that bothered. It’s cute, though."],
			["I’m an artist. I’m working on a series about emptiness. Three years now. I haven’t started."],
			["I’m twenty-something. Twenty-lots. Anyway. Age doesn’t matter, does it? That’s what they said in Barcelona."],
			["If there’s no plan, I’m up for anything. A demo, a christening, the grape harvest. I’d sign up for an air raid."],
			["I’ve lived in Madrid, Barcelona and Berlin. In all three they said I talked funny. Now they say it here too."]]},
	"chiki_after": {
		"es": [["Pues ya está, ¿no? El puente sigue ahí. Qué bien. O qué mal. No sé, a mí me da igual."],
			["Si haces algo luego, avisa. Lo que sea. Yo no tengo ná que hacer hasta… a ver… hasta mayo."],
			["Esta chaqueta es de Londres. Bueno, del mercadillo de Consuegra, pero el puesto se llamaba «London»."]],
		"en": [["So that’s that, mate? Bridge is still standin’. Grand. Or not grand—honestly I’m easy."],
			["Up to summat later, give us a bell. Anything goes. Zero plans till… let’s see… May."],
			["This jacket’s straight from London, mind. Well, Consuegra market, stall were called “London” though."]]},
	"alberto_again": {
		"es": ["¿Y las firmas? ¿Que te s'á hecho tarde? A mí también se me hace tarde y aquí estoy, desde las siete.",
			"Enga, otra vez. Cinco firmas, de gente de fuera de la manifestación, {plazo}."],
		"en": ["Where are the signatures? Caught short on time? Clock sneaks up on me too, still ’ere since seven.",
			"Enga, one more crack. Five signatures, folks outside this crowd, {plazo}."]},
	"firmas_plazo_dusk": {"es": "antes de que anochezca", "en": "before nightfall"},
	"firmas_plazo_dawn": {"es": "antes de que amanezca", "en": "before dawn"},
	"alberto_firmas": {
		"es": ["¿Las cinco? A ver… Una, dos… esta es una pezuña. Vale. Vale también.",
			"Con estas ya son cuarenta y ocho. De veinticuatro personas. ¡Hemos doblao la plataforma!",
			"Toma, diez euros de la hucha. No digas ná, que la hucha es de mi madre.",
			"Mañana se las llevo al alcalde. Y si no nos recibe, me encadeno al puente. Bueno, me ato. Con cuerda. Que la cadena pesa."],
		"en": ["Got all five? Let’s see… One, two… this one’s a hoofprint. Sorted—counts all the same.",
			"Takes us to forty-eight! Off twenty-four folks. Proper doubled our numbers!",
			"Here, ten euros out the piggy bank. Keep schtum—it’s me mum’s.",
			"Tomorrow I march ’em up to the Mayor. Won’t see us, I’m chainin’ meself to the bridge. Well, tyin’—rope’s lighter’n chains."]},
	"alberto_after": {
		"es": [["El puente sigue en pie. De momento. Yo no me fío y duermo con un ojo abierto. El izquierdo."],
			["¿Has firmao hoy? Es broma. ¿O no?"]],
		"en": [["Bridge is still standin’—for now. Don’t trust ’em an inch, sleep with one eye cracked. The left ’un."],
			["Signed owt today? Just kiddin’. Or am I?"]]},
	"obj_firmas_day": {"es": "Consigue firmas pa'l puente antes de que se haga de noche: llevas %d de %d.", "en": "Collect signatures for the bridge before nightfall: %d of %d so far."},
	"obj_firmas_night": {"es": "Consigue firmas pa'l puente antes de que amanezca: llevas %d de %d.", "en": "Collect signatures for the bridge before dawn: %d of %d so far."},
	"obj_firmas_back": {"es": "Llévale las cinco firmas al Alberto, al puente.", "en": "Take the five signatures to Alberto, at the bridge."},
	"t_firma": {"es": "Firma %d de %d.", "en": "Signature %d of %d."},
	"t_firmas_all": {"es": "¡Las cinco! Llévaselas al Alberto.", "en": "All five! Take them to Alberto."},
	"t_firmas_late": {"es": "Te s'á pasao la hora y las firmas que llevabas ya no valen. Vuelve a ver al Alberto.", "en": "Time’s up, and the signatures you had no longer count. Go back to Alberto."},
	"t_unlocked": {"es": "El Alberto y la Chiki ya están en tu Agenda.", "en": "Alberto and Chiki are in your Diary now."},
	"firma_alberto": {
		"es": ["¿Yo? Yo he firmao el primero. Y el tercero. Y el octavo, con la izquierda, pa que no se note.", "Las mías no valen. Tira, que se va la luz."],
		"en": ["Me? Signed first, mate. And third. And eighth left-handed so nobody’d clock it.", "Mine don’t count though—scarper afore the light fades."]},
	"firma_chiki": {
		"es": ["Yo ya firmé. Creo. Firmé algo. Igual era lo de un paquete, no sé.", "En Berlín firmábamos contra tó. Aquí también, pero con más viento."],
		"en": ["Reckon I already signed. Signed summat, anyway—might’ve been for a parcel, dunno.", "In Berlin we signed petitions against everything. Same round ’ere, just windier."]},
	"firma_protest_serious": {
		"es": ["¡Yo he firmao el segundo! Y he traío a mi [[cuñao|cuñá]], que ha firmao llorando.", "Firmao, sellao y con el DNI apuntao. Busca fuera, que aquí hemos firmao tos."],
		"en": ["Signed second, I did! Dragged me [[brother-in-law|sister-in-law]] down an’ all, signed blubbin’.", "Signed, sealed and ID logged. Try further down the street—whole crowd ’ere’s already signed."]},
	"firma_protest_gossip": {
		"es": ["Yo he firmao, yo he firmao. No sé el qué, pero he firmao.", "A mí ya me la han pedío tres veces. He firmao dos y media."],
		"en": ["I signed, I signed! Clue what for, signed all the same.", "Hit me up three times already—signed twice and a half."]},
	"firma_again_si": {"es": ["Que ya te he firmao. ¿Quiés que te firme también la frente?"], "en": ["Signed once already, love. Want me autograph on your forehead next?"]},
	"firma_again_no": {"es": ["Que no. Y si me lo vuelves a pedir, que menos."], "en": ["Nope. Ask again and it’s double nope."]},
	"firma_si": {
		"es": ["Trae pa'cá. ¿Ande firmo? ¿Aquí? ¿Y esto no será pa un crédito?",
			"Yo firmo lo que sea si es contra el Ayuntamiento.",
			"Por ese puente pasé yo de [[novio|novia]]. Y de [[casao|casá]]. Y huyendo. Trae.",
			"Firmo. Pero pon que soy de Consuegra, que aquí no quiero líos.",
			"¿El puente? Claro, hombre. ¿Y ande va uno a mirar el agua cuando llueve?",
			"Venga. Mi firma y la de mi [[mujer|marido]], que firma igual que yo porque se la hago yo."],
		"en": ["Pass it ’ere. Sign right there? Ain’t some dodgy loan, is it?",
			"Sign owt if it winds up the town hall.",
			"Crossed that bridge courtin’, married, and scarperin’. Hand the pen.",
			"Alright, stick me down from Consuegra though—don’t fancy grief round ’ere.",
			"The bridge? Course, mate. Where else you meant to stand watchin’ the rain flood down?",
			"Enga. Mine and me [[missus|old man]]’s signature—look dead alike ’cause I scribble hers too."]},
	"firma_no": {
		"es": ["No, que la última vez que firmé algo me llegó una enciclopedia.",
			"Hoy no firmo, que es martes. O el día que sea. Hoy no.",
			"No puedo, tengo la mano de firmar ocupá. Luego la tengo libre, pero luego no estaré.",
			"Yo es que soy más de túneles.",
			"Uy, no. Mi [[mujer|marido]] no me deja firmar desde lo del apartamento en Torrevieja.",
			"Sin gafas no firmo. Y las gafas no las encuentro porque sin gafas no veo.",
			"No, que si firmo luego me sale el nombre en internet y me llaman los de las alarmas.",
			"¿Y si luego lo tiran igual y he hecho el ridículo? Quita, quita.",
			"Yo ya firmé por otro puente en el ochenta y dos y mira: ni puente ni ná."],
		"en": ["Nope—last time I signed summat a whole encyclopaedia showed up on the doorstep.",
			"No signin’ Tuesdays. Or whatever day it is. Definitely not today.",
			"Can’t—me signin’ hand’s tied up. Might be free later, won’t be ’ere later though.",
			"More of a tunnel bloke meself.",
			"Ooh, no. Me [[missus|old man]] banned me from signin’ owt after that Torrevieja timeshare.",
			"Never sign without me specs. Can’t find me specs ’cause I can’t see without ’em.",
			"No chance—sign that, me name’s online and alarm salesmen ring round the clock.",
			"And when they flatten it anyway and I look a mug? No thanks.",
			"Signed for another bridge back in ’82 and look—no bridge, nowt."]},
	"firma_si_kid": {"es": "Yo firmo con un dinosaurio. Es mi firma. Es oficial.", "en": "I sign with a dinosaur. Official autograph, that."},
	"firma_no_kid": {"es": "Mi madre dice que no firme ná hasta los dieciocho. Ni los deberes.", "en": "Mum says no signin’ owt till I’m eighteen. Not even homework."},
	"firma_si_paca": {"es": "Trae. Y que conste que firmo por el puente y no por el Alberto, que ese zagal me debe una paella.", "en": "Pass it ’ere, love. Mind, I sign for the bridge, not young Alberto—that lad still owes me a paella."},
	"firma_no_paca": {"es": "Yo no firmo ná sin leerlo. Y no lo vía leer.", "en": "Never sign owt unread, love—and I ain’t readin’ all that."},
	"firma_si_loli": {"es": "Firmo. Y si lo tiran, que no cuenten con mi aceite.", "en": "I’ll sign. Flatten it and they can whistle for me olive oil."},
	"firma_no_loli": {"es": "No, que estoy trabajando y aquí tó lo que firmo es un albarán.", "en": "Can’t, love—on shift, owt I sign ’ere turns into a delivery note."},
	"firma_si_eusebio": {"es": "Firmo, que ese puente me trae clientes: lo suben, se cansan y almuerzan.", "en": "Sign away—that bridge drags punters straight in: hike up, get knackered, stop for lunch."},
	"firma_no_eusebio": {"es": "No, que luego dicen que el bar se mete en política. Aquí solo se discute de fútbol y de herencias.", "en": "Nope—folks’ll say the bar’s playin’ politics. Round ’ere we only row over footy and wills."},
	"firma_si_anselmo": {"es": "Firmo. Ese puente lo bendijo un antecesor mío. Borracho, pero lo bendijo.", "en": "I’ll sign. One o’ me predecessors blessed that bridge. Three sheets to the wind, mind, still counts."},
	"firma_no_anselmo": {"es": "{Hijo|Hija}, la Iglesia no firma. La Iglesia espera. Llevamos dos mil años esperando y mira qué bien.", "en": "My child, the Church signs nowt. The Church waits. Two thousand years waitin’ and look how grand that’s gone."},
	"firma_si_ramirez": {"es": "Firmo como ciudadano. Como teniente, no he visto ná.", "en": "Sign as a private citizen. As Lieutenant? I clocked nowt."},
	"firma_no_ramirez": {"es": "Negativo. Un agente no firma: un agente levanta acta. ¿Quiés un acta?", "en": "Negative. An officer doesn’t sign petitions—an officer writes citations. Fancy one?"},
	"firma_si_dolores": {"es": "Firmo, firmo, que el puente no tiene la culpa de ná. Y ya que estáis, apuntad debajo que le cambien el nombre a mi calle.", "en": "Signin’, signin’—nowt the poor bridge’s fault. While you’re at it, scribble at the bottom to rename me bloomin’ street."},
	"firma_no_dolores": {"es": "Yo no firmo ná hasta que le cambien el nombre a la calle de la Amargura. Cada cosa a su tiempo, {hijo|hija}.", "en": "I sign nowt till they rename Calle de la Amargura. First things first, {lad|lass}."},
	"firma_si_maruja": {"es": "Firmo, firmo. ¿Y quién más ha firmao? Déjame ver la lista. No, por ná. Por saber.", "en": "I’ll sign, I’ll sign. Who else is on ’ere? Giz a look at the sheet—nosy? No, just checkin’."},
	"firma_no_maruja": {"es": "No firmo hasta saber quién ha firmao antes. Que yo al lao de según quién no pongo mi nombre.", "en": "Sign nowt till I clock who signed afore me—certain folks round ’ere I ain’t sharin’ ink with."},
	"firma_si_venancio": {"es": "Firmo. Un puente viejo que se cae da trabajo; uno que tiran aposta no deja ni eso.", "en": "Sign me up. An old bridge tumblin’ brings trade; knockin’ it down deliberate leaves nowt."},
	"firma_no_venancio": {"es": "No firmo. En mi oficio las firmas son siempre por un disgusto.", "en": "No signin’. In me line o’ work, a signature means somebody pegged it."},
	"firma_si_genaro": {"es": "Firmo. Lo viejo que funciona no se toca. Mírame a mí.", "en": "Sign away. You don’t mess with old things still tickin’. Take a butcher’s at me."},
	"firma_no_genaro": {"es": "No. Yo ya firmé contra el viento en el cincuenta y nueve y sigue soplando.", "en": "Nope. Signed a petition against the wind back in ’59 and it’s blowin’ yet."},
	"firma_si_kevin": {"es": "Firmo. Con el nombre entero: Kevin-José. Con guion. El guion es lo más mío.", "en": "I’ll sign—full name: Kevin-José. Don’t miss the hyphen, proper part o’ me brand."},
	"firma_no_kevin": {"es": "No puedo: soy menor. Pero te lo notarío por dos euros.", "en": "Can’t, I’m underage. Stamp it official for two euros though, deal?"},
	"firma_si_feliciano": {"es": "Firmo, firmo. Por ese puente pasaba yo pa ir a por el jamón del Henry. ¡Firmo dos veces si me dejas!", "en": "Sign me down, twice if you’ll let me! Used to belt over that bridge for Henry’s ham."},
	"firma_no_feliciano": {"es": "Ahora no, que me pillas contando los días pa'l jueves y pierdo la cuenta.", "en": "Not now, love—caught me countin’ down till Thursday, throw me right off."},
	"firma_si_nino_negro": {"es": "Vale, firmo. Si salvamos el puente, lo bajo con la bici sin frenar. Y luego a la piscina.", "en": "Sound, I’ll sign. Save the bridge and I’m bomb-runnin’ it on me bike, no brakes, straight to the pool."},
	"firma_no_nino_negro": {"es": "Ahora no, que tengo las manos de crema de cacao y te pongo el papel perdío.", "en": "Can’t now, got chocolate spread all over me mitts—state o’ your sheet after, eh?"},
	"firma_si_goat": {"es": ["Beeeh.", "(Moja la pezuña en un charco y la planta en el papel. En este pueblo ha valío pa cosas peores.)"], "en": ["Beeeh.", "(Dips a hoof in a puddle and stamps the page. Round ’ere that’s passed for worse.)"]},
	"firma_no_goat": {"es": ["Beeeh.", "(Se come la esquina del papel ande iba la firma. Lo cuentas como un no.)"], "en": ["Beeeh.", "(Chews the corner clean off where the line goes. Put that down as a no.)"]},
	"firma_si_josefa": {"es": "¿Otra vez? Trae. Con esta van cinco. Y dile al Alberto que la sexta se la cobro.", "en": "Back again? Hand it ’ere, love—makes five now. Tell Alberto sixth one costs ’im."},
	"firma_no_josefa": {"es": "No, {hijo|hija}, que ya le he firmao cuatro veces y a la quinta me empadronan en el puente.", "en": "No chance, {lad|lass}—signed four times already, fifth one they’ll stick me address down as the bridge."},
	"firma_si_vip": {"es": "Firmo. Son cuarenta euros. Es broma. Son veinte. Que no, hombre, que firmo.", "en": "Sign away—forty quid. Kidding. Twenty. Relax, mate, ’ere y’are."},
	"firma_no_vip": {"es": "Firmar es un servicio. Los servicios se cobran. ¿No pagas? Pues no hay firma.", "en": "Signin’’s a service, mate. Services cost dough. No cash, no scribble."},
	"firma_si_luis": {"es": "Firmo, firmo. Y si hace falta os lo firmo en binario, que pa eso estudié.", "en": "Sign it, sign it. Scribble it in binary if you want—what I went to uni for, eh?"},
	"firma_no_luis": {"es": "¿Un puente? Yo no firmo ná que no se pueda enrollar en pan de pita.", "en": "A bridge? I sign nowt that won’t wrap up tidy in a pitta."},
	"firma_si_diurno": {"es": "¡Pues claro que firmo! Con mi letra de la mili, que es la más bonita del pueblo. Y le pongo un sello, que me sobran.", "en": "Course I’ll sign! Neat national-service hand, finest penmanship in town—stick a stamp on an’ all, got stacks."},
	"firma_no_diurno": {"es": "Ay, ahora no puedo, que estoy de servicio y en horas de trabajo no firmo ná que no lleve franqueo.", "en": "Ooh, can’t right now—on shift, never stamp owt without proper postage."},
	"firma_si_nocturno": {"es": "Trae acá, coño. Firmo, pero no por el puente: por joder al ayuntamiento, que me debe tres trienios.", "en": "Giz it ’ere, sod it. Not signin’ for the bloody bridge—signin’ just to wind up the town hall, owe me three backdated rises."},
	"firma_no_nocturno": {"es": "¿Que firme yo? Ni de coña. Que te firme el Diurno, que ése firma hasta las multas con corazoncitos.", "en": "Me sign? Not a snowball’s. Get Diurno—mug signs even parkin’ tickets with little love hearts."},
	"firma_si_henry": {"es": "Firmo, pero rápido, que se me quema el jamón.", "en": "Quick scribble then, ham’s catchin’ in the oven."},
	"firma_no_henry": {"es": "Ahora no, que tengo las manos de salsa y te pringo las otras cuatro.", "en": "Not now—me mitts are plastered in gravy, ruin the other four lines."},
	"obj_bridge_tbc": {"es": "El Alberto ya te contará qué hay que hacer. (Próximamente)", "en": "Alberto will tell you what needs doing. (Coming soon)"},
	"alberto_idle": {"es": ["¿Has firmao? ¿Seguro? Firma otra vez, por si acaso."], "en": ["Signed yet? Dead sure? Sign again just in case, mate."]},
	"alberto_bridge": {
		"es": ["¿Te manda la Josefa? Pues llegas a tiempo: nos lo quieren tirar. El puente. Ese. Ahí lo tiés, tan tranquilo.",
			"Más de cien años tiene. Mil novecientos once. Y cuando viene riada, el agua por abajo y la gente por arriba. Sin una grieta.",
			"Y ahora dicen que estorba. Que hay que tirarlo pa hacer «una calle ancha pa los coches». ¡Si tienen la Matías Pérez ahí al lao, igual de ancha!",
			"Así que he fundao la Plataforma Vecinal «El Puente No Se Toca». Semos catorce. Nueve son familia mía y dos no saben que están.",
			"Llevamos cuarenta y tres firmas. Bueno, cuarenta y tres firmas de diecinueve personas. En el Ayuntamiento dicen que así no vale.",
			"Me hacen falta cinco de gente que no esté aquí, en la manifestación. Cinco. Y tú tiés cara de no saber decir que no.",
			"Pregúntale a quien pilles por la calle. Y las quiero {plazo}. ¡Arreando!"],
		"en": ["Josefa sent you? Proper nick of time—they’re wantin’ to flatten it. The bridge. That ’un right there, mindin’ its own.",
			"Over a century old. Nineteen eleven. Flood rolls in, water shoots underneath, folks stroll over top. Not one crack.",
			"Now they reckon it’s in the way. Needs knockin’ down for “a wide motor road”—when Matías Pérez is right alongside it, just as wide!",
			"So I set up the Plataforma Vecinal «El Puente No Se Toca». Fourteen of us—nine are me own kin and two don’t know they joined.",
			"Sat on forty-three signatures. Well—forty-three from nineteen folks. Town hall claims that don’t wash.",
			"I need five more from outside this protest. Five. And you’ve got the mug of somebody who can’t say no.",
			"Tap up whoever’s walkin’ down the street. Want ’em {plazo}. Enga, off you pop!"]},
	"t_turbo_hint": {"es": "%s — nitro. Si lo apuras se quema; se recarga corriendo. Ojo a los Pitufos.", "en": "%s — nitro. Empty it and it burns out; speed fills it. Mind the Pitufos."},
	"t_turbo_seen": {"es": "¡Te ha visto un Pitufo con el turbo! Ahora corre de verdad.", "en": "A Pitufo saw you on the turbo! Now you really need it."},
