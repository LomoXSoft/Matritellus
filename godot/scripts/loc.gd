	"n_javi": {"es": "Javi", "en": "Javi"},
	"t_javi_known": {"es": "Ya conoces Pollos Asados Javi: los martes y domingos reparte pollo asao.", "en": "You know Pollos Asados Javi now: on Tuesdays and Sundays he delivers roast chicken."},
	"josefa_javi": {"es": ["¿Sabes quién anda preguntando por ti? El Javi, el de los pollos asaos.", "Los martes y los domingos no da abasto con los pollos, y busca quien se los lleve a la gente. Pásate, que paga y no muerde. Bueno, muerde pollo."],
		"en": ["Do you know who’s been asking after you? Javi, the roast-chicken man.", "On Tuesdays and Sundays he can’t keep up with the chickens, and he’s looking for someone to take them round. Go and see him: he pays and he doesn’t bite. Well, he bites chicken."]},
	"javi_hello": {
		"es": [["¡Buenas! Pollos asaos, patatas y lo que se tercie. Hoy no te puedo dar faena, que no te conozco de na."],
			["Aquí el pollo se hace despacio, como las cosas buenas. Y como yo."]],
		"en": [["Morning! Roast chickens, chips and whatever comes up. I can’t give you work today: I don’t know you from Adam."],
			["Here the chicken is done slowly, like all good things. And like me."]]},
	"javi_chat": {
		"es": [["¡Hombre! ¿Qué, otro pollito?"], ["El secreto del pollo es el tomillo. Y el otro secreto, que no te lo digo."], ["Dicen que estoy hermoso. Es el olor, que alimenta."]],
		"en": [["Well, hello! Another chicken, eh?"], ["The secret of the chicken is thyme. And the other secret, I’m not telling."], ["They say I’m a fine figure of a man. It’s the smell: it feeds you."]]},
	"javi_days": {"es": "Los repartos, los martes y los domingos. Hoy no, que hoy los pollos se los come el que viene.", "en": "Deliveries on Tuesdays and Sundays. Not today: today the chickens get eaten by whoever comes in."},
	"javi_pollo": {
		"es": ["¡Menos mal que vienes! {quien} me ha pedío un pollo asao con patatas.",
			"Llévaselo calentito, que el pollo frío es otra cosa. Peor."],
		"en": ["Thank goodness you’re here! {quien} has ordered a roast chicken with chips.",
			"Take it over while it’s hot: cold chicken is something else. Worse."]},
	"javi_pollo_q": {"es": "¿Le llevas el pollo a %s?", "en": "Will you take the chicken to %s?"},
	"javi_pollo_yes": {"es": "Venga, dame el pollo", "en": "Go on, give me the chicken"},
	"javi_pollo_no": {"es": "Ahora no", "en": "Not now"},
	"javi_pollo_later": {"es": ["Pues lo llevo yo. Rodando, que no me da pa más."], "en": ["Then I’ll take it myself. Rolling: that’s all I can manage."]},
	"javi_pollo_none": {"es": ["Hoy no me ha pedío nadie pollo. Será que llueve. O que es fin de mes."], "en": ["Nobody’s ordered chicken today. Must be the rain. Or the end of the month."]},
	"obj_recoger_pollo": {"es": "Coge el pollo asao del mostrador.", "en": "Pick up the roast chicken from the counter."},
	"obj_recoger_pedido": {"es": "Coge el pedido de Henry.", "en": "Pick up Henry’s order."},
	"t_order_go": {"es": "¡Cogío! Corre, que se enfría.", "en": "Got it! Run, it’s going cold."},
	"inv_n_pollo": {"es": "Pollo asao", "en": "Roast chicken"},
	"obj_pollo": {"es": "Lleva el pollo asao de Javi a %s, antes de que se enfríe.", "en": "Take Javi’s roast chicken to %s before it goes cold."},
	"faena_title_pollo": {"es": "Un pollo de Javi", "en": "A chicken from Javi"},
	"pollo_gracias": {
		"es": [["¡El pollo! Y con sus patatas. Dile a Javi que se ha lucío."], ["Ay, qué olorcito. Hoy no se cocina en esta casa."], ["Ya era hora, que tengo a los críos comiéndose la mesa."]],
		"en": [["The chicken! With its chips. Tell Javi he’s outdone himself."], ["Oh, that smell. Nobody’s cooking in this house today."], ["About time: the kids were starting on the table."]]},
	"faena_done_pollo": {"es": "Pollo entregao a %s", "en": "Chicken delivered to %s"},
	"faena_fail_pollo": {"es": "El pollo se ha enfriao. Ahora es pollo pa caldo.", "en": "The chicken has gone cold. Now it’s soup chicken."},
	"firma_si_javi": {"es": "Firmo, firmo. Y si queréis, os hago un pollo pa la manifestación.", "en": "I’ll sign, I’ll sign. And if you like, I’ll do you a chicken for the demonstration."},
	"firma_no_javi": {"es": "Yo no me meto en líos, que tengo el horno encendío.", "en": "I keep out of trouble: I’ve got the oven on."},
	# ---- jobs (trabajos.gd; the user, 21 Nov 2026) ----
	"n_faenas": {"es": "El de las faenas", "en": "The odd-jobs man"},
	"food_pedido": {"es": "Un pedido pa llevar", "en": "An order to deliver"},
	"firma_si_faenas": {"es": "Firmo. Si quieres, te busco cuatro más a destajo.", "en": "I’ll sign. If you like, I’ll find you four more, piecework."},
	"firma_no_faenas": {"es": "Yo no firmo na que no lleve sueldo.", "en": "I don’t sign anything that doesn’t come with wages."},
	"firma_si_edmundo": {"es": "Firmo, firmo. Y ya que estamos, firme usted aquí, que es un seguro de vida. ((Pa mí.))", "en": "I’ll sign, I’ll sign. And while we’re at it, sign here: it’s a life insurance. ((For me.))"},
	"firma_no_edmundo": {"es": "El banco no firma peticiones. Solo hipotecas. ((Y desahucios.))", "en": "The bank doesn’t sign petitions. Only mortgages. ((And evictions.))"},
	"log_trabajos": {"es": "Trabajos (El de las faenas, en la plaza; Henry, menos los jueves)", "en": "Jobs (the odd-jobs man on the square; Henry, except Thursdays)"},
	"log_trabajos_cash": {"es": "cobrao %s", "en": "%s earned"},
	"faenas_hello": {
		"es": [["¿Buscas faena? Aquí la hay. Mal pagá no, que la pagan otros."],
			["Trabajo hay, lo que no hay es ganas. ¿Tú tiés ganas?"],
			["Dime qué te apetece, que de to tengo: coche, taxi o campo."]],
		"en": [["Looking for work? There’s plenty. Badly paid, no: other people pay it."],
			["There’s work; what there isn’t is the will. Have you got the will?"],
			["Tell me what you fancy, I’ve got the lot: van, taxi or the fields."]]},
	"faenas_q": {"es": "¿Qué faena quieres?", "en": "Which job do you want?"},
	"faenas_opt_reparto": {"es": "Repartos en coche", "en": "Deliveries by car"},
	"faenas_opt_taxi": {"es": "Taxi del pueblo", "en": "Town taxi"},
	"faenas_opt_jornal": {"es": "Jornal en el campo", "en": "A day in the fields"},
	"faenas_opt_no": {"es": "Na, gracias", "en": "Nothing, thanks"},
	"faenas_busy": {"es": ["Termina lo que tiés entre manos y luego hablamos, que la faena no se va a ningún lao."], "en": ["Finish what you’re on and then we’ll talk: the work isn’t going anywhere."]},
	"faenas_busy_mine": {"es": ["¿Otra vez aquí? Ya tiés faena. ¡Arreando!"], "en": ["Back again? You’ve got a job already. Get going!"]},
	"faena_title_reparto": {"es": "Reparto en coche", "en": "Car delivery"},
	"faena_title_taxi": {"es": "Taxi del pueblo", "en": "Town taxi"},
	"faena_title_jornal": {"es": "Jornal en el campo", "en": "A day in the fields"},
	"faena_title_pedido": {"es": "Un pedido de Henry", "en": "An order from Henry"},
	"faenas_reparto": {
		"es": ["Hay un bulto que recoger en {calle}. Lo cargas en el coche y lo llevas ande te diga.",
			"Cuanto antes llegue y más entero, más cobras. Si llega hecho una pena, cobras una pena."],
		"en": ["There’s a load to pick up on {calle}. Put it in the car and take it where I tell you.",
			"The sooner it gets there and the more of it in one piece, the more you get paid. If it arrives in a sorry state, so does your pay."]},
	"faenas_taxi": {
		"es": ["Coge un coche y date una vuelta. La gente que vaya a pie te hará señas: paras, se suben y te dicen ande van.",
			"Cinco carreras y has acabao. Si te bajas del coche mucho rato, se acabó el turno."],
		"en": ["Get a car and drive round. People on foot will wave you down: you stop, they get in and tell you where.",
			"Five fares and you’re done. Get out of the car for long and the shift is over."]},
	"faenas_jornal": {
		"es": ["En el campo, a las afueras, hay rosa del azafrán pa coger. A mano, como toa la vida.",
			"Veinticinco euros por rosa. Y si las coges toas, un extra. Que no se te pase la hora, que el sol no espera."],
		"en": ["Out in the fields, on the edge of town, there’s saffron to pick. By hand, as it’s always been.",
			"Twenty-five euros a flower. Pick the lot and there’s a bonus. Don’t lose track of time: the sun doesn’t wait."]},
	"obj_reparto_carga": {"es": "Recoge el bulto con el coche.", "en": "Pick up the load with the car."},
	"obj_reparto_entrega": {"es": "Lleva el bulto a {calle}, antes de que se acabe el tiempo.", "en": "Take the load to {calle} before time runs out."},
	"t_reparto_loaded": {"es": "Cargao. ¡A correr!", "en": "Loaded. Go!"},
	"t_faena_car": {"es": "Esto va en coche.", "en": "This is a job for a car."},
	"faena_done_reparto": {"es": "Bulto entregao", "en": "Load delivered"},
	"faena_fail_reparto": {"es": "Se acabó el tiempo: el bulto ya no lo quiere nadie.", "en": "Out of time: nobody wants the load now."},
	"obj_taxi_coche": {"es": "Coge un coche pa hacer de taxi.", "en": "Get a car to work as a taxi."},
	"obj_taxi_buscar": {"es": "Busca a quien te haga señas (%d de %d carreras).", "en": "Look for someone waving you down (%d of %d fares)."},
	"obj_taxi_llevar": {"es": "Lleva a tu cliente a {calle}.", "en": "Take your fare to {calle}."},
	"taxi_hail": {"es": ["¡Taxi!", "¡Eh, tú, el del coche!", "¡Quieto ahí, que me llevas!", "¡Oiga! ¡Que voy con prisa!"],
		"en": ["Taxi!", "Hey, you, in the car!", "Stop, stop, give me a lift!", "Excuse me! I’m in a hurry!"]},
	"taxi_to": {"es": ["A {calle}, y rapidito.", "Llévame a {calle}, que me esperan.", "A {calle}. Y no me des vueltas, que te conozco."],
		"en": ["To {calle}, and quick.", "Take me to {calle}, they’re waiting for me.", "To {calle}. And no detours, I know your sort."]},
	"taxi_thanks": {"es": ["Gracias, majo.", "Hasta otra.", "Pues no conduces tan mal.", "Quédate con la vuelta. Bueno, no."],
		"en": ["Thanks, love.", "See you.", "You don’t drive that badly.", "Keep the change. Well, no."]},
	"taxi_angry": {"es": ["¡Pa esto me voy andando!", "¡Menudo taxista!", "¡Ni un euro te doy!"],
		"en": ["I’d have been quicker walking!", "Some taxi driver!", "Not a cent from me!"]},
	"t_taxi_fare": {"es": "Carrera cobrada: %s (%d de %d).", "en": "Fare paid: %s (%d of %d)."},
	"t_taxi_lost": {"es": "Se ha bajao sin pagar: tardabas mucho.", "en": "They got out without paying: you took too long."},
	"t_taxi_over": {"es": "Turno acabao: %d carreras, %s.", "en": "Shift over: %d fares, %s."},
	"t_taxi_none": {"es": "Turno acabao sin una carrera.", "en": "Shift over without a single fare."},
	"obj_jornal_ir": {"es": "Ve al campo, a las afueras.", "en": "Go to the fields, on the edge of town."},
	"obj_jornal_coger": {"es": "Coge las %d rosas del azafrán antes de que se acabe el tiempo.", "en": "Pick the %d saffron flowers before time runs out."},
	"t_jornal_go": {"es": "%d rosas pa coger y %d segundos. ¡A la faena!", "en": "%d flowers to pick and %d seconds. To work!"},
	"t_jornal_rosa": {"es": "Rosa %d de %d", "en": "Flower %d of %d"},
	"faena_done_jornal": {"es": "Jornal acabao: %d de %d rosas", "en": "Day’s work done: %d of %d flowers"},
	"faena_fail_jornal": {"es": "Se acabó la jornada sin coger ni una rosa.", "en": "The day ended without a single flower picked."},
	"henry_pedido": {
		"es": ["Hoy no es jueves, pero aquí se come tos los días. {quien} me ha pedío algo de comer.",
			"Llévaselo calentito, que si se enfría me lo devuelven. Y yo lo vuelvo a calentar, pero eso no lo sabe nadie."],
		"en": ["It isn’t Thursday, but people eat every day. {quien} has ordered something.",
			"Take it over while it’s hot: if it goes cold they send it back. And I heat it up again, but nobody knows that."]},
	"henry_pedido_q": {"es": "¿Le llevas el pedido a %s?", "en": "Will you take the order to %s?"},
	"henry_pedido_yes": {"es": "Venga, dámelo", "en": "Go on, give it here"},
	"henry_pedido_no": {"es": "Ahora no", "en": "Not now"},
	"henry_pedido_later": {"es": ["Pues se lo come frío. Como los domingos."], "en": ["Then they’ll eat it cold. Like on Sundays."]},
	"henry_pedido_none": {"es": ["Hoy no me ha pedío nadie na. La gente está a dieta. O en Consuegra."], "en": ["Nobody’s ordered a thing today. People are on a diet. Or in Consuegra."]},
	"obj_pedido": {"es": "Lleva el pedido de Henry a %s, antes de que se enfríe.", "en": "Take Henry’s order to %s before it goes cold."},
	"pedido_gracias": {
		"es": [["¡Mi comida! Y calentita. Dile a Henry que es un artista."], ["Ya era hora, que tenía el estómago en los pies."], ["¡Qué bien huele! Anda, toma, por las molestias."]],
		"en": [["My food! And still hot. Tell Henry he’s an artist."], ["About time: my stomach was down by my feet."], ["That smells good! Here, for your trouble."]]},
	"faena_done_pedido": {"es": "Pedido entregao a %s", "en": "Order delivered to %s"},
	"faena_fail_pedido": {"es": "El pedido se ha enfriao. Henry no se va a enterar. Tú sí.", "en": "The order has gone cold. Henry won’t find out. You will."},
