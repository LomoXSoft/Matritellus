	"vip_spar_q": {"es": "«¿QUÉ? ¿ECHAMOS UNO?»", "en": "“WELL? FANCY A ROUND?”"},
	"vip_spar": {"es": "Echar un combate en la trastienda", "en": "Have a fight in the back room"},
	"vip_spar_no": {"es": "Otro día", "en": "Another day"},
	"n_alberto": {"es": "El Alberto", "en": "Alberto"},
	"bridge_banner": {"es": "EL PUENTE NO SE TOCA", "en": "EL PUENTE NO SE TOCA"},
	"n_chiki": {"es": "La Chiki", "en": "Chiki"},
	"placards": {"es": ["EL PUENTE NO SE TOCA", "CIEN AÑOS Y NI UNA GRIETA", "PA COCHES, LA MATÍAS PÉREZ", "MI ABUELO SE DECLARÓ AQUÍ", "TIRAR ES DE COBARDES", "YO HE VENÍO A MIRAR"],
		"en": ["EL PUENTE NO SE TOCA", "A HUNDRED YEARS, NOT ONE CRACK", "CARS: USE MATÍAS PÉREZ", "MY GRANDAD PROPOSED HERE", "KNOCKING DOWN IS FOR COWARDS", "I JUST CAME TO LOOK"]},
	"protest_chant": {"es": ["¡El puente no se toca!", "¡Cien años y ni una grieta!", "¡Alcalde, valiente, tírate tú del puente!", "¡Pa los coches, la Matías Pérez!", "¡Menos asfalto y más puente!"],
		"en": ["Hands off the bridge!", "A hundred years and not one crack!", "Mayor, be brave: jump off it yourself!", "Cars can use Matías Pérez!", "Less tarmac, more bridge!"]},
	"protest_serious": {
		"es": [["¡El puente no se toca! Mi abuelo se declaró ahí encima. Le dijeron que no, pero se declaró."],
			["Llevo aquí desde las siete. No he desayunao. Por el puente, lo que haga falta. Menos el almuerzo, que eso es sagrao."],
			["Hoy es el puente y mañana es la ermita. Y pasao, mi cochera. Que te lo digo yo."]],
		"en": [["Hands off the bridge! My grandad proposed on top of it. She said no, but he proposed."],
			["I’ve been here since seven. No breakfast. For the bridge, whatever it takes. Except lunch. Lunch is sacred."],
			["Today the bridge, tomorrow the chapel. The day after, my garage. Mark my words."]]},
	"protest_gossip": {
		"es": [["Yo he venío a ver quién venía. Y ha venío to el mundo. Ya tengo pa una semana."],
			["¿Tú sabes de qué va esto? Yo tampoco, pero hay ambiente."],
			["A mí el puente me da igual. Yo he bajao a por el pan y me he liao."]],
		"en": [["I came to see who’d come. Everybody came. That’s me sorted for a week."],
			["Do you know what this is about? Me neither, but there’s a good atmosphere."],
			["I couldn’t care less about the bridge. I came out for bread and got caught up."]]},
	# La Chiki and the walls of the peñas (pintadas.gd). {pena}: your peña; {calle}: a street
	"chiki_intro_same": {"es": ["¡Anda! ¿De los Nietos de Marzo? ¡Haberlo dicho antes, {hermoso|hermosa}!", "Yo también. Desde los pañales. Los pañales también eran de la peña."],
		"en": ["Well! Nietos de Marzo? You could have said so before!", "Me too. Since I was in nappies. The nappies were the peña's as well."]},
	"chiki_intro_other": {"es": ["¿De {pena}? Vaya por Dios.", "Yo soy de los Nietos de Marzo. Pero no pasa na: aquí cabemos tos. Unos más que otros, pero tos."],
		"en": ["{pena}? Oh, for heaven's sake.", "I'm Nietos de Marzo. But never mind: there's room here for everybody. Some more than others, but everybody."]},
	"chiki_intro_penas": {"es": ["Una peña es eso: pertenecer a algo. Una comunidad. Ayudarse unos a otros cuando las cosas vienen mal dadas.", "Bueno. Sobre to es emborracharse juntos.", "Y en la feria, subirse al Toro Loco a ver quién echa la pota antes. Pero con mucho sentimiento."],
		"en": ["That's what a peña is: belonging. A community. Helping each other out when things go badly.", "Well. Mostly it's getting drunk together.", "And at the fair, riding the Toro Loco to see who throws up first. But with a lot of feeling."]},
	"chiki_intro_tour": {"es": ["¿Ves esa pintada? Las hay por to el pueblo. Cada peña tiene su logo.", "El trabajo de una peña es pintar su logo encima del de la peña rival. Pared a pared.", "Es como una guerra de territorios de mafias, pero con menos muertos. Drogas, las mismas."],
		"en": ["See that one? They're all over town. Every peña has its logo.", "A peña's job is to paint its logo over the rival peña's. Wall by wall.", "It's like a mafia turf war, with fewer dead. The same amount of drugs, though."]},
	"chiki_intro_spray": {"es": ["¿Tú tiés spray?", "…", "Ya veo que no."], "en": ["Have you got a spray can?", "…", "I see you haven't."]},
	"chiki_spray_same": {"es": ["Toma el mío. Entre marzistas hay que ayudarse.", "Y cuando tapes una de las otras, piensa en mí. Bueno, mejor no pienses en mí: tú tapa."],
		"en": ["Take mine. Marzistas help each other.", "And when you cover one of the others, think of me. Actually, don't think of me: just cover it."]},
	"chiki_spray_other": {"es": ["Toma. Está medio vacío, que conste.", "A mí no me gusta ayudar a otras peñas. Pero estoy en control de la ira, por lo del estrés, y dice el psicólogo que ayudar me viene bien.", "(De toas las peñas del pueblo, ha ido a escoger {pena}. La más cutre.)"],
		"en": ["Here. It's half empty, mind.", "I don't like helping other peñas. But I'm in anger management, for the stress, and the psychologist says helping does me good.", "(Of all the peñas in town, they go and pick {pena}. The shabbiest.)"]},
	"chiki_q_tag": {"es": "¿Has visto alguna pintada por ahí?", "en": "Seen any graffiti around?"},
	"chiki_q_chat": {"es": "Na, charlar un rato.", "en": "Nothing, just a chat."},
	"chiki_hint": {"es": ["Me ha parecío ver una en {calle}. Pero no te lo aseguro, que iba con prisa."], "en": ["I think I saw one in {calle}. But don't hold me to it, I was in a hurry."]},
	"chiki_somewhere": {"es": "una calle de por ahí", "en": "some street round here"},
	"chiki_hint_again": {"es": ["Hoy ya te he dicho una. Mañana más, que yo también tengo mi vida."], "en": ["I've told you one today. More tomorrow: I have a life too."]},
	"chiki_hint_none": {"es": ["Pues ahora mismo no se me ocurre ninguna. ¿No las habrás tapao ya toas?"], "en": ["Can't think of any right now. Haven't you covered them all already?"]},
	"chiki_call_same": {"es": ["¡Las has tapao toas! ¡Toítas!", "Por eso aceptamos forasteros en la peña: luego son los que más se involucran. Los de aquí nos quedamos en la barra."],
		"en": ["You've covered them all! Every one!", "That's why we take in outsiders: they're the ones who get stuck in. Us locals stay at the bar."]},
	"chiki_call_other": {"es": ["Ya me han dicho que has tapao toas las pintadas del pueblo.", "No te vía decir que esté contenta. Pero el que le da vidilla al pueblo, a mí me tiene. Eso lo respeto."],
		"en": ["I hear you've covered every wall in town.", "I won't say I'm happy about it. But whoever livens the town up has me on their side. I respect that."]},
	"chiki_maria": {"es": ["Oye, ya que semos de confianza…", "Me llamo María. Lo de La Chiki es de cuando era chica, y ya se quedó.", "¿Conoces a Don Luis, el del Kebab Luis? Es mi hermano.", "Es curioso lo poco que nos parecemos: en lo físico, en lo filosófico, en lo cultural y en las aficiones.", "Y sin embargo, semos mu parecíos. Extraño, ¿no?"],
		"en": ["Listen, now that we trust each other…", "My name's María. La Chiki is from when I was little, and it stuck.", "Do you know Don Luis, of the Kebab Luis? He's my brother.", "Funny how little we look alike: physically, philosophically, culturally, in what we like.", "And yet we're very alike. Strange, isn't it?"]},
	"chiki_title": {"es": "Las pintadas de las peñas", "en": "The peñas' walls"},
	"log_chiki_open": {"es": "La Chiki te ha dao spray: pídele pistas", "en": "La Chiki gave you a spray: ask her for tips"},
	"t_tags_unlocked": {"es": "Las pintadas: tapa con el logo de tu peña las de las otras. Pregúntale a La Chiki si ha visto alguna.", "en": "The walls: cover the other peñas' logos with yours. Ask La Chiki if she's seen any."},
	"chiki_idle": {
		"es": [["¿Yo? Yo he venío por el Alberto. A mí el puente, la verdad, me da un poco igual. Pero es mono."],
			["Soy artista. Ahora estoy con una serie sobre el vacío. Llevo tres años. No he empezao."],
			["Tengo veintitantos. Veintimuchos. Bueno. La edad da igual, ¿no? Eso decían en Barcelona."],
			["Si no hay plan, yo me apunto a lo que sea. Manifestación, bautizo, vendimia. A un bombardeo me apuntaba."],
			["He vivío en Madrid, en Barcelona y en Berlín. En las tres me decían que hablaba raro. Aquí ya me lo dicen también."]],
		"en": [["Me? I came for Alberto. The bridge, honestly, I’m not that bothered. It’s cute, though."],
			["I’m an artist. I’m working on a series about emptiness. Three years now. I haven’t started."],
			["I’m twenty-something. Twenty-lots. Anyway. Age doesn’t matter, does it? That’s what they said in Barcelona."],
			["If there’s no plan, I’m up for anything. A demo, a christening, the grape harvest. I’d sign up for an air raid."],
			["I’ve lived in Madrid, Barcelona and Berlin. In all three they said I talked funny. Now they say it here too."]]},
	"chiki_after": {
		"es": [["Pues ya está, ¿no? El puente sigue ahí. Qué bien. O qué mal. No sé, a mí me da igual."],
			["Si haces algo luego, avisa. Lo que sea. Yo no tengo na que hacer hasta… a ver… hasta mayo."],
			["Esta chaqueta es de Londres. Bueno, del mercadillo de Consuegra, pero el puesto se llamaba «London»."]],
		"en": [["So that’s that, then? The bridge is still there. Great. Or not great. I don’t know, I don’t mind."],
			["If you’re doing anything later, shout. Anything. I’ve got nothing on until… let me see… May."],
			["This jacket’s from London. Well, from the market in Consuegra, but the stall was called “London”."]]},
	"alberto_again": {
		"es": ["¿Y las firmas? ¿Que se t'á hecho tarde? A mí también se me hace tarde y aquí estoy, desde las siete.",
			"Enga, otra vez. Cinco firmas, de gente de fuera de la manifestación, {plazo}."],
		"en": ["And the signatures? You ran out of time? I run out of time too, and here I am, since seven.",
			"Enga, again. Five signatures, from people outside the demonstration, {plazo}."]},
	"firmas_plazo_dusk": {"es": "antes de que anochezca", "en": "before nightfall"},
	"firmas_plazo_dawn": {"es": "antes de que amanezca", "en": "before dawn"},
	"alberto_firmas": {
		"es": ["¿Las cinco? A ver… Una, dos… esta es una pezuña. Vale. Vale también.",
			"Con estas ya son cuarenta y ocho. De veinticuatro personas. ¡Hemos doblao la plataforma!",
			"Toma, diez euros de la hucha. No digas na, que la hucha es de mi madre.",
			"Mañana se las llevo al alcalde. Y si no nos recibe, me encadeno al puente. Bueno, me ato. Con cuerda. Que la cadena pesa."],
		"en": ["All five? Let’s see… One, two… this one’s a hoof. Fine. That counts too.",
			"That makes forty-eight. From twenty-four people. We’ve doubled the platform!",
			"Here, ten euros from the tin. Say nothing: it’s my mother’s tin.",
			"Tomorrow I take them to the mayor. And if he won’t see us, I chain myself to the bridge. Well, tie myself. With rope. Chains are heavy."]},
	"alberto_after": {
		"es": [["El puente sigue en pie. De momento. Yo no me fío y duermo con un ojo abierto. El izquierdo."],
			["¿Has firmao hoy? Es broma. ¿O no?"]],
		"en": [["The bridge is still standing. For now. I don’t trust them: I sleep with one eye open. The left one."],
			["Have you signed today? Just kidding. Or am I?"]]},
	"obj_firmas_day": {"es": "Consigue firmas pa'l puente antes de que se haga de noche: llevas %d de %d.", "en": "Collect signatures for the bridge before nightfall: %d of %d so far."},
	"obj_firmas_night": {"es": "Consigue firmas pa'l puente antes de que amanezca: llevas %d de %d.", "en": "Collect signatures for the bridge before dawn: %d of %d so far."},
	"obj_firmas_back": {"es": "Llévale las cinco firmas al Alberto, al puente.", "en": "Take the five signatures to Alberto, at the bridge."},
	"t_firma": {"es": "Firma %d de %d.", "en": "Signature %d of %d."},
	"t_firmas_all": {"es": "¡Las cinco! Llévaselas al Alberto.", "en": "All five! Take them to Alberto."},
	"t_firmas_late": {"es": "Se t'á pasao la hora y las firmas que llevabas ya no valen. Vuelve a ver al Alberto.", "en": "Time’s up, and the signatures you had no longer count. Go back to Alberto."},
	"t_unlocked": {"es": "El Alberto y la Chiki ya están en tu Agenda.", "en": "Alberto and Chiki are in your Diary now."},
	"firma_alberto": {
		"es": ["¿Yo? Yo he firmao el primero. Y el tercero. Y el octavo, con la izquierda, pa que no se note.", "Las mías no valen. Tira, que se va la luz."],
		"en": ["Me? I signed first. And third. And eighth, left-handed, so it wouldn’t show.", "Mine don’t count. Go on, the light’s going."]},
	"firma_chiki": {
		"es": ["Yo ya firmé. Creo. Firmé algo. Igual era lo de un paquete, no sé.", "En Berlín firmábamos contra to. Aquí también, pero con más viento."],
		"en": ["I already signed. I think. I signed something. Might have been for a parcel, I don’t know.", "In Berlin we signed against everything. Here too, but it’s windier."]},
	"firma_protest_serious": {
		"es": ["¡Yo he firmao el segundo! Y he traío a mi [[cuñao|cuñá]], que ha firmao llorando.", "Firmao, sellao y con el DNI apuntao. Busca fuera, que aquí hemos firmao tos."],
		"en": ["I signed second! And I brought my [[brother-in-law|sister-in-law]], who signed in tears.", "Signed, stamped, ID number and all. Look elsewhere: everybody here has signed."]},
	"firma_protest_gossip": {
		"es": ["Yo he firmao, yo he firmao. No sé el qué, pero he firmao.", "A mí ya me la han pedío tres veces. He firmao dos y media."],
		"en": ["I’ve signed, I’ve signed. No idea what, but I’ve signed.", "They’ve asked me three times already. I’ve signed two and a half."]},
	"firma_again_si": {"es": ["Que ya te he firmao. ¿Quiés que te firme también la frente?"], "en": ["I’ve already signed. Do you want me to sign your forehead as well?"]},
	"firma_again_no": {"es": ["Que no. Y si me lo vuelves a pedir, que menos."], "en": ["No. And if you ask again, even less."]},
	"firma_si": {
		"es": ["Trae pa'cá. ¿Ande firmo? ¿Aquí? ¿Y esto no será pa un crédito?",
			"Yo firmo lo que sea si es contra el Ayuntamiento.",
			"Por ese puente pasé yo de [[novio|novia]]. Y de [[casao|casá]]. Y huyendo. Trae.",
			"Firmo. Pero pon que soy de Consuegra, que aquí no quiero líos.",
			"¿El puente? Claro, hombre. ¿Y ande va uno a mirar el agua cuando llueve?",
			"Venga. Mi firma y la de mi [[mujer|marido]], que firma igual que yo porque se la hago yo."],
		"en": ["Give it here. Where do I sign? Here? This isn’t for a loan, is it?",
			"I’ll sign anything if it’s against the town hall.",
			"I crossed that bridge courting. And married. And running away. Give it here.",
			"I’ll sign. But put me down as from Consuegra, I don’t want trouble here.",
			"The bridge? Of course. Where else would you stand and watch the water when it rains?",
			"Go on. My signature and my [[wife|husband]]’s, which is the same as mine because I do it for [[her|him]]."]},
	"firma_no": {
		"es": ["No, que la última vez que firmé algo me llegó una enciclopedia.",
			"Hoy no firmo, que es martes. O el día que sea. Hoy no.",
			"No puedo, tengo la mano de firmar ocupá. Luego la tengo libre, pero luego no estaré.",
			"Yo es que soy más de túneles.",
			"Uy, no. Mi [[mujer|marido]] no me deja firmar desde lo del apartamento en Torrevieja.",
			"Sin gafas no firmo. Y las gafas no las encuentro porque sin gafas no veo.",
			"No, que si firmo luego me sale el nombre en internet y me llaman los de las alarmas.",
			"¿Y si luego lo tiran igual y he hecho el ridículo? Quita, quita.",
			"Yo ya firmé por otro puente en el ochenta y dos y mira: ni puente ni na."],
		"en": ["No. Last time I signed something, an encyclopaedia turned up.",
			"I’m not signing today, it’s Tuesday. Or whatever day it is. Not today.",
			"I can’t, my signing hand is busy. It’ll be free later, but I won’t be here later.",
			"I’m more of a tunnel person, myself.",
			"Oh no. My [[wife|husband]] hasn’t let me sign anything since the flat in Torrevieja.",
			"I don’t sign without my glasses. And I can’t find my glasses because I can’t see without them.",
			"No: if I sign, my name ends up on the internet and the alarm people start ringing.",
			"And if they knock it down anyway and I look a fool? No, no.",
			"I signed for another bridge in eighty-two and look: no bridge, no nothing."]},
	"firma_si_kid": {"es": "Yo firmo con un dinosaurio. Es mi firma. Es oficial.", "en": "I sign with a dinosaur. It’s my signature. It’s official."},
	"firma_no_kid": {"es": "Mi madre dice que no firme na hasta los dieciocho. Ni los deberes.", "en": "My mum says I mustn’t sign anything until I’m eighteen. Not even my homework."},
	"firma_si_paca": {"es": "Trae. Y que conste que firmo por el puente y no por el Alberto, que ese zagal me debe una paella.", "en": "Give it here. And for the record, I’m signing for the bridge, not for Alberto: that boy owes me a paella."},
	"firma_no_paca": {"es": "Yo no firmo na sin leerlo. Y no lo vía leer.", "en": "I sign nothing without reading it. And I am not going to read it."},
	"firma_si_loli": {"es": "Firmo. Y si lo tiran, que no cuenten con mi aceite.", "en": "I’ll sign. And if they knock it down, they needn’t count on my oil."},
	"firma_no_loli": {"es": "No, que estoy trabajando y aquí to lo que firmo es un albarán.", "en": "No: I’m at work, and anything I sign here is a delivery note."},
	"firma_si_eusebio": {"es": "Firmo, que ese puente me trae clientes: lo suben, se cansan y almuerzan.", "en": "I’ll sign: that bridge brings me customers. They climb it, get tired and have lunch."},
	"firma_no_eusebio": {"es": "No, que luego dicen que el bar se mete en política. Aquí solo se discute de fútbol y de herencias.", "en": "No: they’ll say the bar is getting political. In here we only argue about football and inheritances."},
	"firma_si_anselmo": {"es": "Firmo. Ese puente lo bendijo un antecesor mío. Borracho, pero lo bendijo.", "en": "I’ll sign. A predecessor of mine blessed that bridge. Drunk, but he blessed it."},
	"firma_no_anselmo": {"es": "{Hijo|Hija}, la Iglesia no firma. La Iglesia espera. Llevamos dos mil años esperando y mira qué bien.", "en": "My child, the Church does not sign. The Church waits. Two thousand years of waiting, and look how well it’s gone."},
	"firma_si_ramirez": {"es": "Firmo como ciudadano. Como teniente, no he visto na.", "en": "I sign as a citizen. As a lieutenant, I saw nothing."},
	"firma_no_ramirez": {"es": "Negativo. Un agente no firma: un agente levanta acta. ¿Quiés un acta?", "en": "Negative. An officer doesn’t sign: an officer files a report. Would you like a report?"},
	"firma_si_dolores": {"es": "Firmo, firmo, que el puente no tiene la culpa de na. Y ya que estáis, apuntad debajo que le cambien el nombre a mi calle.", "en": "I’ll sign, I’ll sign, the bridge has done nothing wrong. And while you’re at it, put underneath that they change my street’s name."},
	"firma_no_dolores": {"es": "Yo no firmo na hasta que le cambien el nombre a la calle de la Amargura. Cada cosa a su tiempo, {hijo|hija}.", "en": "I’m not signing anything until they change the name of Calle de la Amargura. One thing at a time, {hijo|hija}."},
	"firma_si_maruja": {"es": "Firmo, firmo. ¿Y quién más ha firmao? Déjame ver la lista. No, por na. Por saber.", "en": "I’ll sign, I’ll sign. Who else has signed? Let me see the list. No reason. Just to know."},
	"firma_no_maruja": {"es": "No firmo hasta saber quién ha firmao antes. Que yo al lao de según quién no pongo mi nombre.", "en": "I’m not signing until I know who signed before me. There are names I won’t put mine next to."},
	"firma_si_venancio": {"es": "Firmo. Un puente viejo que se cae da trabajo; uno que tiran aposta no deja ni eso.", "en": "I’ll sign. An old bridge that falls down is work for me; one they knock down on purpose isn’t even that."},
	"firma_no_venancio": {"es": "No firmo. En mi oficio las firmas son siempre por un disgusto.", "en": "I don’t sign. In my trade a signature always means bad news."},
	"firma_si_genaro": {"es": "Firmo. Lo viejo que funciona no se toca. Mírame a mí.", "en": "I’ll sign. You don’t touch old things that work. Look at me."},
	"firma_no_genaro": {"es": "No. Yo ya firmé contra el viento en el cincuenta y nueve y sigue soplando.", "en": "No. I signed against the wind in fifty-nine and it’s still blowing."},
	"firma_si_kevin": {"es": "Firmo. Con el nombre entero: Kevin-José. Con guion. El guion es lo más mío.", "en": "I’ll sign. Full name: Kevin-José. With the hyphen. The hyphen is the part that’s really me."},
	"firma_no_kevin": {"es": "No puedo: soy menor. Pero te lo notarío por dos euros.", "en": "I can’t: I’m a minor. But I’ll notarise it for two euros."},
	"firma_si_feliciano": {"es": "Firmo, firmo. Por ese puente pasaba yo pa ir a por el jamón del Henry. ¡Firmo dos veces si me dejas!", "en": "I'll sign, I'll sign. I used to cross that bridge to get Henry's ham. I'd sign twice if you let me!"},
	"firma_no_feliciano": {"es": "Ahora no, que me pillas contando los días pa'l jueves y pierdo la cuenta.", "en": "Not now, you've caught me counting the days to Thursday and I'll lose count."},
	"firma_si_nino_negro": {"es": "Vale, firmo. Si salvamos el puente, lo bajo con la bici sin frenar. Y luego a la piscina.", "en": "Fine, I’ll sign. If we save the bridge I’ll ride over it without braking. And then off to the pool."},
	"firma_no_nino_negro": {"es": "Ahora no, que tengo las manos de crema de cacao y te pongo el papel perdío.", "en": "Not now, my hands are covered in chocolate spread and I’d ruin your paper."},
	"firma_si_goat": {"es": ["Beeeh.", "(Moja la pezuña en un charco y la planta en el papel. En este pueblo ha valío pa cosas peores.)"], "en": ["Beeeh.", "(She dips a hoof in a puddle and plants it on the paper. In this town that has counted for worse.)"]},
	"firma_no_goat": {"es": ["Beeeh.", "(Se come la esquina del papel ande iba la firma. Lo cuentas como un no.)"], "en": ["Beeeh.", "(She eats the corner of the page where the signature was to go. You count that as a no.)"]},
	"firma_si_josefa": {"es": "¿Otra vez? Trae. Con esta van cinco. Y dile al Alberto que la sexta se la cobro.", "en": "Again? Give it here. That makes five. And tell Alberto I’m charging for the sixth."},
	"firma_no_josefa": {"es": "No, {hijo|hija}, que ya le he firmao cuatro veces y a la quinta me empadronan en el puente.", "en": "No, {hijo|hija}: I’ve signed four times already, and at the fifth they register me as living on the bridge."},
	"firma_si_vip": {"es": "Firmo. Son cuarenta euros. Es broma. Son veinte. Que no, hombre, que firmo.", "en": "I’ll sign. That’s forty euros. Joking. Twenty. No, no, I’ll sign."},
	"firma_no_vip": {"es": "Firmar es un servicio. Los servicios se cobran. ¿No pagas? Pues no hay firma.", "en": "Signing is a service. Services cost money. Not paying? No signature."},
	"firma_si_luis": {"es": "Firmo, firmo. Y si hace falta os lo firmo en binario, que pa eso estudié.", "en": "I’ll sign, I’ll sign. In binary if need be, that’s what I studied for."},
	"firma_no_luis": {"es": "¿Un puente? Yo no firmo na que no se pueda enrollar en pan de pita.", "en": "A bridge? I sign nothing that can’t be rolled up in pitta bread."},
	"firma_si_diurno": {"es": "¡Pues claro que firmo! Con mi letra de la mili, que es la más bonita del pueblo. Y le pongo un sello, que me sobran.", "en": "Of course I’ll sign! In my army handwriting, the prettiest in town. And I’ll stick a stamp on it, I’ve plenty."},
	"firma_no_diurno": {"es": "Ay, ahora no puedo, que estoy de servicio y en horas de trabajo no firmo na que no lleve franqueo.", "en": "Oh, not now, I’m on duty, and in working hours I sign nothing without postage."},
	"firma_si_nocturno": {"es": "Trae acá, coño. Firmo, pero no por el puente: por joder al ayuntamiento, que me debe tres trienios.", "en": "Give it here, damn it. I’ll sign, but not for the bridge: to screw the town hall, it owes me three pay rises."},
	"firma_no_nocturno": {"es": "¿Que firme yo? Ni de coña. Que te firme el Diurno, que ése firma hasta las multas con corazoncitos.", "en": "Me, sign? No fucking way. Get Diurno to sign it: he signs even his fines with little hearts."},
	"firma_si_henry": {"es": "Firmo, pero rápido, que se me quema el jamón.", "en": "I’ll sign, but quick: the ham’s burning."},
	"firma_no_henry": {"es": "Ahora no, que tengo las manos de salsa y te pringo las otras cuatro.", "en": "Not now: my hands are all sauce and I’d smear the other four."},
	"obj_bridge_tbc": {"es": "El Alberto ya te contará qué hay que hacer. (Próximamente)", "en": "Alberto will tell you what needs doing. (Coming soon)"},
	"alberto_idle": {"es": ["¿Has firmao? ¿Seguro? Firma otra vez, por si acaso."], "en": ["Have you signed? Sure? Sign again, just in case."]},
	"alberto_bridge": {
		"es": ["¿Te manda la Josefa? Pues llegas a tiempo: nos lo quieren tirar. El puente. Ese. Ahí lo tiés, tan tranquilo.",
			"Más de cien años tiene. Mil novecientos once. Y cuando viene riada, el agua por abajo y la gente por arriba. Sin una grieta.",
			"Y ahora dicen que estorba. Que hay que tirarlo pa hacer «una calle ancha pa los coches». ¡Si tienen la Matías Pérez ahí al lao, igual de ancha!",
			"Así que he fundao la Plataforma Vecinal «El Puente No Se Toca». Semos catorce. Nueve son familia mía y dos no saben que están.",
			"Llevamos cuarenta y tres firmas. Bueno, cuarenta y tres firmas de diecinueve personas. En el Ayuntamiento dicen que así no vale.",
			"Me hacen falta cinco de gente que no esté aquí, en la manifestación. Cinco. Y tú tiés cara de no saber decir que no.",
			"Pregúntale a quien pilles por la calle. Y las quiero {plazo}. ¡Arreando!"],
		"en": ["Josefa sent you? Just in time: they want to pull it down. The bridge. That one. There it is, minding its own business.",
			"Over a hundred years old. Nineteen eleven. And when the flood comes, the water goes under and the people go over. Not a crack in it.",
			"And now they say it’s in the way. That it has to go, for “a wide street for the cars”. With Matías Pérez right there, just as wide!",
			"So I founded the Plataforma Vecinal «El Puente No Se Toca». There are fourteen of us. Nine are my family and two don’t know they’re in it.",
			"We’ve got forty-three signatures. Well. Forty-three signatures from nineteen people. The town hall says that doesn’t count.",
			"I need five from people who aren’t here at the demonstration. Five. And you’ve got the face of someone who can’t say no.",
			"Ask whoever you find in the street. And I want them {plazo}. ¡Arreando!"]},
	"t_turbo_hint": {"es": "%s — nitro. Si lo apuras se quema; se recarga corriendo. Ojo a los Pitufos.", "en": "%s — nitro. Empty it and it burns out; speed fills it. Mind the Pitufos."},
	"t_turbo_seen": {"es": "¡Te ha visto un Pitufo con el turbo! Ahora corre de verdad.", "en": "A Pitufo saw you on the turbo! Now you really need it."},
	"log_page": {"es": "Página %d de %d", "en": "Page %d of %d"},
	"log_foot": {"es": "← → pasar página     ↑ ↓ elegir     <ok> aceptar     <esc> volver", "en": "← → turn the page     ↑ ↓ choose     <ok> accept     <esc> back"},
	"log_folk": {"es": "VECINOS", "en": "NEIGHBOURS"},
	"log_radio": {"es": "RADIO", "en": "RADIO"},
	"log_radio_on": {"es": "puesta", "en": "tuned in"},
	"log_radio_none": {"es": "(de momento, música de ascensor)", "en": "(lift music, for now)"},
	"log_radio_how": {"es": "En el coche, %s cambia de emisora. Al final del dial, la radio se apaga.", "en": "In the car, %s changes station. Past the end of the dial, the radio goes off."},
	"log_folk_none": {"es": "No conoces a nadie. Anda, sal y saluda.", "en": "You don’t know anybody. Go on, get out and say hello."},
	"log_folk_how": {"es": "Saludar +3 (una vez al día) · hacerles una misión +10 · un minijuego con ellos +5 la primera vez, luego +1 · no cogerles el teléfono −1 · pegarles o atropellarlos −3 (una vez al día). La confianza no baja de 25, 50 ni 75 una vez alcanzaos; a 100 se queda de oro.",
		"en": "Saying hello +3 (once a day) · a mission for them +10 · a minigame with them +5 the first time, then +1 · not picking up their call −1 · hitting them or running them over −3 (once a day). Trust never drops back below 25, 50 or 75 once reached; at 100 it turns to gold."},
	"log_thu": {"es": "Los jueves por la mañana te llamará algún vecino con hambre. Ten el móvil a mano.", "en": "On Thursday mornings a hungry neighbour will ring you. Keep your phone handy."},
	"log_closed": {"es": "cerrao", "en": "locked"},
	"log_best": {"es": "Ganaos: %d de %d · Mejor marca: %d puntos", "en": "Won: %d of %d · Best score: %d points"},
