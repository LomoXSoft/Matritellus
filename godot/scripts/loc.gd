	"t_repair_heat": {"es": "Chapa, pintura nueva y ni un pitufo detrás. Son %d €, sin factura.", "en": "Bodywork, fresh paint, and not a cop on your tail. That’s %d €, no receipt."},
	"t_repair_heat_free": {"es": "Chapa, pintura nueva y ni un pitufo detrás. Te lo apunto.", "en": "Bodywork, fresh paint, and not a cop on your tail. On the tab."},
