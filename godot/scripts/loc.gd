	# ---------- Un torneo en los Galaxy Recress (recress.gd): the Civismo line, Alberto's second ----------
	# In dialogue, *word* is a mission object (green, outlined) and #word# an objective (red, outlined): Loc.rich.
	"rec_title": {"es": "Un torneo en los Galaxy Recress", "en": "A tournament at the Galaxy Recress"},
	"n_alcalde": {"es": "El alcalde", "en": "The mayor"},
	"n_copista": {"es": "La de la copistería", "en": "The copy-shop girl"},
	"n_alcaldesa": {"es": "La mujer del alcalde", "en": "The mayor's wife"},
	"n_madre_alcalde": {"es": "Una señora mayor", "en": "An old lady"},
	"n_comentarista": {"es": "El comentarista", "en": "The commentator"},
	"n_katakumba": {"es": "Katakumba69", "en": "Katakumba69"},
	"katakumba_nachin": {"es": ["Oye… que tú y yo ya semos colegas de verdá, ¿no? Pues te vía contar una cosa que no sabe nadie.", "Lo de Katakumba69 es mi nombre de guerra. El de verdá es… Ignacio José Gómez-Carreño de la Llave.", "Nachín, pa los amigos.", "Bueno, pa los del foro. En carne y hueso no tengo.", "Tú esto no se lo digas a nadie, ¿eh? Que me hundes la reputación en el ránking."],
		"en": ["Oi… you and me are proper mates now, right? Tell you summat nobody knows.", "Katakumba69’s just me handle. Real name’s… Ignacio José Gómez-Carreño de la Llave.", "Nachín to me mates.", "Well, forum mates. Haven’t got any IRL.", "Keep schtum about this, alright? Wreck me leaderboard rep otherwise."]},
	"alberto_rec_1": {
		"es": ["¡Hombre! ¿Qué tal llevas lo de las actividades cívicas? ¿Has hecho mucho por el pueblo?",
			"A mí es que lo del pueblo me tira mucho, oye. Que yo el noventa por ciento del año estoy fuera: Madrid, Valencia, ande me mande el curro…",
			"Pero lo mío es esto. El pueblo. Lo de toa la vida."],
		"en": ["Wotcher! How’s the civic grafting goin’? Done much for the village?",
			"Town pulls at me proper hard, mate. Ninety per cent of the year I’m away—Madrid, Valencia, wherever work drags me…",
			"My heart’s ’ere though. Village life. Proper old-school."]},
	"alberto_rec_tour": {
		"es": ["El caso es que, cuando no son fiestas, el pueblo está mu dejao. Mira esto: escombros, y ahí se quedan.",
			"El puente, que si no llegamos a echarle mano, lo tiran.",
			"Locales cerraos que no se abren ni pa ventilar.",
			"La antena esa, que no sé ni pa qué sirve ya.",
			"Y las urgencias, pa lo que hay…"],
		"en": ["Thing is, outside fiesta week the town’s half asleep. Look at that: pile o’ rubble, sits there forever.",
			"The bridge—if we hadn’t stepped in, they’d’ve flattened it.",
			"Boarded-up shops never even cracked open for fresh air.",
			"That mast up there—buggered if I know what it’s for anymore.",
			"And the A&E, for all the good it does…"]},
	"alberto_rec_idea": {
		"es": ["Le hace falta vidilla, al pueblo. Algo pa que la gente salga de casa…", "¡Espera! ¡Ya lo tengo! ¿Tú te acuerdas de los Galaxy Recress?"],
		"en": ["Town needs a proper kick up the backside. Summat to get folks off the settee…", "Hold on! Bang on—remember Galaxy Recress?"]},
	"alberto_rec_recress": {
		"es": ["Los recreativos de la calle Zaragoza. Ahí echábamos las tardes enteras, hasta mediaos de los dos mil.", "Llevan veinte años cerraos. Veinte. Con lo que fueron."],
		"en": ["The arcade down Calle de Zaragoza. Spent whole afternoons bunked in there till the mid-noughties.", "Been shut twenty years. Twenty! After all it was."]},
	"alberto_rec_tokken": {
		"es": ["¿Y si los abrimos pa un día? ¡Un torneo de Tokken 9! El de lucha, el que está ahora de moda.", "Pa eso hace falta el permiso del #alcalde#. ¿Te encargas tú? Yo te echo una mano en lo que pueda."],
		"en": ["What if we crack the shutters open for a day? A Tokken 9 tournament! That fighter everybody’s playin’.", "Need the #mayor#’s nod for it. Reckon you can sort him out? I’ll chip in how I can."]},
	"alberto_rec_busy": {"es": ["¿Cómo va lo del torneo? Tú tira, que yo voy diciéndolo por ahí."], "en": ["How’s the tourney lookin’? Crack on, I’m spreadin’ word round town."]},
	"alberto_rec_call": {"es": ["¡Ey! Soy Alberto. Oye, ¿tiés un rato? Pásate por el puente, que se me ha ocurrío una cosa pa darle vidilla al pueblo."],
		"en": ["Oi, it’s Alberto! Got five? Pop down the bridge—brainwave to liven the place up."]},
	"alberto_rec_packed": {"es": ["¡Pero bueno! ¿Qué has hecho? ¡Los recreativos están hasta arriba de gente!", "¡Vente ya pa'cá, que esto empieza!"],
		"en": ["Blimey! What’ve you done? The arcade’s rammed to the doors!", "Leg it over ’ere—about to kick off!"]},
	"alberto_rec_hey": {"es": "¡Eeeh! ¡Aquí!", "en": "Oiii! Over ’ere!"},
	"alberto_rec_door": {"es": ["¡Mírate esto! ¡Está hasta los topes!", "El alcalde ha estao llamando a gente y moviendo contactos, y él mismo ha ido pegando carteles por tó el pueblo."],
		"en": ["Get a load o’ this! Packed to the rafters!", "Mayor’s been ringin’ round pullin’ strings, even slapped posters up round town himself."]},
	"alberto_rec_door2": {"es": ["Dicen que va a empezar ya. ¡Vamos pa dentro!"], "en": ["About to kick off, they reckon. Inside, quick!"]},
	"alberto_rec_dale": {"es": ["¡Venga, dale una paliza, que está mu subidito!"], "en": ["Enga, leather him—gettin’ far too big for his boots!"]},
	"alberto_rec_won": {"es": ["¡Le has ganao! ¡Al alcalde! ¡Esto no lo olvida el pueblo en la vida!"], "en": ["You had him! Beat the Mayor! Village won’t shut up about this till kingdom come!"]},
	# the mayor speaks like a politician: no Manchego, many words and nothing in them
	"alcalde_rec": {
		"es": ["Buenos días. Qué alegría ver a la ciudadanía implicada en el día a día del municipio.",
			"Un torneo en los antiguos recreativos… Mire, es una propuesta que valoro muy positivamente y que se enmarca en nuestra hoja de ruta de dinamización.",
			"Desde este equipo de gobierno siempre hemos apostado por el ocio, por la juventud, por la cultura y, en definitiva, por las personas.",
			"Ahora bien: hay que ser responsables, poner en valor los recursos existentes y abordarlo desde una perspectiva transversal y sostenible.",
			"…",
			"Bueno. Para que nos entendamos: no hay dinero. No puedo justificar ese gasto.",
			"A no ser, claro, que lo pusiera usted. Serían %d euros. Se le devolverían, ¿eh? Con creces."],
		"en": ["Good morning. What a pleasure to see citizens involved in the day-to-day life of the municipality.",
			"A tournament in the old arcade… Look, it's a proposal I view very positively, and it fits squarely within our roadmap for revitalisation.",
			"This administration has always been committed to leisure, to young people, to culture and, at the end of the day, to people.",
			"That said: we have to be responsible, make the most of existing resources and approach it from a cross-cutting, sustainable perspective.",
			"…",
			"Right. Let's be clear: there's no money. I can't justify the expense.",
			"Unless, of course, you were to put it up. That would be %d euros. You'd get it back, mind. With interest."]},
	"alcalde_rec_back": {"es": ["Hombre, de nuevo por aquí. ¿Ha podido usted reunir la cantidad? Eran %d euros."], "en": ["Ah, back again. Have you managed to raise the sum? It was %d euros."]},
	"alcalde_rec_nomoney": {"es": ["Ya veo. Lo siento, de verdad, pero no hay otra manera.", "Le espero aquí. Esta institución no se va a ninguna parte."],
		"en": ["I see. I'm sorry, truly, but there's no other way.", "I'll wait for you here. This institution isn't going anywhere."]},
	"alcalde_rec_later": {"es": ["Lo entiendo perfectamente. Cuando lo tenga claro, aquí estaré."], "en": ["I understand perfectly. When you've made up your mind, I'll be here."]},
	"alcalde_rec_paid": {"es": ["Muchas gracias. Este gesto le honra, y así constará. En mi memoria, al menos.", "Pásese por la #copistería# a por los *carteles*. Yo voy llamando a gente para organizarlo todo."],
		"en": ["Thank you very much. This gesture does you credit, and it shall be recorded. In my memory, at least.", "Call in at the #copy shop# for the *posters*. I'll start ringing round to get everything organised."]},
	"alcalde_rec_wait": {"es": ["Usted a lo suyo, que yo estoy moviendo los hilos."], "en": ["You get on with your part, I'm pulling the strings."]},
	"alcalde_after": {"es": [["Aquel torneo marcó un antes y un después. Lo digo siempre en los plenos."], ["La revancha, cuando usted quiera. Bueno, cuando quiera yo."]],
		"en": [["That tournament was a turning point. I always say so at council meetings."], ["A rematch whenever you like. Well, whenever I like."]]},
	"alcalde": {"es": [["Buenos días. Aquí estamos, trabajando por y para el municipio.", "Mi puerta siempre está abierta. La del ayuntamiento, quiero decir."],
			["Estamos estudiando una batería de medidas transversales.", "En próximas fechas se informará puntualmente a la ciudadanía."]],
		"en": [["Good morning. Here we are, working by and for the municipality.", "My door is always open. The town hall's door, I mean."],
			["We are studying a raft of cross-cutting measures.", "Citizens will be duly informed in due course."]]},
	"alcalde_rec_born": {"es": ["¿Qué? Yo no nací alcalde.", "Llevo matando bichos desde antes de que nacierais la mayoría."], "en": ["What? I wasn't born mayor.", "I've been killing monsters since before most of you were born."]},
	"alcalde_rec_thanks": {"es": ["Gracias, gracias. A todos. Al pueblo. Esto demuestra que, cuando remamos todos en la misma dirección…"],
		"en": ["Thank you, thank you. All of you. The town. This goes to show that, when we all row in the same direction…"]},
	"alcalde_rec_more": {"es": ["…esto me ha sabido a poco."], "en": ["…that wasn't nearly enough for me."]},
	"alcalde_rec_challenge": {
		"es": ["Hagamos una cosa. Me da la impresión de que a usted le gustan los videojuegos.", "¿Por qué no combate contra mí, ya que ha organizado todo esto?",
			"Y para hacerlo más interesante: doble o nada. Si me gana, le devuelvo lo que puso multiplicado por dos. Si pierde… se queda en las arcas municipales. ¿Qué me dice?"],
		"en": ["Let's do something. I get the impression you like video games.", "Why not take me on, since you organised all this?",
			"And to make it more interesting: double or nothing. Beat me, and you get back what you put up twice over. Lose… and it stays in the municipal coffers. What do you say?"]},
	"alcalde_rec_mum": {"es": ["Mamá, por favor, aquí no."], "en": ["Mum, please, not here."]},
	"alcalde_rec_again": {"es": ["¿Otra? Cuando usted quiera. Siéntese, siéntese."], "en": ["Another? Whenever you like. Sit down, sit down."]},
	"alcalde_rec_lost": {"es": ["No… no puede ser… He perdido… ¿Yo?"], "en": ["No… it can't be… I've lost… Me?"]},
	"alcalde_rec_excuse": {"es": ["Sí, bueno, es que los nuevos sistemas de combos y cancelaciones son muy raros.", "El juego no es el mismo desde que cambiaron el motor gráfico…"],
		"en": ["Yes, well, these new combo and cancel systems are very odd.", "The game hasn't been the same since they changed the graphics engine…"]},
	"alcalde_rec_curse": {"es": "Motor gráfico… Tokken 2, eso sí que era un juego…", "en": "Graphics engine… Tokken 2, now that was a game…"},
	# (ajedrez) the mayor's chess, after the Recress (ajedrez_humano.gd; the user's design in guion/ajedrez.md). He still
	# speaks like a politician. ((…)) is said under his breath (Loc.rich: in grey).
	"aj_title": {"es": "Partidas en la cabeza", "en": "Games in his head"},
	"mg_ajedrez": {"es": "Ajedrez humano", "en": "Human chess"},
	"mg_ajedrez_unlock": {"es": "Escucha al alcalde hablar de su ajedrez, después del torneo de los Recress.", "en": "Hear the mayor out about his chess, after the Recress tournament."},
	"log_aj_open": {"es": "el alcalde quiere hablar contigo en la puerta del ayuntamiento", "en": "the mayor wants a word at the town hall door"},
	"p_aj_play": {"es": "<interact> Jugar", "en": "<interact> Play"},
	"aj_unlocked": {"es": "Has desbloqueado el Ajedrez humano como minijuego", "en": "You've unlocked Human Chess as a minigame"},
	"aj_m_intro": {"es": ["Hombre, usted por aquí. Pase, pase. Bueno, no pase, que estamos en la calle.",
			"Le voy a confesar una cosa. Desde que perdí en el torneo de Tokken 9, he dejado un poco los videojuegos.",
			"Un servidor necesitaba reorientar su estrategia de ocio. Y he vuelto a mis antiguos hobbies. Como el ajedrez."],
		"en": ["Well, look who it is. Come in, come in. Well, don't come in, we're in the street.",
			"I'll confess something. Since I lost the Tokken 9 tournament, I've rather given up video games.",
			"Yours truly needed to realign his leisure strategy. So I've gone back to my old hobbies. Like chess."]},
	"aj_m_window": {"es": ["Cuando miro por la ventana de mi despacho, veo el tablero de la plaza.",
			"Y me imagino partidas. Aperturas, tácticas, finales… Todo aquí, en la cabeza, para entrenar."],
		"en": ["When I look out of my office window, I can see the chessboard in the square.",
			"And I imagine games. Openings, tactics, endgames… All up here, in my head, to keep in training."]},
	"aj_m_pieces": {"es": ["Lo más gracioso es que, como veo pasar a la gente del pueblo, las figuras que me imagino han empezado a ser… gente del pueblo.",
			"La gente alta, de alfiles.", "La gente bajita, de torres.", "Los niños, de peones.", "Los perros, de caballos.", "E incluso mi mujer y yo… de reina y de rey."],
		"en": ["The funny thing is, since I watch the townsfolk go by, the pieces I imagine have started to be… townsfolk.",
			"Tall people as bishops.", "Short people as rooks.", "Children as pawns.", "Dogs as knights.", "And even my wife and I… as queen and king."]},
	"aj_m_ask": {"es": ["…", "Usted pensará que estoy loco, ¿verdad?"], "en": ["…", "You must think I'm mad, don't you?"]},
	"aj_q": {"es": "¿Piensas que está loco?", "en": "Do you think he's mad?"},
	"aj_q_no": {"es": "Noooo, que vaaa, muy normal todo", "en": "Noooo, not at aaall, all perfectly normal"},
	"aj_q_yes": {"es": "Como una puñetera regadera", "en": "Mad as a bloody box of frogs"},
	"aj_m_sarcasm": {"es": ["Mire, no me gustan los sarcasmos.", "Bastante tengo que aguantar en el trabajo. En los plenos, sin ir más lejos."],
		"en": ["Look, I don't care for sarcasm.", "I have to put up with enough of it at work. At council meetings, for a start."]},
	"aj_m_honest": {"es": ["¡Ja, ja, ja, ja! ¡Como una puñetera regadera! ¡Muy bueno!", "Le agradezco la sinceridad, de verdad. Escasea. En política, más todavía."],
		"en": ["Ha, ha, ha, ha! Mad as a bloody box of frogs! Very good!", "I appreciate your honesty, truly. It's in short supply. In politics, even more so."]},
	"aj_m_bye": {"es": ["Bueno, le dejo, que tengo mucho trabajo ((y una partida abierta en SuperChess 2.0))."],
		"en": ["Right, I'll leave you to it, I've got a lot of work ((and a game going on SuperChess 2.0))."]},
