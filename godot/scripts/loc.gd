	"ask_food_henry": {"es": "¿Qué te pongo?", "en": "What can I get you?"},
	# ---- Correa: its two clerks, their stories of the mili, and the letters (cartas.gd; the user, 16 Nov 2026) ----
	"n_diurno": {"es": "Diurno Correa", "en": "Diurno Correa"},
	"n_nocturno": {"es": "Nocturno Correa", "en": "Nocturno Correa"},
	"correa_hablar": {"es": "Hablar", "en": "Talk"},
	"correa_enviar": {"es": "Enviar una carta", "en": "Send a letter"},
	"correa_enviar_hoy": {"es": "Enviar una carta (ya mandaste una hoy)", "en": "Send a letter (you sent one today)"},
	"correa_enviar_nadie": {"es": "Enviar una carta (no conoces a nadie)", "en": "Send a letter (you don’t know anybody yet)"},
	"correa_salir": {"es": "Salir", "en": "Leave"},
	"correa_hola_diurno": {"es": ["¡Buenos días, buenos días! ¿Qué se le ofrece a {este|esta} joven?", "¡Hombre, {majo|maja}! ¿Qué te se ofrece? Pa mandar, pa charrar, pa lo que sea.", "¡Adelante, adelante! En Correa, servicio con una sonrisa. La sonrisa es mía; el servicio, del Estado.", "¡Buenas! ¿Una carta? ¿Una batallita? Tengo de las dos, y la segunda es gratis."],
		"en": ["Good mornin’, good mornin’! What can I sort out for {this young chap|this young lady}?", "Well now, {lad|love}! What’ll it be? Postin’, natterin’, whatever you fancy.", "Step right up! At Correa, service with a smile. Smile’s mine; service belongs to the State.", "Wotcher! A letter? A war story? Got plenty o’ both, second one’s on the house."]},
	"correa_hola_nocturno": {"es": ["¿Qué pasa? ¿Vienes a mandar algo o a tocarme los cojones? Que pa las dos cosas hay que coger número.", "Ventanilla uno. Desembucha, que cierro a las ocho y no me pagan las horas extra. Ni las otras, ya puestos.", "Mira quién ha venío: {el listo|la lista} del pueblo. ¿Qué cojones quieres?", "Ése te habrá dicho que soy un borde. Y un cabrón. Las dos cosas son verdad. ¿Qué quieres?"],
		"en": ["What? You ’ere to post summat or break me balls? Take a ticket either way.", "Counter one. Spit it out—shut at eight, don’t pay overtime. Don’t pay regular time, come to that.", "Look who rolled in: the village smart-arse. What the bloody hell do you want?", "He’ll have warned you I’m grumpy. And a right bastard. Both bang on. What do you want?"]},
	"correa_papel_diurno": {"es": ["¡Una carta! ¡Qué alegría, con lo poco que se escribe ya! Tome, papel y sobre.", "Escriba, escriba con calma. Y si le falta una palabra bonita, me la pide, que tengo un cajón lleno."],
		"en": ["A letter! Lovely to see, folks barely put pen to paper anymore. Here y’are, sheet and envelope.", "Take your time, write away. Need a fancy word, just holler—got a drawer stuffed with ’em."]},
	"correa_papel_nocturno": {"es": ["Papel y sobre. Escribe y no me des la brasa mientras, que tengo una edad y mu poca paciencia.", "Ahí tiés. Y con letra clara, coño, que luego la leo pa ver el franqueo. Es broma. O no, que aquí uno se aburre de cojones."],
		"en": ["Paper and envelope. Write it and spare me your waffle—gettin’ on a bit and short on patience.", "Here. Neat hand, for fuck’s sake, I read ’em to price the stamps. Joking. Or not—bloody bored stiff in ’ere."]},
	"correa_enviada_diurno": {"es": ["¡Mañana la tiene! Palabrita de funcionario.", "Ya va pa allá. Le he puesto el sello más bonito que tenía, el del lince."],
		"en": ["On their doormat tomorrow! Civil servant’s honour.", "Off it pops. Stuck me prettiest stamp on it—the lynx one."]},
	"correa_enviada_nocturno": {"es": ["Mañana la tiene. Si no llueve. Y si llueve también, qué cojones, que yo no soy el Diurno, que se moja y se pone a llorar.", "Hala, sellada. Lo que hayas puesto ya es cosa tuya. Si es una guarrada, yo no he visto ná."],
		"en": ["Gets there tomorrow. If it stays dry. Even if it buckets down, sod it—I’m not Diurno, gets a sprinkle and starts blubbin’.", "Stamped. Whatever filth you scribbled’s your look-out—I clocked nowt."]},
	"correa_nada_diurno": {"es": ["¿No? Bueno, otro día será. Las cartas, como el vino: mejor reposadas.", "Ná, no pasa ná. Aquí le guardo su papel pa cuando quiera."],
		"en": ["No? Another day then. Letters are like proper wine—better left to breathe.", "No bother, love, no bother. Keep your paper safe right ’ere till next time."]},
	"correa_nada_nocturno": {"es": ["¿Me haces sacar el papel pa ná? Me cago en la leche. Siguiente.", "Pos ná, a tomar viento. Ya vendrás cuando sepas escribir."],
		"en": ["Dragged out the stationery for nowt? Bloody ’ell. Next!", "Right, hop it then. Come back once you’ve learnt to spell."]},
	"correa_adios_diurno": {"es": ["¡Vis con Dios! Y salude a su madre, aunque no la conozca.", "¡Hasta luego! Aquí estoy de ocho a dos, como un reloj. Bueno, como un reloj de los de antes."],
		"en": ["God bless! Say hello to your mum from me, even if we ain’t met.", "Ta-ra! Right ’ere eight till two, regular as clockwork. Old clockwork, mind."]},
	"correa_adios_nocturno": {"es": ["Hala, a cascarla.", "Cierra al salir. Que no, que es automática, {pazguato|pazguata}. Pero ciérrala igual."],
		"en": ["Go on, sod off.", "Shut the door behind you. No, it’s automatic, you plum—shut it anyway."]},
	"mili_0_diurno": {"es": ["¿Te he contao lo de la gallina del sargento? ¡Qué tiempos!", "Teníamos un hambre... Y el sargento con una gallina en el patio, más gorda que el coronel.", "Esa noche la guisamos con patatas, y el sargento se comió dos platos. ¡Y repitió! Nunca supo que era la suya.", "Al Nocturno lo arrestaron unos días, pero eso fue por otra cosa, me paece. Ja, ja."],
		"en": ["Have I told you about the sergeant’s hen? What times those were!", "We were starving... And the sergeant had a hen in the yard, fatter than the colonel.", "That night we stewed it with potatoes, and the sergeant ate two plates. Seconds, even! He never knew it was his.", "Nocturno got locked up for a few days, but that was for something else, I think. Ha, ha."]},
	"mili_0_nocturno": {"es": ["La gallina. El mamón ese te ha contao lo de la gallina, ¿a que sí? Pues ahora te la cuento yo, que estaba allí.", "La robó él. La desplumó él. ¿Y las plumas ande cojones las escondió? Debajo de MI catre, el mu hijo de su madre.", "Quince días de calabozo, pelando patatas pa toa la compañía. Patatas pa la gallina, encima. ¡Pa la gallina!", "Y él silbando, con la barriga llena. Cuarenta y tantos años y entavía le metía una hostia. Bueno, dos."],
		"en": ["The hen. That prick’s told you about the hen, hasn’t he? Well, now I’ll tell it, ’cause I was there.", "He stole it. He plucked it. And where the fuck did he hide the feathers? Under MY bunk, the son of a gun.", "Fifteen days in the cells, peeling potatoes for the whole company. Potatoes for the hen, on top of it. For the hen!", "And him whistling, belly full. Forty-odd years on and I’d still smack him one. Well, two."]},
	"mili_1_diurno": {"es": ["Una noche de guardia en la garita, con un frío que hacíamos corchetes, me puse a cantar pa no dormirme.", "Toa la noche. Coplas, pasodobles, jotas, sin repetir ni una. Hasta los perros del cuartel se arrimaron a escucharme.", "Al Nocturno le tocaba la garita de al lao. Dice que aquella noche no pegó ojo. ¡Pos de eso se trataba, de no dormirse!"],
		"en": ["One night on guard in the sentry box, so cold our teeth were chattering, I started singing to stay awake.", "All night. Coplas, pasodobles, jotas, not one twice. Even the barracks dogs came over to listen.", "Nocturno had the next box along. He says he didn’t sleep a wink that night. Well, that was the whole point!"]},
	"mili_1_nocturno": {"es": ["Una noche de guardia. Seis horas en una garita, y a diez metros el cansino ese cantando coplas.", "Desafinando como un gato con el rabo pillao. Seis horas. Los perros aullaban, y no de gusto, coño: de pena.", "Pedí el traslado a la mañana siguiente y me lo denegaron, los mu cabrones. Por eso aquí me pedí la tarde: pa no oírlo ni mear a la vez que él."],
		"en": ["One night on guard. Six hours in a sentry box, and ten metres off, that pain in the arse singing coplas.", "Off key like a cat with its tail caught. Six hours. The dogs were howling, and not for joy, damn it: for pity.", "I asked for a transfer next morning and the bastards turned it down. That’s why I took afternoons here: so I don’t hear him, or even piss at the same time as him."]},
	"mili_2_diurno": {"es": ["Al volver de premiso nos vinimos al pueblo en un camión de melones. ¡A dedo, como los artistas!", "Catorce horas de viaje, tumbaos encima de los melones, mirando las estrellas. Me comí... no sé, siete u ocho. ¡Echusté!", "Llegamos a Matritellus más contentos que unas pascuas. Bueno, yo. El Nocturno llegó verde."],
		"en": ["Coming home on leave, we hitched a ride to town on a melon lorry. Thumbing it, like film stars!", "Fourteen hours, lying on top of the melons, looking at the stars. I ate... I don’t know, seven or eight. Loads!", "We got to Matritellus happy as Larry. Well, I did. Nocturno arrived green."]},
	"mili_2_nocturno": {"es": ["El camión de melones. Catorce horas encima de los melones. Ya te lo habrá vendío como si fuera un crucero, el gilipollas.", "Se comió nueve. NUEVE melones. Y el camión sin parar, y a la tercera hora... se cagó encima. Encima de los melones. Al lao mío.", "Llegué verde, sí. Del olor. Desde entonces no puedo ver un melón ni en afoto. Ni a él con camiseta verde."],
		"en": ["The melon lorry. Fourteen hours on top of the melons. He’ll have sold it to you like a cruise, the dickhead.", "He ate nine. NINE melons. And the lorry never stopped, and by the third hour... he shat himself. On the melons. Right next to me.", "I arrived green, yes. From the stink. Since then I can’t look at a melon, not even in a photo. Nor at him in a green T-shirt."]},
	"mili_3_diurno": {"es": ["En la mili yo tenía buena letra, y medio cuartel me pedía que les escribiera las cartas a las novias.", "Yo les ponía cosas bonitas, de poesía: «tus ojos son dos luceros», y eso. Cobraba en tabaco.", "Ahí me entró el gusanillo de las cartas. Por eso acabé en Correa. Es vocación, ¿sabes?"],
		"en": ["In the mili I had good handwriting, and half the barracks asked me to write their letters to their girlfriends.", "I wrote them pretty things, like poetry: “your eyes are two bright stars”, and the like. They paid me in cigarettes.", "That’s where I got the bug for letters. That’s how I ended up at Correa. It’s a calling, you know?"]},
	"mili_3_nocturno": {"es": ["El poeta. El tío escribía las cartas de amor de media compañía. La misma carta pa toas, palabra por palabra, el mu jeta.", "Hasta que dos novias del mismo pueblo se enseñaron las cartas en la fuente. Dos novias, una carta, dos cornudos. Imagínate el pitote.", "Hubo hostias en el cuartel una semana. Y el del ojo morao fui yo, que ni novia tenía. Ni tengo. Ni falta que me hace, coño."],
		"en": ["The poet. He wrote half the company’s love letters. The same letter for all of them, word for word, the cheeky sod.", "Until two girlfriends from the same village compared them at the fountain. Two girls, one letter, two lads with horns. Imagine the ruckus.", "There were punch-ups in the barracks for a week. And the one with the black eye was me, and I didn’t even have a girlfriend. Still don’t. Don’t bloody need one."]},
	"mili_4_diurno": {"es": ["En la jura de bandera hacía un calor que se derretía el asfalto, y yo... ¡pum! Me desmayé.", "Y me recogió el mismísimo coronel, en brazos, delante de toas las madres. ¡Qué vergüenza, y qué honor!", "Mi madre lo contaba hasta el último día. Que en paz descanse."],
		"en": ["At the swearing-in it was so hot the tarmac was melting, and I... bang! Fainted.", "And the colonel himself picked me up, in his arms, in front of all the mothers. The shame of it, and the honour!", "My mother told that story till her last day. God rest her."]},
	"mili_4_nocturno": {"es": ["¿Desmayao? Y una polla. Se tiró. Lo vide yo: miró pa los laos, buscó al coronel y se dejó caer encima como un saco de patatas.", "Pa librarse del desfile, que tenía una ampollita en el pie. Una ampollita. El nenaza.", "Y al otro día, ¿quién desfiló por él? Este pringao. Dos veces. Y él en la enfermería, comiendo natillas y rascándose los huevos."],
		"en": ["Fainted? My arse. He threw himself. I saw it: looked left and right, found the colonel and dropped on him like a sack of spuds.", "To get out of the parade, ’cause he had a little blister on his foot. A little blister. The big baby.", "And next day, who marched in his place? This mug. Twice. And him in the sick bay, eating custard and scratching his balls."]},
	"mili_5_diurno": {"es": ["Al licenciarnos, en Correa buscaban dos funcionarios. ¡Dos! Ni uno ni tres. Aquello era el destino.", "Desde entonces juntos, cuarenta y tantos años. Él de tarde, yo de mañana. Como hermanos.", "Él no lo dice, pero me quiere. A su manera. A cagaíto."],
		"en": ["When we were discharged, Correa was looking for two clerks. Two! Not one, not three. It was fate.", "Together ever since, forty-odd years. Him in the afternoons, me in the mornings. Like brothers.", "He won’t say it, but he loves me. In his way. A tiny bit at a time."]},
	"mili_5_nocturno": {"es": ["Al licenciarme eché la solicitud pa Correa. Yo solo. Tranquilo. Un sitio sin melones y sin gilipollas.", "Al día siguiente estaba el gilipollas en la cola, con su solicitud, silbando. Porque yo la había echao. Me cago en mi suerte.", "Cuarenta y tres años. Me pedí la tarde pa no coincidir, y aun así me deja notitas en el cajón. Notitas. Con corazones. Algún día lo mato."],
		"en": ["When I got out I applied to Correa. On my own. In peace. A place with no melons and no dickheads.", "Next day the dickhead was in the queue with his form, whistling. Because I’d applied. Just my bloody luck.", "Forty-three years. I took afternoons so we wouldn’t overlap, and he still leaves me little notes in the drawer. Little notes. With hearts. One day I’ll kill him."]},
	"carta_cab": {"es": "SERVICIO POSTAL CORREA", "en": "CORREA POSTAL SERVICE"},
	"carta_para": {"es": "Para:", "en": "To:"},
	"carta_hint": {"es": "Escribe aquí lo que le quieras decir…", "en": "Write what you want to tell them here…"},
	"carta_vacia": {"es": "Escribe algo, que un sobre vacío no lo lleva ni el Diurno.", "en": "Write something: not even Diurno would deliver an empty envelope."},
	"carta_firma": {"es": "Firmao: ", "en": "Signed: "},
	"carta_keys_hint": {"es": "A: escribe · B: borra · Start: envía · LB/RB: a quién", "en": "A: type · B: rub out · Start: send · LB/RB: to whom"},
	"carta_enviar": {"es": "Enviar", "en": "Send"},
	"carta_volver": {"es": "Volver", "en": "Back"},
	"carta_sello": {"es": "CORREA", "en": "CORREA"},
	"carta_bien_x": {"es": [["¿Sí? Que me ha llegao tu carta. Qué detalle, {hijo|hija}. Ya no escribe nadie."], ["Oye, que he leío tu carta. Me ha alegrao el día. Bueno, la mañana. Bueno, un rato."]],
		"en": [["Hello? Your letter came. How thoughtful, {lad|love}. Nobody writes any more."], ["Listen, I read your letter. It made my day. Well, my morning. Well, a while."]]},
	"carta_mal_x": {"es": [["¿Tú eres {el|la} de la carta? Pues que sepas que la'é quemao. Y luego he pisao las cenizas."], ["Me ha llegao tu carta. ¿Eso es lo que piensas de mí? Mu bien. Mu bien. Apuntao queda."]],
		"en": [["Are you the one who sent the letter? Well, I burnt it. Then I stamped on the ashes."], ["Your letter came. So that’s what you think of me? Fine. Fine. Duly noted."]]},
	"carta_bien_diurno": {"es": [["¡Me ha llegao tu carta! ¡A mí, que llevo cuarenta años repartiéndolas! Se me han saltao las lágrimas, {hijo|hija}.", "La'é guardao en el cajón, al lao de las notitas que le dejo al Nocturno."], ["¿Sí? ¡Soy el Diurno, de Correa! Qué carta más bonita. La'é leío tres veces y la'é olío una.", "Huele a ti. No sé a qué hueles tú, pero huele."]],
		"en": [["Your letter came! To me, after forty years of handing them out! It brought tears to my eyes, {lad|love}.", "I’ve kept it in the drawer, next to the little notes I leave for Nocturno."], ["Hello? It’s Diurno, from Correa! What a lovely letter. I’ve read it three times and sniffed it once.", "It smells of you. I don’t know what you smell of, but it smells of it."]]},
	"carta_mal_diurno": {"es": [["Me ha llegao tu carta. Yo... bueno. Yo creía que éramos amigos.", "Ná, no pasa ná. Ya me lo dijo el Nocturno: «A ése no le pongas el sello del lince». Y yo, tonto, el del lince."], ["¿Sí? Soy el Diurno. Que he leío tu carta.", "Mira, en la mili me dijeron cosas más bonitas. Y en la mili me dijeron de tó."]],
		"en": [["Your letter came. I... well. I thought we were friends.", "Never mind, never mind. Nocturno warned me: “Don’t give that one the lynx stamp.” And me, the fool, the lynx."], ["Hello? It’s Diurno. I’ve read your letter.", "Look, in the mili they called me nicer things. And in the mili they called me everything."]]},
	"carta_bien_nocturno": {"es": [["Soy el Nocturno. Me ha llegao tu carta.", "...", "Joder. Ya. Eso. Que me ha llegao. Como se lo digas al Diurno te meto el sello por el culo."], ["¿Una carta pa mí? Cuarenta y tres años en Correa, y la primera que no es una puta factura.", "No me ha gustao. Bueno, un poco. Bueno, la'é guardao, ¿vale? Pa encender la estufa. O no. Cuelga ya, coño."]],
		"en": [["It’s Nocturno. Your letter came.", "...", "Fuck. Right. That’s it. It came. Tell Diurno and I’ll shove the stamp up your arse."], ["A letter for me? Forty-three years at Correa, and the first one that isn’t a fucking bill.", "I didn’t like it. Well, a bit. Well, I kept it, all right? To light the stove. Or not. Hang up, for fuck’s sake."]]},
	"carta_mal_nocturno": {"es": [["Soy el Nocturno. Tu cartita. La'é leío, {chaval|chavala}.", "He hecho la mili, he aguantao al Diurno cuarenta y tres años, ¿y te crees que me vas a ofender con cuatro palabrotas? Me la suda. A la cola, {mamón|mamona}."], ["¿Sí? Lo de tu carta. La ha sellao el Diurno, así que la ha leío media oficina y se han descojonao de tus faltas.", "La próxima que mandes paga el doble. Por la mala leche, que pesa. Y te la sello del revés, por {listo|lista}."]],
		"en": [["It’s Nocturno. Your little letter. I’ve read it, kid.", "I did the mili, I’ve put up with Diurno for forty-three years, and you think you’ll offend me with a few swear words? I don’t give a shit. Get in the queue, you prick."], ["Hello? About your letter. Diurno stamped it, so half the office has read it and pissed themselves at your spelling.", "The next one you send pays double. For the spite: it’s heavy. And I’ll stamp it upside down, smart-arse."]]},
	# (letters' answers: two kind calls and two nasty ones for each neighbour with a name)
	"carta_bien_josefa": {"es": [["¿Sí? ¿Es {el|la} de la Eufrasia? Soy la Josefa. Te llamo con el teléfono que me arreglaste, ¿eh? Ya no sale el chino del tiempo.", "Me ha llegao tu carta. La'é leío tres veces: con las gafas de cerca, con las de lejos y con las de mi difunto, que no me sirven pa ná.", "Mu bonita, {hermoso|hermosa}. En cuanto te vea te doy unas pesetas. En mano, que por teléfono no caben."], ["¡Ay, {hijo|hija}! Que el cartero me ha traío tu carta y me he echao a llorar. Bueno, estaba pelando cebolla, pero también por la carta.", "La'é puesto en el aparador, al lao del retrato de mi difunto. Él en cuarenta años no me escribió ná. Ni la lista de la compra.", "Ya se lé contao a media calle. La otra media se entera mañana, que hoy ya no me da la tarde."]], "en": [["Hello? Is that Eufrasia’s {lad|lass}? It’s Josefa, pet. Ringin’ off the mobile you sorted—no Chinese bloke readin’ the forecast now.", "Your letter turned up! Read it three times: readin’ specs, distance specs, and me late husband’s, which are bloomin’ useless.", "Proper lovely, {love|pet}. Next time I clap eyes on you I’ll slip you some pesetas. By hand—won’t squeeze down the wire."], ["Oh, {lad|love}! Postie dropped your letter and I burst into tears. Well, I were choppin’ onions, mind—still, letter set me off too.", "Stood it proud on the sideboard beside me late husband’s photo. Forty years wed, never scribbled me a word—not even a shopping list.", "Told half the lane already. Rest’ll hear tomorrow—run out of daylight today."]]},
	"carta_mal_josefa": {"es": [["Soy la Josefa. Me ha llegao tu cartita. Mira: una es viuda, pero no es tonta. Y leer, sé. Ojalá no supiera.", "Con lo que te has gastao en el sello te podías haber comprao un poco de vergüenza, que en el Mercamona la tienen de oferta.", "Así te se desconfigure a ti la vida y te salga un chino dando el tiempo. ¡Sinvergüenza!"], ["¿Pa esto te di yo dos mil quinientas pesetas? Devuélvemelas, {so desgraciao|so desgraciá}. En pesetas, claro.", "Y ahora que el teléfono me va, vía llamar a tó el pueblo pa contar lo que me has escrito. Eso te pasa por arreglármelo."]], "en": [["It’s Josefa. Your nasty little note came. Look, I’m a widow, not daft. Read fine I can—wish I hadn’t.", "Money you wasted on that stamp could’ve bought some decency down Mercamona while it’s on offer.", "May your whole life go sideways with some Chinese fella readin’ the weather at you. Bare-faced cheeky sod!"], ["What I forked over two thousand five hundred pesetas for, was it?! Cough ’em right back up, you {wretch|heartless cow}. In pesetas, mind.", "And now me mobile’s tickin’ again, I’m bellin’ every house in the village to read out your filth. Serve you right for fixin’ it."]]},
	"carta_bien_vip": {"es": [["V.I.P., Vendo e Instalo, ¿dígame? …Ah, eres tú. Que me ha llegao tu carta. Mu bonita.", "Leerla son quince euros, pero te los perdono. Bueno, la mitad. Siete cincuenta. Más IVA."], ["Oye, lo de tu carta me ha tocao aquí, en el pecho. Y mira que el pecho lo tengo curtío de tanto guantazo en la trastienda.", "Ya que estás tan {cariñoso|cariñosa}: lo de casarte con {mi hija|mi hijo} sigue en pie. Las tierras también. Tú piénsatelo."]], "en": [["V.I.P., Vendo e Instalo, hello? …Oh, it’s you. Your letter’s arrived. Very nice.", "Reading it is fifteen euros, but I’ll let you off. Well, half. Seven fifty. Plus VAT."], ["Listen, that letter of yours got me right here, in the chest. And my chest is tanned leather from all the punches in the back room.", "Since you’re feeling so sweet: the offer to marry my {daughter|son} still stands. So does the land. You think about it."]]},
	"carta_mal_vip": {"es": [["¿Me has escrito eso a mí? ¿A MÍ?", "La'é leío en voz alta en la trastienda, subío al ring. Por cada burrá que pones, un asalto. Me salen catorce.", "Ven calentando, que hoy la P de V.I.P. viene con el pan recién sacao del horno."], ["Soy el Fonsi. Tu carta la'é leío, y leer mierda es un servicio. Los servicios se cobran.", "Te la'é cargao en la cuenta: ochenta euros, más IVA. Noventa y siete. Y el diagnóstico de tu cara, gratis, en cuanto te pille."]], "en": [["You wrote that to me? To ME?", "I read it out loud in the back room, standing in the ring. One round for every bit of filth you wrote. I make it fourteen.", "Come warmed up: today the P in V.I.P. comes with loaves fresh from the oven."], ["It’s Fonsi. I’ve read your letter, and reading shite is a service. Services cost money.", "I’ve put it on your account: eighty euros plus VAT. Ninety-seven. And a diagnosis of your face, free, the minute I catch you."]]},
	"carta_bien_alberto": {"es": [["¡Ey! Soy Alberto. Tu carta la'é leío en voz alta en el puente, a la plataforma. A los catorce. Bueno, a los cinco que había.", "Esto es lo que le hace falta al pueblo: gente que escribe. ¿Me la firmas por detrás? Pa la carpeta. Por si acaso."], ["Oye, que tu carta me ha pillao fuera, por el curro. Me la ha leío mi madre por teléfono, llorando.", "Ella llorando y yo también, y la llamada costando un dineral. De la hucha, ¿eh? Tú ni caso.", "Enga, en cuanto vuelva al pueblo te invito a una caña. En el puente, que ahí no se paga terraza."]], "en": [["Hey! It’s Alberto. I read your letter out loud on the bridge, to the platform. All fourteen of them. Well, the five who were there.", "This is what the town needs: people who write. Will you sign the back of it for me? For the folder. Just in case."], ["Listen, your letter caught me away, for work. My mother read it to me over the phone, in tears.", "Her crying and me too, and the call costing a fortune. Out of the tin, mind. Don’t you worry about it.", "Enga, as soon as I’m back in town I’ll buy you a beer. On the bridge: no terrace to pay for there."]]},
	"carta_mal_alberto": {"es": [["¿Tú me has escrito eso a mí? ¿A mí, que llevo desde las siete en el puente dándole vidilla al pueblo?", "En la plataforma semos catorce, y nueve son familia mía. Los nueve saben ya lo que me has puesto. Y mi madre, la de la hucha.", "Te borraba las cinco firmas, {so zanguango|so zanguanga}. Bueno, esas no, que hacen falta. Pero en mi corazón, borradas."], ["Soy Alberto. Yo vengo al pueblo cuando el curro me deja, pa arreglar cosas, y tú me escribes pa tocarme los huevos.", "He leío la carta en el puente y he estao a punto de tirarme. Pero el puente es mu bajo y el arroyo va seco. Ni pa eso vale.", "Si algún día te entra la vergüenza, me llamas. Hasta entonces, ni me saludes, que no te firmo ni la esquela."]], "en": [["You wrote that to me? To me, who’s been on the bridge since seven putting some life into this town?", "There are fourteen of us in the platform, and nine are my family. All nine know what you wrote. And my mother, the one with the tin.", "I’d strike out your five signatures, you lazy lump. Well, not those, we need them. But in my heart, struck out."], ["It’s Alberto. I come back to town whenever work lets me, to fix things, and you write to me to break my balls.", "I read the letter on the bridge and nearly threw myself off. But the bridge is too low and the stream’s dry. Useless even for that.", "If shame ever catches up with you, ring me. Till then don’t even say hello: I wouldn’t sign your death notice."]]},
	"carta_bien_chiki": {"es": [["¿Sí? Soy la Chiki. Me ha llegao tu carta. En papel, con sello. Qué analógico tó, ¿no? Me ha flipao.", "La vía meter en mi serie sobre el vacío. Es la primera pieza. Tres años esperando a empezar, y vas tú y me desbloqueas."], ["Oye, lo de la carta… En Berlín nadie me escribía cartas. Me escribían multas.", "No sé qué decirte. Bueno, sí: que me ha gustao. Pero no se lo digas a nadie, que tengo fama de que tó me da igual.", "Si haces algo luego, avisa. Lo que sea. Hoy me apunto contigo hasta a un bombardeo."]], "en": [["Hello? It’s La Chiki. Your letter came. On paper, with a stamp. How analogue, right? Blew my mind.", "I’m putting it in my series about emptiness. It’s the first piece. Three years waiting to start, and you go and unblock me."], ["Listen, about the letter… In Berlin nobody ever wrote me letters. They wrote me fines.", "I don’t know what to say. Well, I do: I liked it. But don’t tell anyone, I have a reputation for not caring about anything.", "If you’re doing anything later, shout. Anything. Today I’d join you on an air raid."]]},
	"carta_mal_chiki": {"es": [["Ya me ha llegao tu carta. La'é leío dos veces, por si era una performance.", "No. Eres gilipollas y ya está. Y como estoy en control de la ira, ahora vía respirar…", "…Ya. Ya he respirao. Sigues siendo gilipollas. Y le he dicho a mi hermano que te escupa en el durum."], ["El psicólogo me dice que, cuando algo me haga daño, lo convierta en arte.", "Así que con tu carta he hecho una pieza: la'é quemao en un cenicero y he bailao encima. Se llama «Mojón con sello».", "Está inspirá en ti, que conste. La vía colgar en la peña, al lao de la barra."]], "en": [["Well, your letter came. I read it twice, in case it was a performance piece.", "No. You’re just a dickhead. And since I’m in anger management, I’m going to breathe now…", "…Right. I’ve breathed. Still a dickhead. And I’ve told my brother to spit in your durum."], ["My psychologist says that when something hurts me, I should turn it into art.", "So I made a piece out of your letter: burnt it in an ashtray and danced on it. It’s called “Turd with a Stamp”.", "It’s inspired by you, for the record. I’m hanging it in the peña, next to the bar."]]},
	"carta_bien_alcalde": {"es": [["Buenas tardes. Le llamo a título personal, no en calidad de alcalde. He recibido su carta.", "Es un gesto que valoro muy positivamente y que pone en valor la participación ciudadana en el día a día del municipio.", "La tengo enmarcada en mi despacho, junto al diploma de Tokken 2. Ni que decir tiene que esta llamada no consta en acta."], ["Le habla el alcalde. Su carta ha sido elevada a la Junta de Gobierno Local, que en este caso soy yo, y aprobada por unanimidad.", "Le agradezco las palabras, de verdad. Escasean. En política, más todavía.", "Mi madre también la ha leído. Dice que es usted la única persona de este pueblo con modales. Y eso que ella no los tiene."]], "en": [["Good afternoon. I’m calling in a personal capacity, not as mayor. I have received your letter.", "It is a gesture I view very positively, and one that showcases citizen participation in the day-to-day life of the municipality.", "It hangs framed in my office, next to my Tokken 2 certificate. Needless to say, this call is not being minuted."], ["This is the mayor speaking. Your letter has been referred to the Local Governing Board, which in this case is me, and passed unanimously.", "Thank you for your words, truly. They’re in short supply. In politics, even more so.", "My mother read it too. She says you’re the only person in this town with manners. And she has none herself."]]},
	"carta_mal_alcalde": {"es": [["Buenos días. Le llamo en relación con el escrito que tuvo a bien remitirme a través del Servicio Postal Correa.", "En toda mi trayectoria política nunca me habían llamado tantas cosas en tan poco papel. Le felicito por la capacidad de síntesis.", "Le informo de que su vivienda va a recibir una inspección técnica. Exhaustiva. Transversal. Y sin fecha, para que no duerma."], ["Despacho del alcalde, buenas tardes. Su carta consta en acta. Y en el registro de entrada. Y en una lista que llevo yo, aparte.", "Respeto profundamente la libertad de expresión. Igual que respeto mi potestad de poner un contenedor de vidrio delante de su puerta.", "De esos que se vacían a las seis de la mañana. Que tenga usted un buen día."]], "en": [["Good morning. I am calling with regard to the document you saw fit to send me via the Servicio Postal Correa.", "In my entire political career I’ve never been called so many things on so little paper. I commend your powers of synthesis.", "I must inform you that your home will be receiving a technical inspection. Exhaustive. Cross-cutting. And undated, so you won’t sleep."], ["Mayor’s office, good afternoon. Your letter has been minuted. And logged at the registry. And entered on a list I keep myself, separately.", "I deeply respect freedom of expression. Just as I respect my authority to put a bottle bank right outside your door.", "One of the ones they empty at six in the morning. Have a lovely day."]]},
	"carta_bien_copista": {"es": [["¿Sí? Soy la de la copistería. Que me ha llegao tu carta y me ha hecho una ilusión que no veas.", "Le he sacao diez fotocopias a color pa enseñársela a mis amigas. Y la máquina no se ha atascao ni una vez. Eso es una señal."], ["Oye, que he leío tu carta en el descanso. Dos veces.", "Se me ha pasao un capítulo entero del Nerflis sin enterarme. Eso no me pasa ni con los novios. Gracias, de verdad."]], "en": [["Hello? It’s the copy-shop girl. Your letter came and I can’t tell you how chuffed I am.", "I ran off ten colour copies to show my friends. And the machine didn’t jam once. That’s a sign."], ["Listen, I read your letter on my break. Twice.", "A whole episode of Nerflis went by without me noticing. That doesn’t even happen with boyfriends. Thanks, really."]]},
	"carta_mal_copista": {"es": [["Hola. Me ha llegao lo tuyo. ¿Sabes lo que he hecho con ello? A la destructora de papel.", "Y luego he ampliao los trocitos al cuatrocientos por cien y los he pegao en el escaparate, pa que el pueblo vea la mierda que escribes.", "Cuando vengas a fotocopiar algo, la máquina va a estar atascá. Pa ti, siempre."], ["Mira, yo aquí aguanto de tó: al alcalde, a los del ayuntamiento, a los que quieren el DNI por las dos caras en una sola hoja.", "Pero tu carta… Eres más cansino que las moscas en vendimia y más tonto que el que mete el papel al revés.", "Se la'é leío a mis amigas. Ahora en el grupo te llamamos «Papel Atascao»."]], "en": [["Hi. Your thing arrived. Know what I did with it? Straight in the shredder.", "Then I blew the scraps up to four hundred per cent and stuck them in the window, so the whole town can see the shite you write.", "Whenever you come in for photocopies, the machine will be jammed. For you, always."], ["Look, I put up with everything here: the mayor, the council lot, people who want both sides of their ID on one sheet.", "But your letter… You’re more tiresome than flies at the grape harvest and thicker than someone who loads the paper upside down.", "I read it out to my friends. In our group you’re now “Paper Jam”."]]},
	"carta_bien_alcaldesa": {"es": [["¿Sí? Soy la mujer del alcalde. No, él no sabe que te llamo. Él no sabe muchas cosas.", "Me ha gustao mucho tu carta. Treinta años casá y es la primera que me llega que no es de la Diputación."], ["Me ha llegao tu carta. La'é leío en la cocina, antes de que la viera él, que tó lo quiere llevar a pleno.", "Qué cosas más bonitas. Me has alegrao la semana. Y a él lé dejao con la mosca detrás de la oreja, que se la'é leío en voz alta.", "Jeje."]], "en": [["Hello? It’s the mayor’s wife. No, he doesn’t know I’m ringing you. There’s a lot he doesn’t know.", "I liked your letter very much. Thirty years married, and it’s the first one I’ve had that isn’t from the provincial council."], ["Your letter came. I read it in the kitchen before he could see it: he wants to take everything to a council vote.", "Such lovely things. You’ve made my week. And I’ve left him with a flea in his ear: I read it to him out loud.", "Heh heh."]]},
	"carta_mal_alcaldesa": {"es": [["Hola. Soy la mujer del alcalde. Tu carta la'é abierto yo, que en esta casa la correspondencia la abro yo.", "Treinta años aguantando a un político, {hijo|hija}. ¿Tú te crees que me vas a ofender con cuatro palabrotas mal escritas?", "Pero tengo buena memoria y mucha paciencia. Y una mujer con paciencia es peor que el ayuntamiento entero."], ["Ya… Jeje. Me ha llegao tu carta.", "Mira: a lo mejor mi marido se dejó ganar al Tokken. Yo no me dejo ganar a ná. Ni al parchís.", "Así que ándate con ojo, {majo|maja}. En el ajedrez de la plaza las jugadas las piensa él, pero la que se mueve por tó el tablero es la reina."]], "en": [["Hello. The mayor’s wife speaking. I opened your letter meself—in this house I open all the post.", "Thirty years putting up with a politician, {lad|lass}. Reckon a handful of badly spelt swear words is gonna rattle me?", "Got a long memory though, and buckets of patience. Woman with patience beats the entire town hall."], ["Right… Heh heh. Your letter landed.", "Listen: maybe me husband let you beat him at Tokken. I let nobody beat me at owt—not even Ludo.", "Watch your step, {mate|love}. On that square chessboard he cooks up the moves, sure, only it’s the queen roams the whole board."]]},
	"carta_bien_madre_alcalde": {"es": [["¿Diga? ¡Adius, que eres tú! Soy la madre del alcalde. Que me ha traío el cartero tu carta y me la'é leío sin gafas.", "Mu bonita, {hijo|hija}. Mi hijo nunca me escribe. Me manda bandos. ¡Bandos, a su madre!"], ["Ya tengo tu carta en el vasar, al lao de la afoto de mi difunto y del trofeo de los marcianitos de mi hijo.", "Si algún día quiés que le reviente la cara a alguien, tú me avisas. Que a mis años ya no tengo ná que perder.", "Vis con Dios, {hermoso|hermosa}."]], "en": [["Hello? ¡Adius, it’s you! The mayor’s mum ’ere. Postie brought your letter and I read every word without me specs.", "Proper lovely, {lad|love}. Me own boy never writes—sends me council proclamations! Proclamations, to his own mam!"], ["Stood your letter up on the dresser shelf beside me late husband’s snap and me boy’s space-invaders trophy.", "Ever fancy somebody’s mug rearranged, just give us a bell. At my age I’ve nowt left to lose.", "God keep you, {lad|pet}."]]},
	"carta_mal_madre_alcalde": {"es": [["¿Tú eres {el|la} de la carta? ¡Me cago en tu calavera y en el cartero que te la trajo!", "Ochenta y tantos años tengo, y nadie me había faltao así. Bueno, mi difunto. Pero a ese lo zumbaba.", "Como te coja por la plaza te reviento la puta cara. Y esta vez mi hijo no me va a decir «aquí no»."], ["¡Ojooo, lo que me has escrito! Me ha dao un arrichucho que aína me quedo en el poyete.", "Mi hijo dice que no me altere, que es malo pa la tensión. Mi hijo es mu bueno. Tú eres {un hijoputa|una hijaputa}.", "Y no te creas que por vieja no te alcanzo. Ande vayas, allí que me planto con la garrota."]], "en": [["Is this the scallywag sent that letter? Sod you and the blooming postman carried it!", "Eighty-odd years I’ve lived and nobody’s ever mouthed off at me like that. Bar me late husband—and I gave him a right clout.", "Catch you in the square, I’ll smash your bloody face in. This time me boy ain’t stopping me with ‘not ’ere’."], ["Bloomin’ ’eck, state of what you scribbled! Nearly gave me a funny turn right on me doorstep bench.", "Me son says keep calm for me blood pressure. Good lad, me son. You? Proper little {bastard|cow}.", "Don’t reckon I won’t catch up ’cause I’m old neither. Wherever you hide, there I’ll be waving me stick."]]},
	"carta_bien_comentarista": {"es": [["¡Probando, probando! ¿Se me oye? ¡Soy el comentarista! ¡Y tengo en la mano… una carta! ¡Tu carta!", "¡Qué letra, qué estilo, qué manera de cerrar el sobre! ¡Esto es un combo de diez golpes, señoras y señores!", "¡Y el sello, pegao derecho, sin una burbuja! ¡Perfecto!"], ["¡Atención, atención! ¡Llamada en directo! En esta esquina… ¡el comentarista! Y en la otra… ¡{el|la} de las cartas bonitas!", "¡No me lo creo! ¡Me ha emocionao! ¡K.O. en el corazón! ¡Repetición a cámara lenta: vía leerla otra vez!"]], "en": [["Testing, testing! Can you hear me? It’s the commentator! And in my hand I have… a letter! Your letter!", "What handwriting, what style, what a way to seal an envelope! That’s a ten-hit combo, ladies and gentlemen!", "And the stamp, stuck on straight, not one bubble! Perfect!"], ["Attention, attention! Live call! In this corner… the commentator! And in the other… the one with the lovely letters!", "I don’t believe it! I’m welling up! K.O. to the heart! Slow-motion replay: I’m reading it again!"]]},
	"carta_mal_comentarista": {"es": [["¡Uno, dos, uno, dos! Sí, se me oye. Y a ti te se lee, por desgracia.", "¡Lo de tu carta es un golpe bajo, señoras y señores! ¡Golpe bajo! ¡Descalificación inmediata!", "Y que sepas que tengo el micro y sé usarlo. De lao. En toa la cabeza."], ["¡Señoras y señores, barrudos y barrudas! ¡Tenemos {nuevo campeón|nueva campeona}… de la mierda escrita!", "¡Insulto en la primera línea, patada a la ortografía y un remate final que ni la madre del alcalde!", "Vía leerla en el próximo torneo, por megafonía. Con tu nombre. Y despacito."]], "en": [["One, two, one, two! Yes, you can hear me. And sadly, I can read you.", "Your letter is a low blow, ladies and gentlemen! A low blow! Instant disqualification!", "And just so you know, I’ve got the mic and I know how to use it. Sideways. Right across your head."], ["Ladies and gentlemen, barrudos and barrudas! We have a new champion… of written shite!", "An insult in the first line, a kick to the spelling, and a finish not even the mayor’s mother could top!", "I’ll read it out at the next tournament, over the PA. With your name. Nice and slow."]]},
	"carta_bien_katakumba": {"es": [["Eh… hola. Soy Katakumba69. Me ha llegao tu carta. En papel. No sabía que eso se seguía haciendo. Lé tenío que buscar en el foro.", "Es lo más bonito que me han mandao nunca. Después de los frame data del Drácula filtraos. Pero va segundo, ¿eh? Segundo es mucho."], ["Oye, que tu carta la'é escaneao y la'é subío al foro. Sin tu nombre, tranqui.", "Lleva ya cuarenta «me gusta». Treinta y nueve son míos, con otras cuentas. Pero cuentan.", "Si un día quiés echar unas partidas en los Recress, te dejo el mando bueno. El que no está cascao."]], "en": [["Er… hi. It’s Katakumba69. Your letter came. On paper. Didn’t know people still did that. Had to look it up on the forum.", "It’s the nicest thing anyone’s ever sent me. After the leaked Dracula frame data. But it’s second, yeah? Second is a lot."], ["Hey, I scanned your letter and posted it on the forum. Without your name, chill.", "It’s got forty likes already. Thirty-nine are mine, from other accounts. But they count.", "If you ever want a few games at the Recress, I’ll lend you the good stick. The one that isn’t knackered."]]},
	"carta_mal_katakumba": {"es": [["He leío tu carta tres veces, a ver si era ironía. No era ironía.", "Vale. Tú y yo, en la máquina grande de los Recress. Al mejor de cinco. Con el Drácula. Sin piedad.", "Y después te pongo en el foro, en la lista negra, en rojo y con tu foto de carné."], ["{Tío|Tía}, lo que me has escrito, en el foro es ban permanente. Sin apelación.", "Me has dejao más tocao que un combo de cuarenta golpes sin cancelar. Ojalá te toque siempre el mando cascao.", "Y que sepas que contigo el alcalde se dejó ganar. Lo sé. Lo sabemos tos. {Campeón|Campeona} de pega."]], "en": [["I read your letter three times, to see if it was ironic. It wasn’t ironic.", "Fine. You and me, on the big machine at the Recress. Best of five. Dracula. No mercy.", "And then I put you on the forum blacklist, in red, with your ID photo."], ["Mate, what you wrote me is a permanent ban on the forum. No appeal.", "You’ve left me more wrecked than a forty-hit combo with no cancels. I hope you always get the knackered stick.", "And you should know the mayor let you win. I know it. We all know it. Fake champion."]]},
	"carta_bien_henry": {"es": [["¿Sí? Henry, de la Cocina de Henry. Rápido, que tengo el jamón en el horno. Bueno, en el microondas.", "Que me ha llegao tu carta. Mi madre la ha leío y ha llorao, y eso que no llora ni cortando cebolla.", "El jueves que viene, el primer jamón es pa ti. Sin pegarte con nadie. Bueno, un poco, que es tradición."], ["Oye, que tu carta la tengo pegá en la nevera, con el imán del ayuntamiento.", "Ya sabes: pa ti, el plato de lo que haya, recién hecho. Bueno, recién calentao. Pero con cariño, que eso no se calienta."]], "en": [["Hello? Henry, La Cocina de Henry. Quick, I’ve got the ham in the oven. Well, in the microwave.", "Your letter came. My mother read it and cried, and she doesn’t cry even chopping onions.", "Next Thursday, the first ham is yours. No fighting anybody for it. Well, a bit: it’s tradition."], ["Listen, I’ve stuck your letter on the fridge, with the town hall magnet.", "You know how it is: for you, a plate of whatever there is, freshly made. Well, freshly warmed up. But with love, and that needs no warming."]]},
	"carta_mal_henry": {"es": [["Soy el Henry. Tu carta la'é leío. Y luego la'é usao pa limpiar la plancha, que pa algo tenía que servir.", "El jueves, en la puerta, el primer jamón es pa quien te tumbe a ti. Ya lo sabe medio pueblo."], ["Henry al aparato. Me ha llegao lo tuyo y se me ha cortao la digestión. Y la salsa.", "En esta casa te se va a servir siempre lo del jueves. Del jueves de hace tres semanas. Recalentao.", "Y no me pidas el libro de reclamaciones, que lo tengo, pero calzando la mesa."]], "en": [["It’s Henry. I read your letter. And then I used it to wipe the griddle: it had to be good for something.", "Thursday, at the door, the first ham goes to whoever knocks you down. Half the town knows already."], ["Henry speaking. Your thing arrived, and it’s curdled my digestion. And the sauce.", "In this house you’ll always be served Thursday’s. Thursday three weeks ago. Reheated.", "And don’t ask for the complaints book: I’ve got one, but it’s propping up the table."]]},
	"carta_bien_luis": {"es": [["Kebab Luis, ¿qué va a ser? …Ah, eres tú. Que me ha llegao tu carta. Ha compilao a la primera, sin un solo error.", "Me ha tocao el corazón, que con la grasa que lo rodea tiene mérito. El próximo durum te lo pongo con tó. Pagando, ¿eh?"], ["Oye, que he leío tu carta detrás de la barra y se me ha caío una lagrimilla en la salsa blanca.", "Ahora la salsa lleva un ingrediente nuevo: emoción. Código cerrao, como tó lo demás.", "Pásate, que te invito… a sentarte. El kebab se paga: una cosa es el cariño y otra la contabilidad."]], "en": [["Kebab Luis, what’ll it be? …Oh, it’s you. Your letter came. Compiled first time, not a single error.", "It touched my heart, which takes some doing through all that fat. Your next durum comes with everything. Paid for, mind."], ["Listen, I read your letter behind the counter and a little tear fell in the white sauce.", "Now the sauce has a new ingredient: emotion. Closed source, like everything else.", "Come by, I’ll treat you… to a seat. The kebab you pay for: affection is one thing, accounts are another."]]},
	"carta_mal_luis": {"es": [["Soy Don Luis. Tu carta la'é leío y me ha dao un error 500 en los cojones.", "Eso no lo compila ni Dios. Es basura con sello, y aquí la basura se cobra aparte, como el «sin cebolla».", "Tiés reservao un durum especial. Como lo de la otra vez: el moco, la meada y lo otro, tó en el mismo pan."], ["Mira, yo seré gordo, faltón y graciosillo. Pero tú escribes esas cosas a mano y con sello: tú eres gilipollas de nacimiento.", "Te he metío en la lista negra del kebab. Es un archivo de texto con un solo nombre: el tuyo. En mayúsculas.", "Y mi hermana ya lo sabe. Ella está en control de la ira. Yo no. Ojo."]], "en": [["It’s Don Luis. I read your letter and it gave me a 500 error right in the balls.", "Not even God could compile that. It’s rubbish with a stamp on, and rubbish costs extra here, like “no onion”.", "There’s a special durum reserved for you. Like last time: the bogey, the piss and the other thing, all in one pitta."], ["Look, I may be fat, rude and a bit of a joker. But you write that stuff by hand, with a stamp: you’re a born dickhead.", "I’ve put you on the kebab blacklist. It’s a text file with one name on it: yours. In capitals.", "And my sister knows already. She’s in anger management. I’m not. Watch it."]]},
	"carta_bien_repartidor": {"es": [["«[Inserte aquí un saludo en árabe]».", "«Carta recibida. Habibi… sello… gracias… y hasta aquí llega mi árabe. Pero se le nota contento»."], ["«Traducción automática: el repartidor le agradece su carta y le invita a un té. O a un durum. No se ha podido determinar».", "«Te has quedado sin tokens para esta emoción»."]], "en": [["“[Insert a greeting in Arabic here]”", "“Letter received. Habibi… stamp… thank you… and that is all my Arabic. But he sounds happy.”"], ["“Automatic translation: the delivery man thanks you for your letter and invites you for a tea. Or a durum. Could not be determined.”", "“You have run out of tokens for this emotion.”"]]},
	"carta_mal_repartidor": {"es": [["«[Aquí iba un insulto en árabe. De los gordos]».", "«Error 404: perdón no encontrado»."], ["«Lo siento, no sé árabe. Pero pa esto no me hace falta: me cago en tus muertos».", "«Mensaje traducido del manchego. El repartidor ha aprendido manchego solo pa decirte esto»."]], "en": [["“[An insult in Arabic was meant to go here. A big one]”", "“Error 404: forgiveness not found.”"], ["“Sorry, I don’t know Arabic. But I don’t need it for this: curse your dead.”", "“Message translated from Manchego. The delivery man learnt Manchego just to tell you this.”"]]},
	"carta_bien_paca": {"es": [["¿Sí? Soy yo, tu tía. ¿Quién va a ser? A estas horas solo llamo yo y los de las ofertas.", "Me ha llegao tu carta. La'é leío tres veces: una con las gafas y dos sin, y sin gafas me ha gustao más.", "Enga, no te lo creas mucho. Pero te has ganao un cacho del jamón de la herencia. De la punta, que es lo que hay."], ["¡Criatura! ¿Tú qué te creías, que una no tiene corazón? Pos tengo, aunque sea de segunda mano.", "Lo que me has escrito se lé enseñao a la Josefa. Ha llorao. Llora con tó, pero esta vez ha llorao más.", "Y cuelgo, que esto gasta y me estoy poniendo tonta. ¡Bacín!"]], "en": [["Hello? It’s me, your Aunt Paca. Who else? At this hour it’s only me and them telesales lot.", "Your letter turned up. Read it three times: once with me specs, twice without—liked it better without, honestly.", "Enga, don’t let it go to your head. Earned yourself a slice of the inheritance ham though. Just the heel end, mind."], ["Bless your cotton socks! Reckoned your old aunt had no heart? Got one, even if it’s second-hand.", "Showed your letter to Josefa. Proper blubbed, she did—cries at a damp tea towel anyway, cried double today though.", "Hanging up now, meter’s ticking and I’m going soft. Little rascal!"]]},
	"carta_mal_paca": {"es": [["¿Así se le escribe a una tía, so {desgraciao|desgraciá}? ¿Pa eso te enseñaron a escribir?", "La carta esa la'é echao al brasero y ni ha prendío: hasta la lumbre le tiene asco.", "De la herencia, ni el hueso del jamón. Igualico que tu padre: él también tenía la boca como una espuerta."], ["¿Se me oye? Pos óyeme bien, que no lo vía repetir.", "Los de Correa me han dao tu carta con una cara… Ya la habían leío, seguro. ¡Qué vergüenza, por Dios!", "Con la de pañales que te he cambiao yo. Tenía que haberte dejao con el culo cagao, que es lo que te mereces."]], "en": [["Is that how you write to your own aunt, you little {wretch|baggage}? Paid for schooling for that, did we?", "Chucked your letter straight onto the brazier and wouldn’t even catch—even the coals turned their nose up.", "Out the will, not even the ham bone for you. Spit of your dad—gob like a coal scuttle he had too."], ["Hear me alright? Listen good then, ’cause I ain’t saying it twice.", "Correa postie handed over your letter with such a face… Already steamed it open, I’ll wager. Showed us clean up!", "All them nappies I changed on you. Ought to have left you mucky, serves you dead right."]]},
	"carta_bien_loli": {"es": [["¿Sí? Soy la Loli, la de la Cooperativa. Sí, la del aceite. No hay otra Loli: las demás son de imitación.", "Me ha llegao tu carta. Mu bonita. La tengo pinchá en el corcho, al lao de los albaranes.", "Ya le diré a la Paca que no tiés tanta cara de decepción. Un poco sí, pero menos."], ["Oye, que soy yo, la Loli. Te llamo desde la nave, que con la prensa en marcha no me oye nadie.", "Lo de tu carta… Pos mira, me has dejao más blanda que una aceituna en salmuera.", "Pásate y te aparto una botella del bueno. Del bueno de verdad, del que no le doy ni al Eusebio."]], "en": [["Hello? It’s Loli, from the Cooperativa. Yes, the oil one. There’s no other Loli: the rest are knock-offs.", "Your letter came. Very nice. I’ve pinned it on the cork board, next to the delivery notes.", "I’ll tell Paca you don’t look that disappointed after all. A bit, yes, but less."], ["Oi, it’s me, Loli. I’m calling from the shed, nobody can hear me with the press running.", "About your letter… Well, you’ve left me softer than an olive in brine.", "Come by and I’ll put aside a bottle of the good stuff. The really good stuff, the one I don’t even give Eusebio."]]},
	"carta_mal_loli": {"es": [["¿{El sobrino|La sobrina} de la Paca? Pos que sepas que con la carta esa he limpiao el palé.", "Escribirme eso a mí tú, que no sabes llevar seis botellas sin estrellar la mitad.", "Desde hoy, a ti ni aceite de freír. Las tostás te las untas con babas, que de eso vas {sobrao|sobrá}."], ["Loli al aparato. No cuelgues, que esto te lo digo a la cara, aunque sea por teléfono.", "Aquí prensamos la aceituna hasta que confiesa. A ti te prensaba yo hasta que te saliera el alma, si es que tiés.", "Y la Paca ya lo sabe: se la'é leío en voz alta en la báscula, delante de tos los socios. Se han reío hasta los tractores."]], "en": [["Paca’s {nephew|niece}? Well, you should know I wiped the pallet down with that letter of yours.", "Writing me that, you, who can’t carry six bottles without smashing half of them.", "From today you don’t get so much as frying oil. Grease your toast with spit, you’ve plenty of that."], ["Loli speaking. Don’t hang up, I’m saying this to your face, even if it’s down the phone.", "Here we press the olives until they confess. I’d press you until your soul came out, if you’ve got one.", "And Paca knows: I read it to her out loud on the weighbridge, in front of all the members. Even the tractors laughed."]]},
	"carta_bien_eusebio": {"es": [["¿Sí? Soy el Eusebio, el del kiosco. Te llamo del teléfono del bar, que pa mí es gratis y pa los clientes, caro.", "Me ha llegao tu carta. La tengo detrás de la barra, al lao del calendario. Ese honor no lo tiene ni la foto de mi suegra.", "Me he emocionao. Poco, que estoy de turno."], ["Primo, que soy yo. Bueno, primo dice la Paca; yo no lé comprobao, pero por si acaso.", "Lo de tu carta… Te daba un abrazo, pero he visto cómo aparcas.", "Pásate y te pongo una tostá con aceite de la Loli. Invita la casa. Bueno, la casa invita a la mitad."]], "en": [["Hello? It’s Eusebio, from the kiosk. I’m on the bar phone: free for me, dear for the customers.", "Your letter came. It’s behind the bar, next to the calendar. Not even my mother-in-law’s photo gets that honour.", "I was moved. A little. I’m on shift."], ["Cousin, it’s me. Well, Paca says cousin; I haven’t checked, but just in case.", "About your letter… I’d give you a hug, but I’ve seen how you park.", "Come by and I’ll do you a tostada with Loli’s oil. On the house. Well, half on the house."]]},
	"carta_mal_eusebio": {"es": [["Eusebio, del kiosco. Te llamo pa decirte que tu carta está en el váter del bar, pinchá en el clavo del papel.", "Ha durao menos que una tostá en el almuerzo: los clientes la han ido gastando a gusto.", "Por aquí no vuelvas. Si pides algo, te lo pongo con MANTEQUILLA y aviso a los Tricornios."], ["¿Eres tú? Claro que eres tú: la carta esa olía a cobarde desde el sobre.", "Ni primo ni ná. Pa mí ya eres de fuera. De los que piden el café con leche de avena.", "Y los del almuerzo ya lo saben. Una vez se comieron una silla. Contigo no van a ser tan finos."]], "en": [["Eusebio, the kiosk. I’m ringing to tell you your letter is in the bar’s toilet, on the paper nail.", "It lasted less than a tostada at breakfast: the customers have been using it up with relish.", "Don’t come back round here. If you order anything, I’ll serve it with BUTTER and call the Tricornios."], ["Is that you? Course it’s you: that letter stank of coward right through the envelope.", "Cousin nothing. To me you’re an outsider now. One of those who order coffee with oat milk.", "And the breakfast lot already know. They ate a chair once. They won’t be so dainty with you."]]},
	"carta_bien_anselmo": {"es": [["¿Sí? Al habla Don Anselmo. No, no se ha muerto nadie. Hoy no. Te llamo por tu carta.", "Mu bonita, {hijo|hija}. La'é leío en la sacristía con un vinito de misa. Del bueno, que lo merecía.", "Dios te lo pagará. Yo no, que ando mu justo."], ["{Hijo|Hija}, que soy el cura. Me han traío tu carta los de Correa, y se santiguaban en la puerta por la costumbre.", "Cuarenta años de cura, y es la primera carta que me llega que no es pa pedirme rebaja en un entierro.", "Te apunto en la lista de los que no me deben dinero. Es una lista corta: estás tú solo."]], "en": [["Hello? Don Anselmo speaking. No, nobody’s died. Not today. I’m calling about your letter.", "Very nice, my child. I read it in the sacristy with a drop of altar wine. The good one: it deserved it.", "God will repay you. I won’t, I’m a bit short."], ["My child, it’s the priest. The Correa lot brought me your letter, and crossed themselves at the door out of habit.", "Forty years a priest, and it’s the first letter I’ve had that isn’t asking for a discount on a funeral.", "I’m putting you on the list of people who don’t owe me money. It’s a short list: just you."]]},
	"carta_mal_anselmo": {"es": [["Ave María Purísima. ¿No contestas? Ya, ya sé que lo tuyo no es «sin pecado concebida».", "He leío tu carta. Cuarenta años confesando a medio pueblo, borrachos de la feria incluidos, y no había oío tanta guarrería junta.", "Te perdono, que es mi oficio. Pero el día que te entierre, misa corta, en latín y sin pastas. Que se fastidie la Maruja también."], ["Soy Don Anselmo. Sí, el que te va a enterrar a ti también. Pa que lo vayas pensando.", "La carta esa la'é rociao con agua bendita, a ver si se le iba el demonio. Ha echao humo.", "Dios lo ve tó. Lo tuyo también lo ha visto, y me ha dicho que eres {un cabrón|una cabrona}. Con esas palabras, {hijo|hija}."]], "en": [["Ave María Purísima. No answer? No, I know: “conceived without sin” isn’t your line.", "I’ve read your letter. Forty years confessing half the town, the fair’s drunks included, and never so much filth at once.", "I forgive you, it’s my job. But the day I bury you: short Mass, in Latin, no pastries. Maruja can lump it too."], ["It’s Don Anselmo. Yes, the one who’ll be burying you too. Just so you start thinking about it.", "I sprinkled that letter with holy water, to see if the devil would come out. It smoked.", "God sees everything. He’s seen yours too, and He told me you’re a {bastard|bitch}. His very words, my child."]]},
	"carta_bien_ramirez": {"es": [["Aquí el teniente Torrezón. Le llamo a efectos de notificación, {ciudadano|ciudadana}.", "Su carta: recibida, leída y archivada en la carpeta de cosas buenas, que estaba vacía desde el ochenta y siete.", "Queda usted fuera de mi lista. De momento. Va por orden alfabético y la repaso tos los días."], ["Torrezón al habla. Cambio. Bueno, esto es un teléfono, no hace falta decir cambio. Cambio.", "Su carta me ha llegao al alma, {ciudadano|ciudadana}. Y eso que el alma la llevo en la guantera, con el reglamento.", "Si alguna vez le paran los Tricornios, diga que va de mi parte. No sirve de ná, pero les doy pena."]], "en": [["Lieutenant Torrezón here. I am calling you for the purposes of notification, citizen.", "Your letter: received, read and filed in the folder of good things, which had been empty since eighty-seven.", "You are off my list. For now. It’s alphabetical and I go through it every day."], ["Torrezón speaking. Over. Well, it’s a telephone, no need to say over. Over.", "Your letter reached my soul, citizen. And I keep my soul in the glovebox, with the rulebook.", "If the Tricornios ever pull you over, say I sent you. It does no good, but they feel sorry for me."]]},
	"carta_mal_ramirez": {"es": [["No cuelgue, {ciudadano|ciudadana}. Colgarle a la autoridad es desacato, aunque la autoridad esté jubilá.", "He recibío su carta. L'é levantao acta. Tres folios. Por las dos caras.", "Queda usted en mi lista. Por su apellido no le tocaba ni de los primeros, pero l'é puesto el primero. A boli rojo."], ["¿{El ciudadano|La ciudadana} de la carta? No hace falta que se identifique: su letra ya la tengo en una ficha.", "Treinta años en el cuerpo y nadie me había llamao eso por escrito. A la cara sí, pero desde lejos y corriendo.", "Le vía vigilar de día, de noche y en mis días libres, que desde que me jubilé son tos. Pórtese bien, so {mamón|mamona}."]], "en": [["Don’t hang up, citizen. Hanging up on the authorities is contempt, even when the authorities are retired.", "I have received your letter. I have filed a report on it. Three pages. Both sides.", "You’re on my list. Your surname wasn’t anywhere near the top, but I’ve put you first. In red biro."], ["The citizen with the letter? No need to identify yourself: I’ve got your handwriting on a file card.", "Thirty years in the force and nobody had called me that in writing. To my face, yes, but from a distance and running.", "I’ll watch you by day, by night and on my days off, which since I retired is all of them. Behave, you little shit."]]},
	"carta_bien_maruja": {"es": [["¿Sí? ¿Eres tú? Soy la Maruja. Me ha llegao tu carta y ya la tengo archivá. En la carpeta buena, la fina.", "Se la'é enseñao a tu madre. Bueno, por teléfono. Bueno, se la'é leío entera. Bueno, y a la panadera.", "Ya ves: dos días con la carta y medio pueblo sabe lo {majo|maja} que eres. Eso es un servicio, no un cotilleo."], ["Macho, qué carta. No leía yo una así desde la que le mandó a la panadera el segundo marido. Desde Cuenca.", "Un día que tengas tiempo me llevas a un velatorio, que tú conduces como un ángel y yo te hago compañía.", "Y cuando me muera, a mi entierro vienes tú el primero. Ya l'é dicho al Venancio que te guarde sitio."]], "en": [["Hello? That you, {love|pet}? It’s Maruja. Letter turned up—straight in me best ring binder, the posh plastic sleeve.", "Showed your mum too. Over the phone anyway—read her the whole thing. Plus the baker popped in.", "See? Two days and half the parish knows what a {grand lad|lovely lass} you are. Public service, not gossip."], ["Blimey, what a letter! Haven’t read one like it since the baker’s second husband wrote from Cuenca.", "Spare afternoon sometime, run us down to a wake—drive like an angel you do, I’ll keep you nattering.", "When I pop me clogs, you get front pew at me service. Told Venancio to stick a reserved card out."]]},
	"carta_mal_maruja": {"es": [["Soy la Maruja. No, no cuelgues. Yo no cotilleo, yo archivo, y tu carta ya está archivá, ya lo creo.", "La han leío tu madre, la panadera, el Venancio y medio velatorio de esta mañana. Lo más suave que han dicho de ti es «sinvergüenza».", "Cuando te mueras vía tu velatorio. A comerme las pastas y a contar lo de la carta delante de la caja."], ["¿Tú quién te crees que eres pa escribirme eso, macho? No sabes con quién te juegas los cuartos.", "Sé cosas de tus padres que no sabe ni el cura: la fecha de la boda y la de tu bautizo. Echa la cuenta, {tempranillo|tempranilla}.", "Y esto no es una amenaza, {hermoso|hermosa}. Es un archivo. Enga, que te vaya bonito."]], "en": [["Maruja speaking. No, don’t you dare ring off. I don’t gossip, I file—and yours is filed proper, mark me words.", "Your mum’s read it, baker’s read it, Venancio and half this morning’s wake. Politest word anyone used was ‘bare-faced’.", "When it’s your turn, I’m front row at your wake—tucking into the shortbread and reading that letter aloud by the coffin."], ["Who d’you reckon you are scribbling that to me? Messing with the wrong woman, {lad|lass}.", "Know dirt on your folks not even the vicar knows: wedding date and christening date. Do your own sums, {early bird|sharp miss}.", "Ain’t a threat, {sweetheart|pet}—just me filing cabinet. Ta-ra, have a lovely week."]]},
	"carta_bien_dolores": {"es": [["¿Sí? Soy la Dolores, la de la calle de la Amargura. Ya, ya lo sé. No me lo recuerdes.", "Me ha llegao tu carta, {hijo|hija}. Es lo primero bonito que entra en esta calle desde que le pusieron el nombre.", "El cartero de Correa ha subío silbando. ¡Por la Amargura! ¡Silbando! Jesús amante, qué cosas se ven."], ["{Hijo|Hija}, ¿me oyes? Te llamo pa darte las gracias, que una es de las de antes.", "Tu carta la'é puesto en la ventana, de cara a la calle, a ver si la Amargura se anima un poco. Velay que sí.", "Y vía llamar a mi hermana, la de la Paz, pa contárselo. Por su santo no la llamo, pero por esto sí. Que rabie."]], "en": [["Hello? Dolores ’ere, down Bitterness Street. Aye, aye, don’t rub it in.", "Got your letter, {lad|love}. First cheerful thing ever walked up this lane since they christened it.", "Correa postie strolled up whistling! Down Bitterness Street! Whistling! Lord above, wonders never cease."], ["{Lad|Love}, you there? Ringing just to say ta—old-fashioned manners, I was raised proper.", "Propped your letter up in the front window facing the cobbles to perk the street up. Might just work.", "Gonna bell me sister over on Peace Street and brag an’ all. Won’t ring on her saint’s day, I’ll ring for this though. Let her stew."]]},
	"carta_mal_dolores": {"es": [["¿Tú {eres el que|eres la que} me ha escrito la carta esa? ¡Jesús amante! ¡Como si no tuviera una bastante con vivir en la Amargura!", "Ahora sí que le pega el nombre a mi calle. Ya l'é dicho al alcalde que la deje como está, y que te ponga a ti en la placa.", "¡Ñaque eres {malo|mala}, {hijo|hija}! Tiés más mala uva que el que le puso el nombre a esta calle."], ["Escúchame bien, que no te llamo pa quejarme de la calle, fíjate lo que te digo. Te llamo pa quejarme de ti.", "Cuarenta años en la Amargura y ná me había amargao tanto como tu carta, so sinvergüenza.", "Ni un geranio queda en flor. Los gatos se han mudao a la calle de la Paz, ¡a cá mi hermana! ¿Estás {contento|contenta}?"]], "en": [["Was it you scribbled that wretched note? Lord preserve us—as if living down Bitterness wasn’t grief enough!", "Least the street name fits proper now! Told the mayor leave it be and bolt your mug on the street sign.", "Nasty piece of work you are, {lad|lass}! Sourer than whoever named this blinking road."], ["Now listen ’ere—not ringing to bellyache about the street for once. Ringing about you.", "Forty years down Bitterness and nowt’s soured me stomach worse than your letter, cheeky thing.", "Every geranium’s dropped dead. Alley cats’ve packed up and shifted to Peace Street at me sister’s! Chuffed now, are you?"]]},
	"carta_bien_venancio": {"es": [["¿Sí? Venancio, de la funeraria. {Tranquilo|Tranquila}, que no es pa darte el pésame. Toavía no.", "Me ha llegao tu carta. Mu bonita. La'é guardao en el cajón de las esquelas, que es ande guardo lo que más quiero.", "Te mando otra tarjeta, con descuento. Pa ti o pa quien quieras, que yo no pregunto."], ["Aquí el Venancio. Te llamo desde el tanatorio, que hay un silencio que se oye tó mu bien.", "Lo de tu carta me ha tocao. Y a mí no me toca ná, que trabajo con fiambres.", "Ya tengo tu medida: mediana. Por la carta, te pongo el forro bueno, el de raso. Sin prisa, ¿eh? Sin prisa."]], "en": [["Hello? Venancio, from the funeral parlour. Don’t worry, it’s not to offer my condolences. Not yet.", "Your letter came. Very nice. I’ve put it in the obituaries drawer, where I keep what I love most.", "I’m sending you another card, with a discount. For you or whoever you like. I don’t ask."], ["Venancio here. I’m calling from the funeral home: it’s so quiet you can hear everything.", "Your letter touched me. And nothing touches me: I work with cold cuts.", "I’ve got your size: medium. For that letter, you get the good lining, the satin. No rush, eh? No rush."]]},
	"carta_mal_venancio": {"es": [["Buenas, aquí la funeraria. Te llamo pa tomarte medidas. Por teléfono, que en persona me das asco.", "Tu carta se la'é leío a los de la cámara. Ni ellos se han quedao tan fríos.", "Ya tiés la caja elegía: de pino, sin barnizar y una talla menos, pa que vayas {apretao|apretá}. {Apretaíto|Apretaíta}."], ["¿Eres tú? Qué pena. Esperaba que fuera tu familia, pa darme la noticia.", "Por esa carta, tu entierro te lo cobro doble. Y la tarjeta que te di ya no vale de cupón. Ni de ná.", "Y no corras con el coche. Bueno, sí: corre. Corre mucho, que este mes voy flojo."]], "en": [["Good day, funeral parlour here. I’m calling to take your measurements. By phone: in person you turn my stomach.", "I read your letter to the ones in the cold room. Not even they went that cold.", "Your box is chosen: plain pine, no varnish, one size down so you go in snug. Nice and snug."], ["Is that you? Shame. I was hoping it was your family, ringing with the news.", "For that letter I’ll charge you double for your funeral. And that card I gave you isn’t a coupon any more. Or anything.", "And don’t drive fast. Actually, do: drive very fast, business is slow this month."]]},
	"carta_bien_genaro": {"es": [["¿Sí? ¿Me se oye? Soy el Gerardo, el del molino. Te llamo del fijo, que el móvil ese no hay quien lo arranque. Es peor que el tractor.", "Me ha llegao tu carta. La'é leío arriba, en el molino, con las aspas paradas pa que no se volara. Avel que me ha gustao.", "El tractor, cuando quieras. Y si quieres te enseño a moler, que es mu fácil: se espera al aire, y se espera al aire."], ["¡Adius, que eres tú! El Gerardo. Escucha, que esto lo digo una vez y aluego me da vergüenza.", "Lo de tu carta me ha llegao al chiribizo. Desde el ivierno del cincuenta y nueve no me escribía naide ná que no fuera de Hacienda.", "Lo viejo que funciona no se toca. Pero tú escribe de vez en cuando, que eso no rompe ná. Vis con Dios."]], "en": [["Hello? Can you hear me? It’s Gerardo, from the windmill. I’m on the landline, nobody can start that mobile. It’s worse than the tractor.", "Your letter came. I read it up in the mill with the sails stopped, so it wouldn’t blow away. Course I liked it.", "The tractor’s yours whenever. And I’ll teach you to mill if you like, it’s easy: you wait for the wind, and you wait for the wind."], ["Adius, it’s you! Gerardo here. Listen, I’ll say this once and then I’ll go all bashful.", "Your letter went straight to my belly. Since the winter of fifty-nine nobody’s written me a thing that wasn’t from the taxman.", "You don’t touch old things that work. But you write now and then, that breaks nothing. Go with God."]]},
	"carta_mal_genaro": {"es": [["El Gerardo. Tu carta la'é echao a las aspas, y ha salío en confeti pa Consuela, Temblerete y Tolejos. Ya la está leyendo media Mancha.", "Al molino ya le quiso pegar uno de fuera, con lanza y tó. Tú me pegas por carta, que es de cobardes: él por lo menos venía a caballo.", "El tractor, ni tocarlo. Y como te vea por los molinos, te muelo, que pa eso tengo piedra."], ["Óyeme bien, {zanguango|zanguanga}, que a mi edad no se repite ná.", "Tengo leíos tos los almenaques desde el año cuarenta, y tu carta es lo más tonto que me ha llegao.", "El aire es gratis, ¿sabes? Pos tú ni eso. Tú eres aire, sí, pero del que sale por detrás."]], "en": [["Gerardo. I fed your letter to the sails and it came out as confetti over Consuela, Temblerete and Tolejos. Half La Mancha’s reading it.", "A gentleman from out of town once went for my windmill, lance and all. You go for me by letter, the coward’s way: at least he came on horseback.", "Don’t you touch the tractor. And if I see you up by the mills, I’ll grind you: that’s what the millstone’s for."], ["Hear me good, you lazy lump, at my age nothing gets said twice.", "I’ve read every almanac since nineteen forty, and your letter’s the stupidest thing I’ve ever had.", "The wind is free, you know? Well, you’re not even that. You’re wind, all right: the kind that comes out the back."]]},
	"carta_bien_kevin": {"es": [["¿Sí? Soy Kevin-José. Con guion. Te llamo del teléfono de mi abuelo, que no se ha enterao.", "Tu carta la tengo notariá: l'é puesto un sello con una chapa de cerveza. Ahora vale el doble.", "Mi abuelo l'á leío y dice que ahora valgo casi lo que el azafrán. Casi. Lé apuntao."], ["Hola, soy yo, Kevin-José. Estoy sin vigilar, así que puedo hablar lo que quiera.", "Nadie me había escrito nunca una carta. Bueno, una vez el Ayuntamiento, pero era pa mi padre y era una multa.", "Cuando sea notario, tu testamento te lo hago gratis. Bueno, a mitad de precio. Bueno, ya hablaremos."]], "en": [["Hello? Kevin-José speaking—don’t forget the hyphen. Nicked grandad’s phone while he’s snoozing.", "Proper notarised your letter too: whacked a beer-cap stamp on it. Worth double now.", "Grandad read it and reckons I’m nearly worth as much as the saffron now. Nearly. Got that logged."], ["Alright, Kevin-José ’ere. Unsupervised right now so I can natter away.", "Nobody’s ever written me an actual letter. Well, council once, turned out to be me dad’s parking ticket.", "Once I qualify as a solicitor I’ll draft your will free. Alright, half price. Look, we’ll haggle."]]},
	"carta_mal_kevin": {"es": [["L'é enseñao tu carta a mi abuelo y ha dicho una palabra que no me deja decir. Soy Kevin-José, por cierto.", "Te la digo igual, que estoy sin vigilar: que eres {un hijo|una hija} de la gran puta. No sé qué es la gran puta, pero será mu grande.", "Y cuando sea notario, en tu testamento pongo que me lo dejas tó a mí. Es legal si lo escribo yo."], ["Aquí Kevin-José, con guion. Te llamo pa notificarte, que lé visto en la tele de los juicios.", "Mi abuelo ha pesao tu carta: vale menos que el azafrán, menos que yo y menos que una cagarruta de cabra. Dos veces la ha pesao.", "Así que te denuncio. Y cuando te mueras voy al entierro, a ganar, como los notarios."]], "en": [["Showed your letter to me grandad and he swore something I ain’t allowed to repeat. Kevin-José speaking, by the way.", "Gonna tell you anyway ’cause nobody’s listening: proper right {son|daughter} of a total bitch. Dunno how big a total bitch is, sounds massive.", "Wait till I’m a notary—rewriting your will so I pocket the lot. Totally legal if I write it."], ["Kevin-José ’ere, hyphen intact. Calling to serve official notice—saw it on Judge Rinder.", "Grandad weighed your letter: worth less than saffron, less than me, less than dried goat droppings. Double-checked on the scales.", "So I’m suing your socks off. Turning up to your funeral too—collect the fee, same as proper notaries."]]},
	"carta_bien_feliciano": {"es": [["¿Sí? Soy Feliciano. Me ha llegao tu carta.", "¡Qué bonica! La'é leío tres veces. Casi tantas como cuento los días pa'l jueves."],
			["Feliciano al aparato. Tu carta me ha alegrao la semana, que no es fácil, que el jueves queda lejos.", "Si un jueves quieres, te guardo un cachico de jamón. Un cachico, ¿eh? No te emociones."]],
		"en": [["Hello? It's Feliciano. Your letter came.", "How lovely! I've read it three times. Nearly as many times as I count the days to Thursday."],
			["Feliciano speaking. Your letter has made my week, which isn't easy, with Thursday so far off.", "If you like, one Thursday I'll keep you a bit of ham. A bit, mind. Don't get excited."]]},
	"carta_mal_feliciano": {"es": [["Soy Feliciano. Tu carta… Mira, no me ha sentao bien.", "Hasta el jueves no te hablo. Y el jueves tampoco, que estoy ocupao con el jamón."],
			["¿Tú me escribes eso a mí? ¿A mí?", "Me has amargao más que la campana de las monjas a las tres de la mañana."]],
		"en": [["It's Feliciano. Your letter… Look, it didn't go down well.", "I'm not speaking to you until Thursday. Or on Thursday, I'm busy with the ham."],
			["You write that to me? To me?", "You've soured me more than the nuns' bell at three in the morning."]]},
	"carta_bien_nino_negro": {"es": [["¿Sí? Soy yo, el de la valla del parque. Te llamo del teléfono de mi abuela, que tiene los números gordos.", "Tu carta me ha gustao más que un bocadillo de panceta. Bueno, igual. Bueno, casi.", "Se la'é enseñao a mi madre, pa que vea que hay gente que no me llama gordo. Que estoy hermoso."], ["¡Ey! Soy yo. Voy en la bici, hablando con una mano. No te preocupes, que con la otra tampoco freno.", "Tu carta mola mucho. La llevo en la mochila de la piscina, con las salchipapas. Tiene un poco de kétchup, pero se lee.", "Si quieres, mañana te doy un bocadillo de tortilla, del día de antes. Le pego yo un bocao primero, pa ver si está bueno."]], "en": [["Hello? It’s me from by the park railings! Ringing off me nan’s mobile with the chunky buttons.", "Rated your letter even higher than a crispy bacon butty. Well, tie anyway. Dead close.", "Showed me mum too, proves folks reckon I’m well-built, not fat."], ["Oi, it’s me! Bombing along on me bike one-handed—don’t fret, never touch the brakes with me other hand either.", "Your letter’s proper sick. Stuffed it in me swim bag next to the salchipapas—got a dollop of ketchup on it, still reads alright.", "Tell you what, tomorrow I’ll bring you yesterday’s cold omelette butty. I’ll nick one bite first just to test it’s still banging."]]},
	"carta_mal_nino_negro": {"es": [["Tu carta no la entiendo, que tiés letra de médico, pero mi madre l'á leío y se ha reío. ¡Se ha reío!", "Seguro que pone que estoy gordo. ¡Que estoy hermoso! Lo dice mi abuela, que tiene una zapatilla pa ti y otra pa mi madre.", "Con tu carta me limpié la crema de cacao de los dedos, y luego la tiré a la piscina y le meé encima. Ahí la tiés."], ["¡Oye! Que soy yo. Te llamo pa decirte que eres {más tonto|más tonta} que un bocadillo de chopped sin tomate. Y eso es mu triste.", "En mi bici ya no te subes. Tiene dieciocho cambios y ninguno es pa ti.", "Y si te veo en la piscina, me tiro de bomba encima y te ahogo un poco. Tú sí que estás {gordo|gorda}, y no {hermoso|hermosa} como yo."]], "en": [["Can’t read half your scrawl—writes worse than the GP—still me mum read it out and burst out laughing. Laughed right out loud!", "Bet it bangs on about me being fat! I’m bonny! Me nan says so, and she’s got one slipper lined up for you and one for me mum.", "Wiped chocolate spread off me fingers on your letter, chucked it in the deep end and had a wee on it. Sorted."], ["Oi, it’s me! Belled to let you know you’re thicker than a dry chopped-pork sarnie without tomato. Proper sad, that.", "Banned off me mountain bike for life—eighteen gears and zero of ’em for you.", "Spot you down the pool, I’m doing a massive cannonball straight onto your bonce and dunking you a bit. You’re the chunky one, not bonny like me."]]},
	"food_buy_luis": {"es": "Un kebab con tó (%d €)", "en": "A kebab with everything (%d €)"},
	"food_buy_henry": {"es": "Un plato de lo que haya (%d €)", "en": "A plate of whatever there is (%d €)"},
	"food_buy_no_luis": {"es": "Un kebab con tó (%d €; no te llega: tiés %d €)", "en": "A kebab with everything (%d €; you can’t: you have %d €)"},
	"food_buy_no_henry": {"es": "Un plato de lo que haya (%d €; no te llega: tiés %d €)", "en": "A plate of whatever there is (%d €; you can’t: you have %d €)"},
	"food_talk": {"es": "Ná, solo venía a hablar", "en": "Nothing, I only came for a chat"},
	"food_sold_luis": {"es": ["Ahí va. Mastica, que no es puré.", "Toma. Si repites hoy, te hago {socio|socia}.", "Marchando uno con tó. La servilleta va aparte, como el respeto.", "Cómetelo aquí, que por la calle se enfría y luego la culpa es mía."],
		"en": ["There y’are. Chew it, mate, it ain’t baby food.", "Grab it. Back again today and I’ll make you a member.", "One with the lot, comin’ up. Napkins cost extra, same as respect.", "Eat it in ’ere—goes cold in the street and then it’s on my head."]},
	"food_sold_henry": {"es": ["Recién hecho. Bueno, recién calentao.", "Ahí tiés. Casero, casero: lo ha hecho el de la casa de al lao.", "Toma, y rebaña, que el pan va en el precio."],
		"en": ["Fresh out the kitchen. Well, fresh out the microwave.", "Here y’are—proper home cookin’, bloke next door knocked it up.", "Grab it and mop the gravy up, bread’s chucked in."]},
	"t_eat": {"es": ["Pa dentro.", "Buen provecho.", "Con tó y sin miramientos.", "Ni las migas has dejao."], "en": ["Down the hatch.", "Enjoy.", "With everything, no second thoughts.", "Not a crumb left."]},
	"t_eat_3": {"es": "Tres veces has comío ya hoy. Una más y no te abrocha el pantalón.", "en": "Three meals already today. One more and those trousers won’t do up."},
	"t_fatter": {"es": "Cuatro comidas en un día: te has puesto más {hermoso|hermosa}. Una talla más de anchuras.", "en": "Four meals in a day: you’ve filled out. One size wider."},
	"t_faint": {"es": "Ya no te cabe más. Te se va la cabeza…", "en": "There’s no room for any more. Your head is swimming…"},
	"t_trip": {"es": ["¡Hostia!", "Ese cerquillo no estaba ahí.", "¡Ay, la Virgen!", "El suelo, que se mueve."], "en": ["Bloody hell!", "That kerb wasn’t there before.", "Mother of God!", "The ground keeps moving."]},
	"t_faint_car": {"es": "Así no estás pa conducir.", "en": "You’re in no state to drive."},
	"t_faint_salud": {"es": "Un empacho de los gordos. Te han recogío del suelo y te han traío al centro de salud. Ya estás {apañao|apañá}.", "en": "A proper bellyful. They picked you up off the ground and brought you to the health centre. You’ll live."},
	"t_faint_wake": {"es": "Un empacho de los gordos. Te han recogío del suelo y te han dejao en la puerta de casa.", "en": "A proper bellyful. They picked you up off the ground and left you at your own door."},
	"offer_accept": {"es": "Aceptar", "en": "Accept"},
	"offer_reject": {"es": "Rechazar", "en": "Turn it down"},
	"offer_si": {"es": "Sí", "en": "Yes"},
	"offer_no": {"es": "No", "en": "No"},
	"reject_paca": {"es": ["Anda que… Ni pa un recao sirves. Igualico que tu padre, que en paz descanse y bien descansao que está.", "Pos cuando te se pase la tontería, luego hablas conmigo. Yo de aquí no me muevo."],
		"en": ["Well, blimey… Can’t even trust you with one little job. Dead spit o’ your dad, God rest him—and rested he is.", "Once you’ve got over your sulk, come see me later. I ain’t budgin’."]},
	"reject_maruja": {"es": ["Mira {el señorito|la señorita}, que no puede. Luego bien que queréis que vaya una a vuestro entierro.", "Cuando te dé la gana, luego hablas conmigo. Si es que sigo viva, que con vecinos así…"],
		"en": ["Hark at {his lordship|her ladyship}, far too busy. Funny how you lot still want a soul showin’ up at your funeral.", "Whenever it suits you, come find me later—if I’m still breathin’, with neighbours like this…"]},
	"reject_alberto": {"es": ["Ya. Otro que mira pa otro lao. Así nos va: primero el puente, luego el pueblo, y tú tocándote los huevos.", "Si te entra la vergüenza, luego hablas conmigo. Aquí vía estar, que alguien tiene que estar."],
		"en": ["Right. Another bloke lookin’ the other way. First goes the bridge, then the town, while you sit scratchin’ yourself.", "If shame ever catches up, come see me later. I’ll be ’ere—somebody’s gotta."]},
	"reject_call_paca": {"es": ["¿Que no? ¡Mucho tendrás tú que hacer, so {gandul|gandula}! Con la de pañales que te he cambiao yo.", "Cuando te acuerdes de quién te ha dejao la casa, me llamas. O ya te llamaré yo, que soy tonta."],
		"en": ["No? Proper stacked out, are we, you lazy lump! After all them nappies I changed on you.", "Once you remember who left you that house, giz a bell. Or I’ll ring you—soft touch that I am."]},
	"reject": {"es": [["Pos vaya una mierda de {vecino|vecina} que nos ha tocao.", "Cuando cambies de idea, luego hablas conmigo."], ["¿Que no? Hay que joderse con la juventú.", "Anda, tira. Y luego hablas conmigo, si te da la gana."]],
		"en": [["Right useless neighbour we’ve been lumbered with.", "Change your mind, come chat later."], ["No? Young ’uns today, bloomin’ ’ell.", "Go on, sling your hook. Come find me later if you fancy."]]},
	"reject_call": {"es": [["¿Que no? Me cago en la leche, con el hambre que tengo. Así te se indigeste lo que comas.", "Si te lo piensas, me llamas. O ya te llamaré yo, qué remedio."], ["Mu bonito. Aquí [[uno|una]] muriéndose y tú con remilgos, so {desgraciao|desgraciá}.", "Ya hablaremos tú y yo. Llámame luego, si te queda vergüenza."]],
		"en": [["No? Bloody ’ell, and me starvin’. Hope your tea gives you heartburn.", "Think twice, give us a ring. Or I’ll bell you—what choice have I got?"], ["Lovely, that is. Starvin’ to death ’ere and you gettin’ precious, you rotter.", "You and I’ll have words. Ring back later, if you’ve a shred o’ shame left."]]},
	"offer_again": {"es": ["¿Qué? ¿Ya te se ha pasao la tontería? Pos lo dicho.", "Hombre, {el desaparecido|la desaparecida}. Lo mismo de antes: ¿sí o no?", "A ver si ahora sí. Ya sabes lo que hay."],
		"en": ["Well? Got over your sulk yet? Same offer stands.", "Look who crawled back. Same deal as afore: yes or no?", "Let’s see if it’s a yes this round. You know the score."]},
	"call_again": {"es": ["Soy yo otra vez. A ver si ahora te pillo de mejor humor: lo mismo que te dije, ¿lo haces o no?", "¿Qué? ¿Te lo has pensao mejor? Es lo de antes."],
		"en": ["Me again. Caught you in a sunnier mood, ’ave I? Same job—you in or out?", "Well? Slept on it? Same offer as earlier."]},
	"call_back": {"es": ["¿Ahora llamas? Bueno, bien está. Lo de antes: ¿lo haces o no?", "Mira quién se acuerda de [[uno|una]]. Venga, lo que te dije: ¿sí o no?"],
		"en": ["Ringin’ now, are we? Fair play then. Same deal—you doin’ it or not?", "Look who remembered I exist. Go on, what I said earlier: yes or no?"]},
	"call_late": {"es": ["Ya no hace falta, {hermoso|hermosa}: me he apañao con un bocadillo de mortadela. Otro jueves será.", "A buenas horas. Ya he comío, y sin ti. Otro día, si eso."],
		"en": ["Too late now, {lad|love}—made do with a mortadella sarnie. Next Thursday maybe.", "Bit late for that! Ate already, no thanks to you. Another day, reckon."]},
	"obj_declined": {"es": "Has dicho que no. Cuando cambies de idea, habla con %s.", "en": "You said no. When you change your mind, talk to %s."},
	"obj_call_declined": {"es": "Has dicho que no. %s volverá a llamar cuando acabes otra misión; o llama tú desde la Agenda (Vecinos).", "en": "You said no. %s will ring again when you finish another mission; or ring them yourself from the Agenda (Neighbours)."},
	"log_call_back": {"es": "Llamar a %s (le dijiste que no)", "en": "Ring %s (you told them no)"},
	"luis_title": {"es": "En el amor y en kebab", "en": "In Love and Kebab"},
	"n_repartidor": {"es": "El repartidor", "en": "The delivery man"},
	"luis_mision": {"es": ["Ven acá, que tengo un bug en el negocio. Soy el cuarto kebab que abre en este pueblo. ¡El cuarto! Y el pueblo no es tan grande.",
			"Kebab Deluxe, Tele Dürum, ShawarMadridejos… y yo. Aquí no hay estómagos pa tanto pan de pita.",
			"Necesito que vayas a los otros tres y les sabotees la comida. Un moco aquí, una meadica allá… Lo que te pida el cuerpo.",
			"No es ético, pero en el amor y en kebab tó vale."],
		"en": ["Come ’ere, mate—got a right bug in the business. I’m the fourth kebab joint to open in this town. Fourth! And it ain’t London.",
			"Kebab Deluxe, Tele Dürum, ShawarMadridejos… and me. Ain’t enough bellies in town for this much pitta.",
			"Need you to nip round the other three and spoil their stock. Bit o’ bogey ’ere, quick splash o’ piss there… whatever takes your fancy.",
			"Ain’t strictly kosher, mate, all’s fair in love and kebab though."]},
	"luis_go": {"es": ["Así me gusta. El camión del reparto, el que nos trae el género a los cuatro, acaba de irse de aquí ahora mismo.",
			"Va a los otros tres. Tú síguelo: ni mu cerca, que te ve, ni mu lejos, que lo pierdes.",
			"Cuando deje las cajas en la puerta y se vuelva pal camión, de espaldas, les haces el apaño. Tiés medio minuto. ¡Arreando!"],
		"en": ["Now you’re talkin’. Delivery lorry that feeds all four of us has just pulled off this second.",
			"Hittin’ the other three next. Tail it—not too tight or he’ll clock you, not too far or he drops you.",
			"Soon as he dumps the crates by the door and turns back to his cab, you work your magic. Half a minute tops. Enga, shift it!"]},
	"luis_go_again": {"es": ["El camión acaba de irse otra vez. Lo mismo de antes, pero con cabeza. ¡Tira!"], "en": ["Lorry’s just pulled off again. Same caper, use your loaf this time. Leg it!"]},
	"reject_luis": {"es": ["Mu bien. Tú a lo tuyo, que ya me arruino yo solo, so {desagradecío|desagradecía}. Con la cara de hambre que traes.", "Cuando te se pasen los escrúpulos, luego hablas conmigo. Yo de aquí no me muevo, que no quepo por la puerta."],
		"en": ["Sound. Mind your own then, let me go skint solo, you ungrateful git. Lookin’ hank marvin yourself an’ all.", "Once your morals pack up, come chat later. I ain’t goin’ nowhere—can’t squeeze through me own door."]},
	"luis_busy": {"es": ["¿Qué haces aquí? ¡El camión, alma de cántaro, el camión!"], "en": ["What you loiterin’ ’ere for? The lorry, you muppet—the lorry!"]},
	"luis_fail_call": {"es": ["¿Pero tú qué has hecho, criatura? Que me he enterao de tó.", "Vente pal restaurante, que lo vamos a intentar otra vez. Esto no puede quedar así."],
		"en": ["What on Earth did you play at? Heard the whole shambles.", "Pop back down the restaurant—we’re havin’ another crack. Can’t leave it like this."]},
	"luis_retry": {"es": ["Venga, otra vez. Lo mismo, pero bien."], "en": ["Enga, one more go. Same job, properly this time."]},
	"luis_done": {"es": ["¿Los tres? ¿El moco, la meada y… lo otro? Eres {un|una} artista.", "Toma, lo prometío: tus perras y un kebab de la casa. El próximo, pagando, claro."],
		"en": ["All three?! Bogey, piss and… the special? Proper artist, you are.", "Here y’are, deal’s a deal: your brass and a kebab on the house. Next ’un you’re payin’, mind."]},
	"luis_after": {"es": ["¿Te acuerdas del sabotaje? Pos no sirvió de ná.", "Nadie notó la diferencia de sabor. Es más: algunos dijeron que estaba mejor que otros días.", "No sé si reírme o llorar. De momento, cobro."],
		"en": ["Remember that sabotage job? Did bugger all, mate.", "Not one punter clocked the flavour. Worse—couple reckoned it tasted better’n usual.", "Dunno whether to laugh or blub. For now, I’ll pocket their cash."]},
	"arabe": {"es": ["«Lo siento, no sé árabe, esto es un texto de ejemplo».", "«Te has quedado sin tokens para esta traducción».", "«Cuscús, Marruecos… qué sé yo… ¿Paris-Saint Germain?».", "«[Inserte aquí una frase en árabe]».", "«Error 404: idioma no encontrado».", "«Habibi… shawarma… y hasta aquí llega mi árabe»."],
		"en": ["“Sorry, I don’t know Arabic, this is placeholder text.”", "“You have run out of tokens for this translation.”", "“Couscous, Morocco… how should I know… Paris-Saint Germain?”", "“[Insert a sentence in Arabic here]”", "“Error 404: language not found.”", "“Habibi… shawarma… and that is all my Arabic.”"]},
	"firma_si_repartidor": {"es": "«Firma no disponible en su idioma. Se firma igual».", "en": "“Signature not available in your language. Signed anyway.”"},
	"firma_no_repartidor": {"es": "«No se ha podido traducir “puente”. Inténtelo más tarde».", "en": "“Could not translate ‘bridge’. Try again later.”"},
	"obj_luis_follow": {"es": "Sigue al camión del reparto: ni mu cerca, que te ve, ni mu lejos, que lo pierdes.", "en": "Follow the delivery lorry: not too close, he’ll see you; not too far, you’ll lose it."},
	"obj_luis_wait": {"es": "%s. Espera a que deje las cajas y se vuelva pal camión, de espaldas.", "en": "%s. Wait for him to leave the boxes and turn back to the lorry."},
	"obj_luis_sab": {"es": "Ahora: a las cajas, antes de que arranque el camión.", "en": "Now: get to the boxes before the lorry sets off."},
	"obj_luis_back": {"es": "Los tres, apañaos. Vuelve al Kebab Luis a cobrar.", "en": "All three sorted. Back to Kebab Luis for your pay."},
	"obj_luis_retry": {"es": "Vuelve al Kebab Luis: Don Luis quiere intentarlo otra vez.", "en": "Back to Kebab Luis: Don Luis wants to try again."},
	"t_sab_follow": {"es": "¡Síguelo! Ni mu cerca ni mu lejos.", "en": "After it! Not too close, not too far."},
	"t_sab_car": {"es": "¡Corre, súbete a un coche, que se va!", "en": "Quick, get in a car, it’s leaving!"},
	"t_sab_close": {"es": "¡Mu cerca! Te va a ver por el retrovisor.", "en": "Too close! He’ll see you in the mirror."},
	"sab_susp": {"es": "SOSPECHA", "en": "SUSPICION"},
	"sab_murmurs": {
		"es": ["*hablando en árabe inventado*", "*hablando en árabe inventado*", "*murmurando en árabe inventado*", "*canturreando en árabe inventado*", "*hablando en árabe inventado*"],
		"en": ["*speaking made-up Arabic*", "*speaking made-up Arabic*", "*muttering in made-up Arabic*", "*humming in made-up Arabic*", "*speaking made-up Arabic*"]},
	"t_sab_far": {"es": "¡Que lo pierdes! Arrímate.", "en": "You’re losing it! Get closer."},
	"t_sab_stop": {"es": "%s. Quieto ahí, que baja.", "en": "%s. Stay put, he’s getting out."},
	"t_sab_moco": {"es": "Un moco en cada caja. Artesanía.", "en": "A bogey on each box. Craftsmanship."},
	"t_sab_meo": {"es": "Te has meao en las dos cajas. Con puntería.", "en": "You’ve pissed on both boxes. Good aim."},
	"t_sab_cago": {"es": "Te has cagao en las cajas. Que aproveche.", "en": "You’ve shat on the boxes. Bon appétit."},
	"t_sab_all": {"es": "Los tres kebabs, sabotiaos. A cobrar.", "en": "All three kebab houses spoilt. Go and get paid."},
	"t_sab_fail_close": {"es": "TE HA VISTO POR EL RETROVISOR.", "en": "HE SAW YOU IN THE MIRROR."},
	"t_sab_fail_lost": {"es": "LO HAS PERDÍO DE VISTA.", "en": "YOU’VE LOST SIGHT OF IT."},
	"t_sab_fail_caught": {"es": "TE HA PILLAO.", "en": "HE’S CAUGHT YOU."},
	"t_sab_fail_late": {"es": "EL CAMIÓN HA ARRANCAO Y LAS CAJAS, TAN LIMPIAS.", "en": "THE LORRY IS OFF AND THE BOXES ARE AS CLEAN AS EVER."},
	"p_sab_moco": {"es": "<interact> Moco", "en": "<interact> Bogey"},
	"p_sab_meo": {"es": "<interact> Mear", "en": "<interact> Piss"},
	"p_sab_cago": {"es": "<interact> Cagar", "en": "<interact> Shit"},
	"t_side_dropped_luis": {"es": "Lo primero es lo primero. Lo de Don Luis, pa otro rato.", "en": "First things first. Don Luis’s business can wait."},
	"t_luis_unlocked": {"es": "Don Luis ya está en tu Agenda.", "en": "Don Luis is in your Diary now."},
	"log_luis_open": {"es": "te la ofrece Don Luis, en su kebab", "en": "Don Luis offers it, at his kebab"},
	"josefa_menu_title": {"es": "El menú de la Josefa", "en": "Josefa’s Menu"},
	"josefa_menu": {"es": ["¿Recados? Mira qué bien. Pos el primero: te acercas a La Cocina de Henry, en la calle de la Palma, y me traes el menú. Hoy toca jamón asao.",
			"Y que no te lo dé frío, que ese es mu de calentar en el microondas y decir que es del día.",
			"Ah, y toma, llévate este bate. Tú llévatelo. Ya sabrás pa qué es, que en cada pueblo hay sus costumbres."],
		"en": ["Errands? How nice. The first, then: go round to La Cocina de Henry, on Calle de la Palma, and bring me the menu of the day. Today it’s roast ham.",
			"And don’t let him give it to you cold; that one is a great believer in the microwave and calling it fresh.",
			"Oh, and here, take this bat. Just take it. You’ll find out what it’s for: every town has its customs."]},
	"reject_josefa": {"es": ["¿Que no? Pos mu bonito, dejar a una viuda sin comer. Así te salgan los hijos como tú.", "Cuando te acuerdes de lo que es la educación, luego hablas conmigo."],
		"en": ["No? Lovely, leaving a widow without her dinner. May your children turn out like you.", "When you remember what manners are, talk to me later."]},
	"josefa_menu_done": {"es": ["¡Calentico! Así da gusto. Toma, pa ti, que no se diga.",
			"Hoy era un día especial, que si no. Pero lo normal es que los jueves sean el día del jamón asao, y tos los jueves se repite la misma cantinela.",
			"Pos ya conoces al Henry. Y en el pueblo hay restaurantes pa aburrir: hasta cuatro kebabs, fíjate tú. Yo no voy, que me repite.",
			"De momento no tengo más recados. Ya te avisaré, que yo me entero de tó."],
		"en": ["Nice and hot! That’s more like it. Here, for you, so nobody can say I didn’t.",
			"Today was a special day, mind. Normally Thursday is roast ham day, and every Thursday it’s the same old song.",
			"So now you know Henry. And this town has restaurants to spare: four kebab houses, imagine. I don’t go, it repeats on me.",
			"I’ve no more errands for now. I’ll let you know: I hear about everything."]},
	"josefa_no_more": {"es": ["De momento no tengo más recados. Ya te avisaré, que yo me entero de tó.", "Yo antes tenía un teléfono con rueda. Ese no se desconfiguraba. Ese te desconfiguraba el dedo."],
		"en": ["No more errands for now. I’ll let you know: I hear about everything.", "I used to have a phone with a dial. That one never lost its settings. It unsettled your finger."]},
	"obj_menu_fetch": {"es": "Ve a La Cocina de Henry a por el menú de la Josefa (hoy, jamón asao).", "en": "Go to La Cocina de Henry for Josefa’s menu (today, roast ham)."},
	"obj_menu_bring": {"es": "Llévale el jamón a %s antes de que se enfríe del tó.", "en": "Take the ham to %s before it goes stone cold."},
	"t_side_dropped_menu": {"es": "Lo primero es lo primero. El recado de la Josefa, pa otro rato.", "en": "First things first. Josefa’s errand can wait."},
	"log_josefa_open": {"es": "te la ofrece la Josefa, en su puerta", "en": "Josefa offers it, at her door"},
	"neg_informatica": {"es": "tiendas de informática (V.I.P.)", "en": "computer shops (V.I.P.)"},
	"neg_restaurantes": {"es": "restaurantes (La Cocina de Henry, Kebab Luis, Kebab Deluxe, Tele Dürum, ShawarMadridejos)", "en": "restaurants (La Cocina de Henry, Kebab Luis, Kebab Deluxe, Tele Dürum, ShawarMadridejos)"},
	"t_negocio": {"es": "Ya conoces: %s.", "en": "You now know: %s."},
	"log_negocios": {"es": "Negocios que conoces: %s", "en": "Businesses you know: %s"},
	"log_pc": {"es": "Puntos Cívicos: %d  ·  misión principal 5 · secundaria 3 · minijuego 1 (la primera victoria del día)", "en": "Puntos Cívicos: %d  ·  main mission 5 · side mission 3 · minigame 1 (first win of the day)"},
	"food_job": {"es": "«¿No tenías un recado pa mí?»", "en": "“Didn’t you have an errand for me?”"},
	"alberto_pc": {"es": ["Y ahora atiende, que esto es importante: en este pueblo los favores no se pagan solo con perras.",
			"Cada vez que le haces un apaño a alguien ganas Puntos Cívicos. P.C., pa los amigos. Con eso se pué transformar el pueblo: arreglar, abrir, salvar cosas.",
			"Por las firmas te tocan cinco, uno por cada una. Y otros cinco por las que he sacao yo, que te los regalo. Diez.",
			"De aquí en adelante: cinco por cada misión de las gordas, tres por los recados de los vecinos y uno por los juegos."],
		"en": ["Now listen, this matters: in this town favours aren’t only paid in money.",
			"Every time you do somebody a good turn you earn Puntos Cívicos. P.C., to its friends. With those you can change the town: mend things, open them, save them.",
			"For the signatures you get five, one each. And five more for the ones I collected, my treat. Ten.",
			"From now on: five for each of the big missions, three for the neighbours’ errands and one for the games."]},
	"alberto_pc_owed": {"es": "Y me han dicho que ya has hecho algún recado por ahí. Eso también cuenta: %d más.", "en": "And I hear you’ve already run an errand or two. That counts as well: %d more."},
	"alberto_pc_go": {"es": "¿Y sabes pa qué valen diez? Pa esto: arrímate al puente, dale al botón y lo desbloqueas. Se quita la valla del ayuntamiento, se pué cruzar andando y ya no hay quien lo tire.",
		"en": "And do you know what ten are good for? This: walk up to the bridge, press the button and you unlock it. The council’s fence comes down, you can walk across, and nobody can pull it down any more."},
	"obj_puente": {"es": "Arrímate al puente y gasta 10 P.C. en desbloquearlo.", "en": "Walk up to the bridge and spend 10 P.C. to unlock it."},
	"p_puente": {"es": "<interact> Desbloquear · %d P.C.", "en": "<interact> Unlock · %d P.C."},
	"p_cavernas": {"es": "<interact> Arreglar la sala · %d P.C.", "en": "<interact> Restore the hall · %d P.C."},
	"p_toros": {"es": "<interact> Arreglar la plaza de toros · %d P.C.", "en": "<interact> Restore the bullring · %d P.C."},
	"t_toros_open": {"es": "La plaza de toros vuelve a estar en pie, y con la puerta abierta.", "en": "The bullring stands again, and its door is open."},
	"t_cavernas_open": {"es": "La Sala Cavernas vuelve a abrir: de jueves a domingo, de once de la noche a seis de la mañana.", "en": "The Sala Cavernas opens again: Thursday to Sunday, eleven at night to six in the morning."},
	"t_puente_short": {"es": "Hacen falta %d P.C. y tiés %d.", "en": "It takes %d P.C. and you have %d."},
	"t_puente_open": {"es": "El puente es del pueblo: ya se pué cruzar, y ya no lo tira nadie.", "en": "The bridge belongs to the town: you can walk across, and nobody is pulling it down."},
	"mg_jamon": {"es": "Recoger el jamón asao", "en": "Fetching the Roast Ham"},
	"mg_jamon_unlock": {"es": "Hazle a la Josefa el recado del menú.", "en": "Run Josefa’s errand for the menu."},
	"henry_motin": {"es": ["¡A ver, a ver, a ver! Que sois demasiaos y esto no es un banco.",
			"Jamones hay los que hay. Y pa tos no hay.",
			"Así que habrá que hacer lo de siempre."],
		"en": ["Now then, now then! Far too many punters and this ain’t the Bank of England.",
			"Got as many hams as I’ve got, and there ain’t enough to go round.",
			"So we’ll settle it the usual way."]},
	"henry_motin_ya": {"es": "Ya sabéis cómo va: los que queden en pie tendrán jamón asao.", "en": "You know the drill—last folks standin’ get roast ham!"},
	"henry_motin_fin": {"es": ["¡Quietos, que se me enfría! Se acabó lo que se daba.",
			"Y tú, {el|la} del palo: qué manera de atizar. Te se tiene que dar de miedo coger aceituna."],
		"en": ["Pack it in, ham’s goin’ cold! Time’s up!",
			"As for you with the stick—proper swing on you, lad. Must be lethal come olive harvest."]},
	"motin_grita": {"es": ["¡El jamón!", "¡Que yo estaba antes!", "¡Henry, saca el jamón!", "¡A mí no me empujes!", "¡Jueves, jamón! ¡Jueves, jamón!", "¡Que tengo a la suegra en casa!"],
		"en": ["The ham!", "Oi, I were in the queue first!", "Henry, bring out the bloomin’ ham!", "Don’t you shove me!", "Thursday ham! Thursday ham!", "Got me mother-in-law stayin’ over!"]},
	"t_motin_down": {"es": ["¡Al suelo!", "¡Te han dao!", "¡Arriba, que no es ná!"], "en": ["Timber!", "Clipped you one!", "Up y’get, ’tis nowt!"]},
	"motin_hit": {"es": "Golpe", "en": "Hit"},
	"motin_help": {"es": "%s · Toca o mantén y suelta", "en": "%s · Tap or hold and release"},
	"motin_ready": {"es": "¡Bate listo! Suelta pa barrer.", "en": "Bat ready! Release to sweep."},
	"obj_motin": {"es": "¡Atiza! Los que queden en pie tendrán jamón. Llevas %d puntos.", "en": "Lay about you! Whoever is left standing gets ham. %d points so far."},
	"t_motin_score": {"es": "Jamón asao: %d puntos (%d golpes, %d al suelo).", "en": "Roast ham: %d points (%d blows, %d laid out)."},
	"henry_idle": {"es": ["Aquí tó es casero. La receta es de mi madre. El microondas, también.", "Los jueves, jamón asao. Los demás días, lo que haya sobrao del jueves."],
		"en": ["Every dish ’ere’s proper home-made—me mum’s recipe, me mum’s microwave.", "Thursdays, roast ham. Rest o’ the week, whatever’s left off Thursday."]},
	"ham_thanks": {"es": ["¡Ya era hora! A ver… Templao. Te lo perdono.", "Toma, pa ti la corteza. Que no se diga que no soy [[agradecío|agradecía]]."],
		"en": ["About blinkin’ time! Let’s see… Tepid. I’ll let you off.", "Here, have the cracklin’—nobody calls me ungrateful."]},
	"t_ham_loaded": {"es": "Jamón asao en la mano. A llevarlo.", "en": "Roast ham in hand. Off you go with it."},
	"t_ham_bonus": {"es": "+3 segundos", "en": "+3 seconds"},
	"t_ham_cold": {"es": "El jamón se ha enfriao. %s se ha hecho un bocadillo de ná.", "en": "The ham has gone cold. %s made do with a sandwich of nothing."},
	"t_side_dropped": {"es": "Lo primero es lo primero. El jamón, pa otro jueves.", "en": "First things first. The ham can wait for another Thursday."},
	"k_horn": {"es": "Claxon", "en": "Horn"},
	"t_garage_ask": {"es": "«Eso te lo apaño yo por %d €. Si quieres, pita.» <horn>", "en": "“I’ll patch that up for %d €. Sound the horn if you want it done.” <horn>"},
	"p_garage_in": {"es": "Mételo pa dentro, que en la puerta no te lo miro", "en": "Bring it inside — they don’t look at it in the doorway"},
	"p_mending": {"es": "Te lo están apañando… (tú no mires)", "en": "They’re patching it up… (don’t look)"},
	"p_repair": {"es": "<horn> Apañar · %d €", "en": "<horn> Mend · %d €"},
	"p_repair_tab": {"es": "<horn> Apañar · %d € (llevas %d)", "en": "<horn> Mend · %d € (you have %d)"},
	"honked": {"es": ["¡Que ya te he oío!", "¡Pita, pita, que así se arregla tó!", "¡Ni que tuvieras prisa!", "¡A tu abuela le pitas!"],
		"en": ["Heard you first time, mate!", "Honk away, fixes everything that does!", "Reckon you’re in a rush or summat?!", "Go toot at your gran!"]},
	"heat_elite": {"es": "TRICORNIOS", "en": "TRICORNIOS"},
