	"n_narrator": {"es": "El pregonero", "en": "The town crier"},
	"flyover": {
		"es": ["Esto es Madridejos. Un lugar de La Mancha de cuyo nombre nadie se acuerda, porque nadie pregunta.",
			"Aquí hay tres cosas sagrás: el aceite, la siesta y saber de quién eres. Lo demás es opinable.",
			"Los vecinos no cotillean: se informan. Las terrazas son el periódico, y los Pitufos, la página de sucesos.",
			"Los de Consuegra dicen que aquí no pasa nunca na. Los de Camuñas, que pasa demasiao. Llevan razón los dos.",
			"Y en el extrarradio, con el tejao a medias, te espera tu herencia. Y tu tía."],
		"en": ["This is Madridejos. A place in La Mancha whose name nobody remembers, because nobody asks.",
			"Three things are sacred here: olive oil, the siesta, and knowing whose child you are. The rest is opinion.",
			"The neighbours don’t gossip: they keep informed. The terraces are the newspaper, and Los Pitufos the crime page.",
			"People from Consuegra say nothing ever happens here. People from Camuñas say too much does. Both are right.",
			"And out on the edge of town, with half a roof, your inheritance is waiting. And your aunt."]},
	"p_steal": {"es": "<interact> Robar", "en": "<interact> Steal"},
	"t_radio": {"es": "Radio: %s", "en": "Radio: %s"},
	"t_nitro_burnt": {"es": ["¡Quemao! Has apurao el nitro hasta el culo de la botella.", "Se acabó el nitro. Ahora, a pedales.", "El nitro ha dicho «hasta aquí». Dale caña sin él, que se recarga."],
		"en": ["Burnt out! You ran the nitro down to the bottom of the bottle.", "No nitro left. Pedal power now.", "The nitro says “that’s your lot”. Keep the speed up: it fills again."]},
	"t_auto_on": {"es": "Autopiloto puesto. Tú no toques na, que se ofende.", "en": "Autopilot on. Don’t touch anything, it takes offence."},
	"t_auto_stroll": {"es": "Autopiloto de paseo: sin rumbo, como media juventud.", "en": "Autopilot out for a drive: no destination, like half the young people here."},
	"t_auto_off": {"es": "Autopiloto quitao. To tuyo.", "en": "Autopilot off. All yours."},
	"t_auto_here": {"es": "«Ha llegado a su destino.» Más o menos.", "en": "“You have reached your destination.” More or less."},
	"t_auto_chase": {"es": "El autopiloto no se hace responsable de esto. Apáñate.", "en": "The autopilot accepts no responsibility for this. You’re on your own."},
	"t_auto_stuck": {"es": "El autopiloto se ha rendío. Dice que así no se puede trabajar.", "en": "The autopilot gives up. It says it can’t work like this."},
	"t_auto_lost": {"es": "El autopiloto no encuentra la calle. Arrímalo a una.", "en": "The autopilot can’t find a street. Put it on one."},
	"t_nitro_back": {"es": "Nitro otra vez en condiciones.", "en": "The nitro is fit for use again."},
	"stamp_done": {"es": "¡APAÑAO!", "en": "SORTED!"},
	"arrow_here": {"es": "¡AQUÍ!", "en": "HERE!"},
	"t_radio_off": {"es": "Radio apagá. Se oye el motor, que también tiene lo suyo.", "en": "Radio off. Just the engine, which has its charm."},
	"robbed": {"es": ["¡Que era de mi padre!", "¡Si no tiene ni gasolina!", "¡Déjame por lo menos coger las pipas!", "¡Que lo tengo a medias con mi [[cuñao|cuñá]]!"],
		"en": ["That was my father’s!", "It hasn’t even got petrol!", "At least let me grab my sunflower seeds!", "I share that with my [[brother-in-law|sister-in-law]]!"]},
	"witness": {"es": ["¡Pero bueno! ¡Qué cojones pasa!", "¡Esto con Frenco no pasaba!", "¡Malditos forasteros!", "Seguro que es {camuñero|camuñera}.", "¡Llama a los Pitufos, Paqui!", "¡Y a plena luz del día!"],
		"en": ["What the hell is going on!", "This never happened under Frenco!", "Damned outsiders!", "Bet that one’s from Camuñas.", "Call Los Pitufos, Paqui!", "In broad daylight!"]},
