extends Node
## All game text. "es" is the original (Manchego Spanish); "en" is the translation.
## A value is a String, an Array of lines (one dialogue) or an Array of Arrays (several dialogues to cycle).

var lang := "es"
var fem := false          # the player's gender: picks the second half of every {masculine|feminine} pair in the text
var _names: RegEx = null
var _forces = null
var _who := RegEx.create_from_string("\\[\\[([^\\[\\]|]*)\\|([^\\[\\]|]*)\\]\\]")
var _pair := RegEx.create_from_string("\\{([^{}|]*)\\|([^{}|]*)\\}")

func t(key: String):
	var e = TX.get(key)
	if e == null:
		return key
	return _buttons(_gender(e[lang]))

## button names are written in as late as this, so they follow whatever the player is holding (see Controls.glyph)
func _buttons(v):
	if v is String:
		return Controls.fill(v)
	if v is Array:
		var out: Array = []
		for item in v:
			out.append(_buttons(item))
		return out
	return v

## resolves [[said by a man|said by a woman]] pairs for whoever is speaking
func speaker(v, fem_speaker: bool):
	if v is String:
		return _who.sub(v, "$2" if fem_speaker else "$1", true) if v.contains("[[") else v
	if v is Array:
		var out: Array = []
		for item in v:
			out.append(speaker(item, fem_speaker))
		return out
	return v

## dialogue text as BBCode with the names of people (and the police) picked out in red
const NAMES := ["Paca", "Loli", "Eusebio", "Maruja", "Venancio", "Gerardo", "Anselmo", "Torrezón", "Kevin-José", "Eufrasia", "Julián", "Josefa", "Fonsi", "Alberto", "Henry", "Chiki"]
var _marks = null
const OBJ_A := "{{o:"                # (placeholders for the marks, while the other colours go in)
const OBJ_B := ":o}}"
const AIM_A := "{{a:"
const AIM_B := ":a}}"

## (the letters a line shows, without the marks of mission objects and objectives: for the speed it is spoken at)
func plain_len(text: String) -> int:
	return text.replace("*", "").replace("#", "").length()

func rich(text: String) -> String:
	# *a mission object* in green and #an objective# in red, both outlined (the user, 13 November 2026). They are
	# taken out first, before any colour goes in: the colours' own "#" would otherwise be taken for marks.
	if _marks == null:
		_marks = [RegEx.create_from_string("[*]([^*]+)[*]"), RegEx.create_from_string("#([^#]+)#")]
	var t: String = _marks[0].sub(text, OBJ_A + "$1" + OBJ_B, true)
	t = _marks[1].sub(t, AIM_A + "$1" + AIM_B, true)
	if _names == null:
		_names = RegEx.create_from_string("(?<![\\p{L}])(" + "|".join(NAMES) + ")(?![\\p{L}])")
	var out := _names.sub(t.replace("[", "[lb]"), "[color=#c0392b]$1[/color]", true)
	if _forces == null:
		_forces = [RegEx.create_from_string("(?<![\\p{L}])((?:Los |los )?Pitufos?)(?![\\p{L}])"), RegEx.create_from_string("(?<![\\p{L}])((?:Los |los )?Tricornios?)(?![\\p{L}])")]
	out = _forces[0].sub(out, "[color=#2f6bff]$1[/color]", true)
	out = _forces[1].sub(out, "[color=#2f8f55]$1[/color]", true)
	out = out.replace(OBJ_A, "[outline_size=7][outline_color=#14301a][color=#3fd25a]").replace(OBJ_B, "[/color][/outline_color][/outline_size]")
	return out.replace(AIM_A, "[outline_size=7][outline_color=#101010][color=#e8402e]").replace(AIM_B, "[/color][/outline_color][/outline_size]")

func _gender(v):
	if v is String:
		return _pair.sub(v, "$2" if fem else "$1", true) if v.contains("{") else v
	if v is Array:
		var out: Array = []
		for item in v:
			out.append(_gender(item))
		return out
	return v

func toggle() -> void:
	lang = "en" if lang == "es" else "es"

