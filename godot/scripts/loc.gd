	"alcalde_raya_hola": {"es": ["Mientras terminamos de montar el pueblo, ¿una partida de tres en raya? Usted lleva las equis.", "No es ajedrez, pero para hacer tiempo servirá. Usted primero, con las equis."],
		"en": ["While we finish putting the town together, a game of noughts and crosses? You are crosses.", "It is not chess, but it will pass the time. After you, with the crosses."]},
	"alcalde_raya_empieza": {"es": ["Esta vez abro yo.", "Me toca empezar. Por turno riguroso, como en los plenos."], "en": ["This time I open.", "My turn to start. Strict rotation, as in council meetings."]},
	"alcalde_raya_piensa": {"es": ["Mmm.", "Veamos…", "Interesante jugada.", "Ajá.", "Eso no lo había previsto."], "en": ["Hmm.", "Let us see…", "Interesting move.", "Aha.", "I had not foreseen that."]},
	"alcalde_raya_gana": {"es": ["Tres en raya. Ya se lo advertí: siempre tres movimientos por delante.", "He ganado yo. Que conste en acta.", "Gano yo. La experiencia de gobierno, que se nota."],
		"en": ["Three in a row. I did warn you: always three moves ahead.", "I win. Let it be minuted.", "I win. Experience in government shows."]},
	"alcalde_raya_pierde": {"es": ["Me ha ganado. Lo achacaré a que estaba pensando en los presupuestos.", "Enhorabuena. No se lo diga a mi mujer.", "Bien jugado. Exijo la revancha, por supuesto."],
		"en": ["You beat me. I shall put it down to the budget on my mind.", "Congratulations. Do not tell my wife.", "Well played. I demand a rematch, naturally."]},
	"alcalde_raya_tablas": {"es": ["Tablas. Como en los plenos.", "Empate: ni para usted ni para mí. Consenso.", "Tablas. Otra, que esto aún tarda un poco."],
