extends Node
## Autoload. Music (title march, lo-fi on foot, the car radio, the chase track) with crossfades, and the sounds of
## the town: birds by day, crickets from dusk, a dog somewhere, people murmuring at the terrazas.
## The tracks are .wav files in res://assets/audio, generated by tools/make_audio.py -- except the car radio, which
## plays whatever is in the folders radio/radio1, radio/radio2... (see radio/LEEME.txt): each has an emisora.json with
## its name and description, a logo.png and its music (.ogg, .mp3 or .wav).

const DIR := "res://assets/audio/"

signal song_changed(st: Dictionary)      # the station you are tuned to has gone on to its next tune

var stations: Array = []         # one per folder: {name, about, logo: Texture2D or null, tracks: [paths], i: which is playing,
                                 #   since: when that tune began, on the clock of _now()}
var station := 1                 # 1..stations.size(), or 0 = radio off
var _cache := {}
var _players: Array = []         # two music players, for crossfading
var _active := 0
var _track := ""
var _crickets: AudioStreamPlayer
var _murmur: AudioStreamPlayer
var _shots: Array = []
var _next_shot := 0
var _bird_t := 3.0
var _dog_t := 12.0

func _ready() -> void:
	for i in range(2):
		var p := AudioStreamPlayer.new()
		p.bus = "Music"
		p.volume_db = -60.0
		p.finished.connect(_track_over.bind(p))
		add_child(p)
		_players.append(p)
	_load_stations()
	_crickets = _loop_player("crickets")
	_murmur = _loop_player("murmur")
	for i in range(3):
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_shots.append(p)

# ---------------- the car radio ----------------
## where the station folders are: beside the game's own program if it has been exported, otherwise in the project
func radio_root() -> String:
	var beside := OS.get_executable_path().get_base_dir().path_join("radio")
	if DirAccess.dir_exists_absolute(beside):
		return beside
	if OS.has_feature("android"):                # (on a phone the stations travel inside the game itself)
		return "res://radio"
	return ProjectSettings.globalize_path("res://radio")

func _load_stations() -> void:
	stations.clear()
	var root := radio_root()
	var n := 1
	while DirAccess.dir_exists_absolute(root.path_join("radio%d" % n)):
		var dir := root.path_join("radio%d" % n)
		var st := {"name": "Radio %d" % n, "about": "", "logo": null, "tracks": [], "i": 0, "dir": dir}
		if FileAccess.file_exists(dir.path_join("emisora.json")):
			var card = JSON.parse_string(FileAccess.get_file_as_string(dir.path_join("emisora.json")))
			if card is Dictionary:
				st["name"] = String(card.get("nombre", card.get("name", st["name"])))
				st["about"] = String(card.get("descripcion", card.get("descripción", card.get("description", ""))))
		if FileAccess.file_exists(dir.path_join("logo.png")):
			var img := Image.load_from_file(dir.path_join("logo.png"))
			if img != null:
				img.generate_mipmaps()
				st["logo"] = ImageTexture.create_from_image(img)
		var files := Array(DirAccess.get_files_at(dir))
		files.sort()
		for f in files:
			if String(f).get_extension().to_lower() in ["ogg", "mp3", "wav"]:
				st["tracks"].append(dir.path_join(f))
		if st["tracks"].size() > 1:               # (a different one to start with every time you play)
			st["i"] = randi() % st["tracks"].size()
		st["since"] = _now() - randf_range(15.0, 170.0)      # (and on the air already: you catch it half way through)
		stations.append(st)
		n += 1
	station = mini(station, stations.size())

## a tune from a file on disk, as it is (nothing imported)
func _file_stream(path: String, loop: bool) -> AudioStream:
	if not _cache.has(path):
		var made: AudioStream = null
		match path.get_extension().to_lower():
			"wav":
				made = AudioStreamWAV.load_from_file(path)
			"ogg":
				made = AudioStreamOggVorbis.load_from_file(path)
			"mp3":
				var mp3 := AudioStreamMP3.new()
				mp3.data = FileAccess.get_file_as_bytes(path)
				made = mp3
		_cache[path] = made
	var s: AudioStream = _cache[path]
	if s is AudioStreamWAV:
		s.loop_mode = AudioStreamWAV.LOOP_FORWARD if loop else AudioStreamWAV.LOOP_DISABLED
		s.loop_begin = 0
		s.loop_end = int(s.get_length() * s.mix_rate)
	elif s is AudioStreamOggVorbis or s is AudioStreamMP3:
		s.loop = loop
	return s

## The stations are on the air all the time, whether you listen or not (the user, 13 November 2026: tune in and the
## song is usually half way through; get out of the car and back in and it has gone on meanwhile). Each keeps when
## its tune began; tuning in plays it from where it would have got to by now. If it would have ended meanwhile, the
## next one, as far into it as the time left over (one step only: a tune is a few minutes, and walking the whole list
## would mean loading every file).
func _now() -> float:
	return Time.get_ticks_msec() / 1000.0

## [the stream station n is on, how many seconds into it it is by now]
func _radio_live(n: int) -> Array:
	var s := _radio_stream(n)
	if s == null:
		return [null, 0.0]
	var st: Dictionary = stations[n - 1]
	var long := s.get_length()
	var into: float = _now() - float(st.get("since", _now()))
	if long > 1.0 and into >= long:
		if st["tracks"].size() == 1:
			into = fmod(into, long)
		else:
			st["i"] = int(st["i"]) + 1
			s = _radio_stream(n)
			into = fmod(into - long, maxf(1.0, s.get_length()))
			st["since"] = _now() - into
	return [s, maxf(0.0, into)]

## what station n is playing just now (a station with a single tune plays it round and round)
func _radio_stream(n: int) -> AudioStream:
	if n < 1 or n > stations.size():
		return null
	var st: Dictionary = stations[n - 1]
	var tracks: Array = st["tracks"]
	if tracks.is_empty():
		return null
	return _file_stream(tracks[int(st["i"]) % tracks.size()], tracks.size() == 1)

## a tune has ended on its own: if it was the radio, the station goes on to its next one
func _track_over(p: AudioStreamPlayer) -> void:
	if p != _players[_active] or not _track.begins_with("radio_"):
		return
	var n := int(_track.substr(6))
	if n < 1 or n > stations.size():
		return
	stations[n - 1]["i"] = int(stations[n - 1]["i"]) + 1
	stations[n - 1]["since"] = _now()
	p.stream = _radio_stream(n)
	if p.stream != null:
		p.play()
		song_changed.emit(stations[n - 1])

## the tune a station is on, as its file is called: "02_Somebody - Something.ogg" -> "Somebody - Something" ("" for the
## placeholder ones)
func song_of(st: Dictionary) -> String:
	var tracks: Array = st.get("tracks", [])
	if tracks.is_empty():
		return ""
	var name := String(tracks[int(st.get("i", 0)) % tracks.size()]).get_file().get_basename()
	if name.begins_with("provisional"):
		return ""
	var cut := name.find("_")
	if cut > 0 and cut <= 3 and name.substr(0, cut).is_valid_int():
		name = name.substr(cut + 1)
	return name

func _loop_player(name: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = "SFX"
	p.stream = _stream(name, true)
	p.volume_db = -60.0
	add_child(p)
	return p

## The tune the game opens with: one of the radio's, another one every time the game is started -- but only of those
## listed in entrada.txt beside the stations (a piece of each file's name, a line each; "#" starts a comment). The
## user's choice (12 November 2026, after hearing any tune at all there: "algunas son demasiado potentes"): the
## band marches of Holy Week, without singing. If the list is missing or matches nothing, the march the game was
## made with.
var entry := ""                  # its file, once chosen ("-": none)
func entry_tune() -> String:
	if entry == "":
		var wanted: Array = []
		var list := radio_root().path_join("entrada.txt")
		if FileAccess.file_exists(list):
			for line in FileAccess.get_file_as_string(list).split("
"):
				var name := String(line).strip_edges()
				if name != "" and not name.begins_with("#"):
					wanted.append(name)
		var all: Array = []
		for st in stations:
			for path in st["tracks"]:
				for name in wanted:
					if String(path).get_file().findn(name) >= 0 and not (path in all):
						all.append(path)
		entry = String(all.pick_random()) if not all.is_empty() else "-"
	return entry

func _stream(name: String, loop: bool) -> AudioStream:
	if name == "entrada":
		var tune := entry_tune()
		var s0: AudioStream = _file_stream(tune, loop) if tune != "-" else null
		return s0 if s0 != null else _stream("title_march", loop)
	if name.begins_with("radio_"):
		return _radio_stream(int(name.substr(6)))
	if _cache.has(name):
		return _cache[name]
	var path := DIR + name + ".wav"
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		s = load(path)
	elif FileAccess.file_exists(path):
		s = AudioStreamWAV.load_from_file(path)
	if s is AudioStreamWAV and loop:
		s.loop_mode = AudioStreamWAV.LOOP_FORWARD
		s.loop_begin = 0
		s.loop_end = int(s.get_length() * s.mix_rate)
	_cache[name] = s
	return s

## crossfades to a track ("" = silence) at the given volume
func music(track: String, db := -10.0) -> void:
	if track == _track:
		if track != "":
			_players[_active].volume_db = lerpf(_players[_active].volume_db, db, 0.05)
		return
	_track = track
	var old: AudioStreamPlayer = _players[_active]
	_fades[_active] = _fade_out(old, _fades[_active])
	_active = 1 - _active
	if _fades[_active] != null:                  # (this one may still be fading out from a moment ago: get out of the car
		_fades[_active].kill()                   # and straight back in, and that fade would stop the radio just put on)
		_fades[_active] = null
	if track == "":
		return
	var p: AudioStreamPlayer = _players[_active]
	var from := 0.0
	if track.begins_with("radio_"):                # (a station: from wherever it has got to)
		var live := _radio_live(int(track.substr(6)))
		p.stream = live[0]
		from = live[1]
	else:
		p.stream = _stream(track, true)
	if p.stream == null:
		return
	p.volume_db = -50.0
	p.play(from)
	_fades[_active] = create_tween()
	_fades[_active].tween_property(p, "volume_db", db, 0.9)

var _fades: Array = [null, null]       # the fade going on on each music player, if any

func _fade_out(p: AudioStreamPlayer, going: Tween) -> Tween:
	if going != null:
		going.kill()
	var out := create_tween()
	out.tween_property(p, "volume_db", -60.0, 0.8)
	out.tween_callback(p.stop)
	return out

func current() -> String:
	return _track

## a tune's file name as [who plays it, what it is called]: "03_Somebody - Something.ogg" -> ["Somebody", "Something"]
## (["", name] if the name has no " - " in it; ["", ""] for a placeholder)
func song_parts(path: String) -> Array:
	var name := path.get_file().get_basename()
	if name.begins_with("provisional"):
		return ["", ""]
	var cut := name.find("_")
	if cut > 0 and cut <= 3 and name.substr(0, cut).is_valid_int():
		name = name.substr(cut + 1)
	var dash := name.find(" - ")
	if dash < 0:
		return ["", name]
	return [name.substr(0, dash), name.substr(dash + 3)]

## the same for whatever a station is playing now
func playing(st: Dictionary) -> Array:
	var tracks: Array = st.get("tracks", [])
	if tracks.is_empty():
		return ["", ""]
	return song_parts(String(tracks[int(st.get("i", 0)) % tracks.size()]))

## turns the dial: the station now tuned in, or {} if that was the last one and the radio is off
func next_station() -> Dictionary:
	station = (station + 1) % (stations.size() + 1)
	return stations[station - 1] if station > 0 else {}

func _shot(name: String, db: float, pitch: float) -> void:
	var s := _stream(name, false)
	if s == null:
		return
	var p: AudioStreamPlayer = _shots[_next_shot]
	_next_shot = (_next_shot + 1) % _shots.size()
	p.stream = s
	p.volume_db = db
	p.pitch_scale = pitch
	p.play()

## call every frame while in the world. moment = morning | noon | afternoon | evening | night;
## terraza = metres to the nearest terraza (big number if none); on = false mutes it all (menus, cutscenes).
func town(dt: float, moment: String, terraza: float, on: bool) -> void:
	var night := moment == "night"
	var dusk := moment == "evening"
	var want_crickets := -60.0
	if on and night:
		want_crickets = -21.0
	elif on and dusk:
		want_crickets = -29.0
	_fade(_crickets, want_crickets, dt)
	_fade(_murmur, lerpf(-19.0, -42.0, clampf((terraza - 4.0) / 24.0, 0.0, 1.0)) if (on and terraza < 28.0 and not night) else -60.0, dt)
	if not on:
		return
	if not night and not dusk:            # birds, a way off
		_bird_t -= dt
		if _bird_t <= 0.0:
			_bird_t = randf_range(1.5, 7.0)
			_shot("bird_%d" % (randi() % 5), randf_range(-33.0, -26.0), randf_range(0.85, 1.25))
	_dog_t -= dt                           # and always, somewhere, a dog
	if _dog_t <= 0.0:
		_dog_t = randf_range(18.0, 55.0)
		_shot("dog_%d" % (randi() % 4), randf_range(-30.0, -23.0), randf_range(0.85, 1.15))

func _fade(p: AudioStreamPlayer, db: float, dt: float) -> void:
	p.volume_db = move_toward(p.volume_db, db, 40.0 * dt)
	if p.volume_db > -58.0 and not p.playing:
		p.play()
	elif p.volume_db <= -59.0 and p.playing:
		p.stop()
