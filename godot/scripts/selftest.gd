	_check(lesson.size() == Loc.t("alberto_pc").size() + 2 and lesson[0] == Loc.t("alberto_pc")[0] and lesson[-2] == Loc.t("alberto_pc_owed") % 6 and lesson[-1] == Loc.t("alberto_pc_go"),
