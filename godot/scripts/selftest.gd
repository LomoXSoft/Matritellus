	shut = shut and ray.call(Vector2(41.0, 2.0), Vector2(41.0, -5.0), 2.0) and ray.call(Vector2(46.0, -26.0), Vector2(36.0, -26.0), 2.0) and ray.call(Vector2(42.0, -45.0), Vector2(33.0, -45.0), 2.0)
