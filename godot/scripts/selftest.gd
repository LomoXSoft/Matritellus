		"Marciano stands across from the café, and each talk is another tale of the eighties")
	g.player.p = was_p
	await _frames(3)

## The people inside Seguros Sopiss (sopiss_gente.gd, the user, 21 Nov 2026): open, the blonde saleswoman and a customer
## talking insurance, heard through the glass by whoever stands by it, and somebody else in the chair each time; shut,
## the cleaning lady going round with her mop, humming. Tried on the office when it is built (Pretil's sopiss.gd), and
## otherwise on a stand-in a long way off (an office of nothing but its spots and its hours).
class SopissStub extends RefCounted:
	var is_open := true
	var desk_spots: Array = []
	var clean_spots: Array = []

func _sopiss_gente_checks() -> void:
	var pool: Array = Loc.t("sopiss_charla")
	var shapes := true
	for talk in pool:
		for l in talk:
			shapes = shapes and l is Array and l.size() == 2 and String(l[0]) in ["v", "c"] and String(l[1]) != ""
	var en: Array = Loc.TX["sopiss_charla"]["en"]
	_check(shapes and pool.size() >= 8 and en.size() == pool.size(), "Sopiss: %d talks about insurance, every line the saleswoman's or the customer's, in both languages" % pool.size())
	var real = g.world.get("sopiss") if g.get("world") != null else null
	var place = real
	if place == null or not (place.get("desk_spots") is Array):
		place = SopissStub.new()
		var far := MapData.nearest_road(g.player.p + Vector2(320.0, 0.0))
		var o: Vector2 = far["p"]
		place.desk_spots = [o + Vector2(0.0, -0.8), o + Vector2(0.0, 0.8)]
		place.clean_spots = [o + Vector2(-2.0, -1.5), o + Vector2(2.0, -1.5), o + Vector2(2.0, 1.5), o + Vector2(-2.0, 1.5)]
		print("  (no Seguros Sopiss on this map yet: its people tried on a stand-in office)")
	var M = load("res://scripts/sopiss_gente.gd").new()
	M.setup(g, place)
	var was_open: bool = bool(place.get("is_open"))
	var was_phase: String = g.phase
	g.phase = "free"
	g.dlg = null
	var by: Vector2 = M.middle() + Vector2(2.5, 0.0)
	var away: Vector2 = M.middle() + Vector2(60.0, 0.0)
	var seen := func(): return g.sees(M.middle(), M.WATCH)
	if real == null:
		place.is_open = true
	var dt := 0.05
	for k in range(4):
		M.tick(dt, away)
	var blonde: bool = M.seller.look_data.get("hair") == 0xe3c46e and M.seller.voice == "adult_f"
	_check(M.open and not M.seller.away and not M.customer.away and M.cleaner.away and blonde and M.seller.p.distance_to(place.desk_spots[0]) < 0.3,
		"Sopiss open: the blonde saleswoman behind her desk and a customer before it, the cleaning lady not there")
	# by the glass: the talk, line by line, from both of them
	var heard := {"v": 0, "c": 0}
	var first_c = M.customer
	var last := {}
	for k in range(int(40.0 / dt)):
		M.tick(dt, by)
		for who in [["v", M.seller], ["c", M.customer]]:
			var lab = who[1]._label
			if lab != null and who[1].is_barking() and last.get(who[0], "") != lab.text:
				last[who[0]] = lab.text
				heard[who[0]] += 1
		if M._wait > 0.0:
			break
	var talk0: Array = pool[0]
	_check(heard["v"] >= 1 and heard["c"] >= 1 and heard["v"] + heard["c"] == talk0.size() and M._wait > 0.0,
		"Sopiss: standing by the glass you hear a whole talk, %d lines from her and %d from the customer" % [heard["v"], heard["c"]])
	# you go off, and come back: somebody else in the chair (while nobody is looking)
	var unseen: bool = not seen.call()
	M.tick(dt, away)
	_check(not unseen or (M.customer != first_c and is_instance_valid(M.customer) and not M.customer.away and M._customers == 2),
		"Sopiss: when you come back somebody else is buying insurance (%d customers so far)" % M._customers)
	var said := ""
	for k in range(int(8.0 / dt)):
		M.tick(dt, by)
		if M.customer._label != null and M.customer.is_barking():
			said = M.customer._label.text
			break
	var talk1: Array = pool[1 % pool.size()]
	var talk1_c := ""
	for l in talk1:
		if l[0] == "c":
			talk1_c = String(l[1])
			break
	_check(not unseen or said == talk1_c, "Sopiss: and the new customer has another talk (\"%s\")" % said)
	# through the glass
	var other = null
	for n in g.npcs:
		if n.id == "" and not n.has_meta("sopiss"):
			other = n
			break
	var answer: bool = M.talk(M.seller)
	_check(answer and M.seller._label.text in Loc.t("sopiss_cristal") and (other == null or not M.talk(other)),
		"Sopiss: talk to her through the glass and she answers from inside; anybody else is not hers")
	# shut: the cleaning lady, humming, going round
	if real == null:
		place.is_open = false
	else:
		place.set_open(false)
	for k in range(4):
		M.tick(dt, away)
	var homes := {}
	var hummed := 0
	var lalala: Array = Loc.t("sopiss_tarareo")
	var playing := false
	for k in range(int(30.0 / dt)):
		M.tick(dt, by)
		homes[M.cleaner.home] = true
		M.cleaner.p = M.cleaner.home             # (the town moves her along; here she is there at once)
		if M.cleaner.is_barking() and M.cleaner._label.text in lalala:
			hummed += 1
		playing = playing or M.hum.player.playing
	_check(not unseen or (not M.open and M.seller.away and M.customer.away and not M.cleaner.away),
		"Sopiss shut: nobody at the desks, the cleaning lady in")
	_check(homes.size() >= 3 and hummed > 0 and playing and M.cleaner.inner.get_node_or_null("Fregona") != null,
		"Sopiss shut: she goes round %d spots with her mop, humming (♪ over her head, and a tune heard)" % homes.size())
	M.tick(dt, away)
	_check(not M.hum.player.playing, "Sopiss: away from the glass, her humming is not heard")
	var ans2: bool = M.talk(M.cleaner)
	_check(ans2 and M.cleaner._label.text in Loc.t("sopiss_cristal_limpia"), "Sopiss: the cleaning lady answers you through the glass too")
	# leave things as they were
	for n in [M.seller, M.customer, M.cleaner]:
		g.npcs.erase(n)
		n.queue_free()
	M.hum.player.queue_free()
	if real != null:
		real.set_open(was_open)
	g.phase = was_phase
	await _frames(2)

## What is knocked down comes back the next day (props.gd mend; the user, 22 Nov 2026: "Al día siguiente"): street
## furniture and trees a long way off (nobody looking), not the same day, in their own place, standing; the crossroads'
## traffic lights too.
class FakeCar extends RefCounted:
	var linear_velocity := Vector3(6.0, 0.0, 0.0)

func _mend_checks() -> void:
	var P = g.props
	var cam: Vector3 = get_viewport().get_camera_3d().global_position if get_viewport().get_camera_3d() != null else g.player.global_position
	var far_b = null
	for k in P._grid:
		for b in P._grid[k]:
			if b is RigidBody3D and not b.has_meta("keep") and Vector2(cam.x, cam.z).distance_to(b.get_meta("p")) > 320.0:
				far_b = b
				break
		if far_b != null:
			break
	var far_t := -1
	for i in range(g.world.tree_info.size()):
		var t: Dictionary = g.world.tree_info[i]
		if not t["down"] and Vector2(cam.x, cam.z).distance_to(t["p"]) > 320.0:
			far_t = i
			break
	if far_b == null or far_t < 0:
		_check(false, "mending: something to knock down a long way off (furniture %s, tree %d)" % [str(far_b != null), far_t])
		return
	var home: Transform3D = far_b.transform
	var was_day: int = g.day_n
	P._knock(far_b, Vector3(6.0, 0.0, 0.0))
	P._fell(far_t, FakeCar.new())
	await _frames(30)
	var moved: bool = far_b.transform.origin.distance_to(home.origin) > 0.05 or not far_b.freeze
	var same_day: int = P.mend(false)
	var still_down: bool = not far_b.freeze and g.world.tree_info[far_t]["down"]
	g.day_n = was_day + 1
	var put: int = P.mend(false)
	g.day_n = was_day                    # (put back before any frame goes by: llamadas.now() counts the days, and a call left for "tomorrow" would ring)
	await _frames(2)
	var back: bool = far_b.freeze and far_b.visible and far_b.transform.origin.distance_to(home.origin) < 0.01 and far_b.collision_layer == 16
	var in_grid: bool = far_b in P._grid.get(P._key(far_b.get_meta("p")), [])
	var tree_up: bool = not g.world.tree_info[far_t]["down"]
	_check(moved and same_day == 0 and still_down and put >= 2 and back and in_grid and tree_up,
		"knocked down today, it lies there; the next day the bench (or whatever) and the tree are back in their place (%d put back)" % put)
	# the crossroads' traffic lights
	var cr = g.world.get("cruce")
	if cr != null and cr.get("broken") != null and cr.has_method("repair"):
		cr.broken = true
		P._kept_day = g.day_n
		var not_yet: bool = P.mend(false) == 0 or cr.broken
		g.day_n += 1
		P.mend(true)
		g.day_n = was_day
		_check(not_yet and cr.broken == false, "the crossroads' traffic lights knocked down are mended the next day too")
	g.day_n = was_day
	await _frames(2)

## The traffic lights of the crossroads (semaforos.gd, the user, 22 Nov 2026: "Solo paran coches"): their cycle never
## shows green both ways, blinks amber in the small hours, and a town car stops at its line on red and goes on green.
## Tried on Pretil's crossroads when it is built (cruce.gd), otherwise on a stand-in: the four ways in, as Pretil
## measured them on the map (22 Nov), their lines 6 m before the crossroads, and lamps that only remember what they show.
class CruceStub extends RefCounted:
	var heads: Array = []
	var walk: Array = []
	var lit := {}
	var walking := {}
	var broken := false
	func set_light(i: int, s: String) -> void:
		lit[i] = s
	func set_walk(i: int, on: bool, _dark := false) -> void:
		walking[i] = on

func _semaforos_checks() -> void:
	var real = g.world.get("cruce") if g.get("world") != null else null
	var place = real
	if place == null or not (place.get("heads") is Array) or (place.heads as Array).is_empty():
		place = CruceStub.new()
		for w in [[850, 1116, 0, "avenida", 2.8], [185, 193, 0, "arcos", 6.8], [1092, 1093, 1, "salvador", 6.8], [973, 974, 1, "santa_ana", 8.5]]:
			if w[0] >= MapData.nodes.size() or w[1] >= MapData.nodes.size():
				continue
			var na: Vector2 = MapData.nodes[w[0]]
			var nb: Vector2 = MapData.nodes[w[1]]
			place.heads.append({"stop": nb - (nb - na).normalized() * float(w[4]), "a": w[0], "b": w[1], "group": w[2], "name": w[3]})
		place.walk = [{"group": 0}, {"group": 1}]
		print("  (no traffic lights on this map yet: tried on a stand-in crossroads)")
	if place.heads.is_empty():
		_check(false, "traffic lights: the crossroads' road nodes are in the map")
		return
	_check(real == null or g.traffic.lights == g.semaforos, "traffic lights: the game's own are the ones the town's cars mind")
	var L = load("res://scripts/semaforos.gd").new()
	var was_lights = g.traffic.lights
	var was_clock: float = g.clock
	g.set_time(12.0)
	if place.get("broken") == true and place.has_method("repair"):      # (a car of an earlier check has knocked a post down: every light would blink amber)
		print("  ..    the traffic lights were broken at their checks: mended")
		place.repair()
	L.setup(g, place)
	# the cycle
	var both := false
	var seen := {}
	var k := 0.0
	while k < L.cycle():
		L.t = k
		var s0: String = L.state(0)
		var s1: String = L.state(1)
		both = both or (s0 != "rojo" and s1 != "rojo")
		seen[s0 + "/" + s1] = true
		k += 0.25
	_check(not both and seen.has("verde/rojo") and seen.has("rojo/verde") and seen.has("ambar/rojo") and seen.has("rojo/ambar") and seen.has("rojo/rojo"),
		"traffic lights: green one way at a time, amber after green, a moment of red both ways (%s)" % ", ".join(seen.keys()))
	L.t = 1.0
	L.tick(0.0)
	var lamps_ok := true
	if place is CruceStub:
		for i in range(place.heads.size()):
			lamps_ok = lamps_ok and place.lit.get(i, "") == L.state(int(place.heads[i]["group"]))
		lamps_ok = lamps_ok and place.walking.get(0) == false and place.walking.get(1) == true
	else:
		for i in range(place.heads.size()):
			lamps_ok = lamps_ok and String(place.heads[i].get("state", "")) == L.state(int(place.heads[i]["group"]))
		lamps_ok = lamps_ok and not bool(place.auto)
	_check(lamps_ok, "traffic lights: each face shows its group's colour, and the people's lights are green across the street that has red")
	# where a car must stop
	var h0: Dictionary = place.heads[0]
	var dir: Vector2 = ((MapData.nodes[h0["b"]] as Vector2) - (MapData.nodes[h0["a"]] as Vector2)).normalized()
	var e := {"a": h0["a"], "b": h0["b"]}
	L.t = L.GREEN[0] + L.AMBER + L.ALL_RED + 1.0          # (the side streets' green: red for group 0)
	var g_red: float = L.gap(e, (h0["stop"] as Vector2) - dir * 20.0, 2.0, 8.0)
	var g_past: float = L.gap(e, (h0["stop"] as Vector2) + dir * 1.5, 2.0, 0.0)
	var g_turned: float = L.gap({"a": h0["b"], "b": h0["a"], "prev": h0["a"]}, (h0["stop"] as Vector2) - dir * 3.0, 2.0, 0.0)
	L.t = 1.0
	var g_green: float = L.gap(e, (h0["stop"] as Vector2) - dir * 20.0, 2.0, 8.0)
	L.t = L.GREEN[0] + 0.5                                  # (amber: one too fast to stop goes through, one slow stops)
	var g_fast: float = L.gap(e, (h0["stop"] as Vector2) - dir * 4.0, 2.0, 9.0)
	var g_slow: float = L.gap(e, (h0["stop"] as Vector2) - dir * 4.0, 2.0, 1.0)
	_check(absf(g_red - 18.0) < 0.1 and g_past < 0.0 and absf(g_turned - 1.0) < 0.1 and g_green < 0.0 and g_fast < 0.0 and g_slow >= 0.0,
		"traffic lights: on red a car 20 m off has 18 m to its line, none once over it, also just past the turn; on green or too fast on amber, no stop (%.1f %.1f %.1f %.1f %.1f %.1f)" % [g_red, g_past, g_turned, g_green, g_fast, g_slow])
	# in the small hours: amber blinking; at a STOP sign, a moment at the line and on; elsewhere, straight on
	g.set_time(3.0)
	var en := {"a": h0["a"], "b": h0["b"]}
	var n_stop: float = L.gap(en, (h0["stop"] as Vector2) - dir * 2.5, 2.0, 0.0)
	L.held(en, 0.5)
	var n_still: float = L.gap(en, (h0["stop"] as Vector2) - dir * 2.5, 2.0, 0.0)
	L.held(en, 1.0)
	var n_go: float = L.gap(en, (h0["stop"] as Vector2) - dir * 2.5, 2.0, 0.0)
	var side_go := 1.0
	for h in place.heads:
		if String(h.get("name", "")) == "salvador":
			var sd: Vector2 = ((MapData.nodes[h["b"]] as Vector2) - (MapData.nodes[h["a"]] as Vector2)).normalized()
			side_go = L.gap({"a": h["a"], "b": h["b"]}, (h["stop"] as Vector2) - sd * 10.0, 2.0, 5.0)
	var blink: bool = L.state(0) in ["ambar", "off"] and L.state(1) in ["ambar", "off"]
	g.set_time(12.0)
	_check(blink and n_stop >= 0.0 and n_still >= 0.0 and n_go < 0.0 and side_go < 0.0,
		"traffic lights in the small hours: blinking amber; at the Avenida's STOP a car stops a moment and goes (%.1f %.1f %.1f), from the Salvador it goes straight on (%.1f)" % [n_stop, n_still, n_go, side_go])
	# knocked down (the user, 22 Nov 2026: "que rotos funcionen como ámbar"): blinking amber by day as well, STOPs minded
	if place.get("broken") != null:
		var was_broken: bool = bool(place.broken)
		place.broken = true
		L.t = L.GREEN[0] + L.AMBER + L.ALL_RED + 1.0
		var b_blink: bool = L.state(0) in ["ambar", "off"] and L.state(1) in ["ambar", "off"]
		var eb := {"a": h0["a"], "b": h0["b"]}
		var b_stop: float = L.gap(eb, (h0["stop"] as Vector2) - dir * 2.5, 2.0, 0.0)
		place.broken = was_broken
		var b_back: bool = L.state(0) == "rojo"
		_check(b_blink and b_stop >= 0.0 and b_back, "traffic lights knocked down: blinking amber at noon, the STOP minded; mended, the cycle again")
	# the last block of Santa Ana, one way towards the crossroads (Street View; the user, 22 Nov 2026)
	_check(MapData.one_way_says(973, 974) == 1 and MapData.one_way_says(974, 973) == -1 and MapData.one_way_says(969, 970) == 1 and MapData.one_way_says(968, 969) == 0
		and g.traffic.one_way_ok(970, 971) and not g.traffic.one_way_ok(974, 973),
		"Calle de Santa Ana: from the Calle del Romero to the crossroads, one way towards it; the rest as it was")
	# a real car of the town, on the Avenida from the north
	var was_max: int = g.traffic.max_cars
	g.traffic.clear()
	g.traffic.max_cars = 0
	g.traffic.lights = L
	var was_p: Vector2 = g.player.p
	g.player.p = g._pavement((h0["stop"] as Vector2) + dir * 10.0)
	g.player.sync()
	var back: int = h0["a"]                                 # (start a good way back: the last stretch before the crossroads may be only metres long)
	for hop in range(4):
		if (MapData.nodes[h0["b"]] as Vector2).distance_to(MapData.nodes[back]) > 30.0:
			break
		var further := -1
		for o in MapData.neighbours(back):
			if ((MapData.nodes[back] as Vector2) - (MapData.nodes[o] as Vector2)).normalized().dot(dir) > 0.7:
				further = o
		if further < 0:
			break
		back = further
	var nxt: int = h0["a"]
	for o in MapData.neighbours(back):
		if ((MapData.nodes[o] as Vector2) - (MapData.nodes[back] as Vector2)).normalized().dot(dir) > 0.7:
			nxt = o
	var ca: Dictionary = g.traffic.add("panda", 0, back, nxt if back != h0["a"] else h0["b"])
	var cleared: Array = []                                 # (a neighbour crossing in front would stop it short of its line: off the street meanwhile)
	for n in g.npcs:
		if not n.away and n.p.distance_to(h0["stop"]) < 70.0:
			n.away = true
			cleared.append(n)
	L.t = L.GREEN[0] + L.AMBER + L.ALL_RED + 0.5
	var waited := false
	var held := 0.0
	for f in range(int(12.0 * 60)):
		L.t = L.GREEN[0] + L.AMBER + L.ALL_RED + 0.5           # (held at red)
		await get_tree().physics_frame
		if bool(ca.get("at_light", false)):
			waited = true
			held += 1.0 / 60.0
	var cp: Vector2 = ca["car"].p
	var short: float = ((h0["stop"] as Vector2) - cp).dot(dir)
	var stood: bool = absf(ca["car"].forward_speed()) < 0.5
	_check(waited and held > 1.0 and stood and short > 0.5 and short < 6.0,
		"traffic lights: a car coming down the Avenida on red stops at its line (%.1f m short of it, its middle) and waits (%s, %.1f s, speed %.2f, %d->%d, waiting for %s)" % [short, str(waited), held, ca["car"].forward_speed(), ca["a"], ca["b"], str(ca.get("dbg", "-"))])
	L.t = 0.5
	var over := false
	for f in range(int(6.0 * 60)):
		L.t = 0.5
		await get_tree().physics_frame
		var at: Vector2 = ca["car"].p
		if (at - (h0["stop"] as Vector2)).dot(dir) > 1.0:
			over = true
			break
	_check(over, "traffic lights: and on green it goes on through the crossroads")
	for n in cleared:
		n.away = false
	g.traffic.clear()
	g.traffic.max_cars = was_max
	g.traffic.lights = was_lights
	g.player.p = was_p
	g.player.sync()
	g.set_time(was_clock)
	await _frames(2)

## Javi of the Asador de pollos (javi.gd, the user, 21 Nov 2026): known after Josefa's ham, when a Tuesday or a Sunday
## comes round or you talk to him; Josefa tells you about him once; on those days, behind his counter, an order of roast
## chicken for somebody you know. Skipped while the asador is not built (Pretil).
## a call left ringing by an earlier check (Action answers the phone before it opens a door; a check that waits for one
## caller's ring would take another's): said who it is, hung up, and nobody waiting to ring
func _hush_phone(where: String) -> void:
	if g.phone_call != null:
		print("  ..    a call was ringing at %s (%s): hung up" % [where, String(g.phone_call.get("npc", "?"))])
		g._hang_up()
	g.llamadas.reset()
	await _frames(2)

func _javi_checks() -> void:
	var J = g.javi
	var A = g.world.get("asador")
	if A == null or J.n == null:
		print("  (no asador on this map yet: Javi's checks skipped)")
		return
	var D = A.dentro
	var E = g.entradas
	var saved := {"money": g.money, "weekday": g.weekday, "clock": g.clock, "p": g.player.p, "menu": g.stats.get("menu_done"), "javi": g.stats.get("javi"), "jj": g.stats.get("javi_josefa")}
	g.side = null
	g.phase = "free"
	if g.in_car != null:
		g.in_car.set_speed(Vector2.ZERO)
		g._exit_car()
	await _hush_phone("Javi's checks")
	g.stats.erase("javi")
	g.stats.erase("javi_josefa")
	g.stats.erase("menu_done")
	g.weekday = 0
	g.set_time(11.0)
	await _frames(20)
	var not_yet: bool = not J.known()
	g.stats["menu_done"] = true
	await _frames(20)
	var monday: bool = not J.known()                 # (a Monday: not a delivery day)
	g.weekday = 1
	await _frames(20)
	_check(not_yet and monday and J.known() and g.folk.knows("javi"), "Javi is known once Josefa's ham is done and a Tuesday comes round (not on a Monday)")
	# Josefa tells you about him, once
	var josefa = g.named["josefa"]
	g.player.p = josefa.p + (g._pavement(josefa.p) - josefa.p).normalized() * 1.0
	g.player.sync()
	await _frames(4)
	g.talk_to(josefa)
	await _frames(3)
	var told: bool = g.dlg != null and g.dlg["lines"] == Loc.t("josefa_javi")
	await _skip_dialog(false)
	_check(told and g.stats.has("javi_josefa"), "and Josefa tells you about him")
	# into the asador, to his counter
	g.player.p = E.spot(D, false)
	g.player.sync()
	await _frames(4)
	g.interact()
	var w := 0
	while not g.indoors and w < 30:
		await _frames(1)
		w += 1
	g.player.p = D.client_spot
	g.player.sync()
	await _frames(20)
	var behind: bool = g.indoors and J.n.visible and J.n.p.distance_to(D.javi_spot) < 0.3 and J.n in g.marcas.givers()
	if shots:
		await _shot("javi_mostrador")
	g.talk_to(J.n)
	await _skip_dialog(false)
	var asked: bool = g._ask != null and g._ask["options"].size() == 2
	g._choose(0)
	await _frames(3)
	var on_counter: bool = g.trabajos._order_item() != null and g.side["stage"] == "recoger"
	g.pickups.take_tag("orden")
	await _frames(3)
	var who = g.named.get(String(g.side.get("who", ""))) if g.trabajos.active() else null
	_check(behind and asked and on_counter and g.trabajos.kind() == "pollo" and g.side["stage"] == "pedido" and who != null, "on a Tuesday, behind his counter (green arrow), he has a roast chicken for %s" % (who.shown_name() if who != null else "?"))
	var w2 := 0
	while g.indoors and w2 < 60:
		g.player.p = E.spot(D, true)
		g.player.sync()
		E.leave()
		await _frames(2)
		w2 += 1
	var m0: int = g.money
	if who != null:
		g.player.p = who.p + (g._pavement(who.p) - who.p).normalized() * 1.0
		g.player.sync()
		await _frames(4)
		g.talk_to(who)
		await _frames(3)
		await _skip_dialog(false)
	_check(not g.trabajos.active() and g.money > m0 and g.trabajos.earned("pollo") > 0, "taken over hot: %d EUR" % (g.money - m0))
	g.weekday = 2
	await _frames(20)
	_check(not J.has_order() and not (J.n in g.marcas.givers()), "on a Wednesday no chicken to take")
	g.money = saved["money"]
	g.weekday = saved["weekday"]
	g.set_time(saved["clock"])
	g.player.p = saved["p"]
	for k in [["menu_done", "menu"], ["javi", "javi"], ["javi_josefa", "jj"]]:
		if saved[k[1]] == null:
			g.stats.erase(k[0])
		else:
			g.stats[k[0]] = saved[k[1]]
	await _frames(3)

## Jobs (trabajos.gd, the user, 21 Nov 2026): El de las faenas on the square gives deliveries by car, a taxi shift and
## a day in the fields; Henry, any day but Thursday, an order for somebody you know. Each one done and paid. With
## --shots, pictures of him on the square, a fare waving you down and the flowers in the field.
func _trabajos_checks() -> void:
	var T = g.trabajos
	var saved := {"money": g.money, "clock": g.clock, "weekday": g.weekday, "p": g.player.p, "trab": g.stats.get("trabajos")}
	g.side = null
	g.phase = "free"
	g.menu.close()
	if g.in_car != null:
		g.in_car.set_speed(Vector2.ZERO)
		g._exit_car()
	g.weekday = 0
	g.set_time(10.0)
	g.stats.erase("trabajos")
	g.stats["curro"] = true                          # (open once Tía Paca has told you how to earn money: fondo_casa.gd)
	T.place_giver()
	var giver = T.giver
	g.player.p = giver.p + Vector2(1.3, 0.3)
	await _frames(8)
	var marked: bool = giver in g.marcas.givers()
	if shots:
		g.phase = "selfshot"
		g.hud.play_ui.visible = false
		g.player.p = giver.p + Vector2(-6.0, 0.0)
		_aim(MapData.at(giver.p + Vector2(3.0, 3.5), 1.8), MapData.at(giver.p, 1.3))
		await _shot("trabajos_faenas")
		g.hud.play_ui.visible = true
		g.phase = "free"
		g.player.p = giver.p + Vector2(1.3, 0.3)
		await _frames(3)
	g.talk_to(giver)
	await _skip_dialog(false)
	var four: bool = g._ask != null and g._ask["options"].size() == 3
	g._choose(0)
	await _frames(3)
	await _skip_dialog(false)
	_check(marked and four and T.kind() == "reparto" and g.side["stage"] == "carga", "El de las faenas, on the square with the green arrow over him: deliveries or the fields (the taxi is Koke's) -- a delivery")
	# a car, to the load, to the house
	var car = null
	for c in g.cars:
		if is_instance_valid(c) and c != g.paca_car and c.visible:
			car = c
			break
	var from: Vector2 = g.side["from"]
	car.place(from, 0.0)
	car.set_speed(Vector2.ZERO)
	g._enter_car(car)
	await _frames(45)
	var loaded: bool = T.active() and g.side["stage"] == "entrega" and g.hud.timer_slot.visible
	var m0: int = g.money
	g.in_car.place(g.side["to"], 0.0)
	g.in_car.set_speed(Vector2.ZERO)
	await _frames(45)
	var got: int = g.money - m0
	_check(loaded and not T.active() and got >= 100 and got <= 600 and T.earned("reparto") == got and not g.hud.timer_slot.visible, "loaded by car (the clock starts), taken across town and paid by time and damage: %d EUR" % got)
	g.in_car.set_speed(Vector2.ZERO)
	g._exit_car()
	# a day in the fields
	g.player.p = giver.p + Vector2(1.3, 0.3)
	await _frames(4)
	g.talk_to(giver)
	await _skip_dialog(false)
	g._choose(1)
	await _frames(3)
	await _skip_dialog(false)
	var field: Vector2 = g.side["to"]
	var outside: bool = field.distance_to(MapData.poi("Plaza del Ayuntamiento")) > 400.0
	g.player.p = field
	await _frames(10)
	var sown: bool = T.active() and g.side["stage"] == "coger" and int(g.side.get("tot", 0)) == T.FIELD_N
	if shots:
		g.phase = "selfshot"
		g.hud.play_ui.visible = false
		_aim(MapData.at(field + Vector2(-14.0, -14.0), 6.0), MapData.at(field, 0.0))
		await _shot("trabajos_jornal")
		g.hud.play_ui.visible = true
		g.phase = "free"
	m0 = g.money
	for i in range(T.FIELD_N):
		g.pickups.take_tag("jornal_%d" % i)
	await _frames(4)
	var day_pay: int = g.money - m0
	_check(outside and sown and not T.active() and day_pay == T.FIELD_N * T.FIELD_PAY + T.FIELD_ALL, "a day in the fields outside town: %d saffron flowers picked by hand, %d EUR with the bonus" % [T.FIELD_N, day_pay])
	# Henry's order, on a Monday (his counter is open once you know the restaurants)
	var had_menu: bool = g.stats.has("menu_done")
	g.stats["menu_done"] = true
	var henry = g.named["henry"]
	g.player.p = henry.p + Vector2(1.2, 0.4)
	await _frames(6)
	var offers: bool = henry in g.marcas.givers()
	g.talk_to(henry)
	await _frames(3)
	var counter: Array = (g._ask["options"] if g._ask != null else []).map(func(o): return o[0])
	var at_counter: bool = counter.size() == 3 and counter[1] == Loc.t("food_pedido")
	if at_counter:
		g._choose(1)
		await _frames(3)
	await _skip_dialog(false)
	var q: bool = at_counter and g._ask != null and g._ask["options"].size() == 2
	g._choose(0)
	await _frames(3)
	var waiting: bool = T.active() and g.side["stage"] == "recoger" and not g.hud.timer_slot.visible
	var item = T._order_item()
	var near_henry: bool = item != null and (item["p"] as Vector2).distance_to(henry.p) < 2.5
	g.pickups.take_tag("orden")                      # (on the counter by him: the clock starts when it is taken)
	await _frames(3)
	var running: bool = T.active() and g.side["stage"] == "pedido" and g.hud.timer_slot.visible
	_check(waiting and near_henry and running, "his order waits by him, the clock still; picked up, the clock starts")
	var who_id: String = String(g.side.get("who", "")) if T.active() else ""
	var who = g.named.get(who_id)
	var t0: int = g.folk.trust(who_id) if who != null else 0
	m0 = g.money
	if who != null:                                  # (handed over by talking to them: standing a metre off may be inside a wall)
		g.player.p = who.p + (g._pavement(who.p) - who.p).normalized() * 1.0
		g.player.sync()
		await _frames(4)
		g.talk_to(who)
		await _frames(3)
		await _skip_dialog(false)
	var order_pay: int = g.money - m0
	_check(offers and q and who != null and not T.active() and order_pay >= 30 and order_pay <= 150 and g.folk.trust(who_id) >= mini(t0 + 2, 100),
		"any day but Thursday Henry has an order for somebody you know (%s): taken over hot, %d EUR, and they like you a bit better%s" % [who.shown_name() if who != null else "?", order_pay, "" if offers and q and not T.active() and g.folk.trust(who_id) >= mini(t0 + 2, 100) else " -- offers %s, asked %s, still on %s, trust %d -> %d" % [offers, q, T.active(), t0, g.folk.trust(who_id)]])
	g.weekday = 3
	await _frames(3)
	_check(not (henry in T.givers(true)) and not T.henry_can(), "on a Thursday he has the ham to think of, and no orders")
	# back as it was
	if not had_menu:
		g.stats.erase("menu_done")
	g.money = saved["money"]
	g.weekday = saved["weekday"]
	g.set_time(saved["clock"])
	g.player.p = saved["p"]
	if saved["trab"] == null:
		g.stats.erase("trabajos")
	else:
		g.stats["trabajos"] = saved["trab"]
	g.side = null
	await _frames(3)

## Tía Paca, the debt told, on how to earn money (the user, 23 Nov 2026): her lines with the camera going to a saffron
## seller, Henry, Javi and El de las faenas; when she is done, the jobs and the saffron sellers are open.
func _curro_tour_checks() -> void:
	var lines: Array = Loc.t("casa_curro")
	var talking: bool = g.dlg != null and (g.dlg["lines"] as Array).size() == lines.size()
	var open_now: bool = bool(g.stats.get("curro", false)) and g.azafran.marks().size() == 4 and not g.trabajos.giver.away
	var shots_ok := 0
	var guard := 0
	while g.dlg != null and guard < 20:
		var i: int = int(g.dlg["i"])
		await _frames(3)
		var want: String = g.fondo_casa.CURRO_SHOTS[mini(i, g.fondo_casa.CURRO_SHOTS.size() - 1)]
		var cf = g.cam_fixed
		if want == "paca":
			shots_ok += 1 if cf == null else 0
		elif cf != null:
			var who = g.azafran.nearest(g.player.p) if want == "azafran" else (g.trabajos.giver if want == "faenas" else g.named.get(want))
			var at: Vector3 = cf[1]
			shots_ok += 1 if who != null and Vector2(at.x, at.z).distance_to(g.fondo_casa.tour_aim(want, who)[0]) < 0.5 else 0
		if shots:
			await _shot("curro_%d_%s" % [i, want])
		g.dlg["cool"] = 0.0
		g.dialog_advance()                          # (the first press shows the whole line, the second goes on)
		if g.dlg != null and int(g.dlg["i"]) == i:
			g.dialog_advance()
		guard += 1
	await _frames(3)
	_check(talking and open_now and shots_ok == lines.size() and g.cam_fixed == null and g.dlg == null,
		"then, if you are short of money: work. She names the ways with the camera on each (%d of %d shots right); the jobs and the four saffron sellers are open" % [shots_ok, lines.size()])

## The two saffrons (the user, 23 Nov 2026, through Pretil): the hidden ones once per game, the public ones spread again
## each new day of the game, somewhere else (game.gd _spread_saffron).
func _azafran_dia_checks() -> void:
	var pub := func() -> Array: return g.flowers.filter(func(f): return not f.get("hidden", false))
	var hid: Array = g.flowers.filter(func(f): return f.get("hidden", false))
	var gone_was: Array = hid.map(func(f): return f.get("gone", false))
	var first: Array = pub.call()
	var at0: Array = first.map(func(f): return f["p"])
	var s0: int = g.saffron
	# one public and (if there is one about) one hidden picked today
	g._take_flower(g.flowers.find(first[0]))
	var picked_hidden = null
	for f in hid:
		if not f.get("gone", false):
			picked_hidden = f
			break
	var found_was: Array = (g.stats.get("saffron_hidden", []) as Array).duplicate()
	if picked_hidden != null:
		g._take_flower(g.flowers.find(picked_hidden))
	var fewer: bool = pub.call().size() == g.SAFFRON_N - 1
	# the next day
	g.day_n += 1
	g._advance_clock(0.0)
	await _frames(2)
	var now: Array = pub.call()
	var elsewhere: bool = now.all(func(f): return at0.all(func(q): return (q as Vector2).distance_to(f["p"]) >= g.SAFFRON_AWAY))
	var shown: bool = now.all(func(f): return is_instance_valid(f["node"]) and f["node"].is_inside_tree() and f["node"].has_meta("dressed"))
	var hid_now: Array = g.flowers.filter(func(f): return f.get("hidden", false))
	var hidden_kept: bool = hid_now.size() == hid.size() and hid_now.all(func(f): return f in hid) 		and (picked_hidden == null or picked_hidden.get("gone", false))
	_check(fewer and now.size() == g.SAFFRON_N and elsewhere and shown and hidden_kept and g.saffron_day == g.day_n,
		"the streets' saffron: %d about the town, one picked is gone for the day; the next day all %d again, every one %d m or more from yesterday's; the %d hidden ones as they were (one taken stays taken: %s)"
		% [g.SAFFRON_N, now.size(), int(g.SAFFRON_AWAY), hid.size(), "none about" if picked_hidden == null else String(picked_hidden.get("id", ""))])
	# as it was before
	g.saffron = s0
	if picked_hidden != null:
		picked_hidden["gone"] = false
		picked_hidden["node"].visible = true
		g.stats["saffron_hidden"] = found_was
	for k in range(hid.size()):
		hid[k]["gone"] = gone_was[k]
	g.day_n -= 1
	g.saffron_day = g.day_n

## The saffron sellers, the flowers taken by walking over them, the town's skins and headscarves and the talk camera
## (the user, 23 Nov 2026).
func _azafran_checks() -> void:
	await _azafran_dia_checks()
	var A = g.azafran
	var saved := {"money": g.money, "saffron": g.saffron, "curro": g.stats.get("curro"), "p": g.player.p, "cog": g.stats.get("azafran_cogido"), "ven": g.stats.get("azafran_vendido")}
	g.side = null
	g.phase = "free"
	g.menu.close()
	if g.in_car != null:
		g.in_car.set_speed(Vector2.ZERO)
		g._exit_car()
	# skins and headscarves
	var dark := 0
	var scarves := 0
	var scarf_ok := true
	for i in range(3000):
		var o: Dictionary = g._neighbour_look(g.NEIGHBOUR_VOICES[i % g.NEIGHBOUR_VOICES.size()])
		if int(o["skin"]) in [0xc98e5f, 0x8d5a3b, 0x5e3a26]:
			dark += 1
		if String(o.get("hat", "")) == "panoleta":
			scarves += 1
			scarf_ok = scarf_ok and int(o.get("hat_color", 0)) in [0xf2efe6, 0x1b1b1f, 0x2c4a7a]
	_check(dark > 60 and dark < 270 and scarves > 20 and scarf_ok, "dark or black skin in one neighbour of twenty (%d of 3000), and the old women's headscarves white, black or blue (%d)" % [dark, scarves])
	# not there until Tía Paca has told you
	g.stats.erase("curro")
	A.show()
	g.trabajos.place_giver()
	var hidden: bool = A.sellers.size() == 4 and A.sellers.all(func(n): return n.away) and A.marks().is_empty() and g.trabajos.giver.away and not g.trabajos.henry_can()
	g.stats["curro"] = true
	A.show()
	g.trabajos.place_giver()
	var shown: bool = A.sellers.all(func(n): return not n.away) and A.marks().size() == 4 and not g.trabajos.giver.away
	var spread := true
	for i in range(3):
		spread = spread and (A.spots[i] as Vector2).distance_to(A.TOWARDS[i]) < 25.0
	var museo = A._museo_door()
	_check(hidden and shown and spread and museo != null and (A.spots[3] as Vector2).distance_to(museo[0]) < 0.01,
		"the saffron sellers: not there until Tía Paca has told you, then at the four shops' doors (one before the Petril's MUSEO door) with a circle each on the map; El de las faenas too")
	if shots:
		for i in range(4):
			var sp: Vector2 = A.spots[i]
			var sn = A.sellers[i]
			var front := Vector2(sin(sn.h), cos(sn.h))
			var eye: Vector2 = sp + front * 4.5 + Vector2(-front.y, front.x) * 1.5
			g.cam_fixed = [Vector3(eye.x, MapData.foot(sp) + 1.9, eye.y), Vector3(sp.x, MapData.foot(sp) + 1.2, sp.y)]
			g.cam_pos = g.cam_fixed[0]                  # (a cut, not a flight across the town)
			g.cam_look = g.cam_fixed[1]
			g.player.p = sp + front * 3.0 - Vector2(-front.y, front.x) * 1.5
			g.player.sync()
			await _shot("azafran_vendedor_%d" % (i + 1))
		g.cam_fixed = null
	# a flower underfoot: taken by walking over it, no money
	var spot: Vector2 = g._pavement(g.player.p + Vector2(8.0, 0.0))
	var node := Node3D.new()
	g.add_child(node)
	var entry := {"node": node, "p": spot}
	g.flowers.append(entry)
	var m0: int = g.money
	var s0: int = g.saffron
	var c0: int = int(g.stats.get("azafran_cogido", 0))
	g.player.p = spot
	g.player.sync()
	await _frames(6)
	_check(not g.flowers.has(entry) and g.saffron == s0 + 1 and g.money == m0 and int(g.stats.get("azafran_cogido", 0)) == c0 + 1,
		"a saffron flower is taken just by walking over it, and pays nothing there and then (%d on you)" % g.saffron)
	# sold to a seller
	var seller = A.sellers[0]
	g.saffron = 3
	g.player.p = seller.p + Vector2(1.0, 0.0)
	g.player.sync()
	await _frames(4)
	m0 = g.money
	g.talk_to(seller)
	await _frames(3)
	var said: bool = g.dlg != null and String((g.dlg["lines"] as Array)[0]).contains(str(3 * A.PRICE))
	var not_shoulder: bool = g._talk_camera() == false     # (a seller is nobody of the town's own: the camera as it was)
	await _skip_dialog(false)
	_check(said and g.saffron == 0 and g.money == m0 + 3 * A.PRICE and not_shoulder, "a saffron seller buys all you have: 3 flowers, %d euros" % (g.money - m0))
	g.talk_to(seller)
	await _frames(3)
	var none: bool = g.dlg != null and String((g.dlg["lines"] as Array)[0]) in Loc.t("azafran_nada")
	await _skip_dialog(false)
	_check(none, "and with nothing on you, nothing to sell")
	# a talk with one of the town's own: one steady shot of the two of you, and their name on the bubble's tab
	var paca = g.named["paca"]
	g.player.p = g._pavement(paca.p + Vector2(1.4, 0.3))
	g.player.h = 0.0
	g.player.sync()
	await _frames(4)
	var to_her: Vector2 = paca.p - g.player.p
	g.say(paca.shown_name(), ["¡Anda, hermoso! ¿Ande vas tan escopetao? Arrímate, que te cuente una cosa.", "Dos."], paca.voice)
	g.talk_npc = paca
	g.player.p = paca.p + (g.player.p - paca.p).normalized() * 0.9       # (as near as you can walk up to anyone)
	g.player.sync()
	var t_end: int = Time.get_ticks_msec() + 4000
	while Time.get_ticks_msec() < t_end and (g._talk_t < 1.0 or (g.player.p.distance_to(paca.p) < g.TALK_APART - 0.02 and g._talk_step_t < g.TALK_STEP_SECS)):
		await _frames(1)
	await _frames(4)
	var apart: float = g.player.p.distance_to(paca.p)
	var p0: Vector3 = g.cam.global_position
	var view: Vector2 = get_viewport().get_visible_rect().size
	var bubble: Rect2 = g.hud.dlg_bubble.get_global_rect()
	var in_shot := true
	var spots := ""
	for who in [g.player, paca]:
		for up in [0.1, 1.7]:
			var w: Vector3 = who.global_position + Vector3(0, up, 0)
			var at: Vector2 = g.cam.unproject_position(w)
			spots += " (%d, %d)" % [int(at.x), int(at.y)]
			if g.cam.is_position_behind(w) or at.x < 20.0 or at.x > view.x - 20.0 or at.y < 10.0 or at.y > bubble.position.y:
				in_shot = false
	var faces: bool = absf(angle_difference(g.player.h, atan2(to_her.x, to_her.y))) < 0.05
	var tab: Rect2 = g.hud.dlg_tag.get_global_rect()
	var tab_ok: bool = g.hud.dlg_tag.visible and g.hud._tag_col.is_equal_approx(g._speaker_colour(paca)) and g.hud.dlg_tag_text.text == paca.shown_name() and g.hud.dlg_name.text == paca.shown_name() \
			and not g.hud.dlg_name.visible and tab.position.x > bubble.position.x and tab.end.x < bubble.get_center().x \
			and absf(tab.get_center().y - bubble.position.y) < tab.size.y and g.hud.dlg_pointer.left > tab.size.x
	if shots:
		g.dlg["cool"] = 0.0
		g.dialog_advance()                          # (the whole line at once)
		print("talk shot: room %.2f, side %.0f, fov %.0f, %.1f m apart" % [g._talk_room, g._talk_side, g.cam.fov, g.player.p.distance_to(paca.p)])
		await _shot("charla")
		var some := 0
		for id in g.named:                           # the tab that takes each one's colour: a few more of them
			var other = g.named[id]
			if id == "paca" or g._speaker_colour(other) == null or some >= 4:
				continue
			g.hud.set_dlg_name(other.shown_name(), g._speaker_colour(other))
			some += 1
			await _shot("charla_%d" % some)
		g.hud.set_dlg_name(paca.shown_name(), g._speaker_colour(paca))
	g.dlg["cool"] = 0.0
	g.dialog_advance()                              # (the first press shows the whole line, the second goes on)
	g.dlg["cool"] = 0.0
	g.dialog_advance()
	await _frames(6)
	var moved: float = g.cam.global_position.distance_to(p0)
	g.hud.set_dlg_name("")
	var no_tab: bool = not g.hud.dlg_tag.visible
	await _skip_dialog(false)
	await _frames(2)
	_check(in_shot and faces and moved < 0.05 and g.talk_npc == null and apart > 1.5, "a talk with one of the town's own is one steady shot of the two of you, feet and heads over the bubble (%s; the camera moved %.2f m between lines), you turned to them and stepped back from 0.9 m to %.2f m, and it lets go after" % [spots.strip_edges(), moved, apart])
	_check(tab_ok and no_tab, "the speaker's name is on a tab the colour of what they wear, astride the bubble's top left-hand edge, the tail starts clear of it, and a voice with no name has no tab")
	# restore
	g.money = saved["money"]
	g.saffron = saved["saffron"]
	for k in [["curro", "curro"], ["cog", "azafran_cogido"], ["ven", "azafran_vendido"]]:
		if saved[k[0]] == null:
			g.stats.erase(k[1])
		else:
			g.stats[k[1]] = saved[k[0]]
	A.show()
	g.trabajos.place_giver()
	g.player.p = saved["p"]
	g.player.sync()
	if is_instance_valid(node):
		node.queue_free()
	g._refresh_counts()
	await _frames(3)

## Koke el Kokas (the user, 23 Nov 2026): Tía Paca's new line in the tax talk, his call an hour after Josefa's Vizum,
## his fleet on the fairground, the yellow Z15 with the flames, and the taxi run against the clock (koke.gd).
## a camera spot in the middle of the street nearest `p`, `ahead` metres along it (clear of the houses)
func _road_eye(p: Vector2, ahead: float) -> Vector2:
	var r: Dictionary = MapData.nearest_road(p, true)
	return (r["p"] as Vector2) + (r["u"] as Vector2) * ahead

## El Pochi, Foski's cousin (pochi.gd; the user, 26 Nov 2026: "Camisetas de anime todos los días […] Te insulta
## constantemente").
func _pochi_checks() -> void:
	var c = g.named.get("pochi")
	var Q = g.pochi
	var fo = g.named.get("foski")
	_check(c != null and Q != null and c.walker and not c.still and c.beat.size() >= 6 and Q.off_street(c.p) < 14.0 and fo != null and Q.start().distance_to(g.foski.start()) > 20.0,
		"El Pochi is a walker of the Calle del Florido and its Bajada (%d of their corners his), and does not start beside his cousin" % (c.beat.size() if c != null else 0))
	if c == null or Q == null:
		return
	var back: Vector2 = g.player.p
	var saved_clock: float = g.clock
	var was_phase: String = g.phase
	if g.phase != "play":
		g.phase = "free"
	var es: Array = Loc.TX["pochi"]["es"]
	var en: Array = Loc.TX["pochi"]["en"]
	var same := es.size() == en.size() and es.size() >= 8 and Loc.TX["pochi_insultos"]["es"].size() == Loc.TX["pochi_insultos"]["en"].size()
	var all_said := ""
	for i in range(es.size()):
		same = same and (es[i] as Array).size() == (en[i] as Array).size()
		all_said += " ".join(es[i]) + " "
	var his := ""
	for talk in Loc.TX["foski"]["es"]:
		his += " ".join(talk) + " "
	_check(same and all_said.contains("Foski") and all_said.contains("primo") and his.contains("Pochi") and his.contains("primo"),
		"his %d talks are the same in both languages, and the two cousins speak of each other" % es.size())
	# the user's own text boxes for him (pochi.OWN): read by the game alone, never by a test
	var boxes: Array = Q.parse("# nota\n[1]\nuno\ndos\n\n[2]\n\n[3]\n# no\ntres\n")
	Q.extra = [["«recuadro de prueba»"]]
	c.line_i = Loc.TX["pochi"][Loc.lang].size()
	g.player.p = c.p + Vector2(1.5, 0.5)
	g.player.sync()
	g.dlg = null
	g.talk_to(c, true)
	await _frames(3)
	var own_said: String = String((g.dlg["lines"] as Array)[0]) if g.dlg != null else ""
	await _skip_dialog(false)
	Q.extra = []
	_check(boxes.size() == 2 and boxes[0] == ["uno", "dos"] and boxes[1] == ["tres"] and own_said.contains("recuadro de prueba") and Q.own_lines().is_empty() \
			and FileAccess.file_exists(Q.OWN) and FileAccess.get_file_as_string("res://export_presets.cfg").count("data/*.txt") == 3,
		"the user's own text boxes for El Pochi: a box a talk, a line a bubble, notes and empty boxes left out; he says them in his turn; the file ships and no test loads it (%s)" % str([boxes.size(), own_said != ""]))
	# a T-shirt a day, with its drawing; near you, an insult unasked; and he keeps to his streets
	g.set_time(12.0)
	var day0: int = Q._day
	var shirt0: int = int(c.look_data["shirt"])
	var drawn0: bool = c.inner.get_node_or_null("pochi_dibujo") != null
	Q.wear(day0 + 1)
	Q._t = 60.0                                      # (or he would be back in today's at his next look at the calendar)
	var changed: bool = int(c.look_data["shirt"]) != shirt0 and c.inner.get_node_or_null("pochi_dibujo") != null
	g.player.p = c.p + Vector2(40.0, 40.0)
	g.player.sync()
	await _frames(10)
	if shots:
		var ahead := Vector2(sin(c.h), cos(c.h))
		await _view_at(MapData.at(c.p + ahead * 3.0 + Vector2(ahead.y, -ahead.x) * 1.2, 1.25), MapData.at(c.p, 0.95), "pochi_otra", 45.0)
	Q.wear(day0)
	Q._t = 0.0
	g.player.p = c.p + Vector2(2.5, 1.5)
	g.player.sync()
	await _frames(10)
	var from: Vector2 = c.p
	var worst := 0.0
	var shouted := false
	Q._bark = 0.0
	for k in range(8):
		await _frames(45)
		worst = maxf(worst, Q.off_street(c.p))
		shouted = shouted or c.is_barking()
		g.player.p = c.p + Vector2(3.0, 2.0)
		g.player.sync()
	var went: float = c.p.distance_to(from)
	if shots:
		g.player.p = c.p + Vector2(40.0, 40.0)
		g.player.sync()
		await _frames(4)
		var ahead2 := Vector2(sin(c.h), cos(c.h))
		await _view_at(MapData.at(c.p + ahead2 * 3.0 + Vector2(ahead2.y, -ahead2.x) * 1.2, 1.25), MapData.at(c.p, 0.95), "pochi", 45.0)
		await _view_at(MapData.at(c.p + ahead2 * 9.0 + Vector2(ahead2.y, -ahead2.x) * 3.0, 2.2), MapData.at(c.p, 1.0), "pochi_calle", 55.0)
	_check(drawn0 and changed and shouted and went > 1.5 and worst < 14.0,
		"he wears another T-shirt each day, with its drawing; near you he throws an insult unasked; and he walks his streets (%.1f m in twelve seconds, never more than %.1f m from their middle) (%s)" % [went, worst, str([drawn0, changed, shouted])])
	g.dlg = null
	g.hud.dlg_slot.visible = false
	g.phase = was_phase
	g.player.p = back
	g.player.sync()
	g.set_time(saved_clock)

## Foski (foski.gd; the user, 25 Nov 2026: "solo andará dando vueltas por la calle del florido"; "Que haya una broma
## donde bromee sobre suicidarse y luego haya un *silencio incómodo* antes de continuar la conversación").
func _foski_checks() -> void:
	var f = g.named.get("foski")
	var F = g.foski
	_check(f != null and F != null and f.walker and not f.still and f.beat.size() >= 4 and F.off_street(f.p) < 14.0,
		"Foski is a walker who keeps to the Calle del Florido (%d of its corners his, %.1f m from its middle)" % [f.beat.size() if f != null else 0, F.off_street(f.p) if f != null and F != null else -1.0])
	if f == null or F == null:
		return
	var back: Vector2 = g.player.p
	var saved_clock: float = g.clock
	var was_i: int = f.line_i
	var was_phase: String = g.phase
	if g.phase != "play":
		g.phase = "free"
	# what he says: every talk in both languages, the joke with its silence in the middle of it
	var es: Array = Loc.TX["foski"]["es"]
	var en: Array = Loc.TX["foski"]["en"]
	var same := es.size() == en.size() and es.size() >= 8
	var joke := -1
	for i in range(es.size()):
		same = same and (es[i] as Array).size() == (en[i] as Array).size()
		var at: int = (es[i] as Array).find("~~silencio incómodo~~")
		if at > 0 and at < (es[i] as Array).size() - 1 and String(en[i][at]).begins_with("~~"):
			joke = i
	var shown: String = Loc.rich("~~silencio incómodo~~")
	_check(same and joke >= 0 and shown.contains("*silencio incómodo*") and shown.contains("[color=") and not shown.contains("~"),
		"his talks are the same in both languages, and one has a silence in the middle of it, shown as «%s»" % shown.replace("[", "(").replace("]", ")"))
	# by him, at noon: he goes along his street, and stops for you when you talk to him
	g.set_time(12.0)
	g.player.p = f.p + Vector2(2.5, 1.5)
	g.player.sync()
	await _frames(20)
	var from: Vector2 = f.p
	var worst := 0.0
	for k in range(8):
		await _frames(45)
		worst = maxf(worst, F.off_street(f.p))
		g.player.p = f.p + Vector2(3.0, 2.0)
		g.player.sync()
	var went: float = f.p.distance_to(from)
	if shots:
		g.player.p = f.p + Vector2(40.0, 40.0)
		g.player.sync()
		await _frames(4)
		var ahead := Vector2(sin(f.h), cos(f.h))
		await _view_at(MapData.at(f.p + ahead * 3.0 + Vector2(ahead.y, -ahead.x) * 1.2, 1.25), MapData.at(f.p, 0.95), "foski", 45.0)
		await _view_at(MapData.at(f.p + ahead * 9.0 + Vector2(ahead.y, -ahead.x) * 3.0, 2.2), MapData.at(f.p, 1.0), "foski_calle", 55.0)
		g.player.p = f.p + Vector2(3.0, 2.0)
		g.player.sync()
	f.line_i = joke
	g.dlg = null
	g.talk_to(f, true)
	var told: bool = g.dlg != null and (g.dlg["lines"] as Array).size() == (es[joke] as Array).size() and String(g.dlg["lines"][1]).begins_with("~~")
	var spot: Vector2 = f.p
	var quiet := true
	if told:
		for k in range(60):                              # the first line, said
			await _frames(1)
		g.dlg["cool"] = 0.0
		g.dlg["shown"] = 999.0
		g.dialog_advance()
		await _frames(30)
		quiet = int(g.dlg["i"]) == 1 and float(g.dlg["shown"]) < String(g.dlg["lines"][1]).length()      # (the silence takes its time)
		if shots:
			await _frames(150)
			await _shot("foski_silencio")
	var stood: bool = f.p.distance_to(spot) < 0.3
	g.dlg = null
	g.hud.dlg_slot.visible = false
	_check(went > 1.5 and worst < 14.0 and told and quiet and stood,
		"he walks along his street (%.1f m in twelve seconds, never more than %.1f m from its middle), stands still while he talks to you, and his joke is followed by a silence that takes its time (%s)" % [went, worst, str([told, quiet, stood])])
	f.line_i = was_i
	g.player.p = back
	g.phase = was_phase
	g.player.sync()
	g.set_time(saved_clock)

## The night crowd of the Sala Cavernas KAE (fiesta.gd; the user, 25 Nov 2026): only with the hall restored and from 23
## to 6, two or three having a smoke at the door, people dancing and at the bar inside, the unique ones as at any pub.
func _fiesta_checks() -> void:
	var F = g.fiesta
	var sala = g.world.get("cuevas")
	_check(F != null and sala != null and F.sala == sala, "the party hall has its night crowd's keeper (fiesta.gd)")
	if F == null or sala == null:
		return
	var saved_clock: float = g.clock
	var saved_day: int = g.weekday
	var was_restored: bool = sala.restored
	var real_set = F.dentro
	# 0) its nights are Thursday's to Sunday's, from eleven to six of the next morning; restored with 30 Puntos Cívicos
	#    before its boarded doors (kept in the game's stats), and always restored in the free mode
	sala.set_restored(true)
	var when := func(day: int, hour: float) -> bool:
		g.weekday = day
		g.set_time(hour)
		return F.open()
	var nights: bool = when.call(3, 23.5) and when.call(4, 2.0) and when.call(6, 23.5) and when.call(0, 2.0) and when.call(0, 5.9) \
			and not when.call(0, 23.5) and not when.call(1, 2.0) and not when.call(2, 23.5) and not when.call(3, 2.0) and not when.call(3, 22.9) and not when.call(5, 12.0) and not when.call(0, 6.1)
	_check(nights, "the hall's nights are Thursday's to Sunday's: open at 2 on a Monday, shut that night at 23:30, and on a Thursday not before eleven")
	var had_pc: int = g.pc
	var had_stats: Dictionary = g.stats.duplicate()
	var was_free: bool = g.chavisca
	var was_at: Vector2 = g.player.p
	g.chavisca = false
	g.stats.erase(F.FIX_KEY)
	g.stats["pc_on"] = true
	F.begin()
	var worn_first: bool = not sala.restored
	g.player.p = F.fix_spot()
	g.player.sync()
	g.pc = F.FIX_COST - 1
	g.player.h = atan2(sala.P(float(sala.DOOR_X), 0.0).x - g.player.p.x, sala.P(float(sala.DOOR_X), 0.0).y - g.player.p.y)
	g.player.sync()
	g.set_time(17.0)
	await _frames(40)
	var can: bool = F.can_fix() and F.fix_prompt().contains("30") and g.hud.prompt_slot.visible and String(g.hud.prompt.text).contains("30 P.C.")
	if shots:
		await _shot("fiesta_arreglar")
	var said_fix: String = g.hud.prompt.text
	F.fix()
	var short: bool = not sala.restored and g.pc == F.FIX_COST - 1 and not g.stats.has(F.FIX_KEY)
	g.pc = F.FIX_COST + 4
	F.fix()
	var paid: bool = sala.restored and g.pc == 4 and g.stats.has(F.FIX_KEY) and not F.can_fix()
	var lit: bool = (sala.lamps as Array).all(func(p): return g.lights.spots.has(p))
	sala.set_restored(false)
	F.begin()                                         # (a game loaded with it paid)
	var kept: bool = sala.restored
	g.stats.erase(F.FIX_KEY)
	F.begin()
	var not_kept: bool = not sala.restored
	g.chavisca = true
	F.begin()
	var free_ok: bool = sala.restored and not F.can_fix()
	g.chavisca = was_free
	g.pc = had_pc
	g.stats = had_stats
	g.player.p = was_at
	g.player.sync()
	_check(worn_first and can and short and paid and lit and kept and not_kept and free_ok,
		"worn until you pay 30 P.C. before its doors (not with 29), its lamps lit with the town's, kept by the game that paid, and always restored in the free mode (%s, «%s»)" % [str([worn_first, can, short, paid, lit, kept, not_kept, free_ok]), said_fix])
	g.weekday = 5                                     # (a Saturday for all that follows: both ends of the night are the hall's)
	# 1) worn, or by day: nobody
	sala.set_restored(false)
	g.set_time(0.5)
	F.sync(true)
	var none_worn: bool = F.people.is_empty() and not F.open() and F.unique_spots().is_empty()
	sala.set_restored(true)
	g.set_time(12.0)
	F.sync(true)
	var none_day: bool = F.people.is_empty() and not F.open()
	g.set_time(22.9)
	F.sync(true)
	var none_early: bool = F.people.is_empty()
	_check(none_worn and none_day and none_early, "nobody with the hall worn, nor by day, nor before eleven with it restored")
	# 2) restored, at night: two or three at the door, smoking, off the road, apart, looking at one another
	g.player.p = sala.P(30.0, 60.0)                  # (far from the door: they may come)
	g.player.sync()
	var counts := {}
	var smoke_ok := true
	var names_ok := true
	var place_ok := true
	var gaps := []
	for k in range(12):
		g.set_time(12.0)
		F.sync(true)
		g.set_time(23.0 + float(k % 7))               # (23, 0, 1 ... 5: all of the night)
		F.sync(true)
		var out: Array = F.of("puerta")
		counts[out.size()] = true
		for n in out:
			if n.id != "" or not bool(n.look_data.get("smoke", false)) or n.lines_key != "fiesta_puerta" or not n.still:
				smoke_ok = false
			if not (int(n.display_name) >= 0 and int(n.display_name) < 10 and g.NEIGHBOUR_VOICES[int(n.display_name)] == n.voice):
				names_ok = false
			var road: Dictionary = MapData.nearest_road(n.p)
			var off: float = absf((n.p - road["p"]).dot(g._perp(road["u"]))) - float(road["seg"].hw)
			gaps.append(snappedf(off, 0.1))
			if off < 0.4 or sala.P(34.3, 1.5).distance_to(n.p) < 2.5:
				place_ok = false
			for m in out:
				if m != n and m.p.distance_to(n.p) < 1.4:
					place_ok = false
	_check(counts.size() == 2 and counts.has(2) and counts.has(3), "two or three of them at the door, depending on the night: %s" % [counts.keys()])
	_check(smoke_ok and names_ok, "they are anonymous neighbours having a smoke, with the door's lines")
	_check(place_ok, "they stand apart, clear of the way in and off the road (%s m from its edge)" % [gaps.slice(0, 3)])
	var out2: Array = F.of("puerta")
	var a = out2[0]
	var b = out2[1]
	var facing: float = absf(angle_difference(a.h, atan2(b.p.x - a.p.x, b.p.y - a.p.y)))
	_check(facing < 1.0, "and look at one another (%.2f rad off)" % facing)
	if shots:
		g.set_time(0.5)
		await _frames(30)
		await _view_at(MapData.at(sala.P(31.5, 11.0), 2.2), MapData.at(sala.P(30.2, 1.0), 1.3), "fiesta_puerta", 50.0)
		await _view_at(MapData.at(sala.P(24.0, 7.0), 1.8), MapData.at(sala.P(30.0, 2.0), 1.2), "fiesta_puerta_2", 40.0)
	# 3) nobody comes or goes in your sight, nor with you by the door
	g.player.p = sala.P(30.0, 8.0)
	g.player.sync()
	var before: int = F.people.size()
	g.set_time(12.0)
	F.sync()
	var stayed: bool = F.people.size() == before and F.on
	g.player.p = sala.P(30.0, 200.0)
	g.player.sync()
	g.cam.global_position = MapData.at(sala.P(30.0, 220.0), 3.0)
	g.cam.look_at(MapData.at(sala.P(30.0, 400.0), 1.0))
	F.sync()
	_check(stayed and F.people.is_empty() and not F.on, "with you by the door they stay though the night is over; once you are away, they are gone")
	# 4) what they say: the pools in both languages, and one of them said by one of them
	var pools_ok := true
	for key in ["fiesta", "fiesta_puerta"]:
		var es: Array = Loc.TX[key]["es"]
		var en: Array = Loc.TX[key]["en"]
		if es.size() != en.size() or es.size() < 12:
			pools_ok = false
		for i in range(es.size()):
			if (es[i] as Array).size() != (en[i] as Array).size() or (es[i] as Array).any(func(l): return String(l).strip_edges() == ""):
				pools_ok = false
	g.set_time(1.0)
	F.sync(true)
	var one = F.of("puerta")[0]
	g.player.p = one.p + Vector2(1.2, 0.0)
	g.player.sync()
	g.talk_to(one)
	await _frames(3)
	var first: String = String((g.dlg["lines"] as Array)[0]) if g.dlg != null else ""
	var from_pool: bool = first != "" and Loc.TX["fiesta_puerta"][Loc.lang].any(func(d): return String(d[0]).left(8) == first.left(8))
	var who: String = g.hud.dlg_name.text
	await _skip_dialog(false)
	_check(pools_ok and from_pool and who == Loc.t("generic_names")[int(one.display_name)], "%d lines for inside and %d for the door, in both languages; one at the door says one, as \"%s\"" % [Loc.TX["fiesta"]["es"].size(), Loc.TX["fiesta_puerta"]["es"].size(), who])
	# 5) inside: the set's own spots (Pretil's cuevas.dentro) or, until there is one, a few made up here on the forecourt
	var stub: bool = real_set == null
	if stub:
		var floor_: Array = []
		for i in range(9):
			floor_.append(sala.P(8.0 + 2.0 * float(i % 5), 3.0 + 2.2 * float(i / 5)))
		F.dentro = {"dance_spots": floor_, "client_spots": [sala.P(20.0, 3.0), sala.P(21.8, 3.0), sala.P(23.6, 3.0)], "bar_spot": sala.P(21.8, 0.5), "dj_spot": sala.P(12.0, 0.5)}
	g.set_time(12.0)
	F.sync(true)
	g.set_time(2.0)
	F.sync(true)
	var dancers: Array = F.of("baile")
	var drinkers: Array = F.of("barra")
	var floor_n: int = F._floor().size()
	_check(dancers.size() >= int(ceil(floor_n * 0.7)) and dancers.size() <= floor_n and floor_n >= 3, "inside%s, most of the floor is taken: %d dancing on %d spots" % [" (spots made up for the test)" if stub else "", dancers.size(), floor_n])
	_check(not drinkers.is_empty() and drinkers.size() <= F.DRINKERS and drinkers.all(func(n): return n.inner.get_node_or_null("Vaso") != null and n.hand_at != null and n.lines_key == "fiesta"), "%d at the bar with a glass in their hand" % drinkers.size())
	var inside_ok: bool = (dancers + drinkers).all(func(n): return n.id == "" and not bool(n.look_data.get("smoke", false)) and n.lines_key == "fiesta")
	if not stub:
		g._use_door(true, real_set)                   # (in through the door: the set is only there for whoever is inside)
		await _frames(10)
	if not dancers.is_empty():
		var d0 = dancers[0]
		g.player.p = d0.p + Vector2(3.0, 0.0)
		g.player.sync()
		var h0: float = d0.h
		var turned := 0.0
		for i in range(40):
			await _frames(1)
			turned = maxf(turned, absf(angle_difference(d0.h, h0)))
		g.talk_to(d0)
		await _frames(3)
		var still_h: float = d0.h
		await _frames(10)
		var held: bool = is_equal_approx(d0.h, still_h) and g.dlg != null
		await _skip_dialog(false)
		_check(inside_ok and turned > 0.05 and held, "they dance (one turned %.2f rad in 40 frames) and stop to talk to you" % turned)
		if shots and not stub:
			var eye := func(q: Vector2, up: float) -> Vector3: return Vector3(real_set.INSIDE.x + q.x, MapData.foot(real_set.INSIDE + Vector2(0.0, 5.0)) + up, real_set.INSIDE.y + q.y)
			g.player.p = real_set.INSIDE + Vector2(6.0, 5.0)
			g.player.sync()
			await _frames(30)
			await _view_at(eye.call(Vector2(3.0, 3.0), 2.4), eye.call(Vector2(-1.0, 15.0), 1.0), "fiesta_dentro", 62.0)
			await _view_at(eye.call(Vector2(-1.5, 8.0), 1.9), eye.call(Vector2(-8.0, 13.5), 1.1), "fiesta_barra", 55.0)
			await _view_at(eye.call(Vector2(5.0, 22.0), 2.2), eye.call(Vector2(-2.0, 13.0), 1.0), "fiesta_pista", 60.0)
		elif shots:
			await _view_at(MapData.at(sala.P(14.0, 14.0), 2.6), MapData.at(sala.P(13.0, 4.0), 1.2), "fiesta_baile_prueba", 55.0)
	# 5b) the two who work there: Ezequiel behind the bar, Frank Málaga at the decks, on a night only
	if not stub:
		var ez = g.named.get("ezequiel")
		var fr = g.named.get("frank")
		var there: bool = ez != null and fr != null and not ez.away and not fr.away and ez.p.distance_to(real_set.bar_spot) < 1.5 and fr.p.distance_to(real_set.dj_spot) < 0.1 \
				and ez.shown_name() == "Ezequiel" and fr.shown_name() == "Frank Málaga"
		var up: float = (fr.global_position.y - ez.global_position.y) if there else 0.0
		var said_ez := ""
		var shouted := false
		if there:
			g.player.p = real_set.client_spot
			g.player.sync()
			await _frames(3)
			g._find_interaction()
			var reach: bool = g.near_npc == ez or ez.p.distance_to(g.player.p) < 3.2
			g.talk_to(ez)
			await _frames(3)
			said_ez = String((g.dlg["lines"] as Array)[0]) if g.dlg != null and reach else ""
			await _skip_dialog(false)
			F._shout = 0.0
			for i in range(30):
				await _frames(1)
				if fr.is_barking():
					shouted = true
					break
		_check(there and up > 1.0 and said_ez != "" and Loc.TX["ezequiel"][Loc.lang].any(func(d): return String(d[0]).left(8) == said_ez.left(8)) and shouted,
			"Ezequiel is behind the bar and says his own lines across it, Frank Málaga is at the decks on the mezzanine (%.1f m up) and shouts to the floor" % up)
		if shots:
			var eye2 := func(q: Vector2, lift: float) -> Vector3: return Vector3(real_set.INSIDE.x + q.x, MapData.foot(real_set.INSIDE + Vector2(0.0, 5.0)) + lift, real_set.INSIDE.y + q.y)
			g.player.p = real_set.INSIDE + Vector2(8.0, 4.0)
			g.player.sync()
			await _frames(10)
			await _view_at(eye2.call(Vector2(-8.1, 16.3), 1.95), Vector3(ez.global_position.x, ez.global_position.y + 1.2, ez.global_position.z), "fiesta_ezequiel", 42.0)
			F._beat = 4.5         # his hand up
			await _frames(2)
			await _view_at(eye2.call(Vector2(1.6, 19.6), 3.9), Vector3(fr.global_position.x, fr.global_position.y + 1.1, fr.global_position.z), "fiesta_frank", 42.0)
		# 5c) Ángelus Apátrida, down in La Kueva whenever the hall is open: drawn only while La Kueva is
		var an = g.named.get("angelus")
		if real_set.get("kueva_spots") != null and (real_set.kueva_spots as Array).size() > 6:
			g.player.p = real_set.client_spot
			g.player.sync()
			await _frames(20)
			var up_gone: bool = an != null and an.away and not an.visible
			var regulars: Array = F.of("kueva")
			var hidden_up: bool = regulars.all(func(z): return z.away and not z.visible)
			g.player.p = real_set.kueva_spots[6] + Vector2(-1.8, 0.9)
			g.player.sync()
			await _frames(30)
			var down: bool = an != null and not an.away and an.visible and an.p.distance_to(real_set.kueva_spots[6]) < 0.2 and real_set.kueva.visible \
					and absf(an.global_position.y - (float(real_set.level) - float(real_set.K_DEEP))) < 0.4 and an.shown_name() == "Ángelus Apátrida"
			var said_an := ""
			if down:
				g.dlg = null
				g.talk_to(an, true)
				await _frames(3)
				said_an = String((g.dlg["lines"] as Array)[0]) if g.dlg != null else ""
				await _skip_dialog(false)
				if shots:
					await _frames(20)
					await _shot("fiesta_angelus_sala")
					var to := Vector3(sin(an.h), 0.0, cos(an.h))
					for z in regulars:                       # (him alone, for the picture)
						z.away = true
						z.visible = false
					g.player.visible = false
					await _view_at(an.global_position + to * 2.7 + Vector3(0.0, 1.3, 0.0) + to.cross(Vector3.UP) * 0.9, an.global_position + Vector3(0.0, 1.05, 0.0), "fiesta_angelus", 45.0)
					an.h += PI
					an.sync()
					await _view_at(an.global_position + to * 2.7 + Vector3(0.0, 1.3, 0.0) + to.cross(Vector3.UP) * 0.9, an.global_position + Vector3(0.0, 1.05, 0.0), "fiesta_angelus_espalda", 45.0)
					an.h -= PI
					an.sync()
					g.player.visible = true
					for z in regulars:
						z.away = false
						z.visible = true
			# its anonymous regulars: three to five, in its places but his, theirs the lines about the dark
			var theirs: bool = regulars.size() >= 3 and regulars.size() <= 5 and hidden_up and regulars.all(func(z): return not z.away and z.visible and z.lines_key == "fiesta_kueva" \
					and z.p.distance_to(real_set.kueva_spots[6]) > 1.0 and absf(z.global_position.y - (float(real_set.level) - float(real_set.K_DEEP))) < 0.4)
			var said_z := ""
			if theirs:
				g.dlg = null
				g.talk_to(regulars[0], true)
				await _frames(3)
				said_z = String((g.dlg["lines"] as Array)[0]) if g.dlg != null else ""
				await _skip_dialog(false)
				if shots:
					# (seen from where Ángelus stands, over his head: the whole lot of them)
					var zmid := Vector3.ZERO
					for zz in regulars:
						zmid += zz.global_position / float(regulars.size())
					var zeye: Vector3 = an.global_position + (zmid - an.global_position).normalized() * 0.7 + Vector3(0.0, 1.9, 0.0)
					await _view_at(zeye, zmid + Vector3(0.0, 0.9, 0.0), "fiesta_kueva_gente", 72.0)
			_check(theirs and Loc.TX["fiesta_kueva"][Loc.lang].any(func(d): return String(d[0]).left(8) == said_z.left(8)),
				"La Kueva has its %d regulars for the night, drawn only down there, and they talk about how dark it is (%s)" % [regulars.size(), str([theirs, hidden_up, said_z != ""])])
			var numbered: bool = an != null and an.inner.get_node_or_null("angelus_dorsal") != null and an.inner.get_node_or_null("angelus_dorsal_atras") != null      # (a basketball vest: "Ponle algún número")
			_check(up_gone and down and numbered and said_an != "" and Loc.TX["angelus"][Loc.lang].any(func(d): return String(d[0]).left(8) == said_an.left(8)),
				"Ángelus Apátrida is down in La Kueva while the hall is open, says his own lines, and is not drawn from the hall above; his vest has its number (%s)" % str([up_gone, down, said_an != "", numbered]))
		g.set_time(12.0)
		g._use_door(false, real_set)
		await _frames(5)
		g.player.p = sala.P(30.0, 200.0)
		g.player.sync()
		F.sync(true)
		_check(ez != null and fr != null and ez.away and fr.away and (g.named.get("angelus") == null or g.named["angelus"].away), "and by day none of them is there")
		g.set_time(2.0)
		F.sync(true)
	# 6) the unique ones: one more spot among the pubs while the night is on, none after; they leave when it is over
	var R = g.rondas
	var pubs: int = (R.zones["pub"] as Array).size()
	var more: Array = R._spots("pub")
	var spots_open: Array = F.unique_spots()
	g.set_time(12.0)
	var closed_same: bool = R._spots("pub").size() == pubs and F.unique_spots().is_empty()
	var over: bool = not spots_open.is_empty() and R._party_over({"kind": "pub", "p": spots_open[0], "until": 1e12}) and not R._party_over({"kind": "pub", "p": R.zones["pub"][0], "until": 1e12})
	_check(more.size() == pubs + 1 and F.is_mine(more[-1]) and closed_same and over, "for the unique neighbours the hall is one more pub among %d while its night is on, and not after: who is there then goes" % pubs)
	# as it was
	if g.indoors:
		g._use_door(false, real_set)
		await _frames(5)
	F.dentro = real_set
	F.sync(true)
	sala.set_restored(was_restored)
	g.weekday = saved_day
	g.set_time(saved_clock)
	F.sync(true)

## The people in mourning at the cemetery (luto.gd; the user, 25 Nov 2026: "En el cementerio habrá siempre 4/6 NPCs
## dando vueltas. Varias ancianas y un anciano ... las mujeres siempre pañoleta negra se llamarán simplemente Viejo/a de
## luto"), and the unique neighbours with nothing for you who now and then are there instead of a bar (rondas.gd).
func _luto_checks() -> void:
	var L = g.luto
	var cm = g.world.cementerio
	_check(L != null and cm != null and L.people.size() == 6, "six people in mourning for the cemetery (five old women and an old man)")
	if L == null or cm == null or L.people.is_empty():
		return
	var pictures: bool = shots
	var saved_clock: float = g.clock
	var saved_day: int = g.day_n
	# 1) four, five or six of them about each day, the man always
	var counts := {}
	var man_always := true
	for d in range(9):
		g.day_n = d
		L._sync_day(true)
		var about: Array = L.about()
		counts[about.size()] = true
		if not about.any(func(n): return n.voice == "old_m"):
			man_always = false
	g.day_n = saved_day
	L._sync_day(true)
	_check(counts.keys().all(func(k): return int(k) >= 4 and int(k) <= 6) and counts.size() >= 2 and man_always,
		"four to six about, depending on the day, the old man always among them: %s" % [counts.keys()])
	# 2) in black and dark colours, the women under a black headscarf, called Vieja / Viejo de luto
	var dark_ok := true
	var names_ok := true
	for e in L.people:
		var n = e["n"]
		var lk: Dictionary = n.look_data
		var c := Color.hex((int(lk.get("shirt", 0)) << 8) | 0xff)
		if c.get_luminance() > 0.25:
			dark_ok = false
		var want: String = "Viejo de luto" if n.voice == "old_m" else "Vieja de luto"
		if Loc.t("generic_names")[int(n.display_name)] != want or n.id != "":
			names_ok = false
		if n.voice == "old_f" and not (String(lk.get("hat", "")) == "" or (String(lk.get("hat", "")) == "panoleta" and int(lk.get("hat_color", 0)) == L.BLACK)):
			dark_ok = false
	var scarves := 0
	for k in range(400):                             # (a black headscarf on one woman in four, nothing on the others' heads)
		if String(L._look(false).get("hat", "")) == "panoleta":
			scarves += 1
	_check(dark_ok and scarves > 70 and scarves < 130, "they wear black and dark colours, a black headscarf on one woman in four (%d of 400)" % scarves)
	var shawls := 0
	var shawl_ok := true
	for k in range(400):                             # (a black toquilla on about half of the women; an apron only in black)
		var lk: Dictionary = L._look(false)
		if int(lk.get("toquilla", -1)) >= 0:
			shawls += 1
			shawl_ok = shawl_ok and int(lk["toquilla"]) == L.BLACK
		if int(lk.get("mandil", -1)) >= 0 and int(lk["mandil"]) != 0x26262b:
			shawl_ok = false
	var man_lk: Dictionary = L._look(true)
	_check(shawl_ok and shawls > 140 and shawls < 220 and int(man_lk.get("toquilla", -1)) < 0, "a black toquilla on about half of the women (%d of 400), never on the man; an apron, if any, black" % shawls)
	_check(names_ok, "anonymous, and called Vieja de luto and Viejo de luto")
	# 3) they go round the walks and stop at graves, never walking through a row of them, never out of the wall
	var e0: Dictionary = {}
	for e in L.people:
		if not e["n"].away:
			e0 = e
			break
	var n0 = e0["n"]
	g.player.p = n0.p + Vector2(4.0, 0.0)
	g.player.sync()
	var start: Vector2 = n0.p
	var went := 0.0
	var through := 0
	var outside := 0
	var stopped := false
	var last: Vector2 = n0.p
	var secs := 0.0
	for i in range(60 * 120):                          # (two minutes at most: till they have walked some and stopped at a grave)
		await get_tree().physics_frame
		if i % 10 != 0:
			continue
		secs = i / 60.0
		if stopped and went > 8.0 and secs > 30.0:
			break
		for e in L.people:
			var n = e["n"]
			if n.away:
				continue
			var uv: Vector2 = L._uv(n.p)
			if uv.x < 0.4 or uv.y < 0.4 or uv.x > cm.L_N - 0.4 or uv.y > cm.L_W - 0.4:
				outside += 1
			for pr in cm.pair_rows:
				if uv.x > float(pr[0]) + 0.25 and uv.x < float(pr[1]) - 0.25 and uv.y > float(pr[2]) + 0.25 and uv.y < float(pr[3]) - 0.25:
					through += 1
		went += n0.p.distance_to(last)
		last = n0.p
		if bool(e0["stay"]) and float(e0["wait"]) > 0.0 and (e0["path"] as Array).is_empty():
			stopped = true
		g.player.p = n0.p + Vector2(4.0, 0.0)          # (near enough for them to be ticked and seen)
		g.player.sync()
	print("  luto walk: went=%.1f m from %s to %s, through=%d outside=%d stopped=%s" % [went, start, n0.p, through, outside, stopped])
	_check(went > 8.0 and through == 0 and outside == 0, "they walk round the cemetery's walks (%.0f m in %.0f s), never through the graves nor out of the wall" % [went, secs])
	_check(stopped, "and stop at a grave a while, in the aisle beside it")
	# 4) what they say
	var said_f := ""
	var said_m := ""
	for e in L.people:
		var n = e["n"]
		if n.away:
			continue
		g.player.p = n.p + Vector2(1.2, 0.0)
		g.player.sync()
		g.talk_to(n)
		var s: String = " ".join(g.dlg["lines"]) if g.dlg != null else ""
		while g.dlg != null:
			g.dialog_advance()
			await _frames(1)
		if n.voice == "old_m":
			said_m = s
		elif said_f == "":
			said_f = s
	var f_all: String = str(Loc.t("luto_f"))
	var m_all: String = str(Loc.t("luto_m"))
	print("  luto talk: f=%s | m=%s" % [said_f.left(70), said_m.left(70)])
	_check(said_f != "" and f_all.contains(said_f.left(30)) and said_m != "" and m_all.contains(said_m.left(30)), "they talk of death in their own words (Loc luto_f, luto_m)")
	if pictures:
		var e1 = L.about()[0]
		var at: Vector2 = e1.p
		g.player.p = at + (cm.map_at(1.0, 0.0) - cm.map_at(0.0, 0.0)).normalized() * 3.0
		g.player.sync()
		g.clock = 11.0
		g.player.visible = false
		await _frames(30)
		var eye: Vector2 = at + (cm.map_at(0.0, 5.0) - cm.map_at(0.0, 0.0)) + (cm.map_at(3.0, 0.0) - cm.map_at(0.0, 0.0))
		await _view_at(Vector3(eye.x, MapData.height(eye) + 3.0, eye.y), Vector3(at.x, MapData.height(at) + 0.8, at.y), "luto_vieja", 40.0)
		var ids: Array = []
		var mid := Vector2.ZERO
		for k in range(3):                              # (three of them together by a grave, for the picture)
			var nk = L.about()[k]
			var spot: Vector2 = at + (cm.map_at(1.0 + k * 1.2, 0.0) - cm.map_at(0.0, 0.0))
			nk.p = spot
			nk.home = spot
			nk.sync()
			ids.append(nk)
			mid += spot / 3.0
		for e in L.people:
			e["wait"] = 99.0
			e["path"] = []
		await _frames(20)
		var eye2: Vector2 = mid + (cm.map_at(0.0, 5.0) - cm.map_at(0.0, 0.0))
		await _view_at(Vector3(eye2.x, MapData.height(eye2) + 3.0, eye2.y), Vector3(mid.x, MapData.height(mid) + 0.7, mid.y), "luto_grupo", 45.0)
		g.player.visible = true
		for e in L.people:
			e["wait"] = 0.0
	# 5) the unique ones with nothing for you, now and then at the cemetery instead of a bar
	var R = g.rondas
	g.player.p = Vector2(-1500.0, 1500.0)              # (far from everybody: nobody sees them go)
	g.player.sync()
	await _frames(5)
	g.clock = 11.0
	var who = null
	for d in range(40):
		g.day_n = d
		for id in R.ROUNDS:
			var n = g.named.get(id)
			if n != null and R.cementerio(id) and not R.wanted(n) and R.where(R.ROUNDS[id]) != "home":
				who = n
				break
		if who != null:
			break
	var there := false
	if who != null:
		R._t = 0.0
		R.tick(0.1)
		there = g.zonas.in_zone(who.p) and String(R._at.get(who.id, {}).get("kind", "")) == "cementerio"
	var kids_never := true
	for d in range(40):
		g.day_n = d
		if R.cementerio("kevin"):
			kids_never = false
	print("  luto rondas: who=%s there=%s at=%s day=%d" % [who.id if who != null else "-", there, who.p if who != null else null, g.day_n])
	_check(who != null and there, "a unique neighbour with nothing for you is now and then at the cemetery instead (%s)" % [who.id if who != null else "nobody"])
	_check(kids_never, "never a child")
	R.home_all()
	g.day_n = saved_day
	g.clock = saved_clock
	L._sync_day(true)

## La Pili (pili.gd), the Manchegan shopping trolleys of the old neighbours (chara.gd _carrito) and Tía Paca's call when
## you have been idle 24 hours with something to do (fondo_casa.gd _ocio) -- the user, 25 Nov 2026
func _pili_checks() -> void:
	var pictures: bool = shots
	var P = g.pili
	var saved := {"money": g.money, "pc": g.pc, "curro": g.stats.get("curro"), "pili": g.stats.get("pili"), "ocio_h": g.stats.get("ocio_h"), "vizum": g.stats.get("vizum"), "ocio_avisos": g.stats.get("ocio_avisos"),
		"p": g.player.p, "phase": g.phase, "clock": g.clock}
	g.side = null
	g.phase = "free"
	g.stats["vizum"] = g.stats.get("vizum", true)      # (Josefa's Vizum call would ring the moment the inheritance is told)
	if g.in_car != null:
		g.in_car.set_speed(Vector2.ZERO)
		g._exit_car()
	# 1) the trolley: 20 % of the old women, 5 % of the old men, nobody else; never at the wheel nor in a seat
	var got := {"old_f": 0, "old_m": 0, "adult_f": 0, "adult_m": 0, "kid": 0}
	var runs := 3000
	for v in got.keys():
		for r in range(runs):
			if bool(g._neighbour_look(v).get("carro", false)):
				got[v] += 1
	var drivers_with := 0
	for r in range(600):
		if g.driver_look().has("carro"):
			drivers_with += 1
	var ff: float = float(got["old_f"]) / runs
	var fm: float = float(got["old_m"]) / runs
	_check(absf(ff - 0.2) < 0.03 and absf(fm - 0.05) < 0.015 and got["adult_f"] + got["adult_m"] + got["kid"] == 0 and drivers_with == 0,
		"old women pull a shopping trolley %.1f %% of the time, old men %.1f %%, nobody else, and never at a car's wheel" % [ff * 100.0, fm * 100.0])
	var Chara = preload("res://scripts/chara.gd")
	var who = Chara.new()
	g.add_child(who)
	who.setup({"top": 7, "shirt": 0x7a4a9a, "carro": true})
	var has_it: bool = who._carro != null and is_instance_valid(who._carro) and who._carro.get_child_count() >= 10
	for k in range(60):
		who.anim(true, 1.0 / 60.0, 0.0)
	var pulled_k: float = who._carro_k
	var hand_on: bool = who._hr.position.distance_to(who._carro_hand()) < 0.01
	var behind: bool = who._carro.position.z < -0.4 and absf(who._carro.rotation.x - who.CARRO_TIP) < 0.01
	for k in range(60):
		who.anim(false, 1.0 / 60.0, 0.0)
	var stood: bool = who._carro_k < 0.01 and who._carro.position.z > 0.0
	var sitter = Chara.new()
	var fig: Node3D = sitter.sit({"carro": true, "shirt": 0x7a4a9a}, false)
	var sat_with: bool = fig.find_child("carro", true, false) != null
	sitter.free()
	fig.free()
	_check(has_it and pulled_k > 0.99 and hand_on and behind and stood and not sat_with,
		"the trolley (tartan bag, frame, flap, two wheels) is pulled tipped back on its wheels a step behind, right hand on its handle, and stood up beside them when they stop; none in a seat")
	who.queue_free()
	# 2) La Pili: only once Tía Paca has told you of the inheritance; then up and down the Arroyuelo by day
	_check(P != null and P.n != null and P.cajera != null and g.named.has("pili") and g.named.has("pescadera") and bool(P.n.look_data.get("carro", false)),
		"La Pili (with her red tartan trolley) and La Pescadera, on the Merkocarry's till, are in the town")
	if P == null or P.n == null:
		return
	g.stats.erase("curro")
	g.stats["pili"] = ""
	g.set_time(11.0)
	P._sync_presence(true)
	var hidden_before: bool = P.n.away
	g.stats["curro"] = true
	P.n.away = true
	P._sync_presence(true)
	var near_route: bool = P.ARROYO.any(func(a): return P.n.p.distance_to(a) < 16.0)
	_check(hidden_before and not P.n.away and near_route, "La Pili is nowhere before the talk about the inheritance, and after it walks along the Calle del Arroyuelo Medio")
	# 3) Tía Paca, 24 hours idle with La Pili's errand waiting: "¿qué haces tan ocioso?", and where to go
	g.phone_call = null
	g.llamadas.forget("paca")
	g.stats.erase("ocio_avisos")
	var now: float = g.llamadas.now()
	g.side = {"id": "x", "stage": ""}
	g.stats["ocio_h"] = now - 30.0
	g.fondo_casa._ocio(false)
	var busy_resets: bool = absf(float(g.stats["ocio_h"]) - now) < 0.01 and g.phone_call == null and not g.llamadas.pending("paca")
	g.side = null
	g.stats["ocio_h"] = now - 23.0
	g.fondo_casa._ocio(true)
	var not_yet: bool = g.phone_call == null and not g.llamadas.pending("paca")
	g.stats["ocio_h"] = now - 24.5
	var giver = g.fondo_casa.idle_giver()
	g.fondo_casa._ocio(true)
	var call = g.phone_call if g.phone_call != null else (g.llamadas.queue[0]["call"] if not g.llamadas.queue.is_empty() else {})
	var said: String = " ".join(call.get("say", [])) if call is Dictionary else ""
	var rang: bool = call is Dictionary and call.get("npc", "") == "paca" and said.contains("ocios") and said.contains("recado")
	var where_ok: bool = giver != null and said.contains(g.fondo_casa.where(giver.p))
	print("  Paca's call (", giver.id if giver != null else "-", "): ", said)
	var once: bool = giver != null and (g.stats.get("ocio_avisos", []) as Array).has(g.fondo_casa.mission_key(giver)) and g.fondo_casa.idle_giver() != giver
	g.phone_call = null
	g.hud.phone(false)
	g.llamadas.forget("paca")
	g.chavisca = true
	g.stats["ocio_h"] = now - 30.0
	g.fondo_casa._ocio(true)
	var chav_quiet: bool = g.phone_call == null and not g.llamadas.pending("paca")
	g.chavisca = false
	_check(busy_resets and not_yet and rang and where_ok and chav_quiet and once,
		"24 h idle with a mission waiting, Tía Paca rings: \"¿qué haces tan ocioso?\" and where somebody has an errand (%s); once for each mission; not before 24 h, not with something under way, never in the Modo Chavisca" % [g.fondo_casa.where(giver.p) if giver != null else "?"])
	# 4) near her, she comes after you on foot, calling out; far enough off, she gives up
	P.n.p = P._route(2)
	P.n.home = P.n.p
	P.n.sync()
	P._route_i = 2
	g.player.p = P.n.p + Vector2(9.0, 0.0)
	g.player.sync()
	for k in range(6):
		P._t = 0.0
		P.tick(0.4, g.player.p)
		await _frames(2)
	var chases: bool = P.chasing() and P.n.home.distance_to(g.player.p) < 2.0
	var barked: bool = P.n._label != null and P.n._label.visible and String(P.n._label.text) != ""
	if pictures:
		await _frames(90)                        # (she walks up to you)
		var mid: Vector2 = (P.n.p + g.player.p) / 2.0
		var eye: Vector2 = _road_eye(mid, 7.0)
		await _view_at(Vector3(eye.x, MapData.height(eye) + 2.6, eye.y), Vector3(mid.x, MapData.height(mid) + 0.9, mid.y), "pili_persigue", 45.0)
	g.player.p = P.n.p + Vector2(40.0, 0.0)
	g.player.sync()
	P._t = 0.0
	P.tick(0.4, g.player.p)
	var gave_up: bool = not P.chasing()
	_check(chases and barked and gave_up, "within %d m La Pili walks after you calling out (\"¡Oye, tú!\"), and at %d m she gives up" % [int(P.CHASE_NEAR), int(P.CHASE_GIVE_UP)])
	# 5) her talk: the cod, her sons, Laura la mamporrera; no makes her cross, yes sends you to the Merkocarry
	g.money = 20
	g.folk.add("pili", 10)
	var tr0: int = g.folk.trust("pili")
	g.player.p = P.n.p + Vector2(1.2, 0.0)
	g.player.sync()
	g.talk_to(P.n)
	var intro: String = " ".join(g.dlg["lines"]) if g.dlg != null else ""
	while g.dlg != null:
		g.dialog_advance()
		await _frames(1)
	var two: bool = g._ask != null and (g._ask["options"] as Array).size() == 2
	if two:
		g._ask_pick(1)
	while g.dlg != null:
		g.dialog_advance()
		await _frames(1)
	var cross: bool = g.folk.trust("pili") < tr0 and P.stage() == ""
	g.talk_to(P.n)
	while g.dlg != null:
		g.dialog_advance()
		await _frames(1)
	if g._ask != null:
		g._ask_pick(0)
	while g.dlg != null:
		g.dialog_advance()
		await _frames(1)
	var took: bool = P.stage() == "fetch" and g.side != null and g.side["id"] == "pili"
	print("  pili talk: intro=%s two=%s cross=%s took=%s stage=%s side=%s" % [intro.left(60), two, cross, took, P.stage(), g.side])
	_check(intro.contains("bacalao") and intro.contains("mamporrer") and two and cross and took,
		"La Pili goes on about the price of cod, her sons and Laura la mamporrera; No (trust %d -> %d) or Yes, and the errand is on" % [tr0, g.folk.trust("pili")])
	# 6) the Merkocarry: the fish at the first till, the cashier, the crossed-out poster; picked up, why she is banned
	var t = P._tienda()
	g.phone_call = null
	g.hud.phone(false)
	g.llamadas.queue.clear()
	g.player.p = g.entradas.spot(t, false)
	g.player.sync()
	g._door_cool = 0.0
	await _frames(4)
	g.interact()
	await _frames(10)
	var inside: bool = P.in_shop()
	var fish = null
	for it in g.pickups.items:
		if String(it.get("tag", "")) == P.FISH_TAG:
			fish = it
	var posters: bool = P._posters.size() == 2
	var cashier_at_till: bool = P.cajera.p.distance_to(t.spot(-6.4, 3.2)) < 0.8
	if fish != null:
		g.player.p = (fish["p"] as Vector2) + Vector2(0.0, -1.0)
		g.player.h = 0.0
		g.player.sync()
		fish["age"] = 1.0
	await _frames(12)
	if pictures:
		var lv: float = t.level
		var e1: Vector2 = t.spot(-3.0, 4.9)
		var a1: Vector2 = t.spot(-5.4, 2.2)
		await _view_at(Vector3(e1.x, lv + 1.8, e1.y), Vector3(a1.x, lv + 0.8, a1.y), "pili_merkocarry_caja", 55.0)
		var e2: Vector2 = t.spot(-5.5, 0.35)
		var a2: Vector2 = t.spot(-5.5, 1.6)
		await _view_at(Vector3(e2.x, lv + 0.75, e2.y), Vector3(a2.x, lv + 0.5, a2.y), "pili_cartel", 50.0)
		var e3: Vector2 = t.spot(2.4, 1.6)
		var a3: Vector2 = t.spot(2.4, 0.0)
		await _view_at(Vector3(e3.x, lv + 1.55, e3.y), Vector3(a3.x, lv + 1.45, a3.y), "pili_cartel_puerta", 50.0)
	var nf = g.pickups.near(g.player.p)
	var near_fish: bool = nf != null and String(nf.get("tag", "")) == P.FISH_TAG
	var fishes: Array = g.pickups.items.filter(func(it): return String(it.get("tag", "")) == P.FISH_TAG)
	print("  fish: n=%d at=%s player=%s d=%.2f age=%.2f coll=%s cine=%s dlg=%s phase=%s" % [fishes.size(), fishes[0]["p"] if fishes.size() > 0 else null, g.player.p,
		(fishes[0]["p"] as Vector2).distance_to(g.player.p) if fishes.size() > 0 else -1.0, float(fishes[0]["age"]) if fishes.size() > 0 else -1.0,
		fishes[0]["collected"] if fishes.size() > 0 else null, g.cine_lock, g.dlg != null, g.phase])
	g.interact()
	await _frames(4)
	var why: String = " ".join(g.dlg["lines"]) if g.dlg != null else ""
	while g.dlg != null:
		g.dialog_advance()
		await _frames(1)
	print("  merkocarry: inside=%s fish=%s posters=%s cashier=%s near=%s stage=%s why=%s" % [inside, fish != null, posters, cashier_at_till, near_fish, P.stage(), why.left(80)])
	_check(inside and fish != null and posters and cashier_at_till and near_fish and P.stage() == "give" and why.contains("prohibida la entrada") and why.contains("panga"),
		"at the Merkocarry's first till: the spinning fish, the cashier beside it, her crossed-out poster (x2); picked up, the cashier says she is banned for the panga's Christian burial")
	g.entradas.leave()
	await _frames(6)
	# 7) at the Magdalena: "¿esto es una puta panga?" -- and +50 €, +30 P.C.
	P.n.p = P._house()
	P.n.home = P.n.p
	P.n.sync()
	g.player.p = P.n.p + Vector2(1.2, 0.0)
	g.player.sync()
	await _frames(4)
	if pictures:
		await _frames(30)
		var f: Vector2 = _road_eye(P.n.p, 3.0)
		await _view_at(Vector3(f.x, MapData.height(f) + 1.5, f.y), Vector3(P.n.p.x, MapData.height(P.n.p) + 0.9, P.n.p.y), "pili_retrato", 40.0)
	var at_home: bool = P.n.p.distance_to(P.MAGDALENA) < 25.0 and not P.n.away and (g.marcas.givers().has(P.n))
	print("  house: d=%.1f away=%s vis=%s givers=%s pgivers=%s phase=%s" % [P.n.p.distance_to(P.MAGDALENA), P.n.away, P.n.visible, g.marcas.givers().map(func(x): return x.id), P.givers(false).size(), g.phase])
	var m0: int = g.money
	var pc0: int = g.pc + int(g.stats.get("pc_owed", 0))
	g.player.p = P.n.p + Vector2(1.2, 0.0)
	g.player.sync()
	g.talk_to(P.n)
	var end: String = " ".join(g.dlg["lines"]) if g.dlg != null else ""
	while g.dlg != null:
		g.dialog_advance()
		await _frames(1)
	var paid: bool = g.money == m0 + P.PAY and g.pc + int(g.stats.get("pc_owed", 0)) == pc0 + P.PC
	print("  home: at_home=%s end=%s paid=%s done=%s side=%s" % [at_home, end.left(80), paid, P.done(), g.side])
	_check(at_home and end.contains("puta panga") and end.contains("tomar por culo") and paid and P.done() and g.side == null,
		"at her house by the Magdalena: \"¿esto es una puta panga?\", \"veste a tomar por culo\"; +%d € and +%d P.C. all the same" % [P.PAY, P.PC])
	# 8) after: round the town's shops and bars, and far too much about herself
	P._wander_t = 0.0
	P._t = 0.0
	P.tick(0.4, g.player.p)
	var doors: Array = P._shop_doors()
	var shopping: bool = doors.size() >= 6 and doors.any(func(d): return d.distance_to(P.n.home) < 0.5)
	g.talk_to(P.n)
	var after: String = " ".join(g.dlg["lines"]) if g.dlg != null else ""
	while g.dlg != null:
		g.dialog_advance()
		await _frames(1)
	print("  after: shopping=%s home=%s after=%s" % [shopping, P.n.home, after.left(60)])
	_check(shopping and after != "", "after it she goes from shop to supermarket to restaurant (%d doors), telling you far too much" % doors.size())
	if pictures:
		g.set_time(11.0)
		var spot: Vector2 = P._route(3)
		var along: Vector2 = MapData.nearest_road(spot, true)["u"]
		var olds: Array = []
		for k in range(4):
			var lk: Dictionary = g._neighbour_look(["old_f", "old_m"][k % 2])
			lk["carro"] = true
			lk["carro_color"] = [0xb8202a, 0x2a3f7a, 0x6a3a8a, 0x3a7a9a][k]
			lk["carro_dibujo"] = ["", "", "flores", "liso"][k]
			var nn = g._make_npc("", lk, "old_f", spot + along * (k * 1.8 - 2.7))
			nn.still = true
			nn.home = nn.p + along * 30.0
			olds.append(nn)
		olds[3].home = olds[3].p                 # (one stopped: her trolley stood up beside her)
		g.player.p = spot - along * 6.0          # (near enough for their arms and legs -- and trolleys -- to move)
		g.player.sync()
		await _frames(50)
		var c0: Vector2 = olds[1].p
		var ce: Vector2 = _road_eye(c0 + along * 7.0, 0.0)
		await _view_at(Vector3(ce.x, MapData.height(ce) + 1.8, ce.y), Vector3(c0.x, MapData.height(c0) + 0.6, c0.y), "carro_vecinas", 50.0)
		var cs: Vector2 = _road_eye(c0, 0.0)
		await _view_at(Vector3(cs.x, MapData.height(cs) + 1.3, cs.y), Vector3(c0.x, MapData.height(c0) + 0.6, c0.y), "carro_lado", 50.0)
		for nn in olds:
			g.npcs.erase(nn)
			nn.queue_free()
	# put things back
	g.stats["pili"] = saved["pili"] if saved["pili"] != null else ""
	for k in ["curro", "ocio_h", "vizum", "ocio_avisos"]:
		if saved[k] == null:
			g.stats.erase(k)
		else:
			g.stats[k] = saved[k]
	g.money = saved["money"]
	g.pc = saved["pc"]
	g.side = null
	g.player.p = saved["p"]
	g.player.sync()
	g.set_time(saved["clock"])
	g.phase = saved["phase"]
	P.restore()

func _koke_checks() -> void:
	var K = g.koke
	var T = g.trabajos
	var saved := {"money": g.money, "curro": g.stats.get("curro"), "vizum": g.stats.get("vizum"), "vizum_h": g.stats.get("vizum_h"),
		"koke": g.stats.get("koke"), "koke_dia": g.stats.get("koke_dia"), "koke_done_h": g.stats.get("koke_done_h"),
		"p": g.player.p, "phase": g.phase, "muted": g.police.muted,
		"trabajos": (g.stats.get("trabajos", {}) as Dictionary).duplicate(true)}
	g.side = null
	g.phase = "free"
	g.menu.close()
	if g.in_car != null:
		g.in_car.set_speed(Vector2.ZERO)
		g._exit_car()
	# Tía Paca: if you are short of money, sell drugs; and El de las faenas has no taxi any more
	var curro: Array = Loc.t("casa_curro")
	var drugs: bool = curro.any(func(l): return String(l).contains("Economía circular") and String(l).contains("la mitad trafica"))
	_check(drugs and curro.size() == g.fondo_casa.CURRO_SHOTS.size() and not T.has_method("_start_taxi") and not curro.any(func(l): return String(l).contains("taxi")),
		"Tía Paca adds that you can always sell drugs (\"economía circular, lo llaman\"), a shot of her own for it; the odd-jobs man no longer has a taxi shift (it is Koke's)")
	# the fleet on the fairground
	var fleet_ok: bool = K.car != null and K.car.kind == "kokas" and K.car.paint == 0xf2c81e and K.car.spec.has("turbo") and K.fleet.size() == 2 \
		and Geometry2D.is_point_in_polygon(K.car.p, PackedVector2Array(preload("res://scripts/ferial.gd").FAIR)) and K.fleet.all(func(f): return f.kind == "kokas" and f.paint != 0xf2c81e) 		and K.n != null and K.n.p.distance_to(K.car.p) < 5.0
	_check(fleet_ok, "the fleet stands on the fairground, along its longest path: the yellow Z15 with the nitro and two more tuned ones (black, blue), Koke beside them")
	# moved once the bars' terraces were laid out: clear of their tables, and each with its wheels under it
	var rows: Array = [K.car] + K.fleet
	var tables_clear: bool = K._settled and rows.all(func(c): return g.props.terrazas.all(func(t): return (t["p"] as Vector2).distance_to(c.p) >= 6.5))
	var wheels_on: bool = rows.all(func(c): return c.wheels.all(func(w): return (w as Node3D).global_position.distance_to(c.global_position) < 4.0))
	_check(tables_clear and wheels_on, "the fleet was moved clear of the bars' terraces (laid out after it was set up), each car with its four wheels under it")
	# his radio: Koka y Ná as you get in, the key only turns it to Traktor and back (never another nor off), and out of
	# the car the station you had before
	var koka: int = K.station_of("koka")
	var trak: int = K.station_of("traktor")
	var before_st: int = Ambience.station
	Ambience.station = 1 if koka != 1 and trak != 1 else 3
	var had: int = Ambience.station
	g._enter_car(K.fleet[0])
	K._radio_tick()
	var on_koka: bool = Ambience.station == koka
	var turns: Array = []
	for k in range(3):
		var st = K.radio_flip()
		turns.append(Ambience.station if st != null else -1)
	K.fleet[0].set_speed(Vector2.ZERO)
	g._exit_car()
	K._radio_tick()
	var back: bool = Ambience.station == had and K.radio_flip() == null
	Ambience.station = before_st
	_check(koka > 0 and trak > 0 and on_koka and turns == [trak, koka, trak] and back,
		"Koke's cars are tuned to Koka y Ná (station %d); the radio key only turns it to Traktor (%d) and back, never off; out of the car, your own station again" % [koka, trak])
	if shots:
		g.phase = "selfshot"
		g.hud.play_ui.visible = false
		g.set_time(12.0)
		var cp: Vector3 = K.car.global_position
		var fw: Vector3 = K.car.global_transform.basis.z
		var rt: Vector3 = K.car.global_transform.basis.x
		_aim(cp + fw * 5.0 + rt * 4.5 + Vector3(0, 2.2, 0), cp + Vector3(0, 0.9, 0))
		await _shot("koke_coche")
		_aim(cp - fw * 3.5 - rt * 5.5 + Vector3(0, 2.0, 0), cp + Vector3(0, 0.9, 0))
		await _shot("koke_coche_izq")
		_aim(cp + rt * 9.0 - fw * 7.0 + Vector3(0, 4.0, 0), cp - fw * 4.0 + Vector3(0, 0.8, 0))
		await _shot("koke_flota")
		g.hud.play_ui.visible = true
		g.phase = "free"
	# his call: not before an hour of game time after the Vizum, then once
	g.stats["curro"] = true
	g.stats["vizum"] = int(g.day_n)
	g.stats.erase("koke")
	g.stats.erase("koke_dia")
	K._rung = false
	await _hush_phone("Koke's call")
	g.stats["vizum_h"] = K.now_h() - 0.5
	K._t = 0.0
	await _frames(8)
	var quiet: bool = g.phone_call == null and not g.llamadas.pending("koke")
	g.stats["vizum_h"] = K.now_h() - 1.05
	K._t = 0.0
	var rang := false
	for k in range(60):
		await _frames(2)
		if g.phone_call != null:
			rang = g.phone_call["npc"] == "koke"
			break
	var said := ""
	if rang:
		g._answer_call()
		await _frames(3)
		said = " ".join(g.dlg["lines"]) if g.dlg != null else ""
		await _skip_dialog(false)
		await _frames(3)
	var marked: bool = K.n in g.marcas.givers()
	_check(quiet and rang and said.contains("coma") and said.contains("colegio") and said.contains("hierba") and K.called() and K.available() and marked,
		"an hour after the Vizum Koke el Kokas rings (not half an hour after): his partner in a coma, the school's front, the police kept in grass; then he has the green arrow while the day's run is there")
	# the run starts as you get in
	g.set_time(12.0)
	g.player.p = K.car.p + Vector2(2.5, 0.0)
	g.player.sync()
	await _frames(30)
	var cash0: int = g.money
	g._enter_car(K.car)
	await _frames(20)
	var started: bool = K.running() and g.police.muted and K.car.unbreakable and g.hud.timer_slot.visible and absf(float(g.side["t"]) - K.START) < 3.0 and int(g.stats.get("koke_dia", -1)) == int(g.day_n)
	var hp0: float = K.car.hp
	var kn0: int = K.car.knocks
	K.car.damage(60.0)
	var whole: bool = K.car.hp == hp0 and K.car.knocks == kn0 + 1
	for k in range(20):
		if K._waiting.size() > 0:
			break
		await _frames(15)
	var waving: bool = K._waiting.size() > 0 and K._waiting.all(func(w): return is_instance_valid(w["ring"]) and w["n"].still)
	_check(started and whole and waving, "getting into the yellow one starts the run: %d s on the clock, no police, the van cannot be broken (hp %d after a knock), %d fares waving with rings" % [int(K.START), int(K.car.hp), K._waiting.size()])
	# a fare: stop by one, in they get
	var w = K._nearest_waiting(K.car.p)
	var cls := -1
	if w != null:
		cls = int(w["cls"])
		if shots:
			var wp: Vector2 = w["n"].p
			K.car.place(wp + Vector2(10.0, 6.0), atan2(-10.0, -6.0))
			K.car.set_speed(Vector2.ZERO)
			await _frames(40)
			await _shot("koke_cliente")
		K.car.place(w["n"].p + Vector2(2.6, 0.0), 0.0)
		K.car.set_speed(Vector2.ZERO)
		await _frames(30)
	var aboard: bool = K._rider != null and K._rider.away and g.side["stage"] == "viaje" and K.said() != ""
	var dist: float = float(g.side.get("dist", 0.0))
	var cl: Array = K.CLASSES[maxi(0, cls)]
	var dist_ok: bool = dist > float(cl[1]) * 0.6 and dist < float(cl[2]) * 1.6
	_check(aboard and dist_ok, "stop by one and they get in, say where (\"%s\") and their own clock starts: a %s ring, %.0f m" % [K.said(), ["red", "yellow", "green"][maxi(0, cls)], dist])
	# they talk: a knock
	K._said_t = 0.0
	K._chat_t = 9.0
	K.car.knocks += 1
	await _frames(4)
	var crash_line: String = K.said()
	var crash_pool: Array = Loc.t("kokas_crash")
	var talked: bool = crash_pool.any(func(l): return Loc.speaker(String(l), K._fem(K._rider)) == crash_line)
	_check(talked, "a knock, and the fare says so: \"%s\"" % crash_line)
	if shots:
		await _frames(30)
		await _shot("koke_carrera")
	# left where they asked: paid base + bonus, and 30 s more
	var t_before: float = float(g.side["t"])
	var m0: int = g.money
	if aboard:
		var to: Vector2 = g.side["to"]
		K.car.place(to, 0.0)
		K.car.set_speed(Vector2.ZERO)
		await _frames(30)
	var got: int = g.money - m0
	var expect: Array = K.fare_pay(dist, 1.0)
	_check(K.running() and int(g.side.get("fares", 0)) == 1 and got >= int(expect[0]) and got <= int(expect[0]) + int(expect[1]) and float(g.side["t"]) > t_before + K.BONUS - 3.0 and g.side["stage"] == "cliente",
		"left where they asked: %d EUR (a base of %d by the distance, the rest for the time to spare) and %d s more on the clock" % [got, int(expect[0]), int(K.BONUS)])
	# a fare whose own clock runs out gets out without paying
	w = K._nearest_waiting(K.car.p)
	for k in range(20):
		if w != null:
			break
		await _frames(15)
		w = K._nearest_waiting(K.car.p)
	var jumped := false
	if w != null:
		K.car.place(w["n"].p + Vector2(2.6, 0.0), 0.0)
		K.car.set_speed(Vector2.ZERO)
		await _frames(30)
		if K._rider != null:
			m0 = g.money
			var rider = K._rider
			g.side["ft"] = 0.05
			await _frames(6)
			jumped = K._rider == null and g.money == m0 and rider.visible and g.side["stage"] == "cliente"
	_check(jumped, "a fare whose own clock runs out gets out without paying")
	# the shift's clock at nothing: over, the police and the van back as they were
	g.side["t"] = 0.05
	await _frames(6)
	var over: bool = not K.running() and g.side == null and g.police.muted == saved["muted"] and not K.car.unbreakable and K._waiting.is_empty() and T.earned("kokas") >= got and g.in_car == K.car
	var hp1: float = K.car.hp
	K.car.damage(10.0)
	over = over and K.car.hp < hp1                   # (still at the wheel, but it can be broken again)
	g.in_car.set_speed(Vector2.ZERO)
	g._exit_car()
	await _frames(3)
	var refused: bool = K.refuses(K.car) and not K.available()
	_check(over and refused, "the clock at nothing, the shift is over (all you earned is yours): you are still at the wheel, but the van can be broken again and the police are back; once a day: he will not let you have it again today")
	print("    (koke: %d EUR earned in the run)" % (g.money - cash0))
	# restore
	g.money = saved["money"]
	for k in ["curro", "vizum", "vizum_h", "koke", "koke_dia", "koke_done_h"]:
		if saved[k] == null:
			g.stats.erase(k)
		else:
			g.stats[k] = saved[k]
	if g.get("xandro") != null:
		g.xandro.place_npc()
	g.stats["trabajos"] = saved["trabajos"]
	g.police.muted = saved["muted"]
	g.player.p = saved["p"]
	g.player.sync()
	g.phase = saved["phase"]
	g._refresh_counts()
	await _frames(3)

## Xandro and underground Street Races (xandro.gd): unlocked after Koke's first job, 4h phone call, cholo outfit at Talleres Xandro,
## 8 Seta Pandas on the night grid, 100 EUR buy-in / 500-200-100 prizes with 10% loaner commission, free mission retry, daily 3-route rotation.
func _xandro_checks() -> void:
	var X = g.xandro
	var Chara = load("res://scripts/chara.gd")
	var saved := {
		"money": g.money, "day_n": g.day_n, "clock": g.clock, "p": g.player.p, "phase": g.phase,
		"muted": g.police.muted, "koke_dia": g.stats.get("koke_dia"), "koke_done_h": g.stats.get("koke_done_h"),
		"xandro_intro": g.stats.get("xandro_intro"), "xandro_called": g.stats.get("xandro_called"),
		"xandro_paid": g.stats.get("xandro_paid"), "xandro_won": g.stats.get("xandro_won"),
		"xandro_dia": g.stats.get("xandro_dia"), "xandro_route": g.stats.get("xandro_route"),
		"trabajos": (g.stats.get("trabajos", {}) as Dictionary).duplicate(true),
		"folk": g.folk.data.get("xandro"),
	}
	g.side = null
	g.phase = "free"
	g.menu.close()
	if g.in_car != null:
		g.in_car.set_speed(Vector2.ZERO)
		g._exit_car()
	for k in ["koke_dia", "koke_done_h", "xandro_intro", "xandro_called", "xandro_paid", "xandro_won", "xandro_dia", "xandro_route"]:
		g.stats.erase(k)
	var td: Dictionary = g.stats.get("trabajos", {})
	td.erase("kokas")
	td.erase("xandro")
	g.stats["trabajos"] = td
	g.folk.data.erase("xandro")
	X._rung = false
	X.restore()
	await _hush_phone("Xandro's checks")

	# 1. Hidden before Koke's first job, unlocked + visible + cholo look + map giver right after on_koke_done()
	var hidden_before: bool = X.n != null and X.n.away and not X.n.visible and not X.unlocked()
	X.on_koke_done()
	await _frames(3)
	var look: Dictionary = X.n.look_data
	var look_ok: bool = int(look.get("top", -1)) == Chara.CHOLO_CAMISA and float(look.get("build", 1.0)) >= 1.2 \
		and int(look.get("face", 0)) == 8 and int(look.get("glasses", 0)) == 5 and String(look.get("hat", "")) == "beisbol"
	var dist_gar: float = X.n.p.distance_to(X.gar_pos)
	var in_givers: bool = X.n in g.marcas.givers()
	var unlocked_after: bool = X.unlocked() and not X.n.away and in_givers and dist_gar < 15.0
	_check(hidden_before and unlocked_after and look_ok,
		"Xandro is hidden before Koke's first shift (hb=%s), appears beside Talleres Xandro right after it (dist=%.1f away=%s gv=%s) in cholo outfit (build %.2f, top %d)" % [str(hidden_before), dist_gar, str(X.n.away), str(in_givers), float(look.get("build", 1.0)), int(look.get("top", -1))])

	if shots:
		g.player.p = g._pavement(X.n.p + X.gar_out * 3.0)
		g.player.sync()
		await _frames(4)
		g.phase = "selfshot"
		g.hud.play_ui.visible = false
		g.set_time(14.0)
		var fdir := Vector3(sin(X.n.h), 0.0, cos(X.n.h)).normalized()
		var npos: Vector3 = X.n.global_position
		_aim(npos + fdir * 3.1 + Vector3(0.0, 1.35, 0.0), npos + Vector3(0.0, 0.92, 0.0))
		await _shot("xandro_npc")
		var bspot: Vector2 = X._start_proj + X._start_u * 26.0
		g.set_target(bspot, true)
		g.beacon.visible = true
		var cam_b: Vector2 = X._start_proj - X._start_u * 12.0
		_aim(Vector3(cam_b.x, MapData.height(cam_b) + 4.5, cam_b.y), Vector3(bspot.x, MapData.height(bspot) + 24.0, bspot.y))
		await _shot("xandro_beacon_mision")
		g.set_target(null, false)
		g.hud.play_ui.visible = true
		g.phase = "free"

	# 2. 4h in-game phone call
	g.stats["koke_done_h"] = X.now_h() - 2.0
	X._t = 0.0
	await _frames(6)
	var quiet_early: bool = g.phone_call == null and not g.llamadas.pending("xandro")
	g.stats["koke_done_h"] = X.now_h() - 4.1
	X._t = 0.0
	var rang := false
	for k in range(60):
		await _frames(2)
		if g.phone_call != null and String(g.phone_call.get("npc", "")) == "xandro":
			rang = true
			break
	var call_txt := ""
	if rang:
		g._answer_call()
		await _frames(3)
		call_txt = " ".join(g.dlg["lines"]) if g.dlg != null else ""
		await _skip_dialog(false)
		await _frames(4)
	_check(quiet_early and rang and call_txt.contains("puto loco") and call_txt.contains("atropellando") and X.called(),
		"4 in-game hours after Koke's job without talking to Xandro he rings with his exact line (quiet at 2h)")

	# 3. Real route graph checks across all 3 Madridejos routes
	var routes_ok := true
	var r_lens: Array = []
	for r_i in range(X.ROUTES.size()):
		var rd: Dictionary = X.get_route(r_i)
		var pts: PackedVector2Array = rd.get("pts", PackedVector2Array())
		var ll: float = float(rd.get("lap_len", 0.0))
		var cps: Array = rd.get("base_cps", [])
		r_lens.append("%.0fm(%dcps)" % [ll, cps.size()])
		if pts.size() < 20 or ll < 1500.0 or cps.size() < 8:
			routes_ok = false
	_check(routes_ok, "all 3 street race routes build cleanly on Madridejos wide asphalt: %s" % ", ".join(r_lens))

	# 4. Dialogue + Economy + Loaner 10% Commission + Daily Rotation
	g.money = 500
	g.set_time(13.0)
	g.player.p = g._pavement(X.n.p + X.gar_out * 1.6)
	g.player.sync()
	await _frames(4)
	X.talk(X.n)
	await _frames(3)
	var intro_txt: String = " ".join(g.dlg["lines"]) if g.dlg != null else ""
	var has_camunas: bool = intro_txt.contains("Camuñas") and intro_txt.contains("opinables") and intro_txt.contains("Franco") and intro_txt.contains("Seta")
	await _skip_dialog(false)
	await _frames(4)
	if g._ask != null:
		g._ask_pick(0)
	await _frames(15)
	var colors: Array = []
	if X._player_car != null:
		colors.append(X._player_car.paint)
	for r in X._rivals:
		colors.append(r["car"].paint)
	var uniq := {}
	for col in colors:
		uniq[col] = true
	var grid_ok: bool = X.running() and absf(g.clock - X.NIGHT_HOUR) < 0.05 and g.money == 400 \
		and X._rivals.size() == 7 and X._player_car != null and X._player_car.kind == "panda" \
		and X._rivals.all(func(r): return r["car"].kind == "panda" and r["car"].unbreakable) \
		and uniq.size() == 8 and X._player_car.unbreakable and g.police.muted and X._tractor != null
	_check(has_camunas and grid_ok,
		"Xandro intro mentions Camuñas/opinables/Franco/Seta; accepting from 13:00 jumps to %.1f, charges 100 EUR, and puts 8 distinct-colour unbreakable Seta Pandas on the night grid (tractor cameo %s)" % [g.clock, str(X._tractor != null)])

	if shots:
		g.phase = "selfshot"
		g.hud.play_ui.visible = true
		var gp: Vector3 = X._player_car.global_position
		var gf: Vector3 = X._player_car.global_transform.basis.z
		_aim(gp - gf * 8.5 + Vector3(3.5, 4.2, 0.0), gp + gf * 11.0 + Vector3(0.0, 0.6, 0.0))
		await _shot("xandro_parrilla")
		g.phase = "free"

	# Verify countdown holds player still, then ARREA lets all 8 Seta Pandas accelerate
	var hold_ok: bool = X.countdown_hold(X._player_car, 1.0)
	X._cd_t = 0.05
	await _frames(35)
	var moved_ok: bool = X._rivals.all(func(r): return r["car"].p.distance_to(X._start_proj) > 1.5 or r["car"].forward_speed() > 2.0)
	_check(hold_ok and moved_ok and g.side["stage"] == "race",
		"countdown holds throttle at the line, and after ARREA all Seta Pandas launch onto the route")

	# Simulate losing initial mission (5th place) -> free retry & money stays 400
	X._finish(5, false)
	await _frames(4)
	var retry_ok: bool = not X.running() and not X.mission_won() and X.entry_fee() == 0 and g.money == 400 and not g.police.muted and X.current_route_idx() == 0
	# Win initial mission with loaner car (1st place) -> 500 - 10% = 450 EUR
	g.stats["xandro_dia"] = int(g.day_n)
	X._begin_race(0, null, true)
	await _frames(3)
	X._finish(1, false)
	await _frames(4)
	var won_mission_ok: bool = X.mission_won() and g.money == 850 and not X.available() and X.current_route_idx() == 1
	# Next day with player's own Seta Panda -> pays 100 EUR, wins 2nd (200 EUR net, 0% commission), advances to route 2
	g.day_n += 1
	var own_panda = load("res://scripts/car.gd").new()
	g.add_child(own_panda)
	own_panda.setup("panda", 0xe6c229, X.n.p + Vector2(3.0, 0.0), 0.0)
	g.cars.append(own_panda)
	var found_own: bool = X.find_player_seta() == own_panda and X.entry_fee() == 100 and X.available()
	g.money -= 100
	g.stats["xandro_dia"] = int(g.day_n)
	X._begin_race(1, own_panda, false)
	await _frames(3)
	X._finish(2, false)
	await _frames(4)
	var won_own_ok: bool = g.money == 950 and X.current_route_idx() == 2 and is_instance_valid(own_panda)
	# Next day: daily loss (6th) loses the 100 EUR fee and rotates back to route 0
	g.day_n += 1
	g.money -= 100
	g.stats["xandro_dia"] = int(g.day_n)
	X._begin_race(2, null, true)
	await _frames(3)
	X._finish(6, false)
	await _frames(4)
	var lost_daily_ok: bool = g.money == 850 and X.current_route_idx() == 0
	g.cars.erase(own_panda)
	own_panda.queue_free()
	_check(retry_ok and won_mission_ok and found_own and won_own_ok and lost_daily_ok,
		"economy & rotation: mission loss keeps retry free (400), 1st with loaner pays 450 (-10%%, total 850), daily own-Seta 2nd pays 200 full (-100+200=950), daily loss keeps 100 EUR lost (850) and rotates routes 0->1->2->0")

	# Restore clean game state
	X.abort(true)
	g.money = saved["money"]
	g.day_n = saved["day_n"]
	g.set_time(saved["clock"])
	for k in ["koke_dia", "koke_done_h", "xandro_intro", "xandro_called", "xandro_paid", "xandro_won", "xandro_dia", "xandro_route"]:
		if saved[k] == null:
			g.stats.erase(k)
		else:
			g.stats[k] = saved[k]
	g.stats["trabajos"] = saved["trabajos"]
	if saved["folk"] == null:
		g.folk.data.erase("xandro")
	else:
		g.folk.data["xandro"] = saved["folk"]
	g.police.muted = saved["muted"]
	g.player.p = saved["p"]
	g.player.sync()
	g.phase = saved["phase"]
	X.restore()
	g._refresh_counts()
	await _frames(3)

## Josefa's Vizum (the user, 23 Nov 2026; Paca's at first): the tax debt told, walk away from Tía Paca and Josefa rings, "una cosa es serlo y otra
## paecerlo", 20 € for some decent clothes; hung up, the clothes shops open to you, a peseta on the map at each.
func _vizum_checks() -> void:
	var F = g.fondo_casa
	var TR = g.tiendas_ropa
	var saved := {"money": g.money, "curro": g.stats.get("curro"), "vizum": g.stats.get("vizum"), "p": g.player.p, "phase": g.phase}
	g.side = null
	g.phase = "free"
	g.menu.close()
	if g.in_car != null:
		g.in_car.set_speed(Vector2.ZERO)
		g._exit_car()
	await _hush_phone("the Vizum's checks")
	g.stats["curro"] = true
	g.stats.erase("vizum")
	F._vizum_rung = false
	var mx = g.world.get("maxiprecio")
	var paca = g.named["paca"]
	var R = g.rondas                             # (Tía Paca at her door for this: on a visit to the cemetery, "20 m from her" and "90 m
	var graves: Array = R.zones.get("cementerio", [])      # from her" are both the town's far edge, the nearest pavement there is)
	R.zones["cementerio"] = []
	if R.base.has("paca") and paca.p.distance_to(R.base["paca"][0]) > 1.0:
		print("  ..    Tía Paca was %.0f m from her door at the Vizum's checks: back" % paca.p.distance_to(R.base["paca"][0]))
		paca.p = R.base["paca"][0]
		paca.home = paca.p
		paca.state = "idle"
		paca.sync()
		R._at.erase("paca")
	var shut_now: bool = TR.marks().is_empty() and (mx == null or not (mx.dentro in g.entradas.shops()))
	g.player.p = g._pavement(paca.p + Vector2(20.0, 0.0))     # (near Tía Paca: Josefa does not ring)
	g.player.sync()
	F._t = 0.0
	await _frames(6)
	var quiet_near: bool = g.phone_call == null and not g.llamadas.pending("josefa")
	g.player.p = g._pavement(paca.p + Vector2(90.0, 0.0))     # (well away: she does)
	g.player.sync()
	F._t = 0.0
	var rang := false
	for k in range(60):
		await _frames(2)
		if g.phone_call != null:
			rang = g.phone_call["npc"] == "josefa"
			break
	var m0: int = g.money
	var said := ""
	if rang:
		g._answer_call()
		await _frames(3)
		said = " ".join(g.dlg["lines"]) if g.dlg != null else ""
		await _skip_dialog(false)
		await _frames(3)
	var open_now: bool = g.stats.has("vizum") and g.money == m0 + F.VIZUM and (mx == null or mx.dentro in g.entradas.shops()) and TR.marks().size() == TR.SHOPS.keys().filter(func(id): return g.world.get(id) != null).size() 		and TR.marks().all(func(m): return m["kind"] in TR.KINDS and m["p"] is Vector2) and TR.SHOPS["maxiprecio"] == "ropa" and TR.SHOPS["tetoqa"] == "complementos"
	R.zones["cementerio"] = graves
	if not (shut_now and quiet_near and rang and open_now):
		print("  ..    the Vizum: shut %s, quiet near her %s, rang %s, open after %s; Tía Paca at %s" % [shut_now, quiet_near, rang, open_now, paca.p])
	_check(shut_now and quiet_near and rang and said.contains("paecerlo") and said.contains("Vizum") and open_now and g.phone_call == null,
		"the debt told, the clothes shops are shut to you; well away from Tía Paca, Josefa rings with a Vizum of %d euros (\"una cosa es serlo y otra paecerlo\"), and hung up they open, each with its icon on the map (shirt, ring, shoe on the peseta's coin)" % F.VIZUM)
	F._t = 0.0
	await _frames(6)
	_check(g.phone_call == null and not g.llamadas.pending("josefa"), "and she does not ring with it again")
	if shots and mx != null:
		g.player.p = g._pavement(mx.door + Vector2(-25.0, 0.0))
		g.player.sync()
		await _shot("vizum_minimapa")
		g._set_map(true)
		await _shot("vizum_mapa")
		g._set_map(false)
	# restore
	g.money = saved["money"]
	for k in ["curro", "vizum"]:
		if saved[k] == null:
			g.stats.erase(k)
		else:
			g.stats[k] = saved[k]
	g.player.p = saved["p"]
	g.player.sync()
	g.phase = saved["phase"]
	g._refresh_counts()
	await _frames(3)

## The MaxiPrecio's fitting room and Maxi (the user, 23 Nov 2026): every garment at 20 €, straight to your wardrobe at
## home, and out of the shop as you came in; Maxi at his till while the shop is open, his maxis, "¿te pruebas algo?".
func _ropa_checks() -> void:
	var saved := {"money": g.money, "sel": g.look_sel.duplicate(), "armario": (g.armario_owned() as Dictionary).duplicate(true), "p": g.player.p, "phase": g.phase, "maxi": g.stats.get("maxi"), "vizum": g.stats.get("vizum")}
	g.stats["vizum"] = 1                         # (the shop open to you: tiendas_ropa.gd, _vizum_checks)
	g.side = null
	g.phase = "free"
	g.menu.close()
	if g.in_car != null:
		g.in_car.set_speed(Vector2.ZERO)
		g._exit_car()
	var R: int = g.ROPA
	var sale: Array = g.ropa_for_sale()
	var own: Array = (g.armario_owned()[str(R)] as Array).duplicate()
	var fresh: Array = sale.filter(func(v): return not own.has(v))
	var tee_out: bool = not sale.any(func(v): return int(g.Creator.OPTIONS[R]["values"][v]) == g.Creator.PENA_TEE)
	_check(sale.size() >= 15 and not fresh.is_empty() and tee_out, "a clothes shop has every garment there is (%d; the peña's T-shirt only at home), %d of them not in your wardrobe yet" % [sale.size(), fresh.size()])
	var was: Array = g.look_sel.duplicate()
	g.money = 50
	g.open_shop_ropa(g.player.p, 0.0, Vector2.ZERO, 20, null)
	await _frames(3)
	var opened: bool = g.phase == "armario" and g.shop_ropa != null
	for _w in range(40):                         # (the pictures come a few at a time)
		if not g._ropa_drawing:
			break
		await _frames(5)
	var shown: Array = g.hud.shop_cells.filter(func(c): return (c["btn"] as Button).visible)
	var drawn: int = shown.filter(func(c): return (c["icon"] as TextureRect).texture != null).size()
	var draws: bool = DisplayServer.get_name() != "headless"      # (with no window the SubViewports draw nothing: the pictures are checked by `maxi shots`)
	var grid_ok: bool = g.hud.shop_scroll.visible and not g.hud.creator_rows_box.visible and shown.size() == sale.size() and (drawn == sale.size() or not draws)
	var k_last: int = sale.size() - 1
	g._armario_input("pick_%d" % k_last)        # (a click on the last picture: it is put on)
	await _frames(2)
	grid_ok = grid_ok and int(g.look_sel[R]) == int(sale[k_last])
	_check(grid_ok, "the fitting room shows every garment as a picture of you in it (%d of %d drawn), in a grid that scrolls, a click on one puts it on" % [drawn, sale.size()])
	# the colour: the triggers (Z / X, the row's arrows) change it; a new colour is bought with the garment
	var c_was: int = int(g.look_sel[g.ROPA_COLOUR])
	var have_cols: Array = (g.armario_owned()[str(g.ROPA_COLOUR)] as Array).duplicate()
	g._armario_input("pick_%d" % sale.find(fresh[0]))
	var gc := 0
	while (have_cols.has(int(g.look_sel[g.ROPA_COLOUR])) or g.Creator.not_used(g.look_sel, g.ROPA_COLOUR)) and gc < 20:
		g._armario_input("col_next")
		gc += 1
	await _frames(2)
	var c_new: int = int(g.look_sel[g.ROPA_COLOUR])
	var row_ok: bool = g.hud.shop_colour.visible and g.hud.shop_colour_lab.text.contains(String(Loc.t("c_values")[g.ROPA_COLOUR][c_new]))
	var redrawn := false
	for _w in range(40):
		await _frames(5)
		if not g._ropa_drawing:
			break
	redrawn = g._ropa_tex.has(g._ropa_key(fresh[0])) or not draws
	if shots:
		await _shot("maxi_probador_color")
	var m1: int = g.money
	g._armario_input("accept")
	await _frames(2)
	var both: bool = g.money == m1 - 20 and (g.armario_owned()[str(R)] as Array).has(fresh[0]) and (g.armario_owned()[str(g.ROPA_COLOUR)] as Array).has(c_new)
	g._armario_input("col_prev")
	await _frames(2)
	var other_col_price: bool = int(g.look_sel[g.ROPA_COLOUR]) == c_new or g.hud.creator_next.text.contains("20") or (g.armario_owned()[str(g.ROPA_COLOUR)] as Array).has(int(g.look_sel[g.ROPA_COLOUR]))
	_check(c_new != c_was and row_ok and redrawn and both and other_col_price,
		"the triggers change the colour of what you try on (%s), the pictures drawn again in it, and you buy the garment in that colour (both to your wardrobe)" % String(Loc.t("c_values")[g.ROPA_COLOUR][c_new]))
	g.money = 50
	g._armario_input("pick_%d" % sale.find(int(was[R])) if sale.has(int(was[R])) else "pick_0")
	g.look_sel[g.ROPA_COLOUR] = c_was
	fresh = fresh.filter(func(v): return not (g.armario_owned()[str(R)] as Array).has(v))
	var guard := 0
	while not fresh.has(int(g.look_sel[R])) and guard < 60:      # (round to one you do not have)
		g._armario_input("right")
		guard += 1
	var pick: int = int(g.look_sel[R])
	opened = opened and g.hud.creator_next.text.contains("20")      # (the button names the price of one you have not got)
	if shots:
		await _shot("maxi_probador")
	g._armario_input("accept")
	await _frames(2)
	var bought: bool = g.money == 30 and (g.armario_owned()[str(R)] as Array).has(pick) and g.phase == "armario"
	g._armario_input("accept")                   # (the same one again: already yours, nothing taken)
	await _frames(2)
	var twice_no: bool = g.money == 30
	g._armario_input("right")
	guard = 0
	while (g.armario_owned()[str(R)] as Array).has(int(g.look_sel[R])) and guard < 60:
		g._armario_input("right")
		guard += 1
	g.money = 10
	g._armario_input("accept")
	await _frames(2)
	var poor_no: bool = g.money == 10 and not (g.armario_owned()[str(R)] as Array).has(int(g.look_sel[R]))
	g._armario_input("back")
	await _frames(3)
	var left_same: bool = g.phase == "free" and g.shop_ropa == null and g.look_sel == was
	_check(opened and bought and twice_no and poor_no and left_same,
		"in the fitting room you try them on and buy one for 20 euros (%s: to your wardrobe), nothing for what you have or cannot pay, and you leave as you came in" % String(Loc.t("c_values")[R][pick]))
	# at home: what you bought is in the wardrobe
	var at_home: bool = (g.armario_owned()[str(R)] as Array).has(pick)
	_check(at_home, "and it is there in your wardrobe at home, to put on")
	# Maxi, once the MaxiPrecio's inside is built (Pretil's)
	var M = g.maxi
	if M == null or M.n == null:
		print("  --    Maxi waits for the MaxiPrecio's inside (maxiprecio_dentro.gd, Pretil's)")
	else:
		var d = M._inside()
		g.set_time(11.0)
		var wd: int = g.weekday
		g.weekday = 0
		await _frames(4)                             # (the shop opens on its own frame: maxiprecio.gd _process)
		M._t = 0.0
		M.tick(0.1)
		var there: bool = not M.n.away and M.open()
		g.set_time(15.5)
		await _frames(4)
		M._t = 0.0
		M.tick(0.1)
		var gone_shut: bool = M.n.away
		g.set_time(11.0)
		await _frames(4)
		M._t = 0.0
		M.tick(0.1)
		g.stats.erase("maxi")
		g.player.p = M.n.p + Vector2(1.0, 0.0)
		g.talk_to(M.n)
		await _frames(3)
		var hello: String = " ".join(g.dlg["lines"]) if g.dlg != null else ""
		await _skip_dialog(false)
		var asked: bool = g._ask != null and (g._ask["options"] as Array).size() == 2
		if asked:
			g._ask_pick(0)
		await _frames(3)
		var fitting: bool = g.phase == "armario" and g.shop_ropa != null and g.shop_ropa["who"] == M.n
		if shots:
			await _shot("maxi_probador_tienda")
		g._armario_input("back")
		await _frames(3)
		await _skip_dialog(false)
		var maxis: int = hello.countn("maxi")
		_check(there and gone_shut and maxis >= 3 and asked and fitting and g.phase != "armario",
			"Maxi at his till while the MaxiPrecio is open and not when it is shut; his hello full of maxis (%d), then «¿te pruebas algo?» and the fitting room" % maxis)
		g.weekday = wd
	# restore
	g.money = saved["money"]
	g.look_sel = saved["sel"]
	g.stats["armario"] = saved["armario"]
	for k in ["maxi", "vizum"]:
		if saved[k] == null:
			g.stats.erase(k)
		else:
			g.stats[k] = saved[k]
	g._apply_look()
	g.player.p = saved["p"]
	g.player.sync()
	g.phase = saved["phase"]
	g._refresh_counts()
	await _frames(3)

## The Modo Chavisca (the user, 23 Nov 2026: "en vez de Continuar y Nueva partida estas dos opciones estarán dentro de
## Modo Historia. Debajo de modo historia estará Modo Chavisca. Un modo con sus guardados aparte sin misiones, sin heat
## level, sin azafrán. Solo dar vueltas por el pueblo y hablar con los NPCs"): the main menu's two modes, each its
## Continuar and Nueva partida; its saves apart; no prologue; out on your pavement with nothing to do; no offers, no
## calls, no police, no saffron; talk is only talk; and a saved game goes on as it was.
func _chavisca_checks() -> void:
	var paths: Array = []
	for mode in [false, true]:
		g.chavisca = mode
		for i in range(3):
			paths.append(g._slot_path(i))
			if FileAccess.file_exists(g._slot_path(i)):
				DirAccess.remove_absolute(g._slot_path(i))
	g.chavisca = false
	g.phase = "title"
	g.menu.open("main")
	var main_items: Array = g._menu_page("main")["items"].map(func(it): return it["text"])
	if shots:
		await _shot("chavisca_menu")
	g._open_mode(true)
	await _frames(3)
	var page_ok: bool = g.menu.page == "chavisca" and g._menu_page("chavisca")["items"].map(func(it): return it["text"]) == [Loc.t("menu_new"), Loc.t("m_back")]
	if shots:
		await _shot("chavisca_pagina")
	_check(main_items == [Loc.t("menu_story"), Loc.t("menu_chavisca"), Loc.t("m_settings"), Loc.t("m_howto"), Loc.t("m_credits"), Loc.t("m_quit")] and page_ok
		and g._slot_path(0).contains("chavisca_") and not paths[0].contains("chavisca_"),
		"the main menu: Modo Historia and Modo Chavisca, each with its own Continuar/Nueva partida and its own saves")
	g._new_game(0)
	await _frames(3)
	_check(g.phase == "creator", "a new Modo Chavisca game goes straight to your character, no prologue")
	g.hud.hide_creator()
	g.money = 0
	g.stats["nombre"] = "Prueba"
	g._chavisca_begin()
	await _frames(10)
	var flowers_shown: int = g.flowers.filter(func(f): return is_instance_valid(f["node"]) and f["node"].visible).size()
	var saved = g._load_slot(0)
	_check(g.phase == "play" and g.si == g._idx("tbc") and g.in_car == null and g.player.p.distance_to(g._home_pavement) < 0.5 and flowers_shown == 0
		and not g.hud.tally[1][0].visible and g.marcas.givers().is_empty() and g.hud.obj_text.text.contains("Golismeo")
		and saved != null and bool(saved.get("chavisca", false)) and not FileAccess.file_exists(paths[0]),
		"it starts on foot by your door with nothing to do: no saffron (%d shown, none on the tally), nobody with a mission on the map, saved apart" % flowers_shown)
	await _frames(3)
	var pause_items: Array = g._menu_page("pause")["items"].map(func(it): return it["text"])
	var games: Array = g._menu_page("minijuegos")["items"].filter(func(it): return it.has("do") and it["text"] != Loc.t("m_back"))
	_check(not g.hud.obj_slot.visible and not g.hud.tally_slot.visible and not g.hud.map_slot.visible and pause_items.has(Loc.t("m_minigames")) and not pause_items.has(Loc.t("m_log"))
		and games.size() >= 6 and g.recress.done() and g.ajedrez.game_open() and int(g.unlocked.get("jamon", 0)) > 0 and int(g.unlocked.get("box", 0)) > 0,
		"no calendar, slate or minimap; Minijuegos in the pause menu instead of the Agenda, every one open (%d to play), the Galaxy Recress and the chess too" % games.size())
	var here: Vector2 = g.player.p + Vector2(40.0, 0.0)
	g.put_pin(here)
	var pinned: bool = g.track_pick == "pin" and g._guide_target() == here and g._map_missions().any(func(m): return m["id"] == "pin")
	g.player.p = here + Vector2(2.0, 0.0)
	await _frames(4)
	_check(pinned and g.map_pin == null and g.track_pick == "none", "your own marker on the big map takes the arrow there, and goes when you get there")
	g.player.p = g._home_pavement
	g.police.add_heat(80.0)
	g.limite._start(g.player.p)
	var heat_ok: bool = g.police.heat == 0.0 and not g.police.chasing and not g.limite.hunting
	g.llamadas.ring({"npc": "paca", "lines": "paca_call", "ring_first": 0.1})
	await _frames(3)
	var no_call: bool = g.phone_call == null and g.llamadas.queue.is_empty()
	g._weekly_call()
	_check(heat_ok and no_call and g.side == null, "no Tricornios (no heat, no chase at the edge of the map), and nobody rings")
	var talked: Array = []
	for id in ["josefa", "tomasa", "alberto", "fatima"]:
		var n = g.named.get(id)
		if id == "tomasa" and g.tomasa != null:
			n = g.tomasa.get("n")
		if id == "fatima" and g.fatima != null:
			n = g.fatima.n
		if n == null or not is_instance_valid(n):
			continue
		g.player.p = n.p + Vector2(1.0, 0.0)
		g.talk_to(n)
		await _frames(3)
		var said: bool = g.dlg != null
		await _skip_dialog(false)
		await _frames(3)
		if said and g._ask == null and g.menu.page != "choice" and g.side == null and g.phase == "play" and g.shop_ropa == null:
			talked.append(id)
		g.phase = "play"
	_check(talked.size() >= 3, "talking is only talking: no offers, no errands, no shop (%s)" % ", ".join(talked))
	g.money = 31
	g._save(g.si)
	g.money = 0
	g._continue(0)
	await _frames(5)
	_check(g.money == 31 and g.chavisca and g.si == g._idx("tbc") and g.in_car == null and not g.hud.tally[1][0].visible, "a Modo Chavisca game goes on where it was saved")
	for q in paths:
		if FileAccess.file_exists(q):
			DirAccess.remove_absolute(q)
	g.chavisca = false

## The Óptica Corsa's Fátima Corsa and its mirror of glasses (the user, 23 Nov 2026, through Pretil: "una Óptica con
## bata blanca y solo venderá gafas"; "gafas en las ópticas y complementos en las tiendas de complementos"). The screen
## is tried even before Pretil's set is there: every pair but none, the pirate's patch too ("cosa de ojos"), no colour
## row, pictures of your face, the first pair given ("te regala las primeras gafas"), the next at 20 € to your
## wardrobe, nothing for what you have or cannot pay, out as you came in. With the set, she is behind its counter while
## it is open, and talking to her ends at the mirror.
func _fatima_checks() -> void:
	var F = g.fatima
	var TR = g.tiendas_ropa
	_check(TR.KINDS.has("gafas") and TR.SHOPS.get("optica") == "gafas" and TR.SHOPS.get("tetoqa") == "complementos",
		"glasses have shops of their own on the map (the opticians, a pair of glasses on the coin), the Tetoqa keeps the accessories")
	var saved := {"money": g.money, "sel": g.look_sel.duplicate(), "armario": (g.armario_owned() as Dictionary).duplicate(true), "p": g.player.p, "phase": g.phase,
		"fatima": g.stats.get("fatima"), "vizum": g.stats.get("vizum"), "koke": g.stats.get("koke"), F.GIFT: g.stats.get(F.GIFT)}
	g.stats.erase(F.GIFT)
	g.side = null
	g.phase = "free"
	g.menu.close()
	if g.in_car != null:
		g.in_car.set_speed(Vector2.ZERO)
		g._exit_car()
	var was: Array = g.look_sel.duplicate()
	var wd: int = g.weekday
	if F.n != null:
		g.stats["vizum"] = 1
		g.stats["koke"] = g.day_n
		g.weekday = 0
		g.set_time(11.0)
		await _frames(4)
		F._t = 0.0
		F.tick(0.1)
		var there: bool = not F.n.away and F.open()
		g.stats.erase("fatima")
		g.player.p = F.n.p + Vector2(1.0, 0.0)
		g.talk_to(F.n)
		await _frames(3)
		await _skip_dialog(false)
		var tested: bool = (Loc.t("fatima_test") as Array).size() == 3 and String(Loc.t("fatima_test")[2]).contains("cara de pobre")
		var asked: bool = g._ask != null and (g._ask["options"] as Array).size() == 2 and tested
		if asked:
			g._ask_pick(0)
		await _frames(3)
		_check(there and asked and g.phase == "armario" and g.shop_ropa != null and g.shop_ropa["who"] == F.n and F.n.shown_name() == "Fátima Corsa",
			"Fátima Corsa behind the Óptica Corsa's counter while it is open; talked to the first time, she tests your eyes, offers you a pair, and the mirror opens")
	else:
		print("  --    Fátima waits for the Óptica Corsa's inside (optica_dentro.gd, Pretil's): the mirror is tried on its own")
		F.try_on()
		await _frames(3)
	var GL: int = F.GLASSES
	var sale: Array = g.ropa_for_sale()
	for _w in range(40):
		if not g._ropa_drawing:
			break
		await _frames(5)
	var shown: Array = g.hud.shop_cells.filter(func(c): return (c["btn"] as Button).visible)
	var drawn: int = shown.filter(func(c): return (c["icon"] as TextureRect).texture != null).size()
	var n_all: int = (g.Creator.OPTIONS[GL]["values"] as Array).size()
	_check(g.phase == "armario" and g._so() == GL and g._sc() < 0 and sale.size() == n_all - 1 and not sale.has(0) and sale.has(11) and int(g.shop_ropa["price"]) == 0
		and not g.hud.shop_colour.visible and shown.size() == sale.size() and (drawn == sale.size() or DisplayServer.get_name() == "headless") and String(g.shop_ropa["title"]) == "arm_shop_title_gafas",
		"the optician's mirror has every pair of glasses but none, the pirate's patch too (%d), the first given (0 €), no colour row (they come in their own), each a picture of your face (%d drawn)" % [sale.size(), drawn])
	var own: Array = (g.armario_owned().get(str(GL), []) as Array).duplicate()
	var fresh: Array = sale.filter(func(v): return not own.has(v))
	g._armario_input("pick_%d" % sale.find(fresh[0]))
	for _w in range(40):
		await _frames(5)
		if not g._ropa_drawing:
			break
	if shots:
		await _shot("fatima_espejo")
	g.money = 50
	g._armario_input("accept")
	await _frames(2)
	var gift: bool = g.money == 50 and (g.armario_owned()[str(GL)] as Array).has(fresh[0]) and g.stats.has(F.GIFT) and not F.gift_due() and int(g.shop_ropa["price"]) == F.PRICE
	var second: int = sale.filter(func(v): return not (g.armario_owned().get(str(GL), []) as Array).has(v))[0]
	g._armario_input("pick_%d" % sale.find(second))
	await _frames(2)
	g._armario_input("accept")
	await _frames(2)
	var keys_ok: bool = not g.armario_owned().has("-1")
	var bought: bool = gift and g.money == 50 - F.PRICE and (g.armario_owned()[str(GL)] as Array).has(second) and keys_ok
	g._armario_input("accept")
	await _frames(2)
	var twice_no: bool = g.money == 50 - F.PRICE
	g.money = 10
	var guard := 0
	while (g.armario_owned()[str(GL)] as Array).has(int(g.look_sel[GL])) and guard < 30:
		g._armario_input("right")
		guard += 1
	g._armario_input("accept")
	await _frames(2)
	var poor_no: bool = g.money == 10
	g._armario_input("back")
	await _frames(3)
	var left_same: bool = g.phase == "free" and g.shop_ropa == null and g.look_sel == was
	_check(bought and twice_no and poor_no and left_same,
		"at the mirror the first pair is hers (%s, 0 €), the next %d euros (to your wardrobe, and no colour with it), nothing for what you have or cannot pay, and you leave as you came in"
		% [String(Loc.t("c_values")[GL][fresh[0]]), F.PRICE])
	g.weekday = wd
	g.money = saved["money"]
	g.look_sel = saved["sel"]
	g.stats["armario"] = saved["armario"]
	for k in ["fatima", "vizum", "koke", F.GIFT]:
		if saved[k] == null:
			g.stats.erase(k)
		else:
			g.stats[k] = saved[k]
	g._apply_look()
	g.player.p = saved["p"]
	g.player.sync()
	g.phase = saved["phase"]
	g._refresh_counts()
	await _frames(3)

## The Pisacastaña's Manuela Moreno and its bench (the user, 23 Nov 2026: "Las dos opciones me gustan"; her name,
## "Manuela Moreno"; every shoe at 20 €): behind the counter while the shop is open, her pisas, "¿te pruebas algo?",
## the bench with every shoe but going barefoot, pictures of your feet, what you buy to your wardrobe, out as you came.
func _manuela_checks() -> void:
	var M = g.manuela
	if M == null or M.n == null:
		print("  --    Manuela waits for the Pisacastaña's inside (pisacastana_dentro.gd, Pretil's)")
		return
	var saved := {"money": g.money, "sel": g.look_sel.duplicate(), "armario": (g.armario_owned() as Dictionary).duplicate(true), "p": g.player.p, "phase": g.phase,
		"manuela": g.stats.get("manuela"), "vizum": g.stats.get("vizum"), "koke": g.stats.get("koke")}
	g.stats["vizum"] = 1                         # (the shop open to you: tiendas_ropa.gd)
	g.stats["koke"] = g.day_n                    # (or Koke rings an hour after the Vizum)
	g.side = null
	g.phase = "free"
	g.menu.close()
	if g.in_car != null:
		g.in_car.set_speed(Vector2.ZERO)
		g._exit_car()
	var was: Array = g.look_sel.duplicate()
	# at her counter while the shop is open (Monday 11:00), not at four (shut from half past one to five)
	var wd: int = g.weekday
	g.weekday = 0
	g.set_time(11.0)
	await _frames(4)
	M._t = 0.0
	M.tick(0.1)
	var there: bool = not M.n.away and M.open()
	g.set_time(16.0)
	await _frames(4)
	M._t = 0.0
	M.tick(0.1)
	var gone_shut: bool = M.n.away
	g.set_time(11.0)
	await _frames(4)
	M._t = 0.0
	M.tick(0.1)
	# her hello, the question, the bench
	g.stats.erase("manuela")
	g.player.p = M.n.p + Vector2(1.0, 0.0)
	g.talk_to(M.n)
	await _frames(3)
	var hello: String = " ".join(g.dlg["lines"]) if g.dlg != null else ""
	await _skip_dialog(false)
	var asked: bool = g._ask != null and (g._ask["options"] as Array).size() == 2
	if asked:
		g._ask_pick(0)
	await _frames(3)
	if shots:
		await _shot("manuela_tienda")
	var bench: bool = g.phase == "armario" and g.shop_ropa != null and g.shop_ropa["who"] == M.n and g._so() == M.SHOE and g._sc() == M.SHOE_COLOUR
	var pisas: int = hello.countn("pisa")
	_check(there and gone_shut and pisas >= 3 and asked and bench and M.n.shown_name() == "Manuela Moreno",
		"Manuela Moreno behind the Pisacastaña's counter while it is open and not when it is shut; her hello full of pisas (%d), then «¿te pruebas algo?» and the bench" % pisas)
	if not bench:
		g.weekday = wd
		return
	var S: int = M.SHOE
	var C: int = M.SHOE_COLOUR
	var sale: Array = g.ropa_for_sale()
	var barefoot: int = int(g.Creator.NOTHING[S])
	for _w in range(40):                         # (the pictures come a few at a time)
		if not g._ropa_drawing:
			break
		await _frames(5)
	var shown: Array = g.hud.shop_cells.filter(func(c): return (c["btn"] as Button).visible)
	var drawn: int = shown.filter(func(c): return (c["icon"] as TextureRect).texture != null).size()
	var title_ok: bool = String(g.shop_ropa["title"]) == "arm_shop_title_zapatos" and String(Loc.t("arm_shop_title_zapatos")).contains("Pisacastaña")
	_check(sale.size() == (g.Creator.OPTIONS[S]["values"] as Array).size() - 1 and not sale.has(barefoot) and shown.size() == sale.size() and (drawn == sale.size() or DisplayServer.get_name() == "headless") and title_ok,
		"the bench has every shoe there is but going barefoot (%d), each a picture of your feet in it (%d drawn)" % [sale.size(), drawn])
	# a pair you have not got, in a colour you have not got either: 20 euros, both to your wardrobe
	var own: Array = (g.armario_owned()[str(S)] as Array).duplicate()
	var fresh: Array = sale.filter(func(v): return not own.has(v))
	g._armario_input("pick_%d" % sale.find(fresh[0]))
	var have_cols: Array = (g.armario_owned()[str(C)] as Array).duplicate()
	var gc := 0
	while (have_cols.has(int(g.look_sel[C])) or g.Creator.not_used(g.look_sel, C)) and gc < 20:
		g._armario_input("col_next")
		gc += 1
	await _frames(2)
	for _w in range(40):
		await _frames(5)
		if not g._ropa_drawing:
			break
	if shots:
		await _shot("manuela_banco")
	g.money = 50
	var c_new: int = int(g.look_sel[C])
	g._armario_input("accept")
	await _frames(2)
	var bought: bool = g.money == 30 and (g.armario_owned()[str(S)] as Array).has(fresh[0]) and (g.armario_owned()[str(C)] as Array).has(c_new)
	g._armario_input("accept")                   # (the same again: yours already, nothing taken)
	await _frames(2)
	var twice_no: bool = g.money == 30
	g.money = 10
	var guard := 0
	while (g.armario_owned()[str(S)] as Array).has(int(g.look_sel[S])) and guard < 30:
		g._armario_input("right")
		guard += 1
	g._armario_input("accept")
	await _frames(2)
	var poor_no: bool = g.money == 10
	g._armario_input("back")
	await _frames(3)
	var left_same: bool = g.phase == "free" and g.shop_ropa == null and g.look_sel == was
	_check(bought and twice_no and poor_no and left_same,
		"on the bench you buy a pair for 20 euros (%s, in %s: both to your wardrobe), nothing for what you have or cannot pay, and you leave as you came in"
		% [String(Loc.t("c_values")[S][fresh[0]]), String(Loc.t("c_values")[C][c_new])])
	# restore
	g.weekday = wd
	g.money = saved["money"]
	g.look_sel = saved["sel"]
	g.stats["armario"] = saved["armario"]
	for k in ["manuela", "vizum", "koke"]:
		if saved[k] == null:
			g.stats.erase(k)
		else:
			g.stats[k] = saved[k]
	g._apply_look()
	g.player.p = saved["p"]
	g.player.sync()
	g.phase = saved["phase"]
	g._refresh_counts()
	await _frames(3)

## Saffron hidden in special places (the user, 21 Nov 2026, through Pretil: "sería buena idea esconder azafrán en
## ubicaciones especiales"): a flower with "hidden" and an "id" counts once, is kept in stats, and shows in the Agenda.
func _saffron_hidden_checks() -> void:
	var was_found = g.stats.get("saffron_hidden")
	var was_saffron: int = g.saffron
	var was_money: int = g.money
	var was_p: Vector2 = g.player.p
	g.stats.erase("saffron_hidden")
	var spot: Vector2 = g.player.p + Vector2(6.0, 0.0)
	var node := Node3D.new()
	g.add_child(node)
	var entry := {"node": node, "p": spot, "hidden": true, "id": "prueba"}
	g.flowers.append(entry)
	var before: Array = g.hidden_saffron()
	g.player.p = spot
	await _frames(6)
	g.player.sync()                                  # (taken by walking over it, the one thing that is: 23 Nov 2026)
	await _frames(4)
	var after: Array = g.hidden_saffron()
	var page: Array = g._menu_page("log_bg")["items"]
	var shown: bool = page.any(func(it): return String(it.get("text", "")).contains(Loc.t("log_saffron_hidden") % [after[0], after[1]]))
	_check(entry.get("gone", false) and not node.visible and "prueba" in g.stats.get("saffron_hidden", []) and after[0] == before[0] + 1 and g.saffron == was_saffron + 1 and shown,
		"a saffron flower hidden in a special place counts once and is kept (%d of %d hidden found), and the Agenda says so" % [after[0], after[1]])
	g.flowers.erase(entry)
	node.queue_free()
	g.saffron = was_saffron
	g.money = was_money
	g.player.p = was_p
	if was_found == null:
		g.stats.erase("saffron_hidden")
	else:
		g.stats["saffron_hidden"] = was_found
	await _frames(2)

## The house you inherit (fondo_casa.gd, the user, 21 Nov 2026), a "de fondo" line: Tia Paca rings once the bridge is
## unlocked, the tax office's 10.000 EUR, paid a bit at a time at the Banco Cantabria's cash machine; paid off, Edmundo
## Monedero rings and sells you the first step; it is up the next morning and what it costs is owed at the cash machine.
## With --shots, pictures of him at the bank, the cash machine's question and the Agenda's "De fondo" page.
func _casa_checks() -> void:
	var F = g.fondo_casa
	var B = g.world.bancosancho
	var saved := {"money": g.money, "day_n": g.day_n, "clock": g.clock, "weekday": g.weekday, "p": g.player.p,
		"casa": g.stats.get("casa"), "puente_h": g.stats.get("puente_h"), "vizum": g.stats.get("vizum"), "vizum_h": g.stats.get("vizum_h"), "koke": g.stats.get("koke")}
	g.stats.erase("casa")
	g.stats["vizum"] = 0                         # (Josefa's Vizum and Koke's call had: neither rings in the middle of these, away from Tía Paca)
	g.stats["vizum_h"] = -100.0
	g.stats["koke"] = 0
	g.side = null
	g.phase = "free"
	g.menu.close()
	if g.in_car != null:
		g.in_car.set_speed(Vector2.ZERO)
		g._exit_car()
	if g.phone_call != null:
		g._hang_up()
	g.llamadas.reset()
	g.weekday = 0
	g.set_time(10.0)
	g.stats["puente_h"] = g.llamadas.now() - 0.1
	if g.si < 0:
		g.si = g._idx("tbc")                # (run on its own: the story stands where the bridge leaves it)
	F.restore()
	var paca = g.named["paca"]
	g.player.p = paca.p + Vector2(1.6, 0.4)
	g.leaf_refresh()
	await _frames(25)
	var at_end: bool = g.si >= 0 and g.side == null and (g.phase == "free" or g.steps[g.si]["type"] == "tbc")       # (the leaf is the inheritance's only at the end of the story's steps)
	_check(g.phone_call == null and F.stage() == "" and F.CALL_AFTER_H == 0.25 and (not at_end or g.hud.obj_text.text == Loc.t("obj_casa_espera")),
		"the bridge just unlocked: no call yet, and the leaf says the phone is about to ring, not to go for a wander (%s)" % g.hud.obj_text.text)
	g.stats["puente_h"] = g.llamadas.now() - 0.3
	await _frames(40)
	var rang: bool = g.phone_call != null and g.phone_call.get("npc", "") == "paca"
	if rang:
		g._answer_call()
		await _skip_dialog(false)
	await _frames(4)
	_check(rang and F.stage() == "paca" and paca in g.marcas.givers() and g.phone_call == null, "a quarter of a game hour after the bridge is open, Tia Paca rings: come and see her by the house (and the green arrow is over her)")
	await _frames(45)
	_check(not at_end or (g.hud.obj_text.text == Loc.t("obj_casa_paca") and g.target != null), "...and the leaf sends you to her (%s)" % g.hud.obj_text.text)
	g.talk_to(paca)
	await _skip_dialog(false)
	_check(F.stage() == "deuda" and F.owed() == F.DEBT and not (paca in g.marcas.givers()) and g.side == null, "she tells you about la Eufrasia and the tax office: %s owed, a background mission (no errand slot taken)" % F._eur(F.owed()))
	await _curro_tour_checks()
	await _frames(45)
	_check(not at_end or g.hud.obj_text.text == Loc.t("obj_free"), "the debt told, the leaf is the town's again: the inheritance goes on in the background (%s)" % g.hud.obj_text.text)
	# the cash machine, a bit at a time
	g.player.p = B.cajero_spot
	await _frames(4)
	var near: bool = F.atm_near(g.player.p) != null
	g.money = 1500
	g.interact()
	await _frames(3)
	var opts: Array = g._ask["options"] if g._ask != null else []
	var five: bool = opts.size() == 5 and String(opts[3][0]).contains("1.500")
	g._choose(2)
	await _frames(3)
	_check(near and five and F.owed() == 9000 and g.money == 500, "at the Banco Cantabria's cash machine: 100, 500, 1.000 or all you have -- 1.000 in, %s left" % F._eur(F.owed()))
	if shots:
		g.interact()
		await _frames(3)
		await _shot("casa_cajero")
		g._choose(g._ask["options"].size() - 1)
		await _frames(3)
	g.money = 50
	g.interact()
	await _frames(3)
	opts = g._ask["options"] if g._ask != null else []
	var greyed: bool = opts.size() == 5 and not (opts[0][1] as Callable).is_valid() and not (opts[2][1] as Callable).is_valid() and (opts[3][1] as Callable).is_valid()
	g._choose(4)
	await _frames(3)
	_check(greyed and F.owed() == 9000 and g.money == 50 and g._ask == null, "what you cannot pay is greyed out; leaving pays nothing")
	g.money = 9200
	g.interact()
	await _frames(3)
	g._choose(3)
	await _frames(3)
	_check(F.stage() == "propia" and F.owed() == 0 and g.money == 200, "all of it in: the house is yours (200 EUR left over)")
	# Edmundo rings
	await _frames(20)                                # (his call is put down for a quarter of an hour on)
	g.set_time(g.clock + F.EDM_CALL_H + 0.1)
	await _ring_wait("edmundo")
	var edm_rang: bool = g.phone_call != null and g.phone_call.get("npc", "") == "edmundo"
	if edm_rang:
		g._answer_call()
		await _skip_dialog(false)
	await _frames(3)
	_check(edm_rang and F.next_step() == 1, "paid off, Edmundo Monedero rings at once: why not have the house done up?")
	# at the bank, while it is open: inside, behind his desk (Pretil's banco_dentro.gd); at its door if it has no inside
	var edm = F.edmundo
	var BI = B.get("banco")
	var E = g.entradas
	g.player.p = B.cajero_spot + Vector2(0.0, 300.0)
	await _frames(25)
	var there := false
	if BI != null:
		g.player.p = E.spot(BI, false)
		g.player.sync()
		await _frames(4)
		g.interact()
		var waited := 0
		while not g.indoors and waited < 30:
			await _frames(1)
			waited += 1
		g.player.p = BI.client_spot
		g.player.sync()
		await _frames(25)
		there = g.indoors and g.inside_of == BI and edm.visible and not edm.away and edm.p.distance_to(BI.manager_spot) < 0.3 and edm in g.marcas.givers()
	else:
		g.player.p = edm.p + Vector2(1.2, 0.0)
		await _frames(4)
		there = edm.visible and not edm.away and edm.p.distance_to(B.bank_door) < 3.0 and edm in g.marcas.givers()
	if shots:
		await _shot("casa_edmundo")
	_check(there, "he is in the bank while it is open, behind his desk (you go in by the green arrow), with the green arrow over him")
