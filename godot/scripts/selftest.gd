## The house you inherit, inside (casa_dentro.gd and casa_estado.gd): its six states one at a time, the bed and the
## wardrobe where the game looks for them in all of them, the rooms that each state adds, the upper floor up its stairs.
func _casa_dentro_checks() -> void:
	var c = g.get("casa")
	if c == null or not c.has_method("set_state"):
		_check(false, "the house's inside has its six states")
		return
	var was: int = c.state
	var bed: Vector2 = c.bed_spot
	var wardrobe: Vector2 = c.wardrobe_spot
	var ok := true
	var counts: Array = []
	for n in range(6):
		c.set_state(n)
		var shown := 1 if n == 0 else 0
		for e in c.estados:
			if e.visible:
				shown += 1
		ok = ok and shown == 1 and c.state == n and c.bed_spot == bed and c.wardrobe_spot == wardrobe and String(c.room_at(c.in_spawn).get("name", "")) == "sala"
		counts.append(c.rooms().size())
	var up_ok: bool = c.back_door != Vector2.ZERO and String(c.room_at(c.back_spawn).get("name", "")) == "arriba"
	var up_h: float = MapData.foot(c.back_spawn) - c.level
	var mid_h: float = MapData.foot(c.INSIDE + Vector2(5.1, 8.4)) - c.level
	var down_h: float = MapData.foot(c.INSIDE + Vector2(9.0, 3.0)) - c.level
	c.set_state(was)
	_check(ok and counts == [1, 1, 1, 2, 3, 5], "the house's inside has its six states, one shown at a time, the bed and the wardrobe where they were (rooms: %s)" % [counts])
	_check(up_ok and absf(up_h - 3.0) < 0.05 and mid_h > 1.0 and mid_h < 2.0 and absf(down_h) < 0.05,
		"in the last one a door at the back leads up its stairs (half way %.2f m) to the upper floor (%.2f m up); the new rooms' floors are level (%.2f)" % [mid_h, up_h, down_h])

## The house you inherit, outside (casa_fuera.gd): its six fronts built in the same place, one shown and solid at a
## time; its street door where game.gd looks for it, in every state; the upper floor only in the last.
func _casa_fuera_checks() -> void:
	var cf = g.world.get("casa_fuera")
	_check(cf != null and cf.fronts.size() == 6 and cf.pieces > 300, "the house you inherit has its six fronts built by hand (%d pieces)" % (cf.pieces if cf != null else 0))
	if cf == null:
		return
	var was: int = cf.state
	var ok := true
	var tops: Array = []
	for n in range(6):
		cf.set_state(n)
		var shown := 0
		var solid_ := 0
		for f in cf.fronts:
			if f.visible:
				shown += 1
			if f.body != null and (f.body as StaticBody3D).collision_layer != 0:
				solid_ += 1
		var has_door := false
		for op in cf.openings():
			if String(op[1]) == "door" and absf((op[0] as Rect2).position.x - 1.64) < 0.001 and absf((op[0] as Rect2).size.y - 2.1) < 0.001:
				has_door = true
		ok = ok and shown == 1 and solid_ == 1 and has_door and cf.state == n
		tops.append(cf.top())
	cf.set_state(was)
	var near: float = (cf.door as Vector2).distance_to(g.HOME_DOOR)
	_check(ok and near < 2.5 and float(tops[4]) < 4.0 and float(tops[5]) > 6.0,      # (HOME_DOOR is a spot in the street by the door, not on it)
		"one front at a time is shown and solid, its street door never moves (%.2f m from where the game has it), and only the last has the upper floor (eaves %s)" % [near, tops])

## The Silo del Tío Anaranjao (silo.gd; its inside, silo_dentro.gd): the wall found along the pavement with its gate and
## its barred windows, nothing of it on the asphalt, the wall stops you; the set with its rooms, its furniture and its
## bulbs, its floors carrying whoever walks down the steps and the ramp, the camera told which room you are in.
## The almazara "González de la Ruz" (almazara.gd): built, solid on both streets, open at its way in, known to the
## map, nothing of it in a roadway, its hidden saffron where it says, and the walk in from the road to the nook.
func _almazara_checks() -> void:
	var al = g.world.get("almazara")
	_check(al != null and al.pieces > 250 and al.outlines.size() >= 10, "the oil mill González de la Ruz is built by hand (%d pieces, %d outlines)" % [(al.pieces if al != null else 0), (al.outlines.size() if al != null else 0)])
	if al == null:
		return
	var space := get_tree().root.get_world_3d().direct_space_state
	var ray := func(a: Vector2, b: Vector2, h: float) -> bool:
		return not space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(a.x, MapData.height(a) + h, a.y), Vector3(b.x, MapData.height(a) + h, b.y), 1)).is_empty()
	var hits := 0
	for pair in [[al.P(7.0, -6.0), al.P(7.0, 4.0)], [al.P(50.0, -5.0), al.P(50.0, 3.0)], [al.P(130.0, -6.0), al.P(130.0, 5.0)], [Vector2(253.0, -606.5), Vector2(262.0, -600.0)]]:
		if ray.call(pair[0], pair[1], 1.2):
			hits += 1
	var open: bool = not ray.call(al.P(20.7, -6.0), al.P(20.7, 8.0), 1.2)
	var nearest := 99.0
	for q in al.yard:
		var d: float = MapData.road_edge_dist(q)
		if MapData.road_hit != null:
			d += MapData.road_hit.hw - MapData.fitted_hw(MapData.road_hit)
		nearest = minf(nearest, d)
	var told := true
	for o in al.outlines:
		if not MapData.outlines.has(o):
			told = false
	var road := String(MapData.nearest_road(al.P(60.0, -9.0))["seg"].road["n"])
	var back := String(MapData.nearest_road(Vector2(253.0, -606.5))["seg"].road["n"])
	_check(hits == 4 and open and told and nearest > 0.0 and road.contains("Villaca") and back.contains("Triunfo"),
		"its mural, its long wall, its tall nave and its back on the Triunfo stop you (%d of 4); its way in is open (%s); the map knows its outlines (%s); none of its trees in a roadway (the nearest %.1f m from one); it gives on to %s and %s" % [hits, open, told, nearest, road, back])
	var hidden := false
	for f in g.flowers:
		if String(f.get("id", "")) == "almazara" and bool(f.get("hidden", false)) and (f["p"] as Vector2).distance_to(al.saffron_spot) < 0.01:
			hidden = true
	var was: Vector2 = g.player.p
	g.player.p = al.P(20.7, -7.0)
	await _frames(5)
	var in_yard: float = await _walk_at(al.P(20.7, 9.0), 5.0)
	g.player.p = al.P(60.0, 12.0)
	await _frames(3)
	var along: float = await _walk_at(al.P(87.5, 12.2), 8.0)
	var nook: float = await _walk_at(al.P(87.5, 5.0), 3.0)
	g.player.p = al.P(50.0, -4.0)
	await _frames(3)
	var wall: float = await _walk_at(al.P(50.0, 4.0), 3.0)
	_check(hidden and in_yard < 0.5 and along < 0.5 and nook < 0.5 and wall > 3.0 and al.lamps.size() >= 4,
		"a saffron flower is hidden in it (%s); you walk in from the road (%.1f m short), along behind the tanks (%.1f) and into the nook where it is (%.1f); the long wall stops you (%.1f m from the other side); %d lamps of its own" % [hidden, in_yard, along, nook, wall, al.lamps.size()])
	g.player.p = was

## The clothes shop "MaxiPrecio" of the Calle de los Arcos (maxiprecio.gd, maxiprecio_dentro.gd): built on its house of
## the map, its fronts stop you, its hours (two spells on weekdays, Saturday mornings, Sundays shut), its states, its set
## far off and closed, the walk in by the green arrow.
func _maxiprecio_checks() -> void:
	var a = g.world.get("maxiprecio")
	if a == null:
		print("  (no MaxiPrecio on this map yet: its checks skipped)")
		return
	var d = a.get("dentro")
	_check(d != null and a.pieces > 400 and a.openings >= 36 and a.balconies >= 8 and d.pieces + d.props > 150,
		"the clothes shop MaxiPrecio is built by hand (%d pieces, %d windows, %d balconies), with its inside (%d)" % [a.pieces, a.openings, a.balconies, ((d.pieces + d.props) if d != null else 0)])
	if d == null:
		return
	var calles = load("res://scripts/casas_calles.gd")
	var handed: bool = calles.HOUSES.has(a.HOUSE) and (calles.HOUSES[a.HOUSE] as Array).size() == 1 and String(calles.HOUSES[a.HOUSE][0]) == "obra"
	var space := get_tree().root.get_world_3d().direct_space_state
	var stops := 0
	var rays: Array = [[a._along(a.NW, a.SW, 2.0) + a._na * 2.5, a._na], [a.door, a._na], [a.side_spot, a._ng], [a.molino_spot, a._nm], [a._along(a.NE, a.MS, 6.0) + a._nm * 2.0, a._nm]]
	for q in rays:
		var p: Vector2 = q[0]
		var e: Vector2 = p - (q[1] as Vector2) * 5.0
		var y := MapData.height(p) + 1.2
		if not space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(p.x, y, p.y), Vector3(e.x, y, e.y), 1)).is_empty():
			stops += 1
	var streets: Array = []
	for q in [a.door, a.side_spot, a.molino_spot]:
		streets.append(String(MapData.nearest_road(q)["seg"].road["n"]))
	var named: bool = String(streets[0]).contains("Arcos") and String(streets[1]).contains("Granada") and String(streets[2]).contains("Molino")
	_check(handed and stops == rays.size() and named,
		"it stands on its house of the map, handed over as [\"obra\"] (%s); its fronts and its steps stop you (%d of %d); it gives on to %s" % [handed, stops, rays.size(), ", ".join(streets)])
	var good := true
	for on in [true, false]:
		a.set_open(on)
		if a._open.visible != on or a._shut.visible == on or d.open != on:
			good = false
	a.set_open(a.open_at(g.weekday, g.clock))
	var rule: bool = a.open_at(0, 9.5) and a.open_at(0, 13.9) and not a.open_at(0, 9.4) and not a.open_at(0, 14.0) and not a.open_at(0, 16.9) \
		and a.open_at(0, 17.0) and a.open_at(0, 20.9) and not a.open_at(0, 21.0) and a.open_at(4, 18.0) and a.open_at(5, 10.0) and not a.open_at(5, 18.0) \
		and not a.open_at(6, 12.0) and not a.open_at(6, 18.0)
	_check(good and rule, "it keeps the real shop's hours (Monday to Friday 9:30-14:00 and 17:00-21:00, Saturdays 9:30-14:00, Sundays shut): open, the awnings down and the door in; shut, the awnings rolled up (%s, %s)" % [good, rule])
	var far: float = (MapData.nearest_road(d.INSIDE, true)["p"] as Vector2).distance_to(d.INSIDE)
	var from := Vector3(d.in_spawn.x, d.level + 1.0, d.in_spawn.y)
	var walled := true
	for to in [Vector3(6, 0, 0), Vector3(-6, 0, 0), Vector3(0, 0, 13), Vector3(0, 0, -5), Vector3(0, 6, 0)]:
		if space.intersect_ray(PhysicsRayQueryParameters3D.create(from, from + to, 1)).is_empty():
			walled = false
	var level_floor: bool = absf(MapData.foot(d.in_spawn) - d.level) < 0.01 and absf(MapData.foot(d.client_spot) - d.level) < 0.01
	var others := true
	for other in g.entradas.shops():
		if other != d and other.get("INSIDE") != null and (other.INSIDE as Vector2).distance_to(d.INSIDE) < 150.0:
			others = false
	var had: bool = g.stats.has("vizum")             # (shut to you until Josefa's Vizum: Sistemas's tiendas_ropa.gd)
	var was_vizum = g.stats.get("vizum")
	var shut_first: bool = had or g.get("tiendas_ropa") == null or not g.entradas.is_shop(d)
	g.stats["vizum"] = 1
	var shop: bool = g.entradas.is_shop(d)
	if had:
		g.stats["vizum"] = was_vizum
	else:
		g.stats.erase("vizum")
	_check(far > 200.0 and walled and level_floor and others and d.door_out.distance_to(a.door) < 2.0 and shop and shut_first,
		"its inside is a set of its own far from the town (%.0f m from any street, no other set near: %s), closed all round (%s), its floor level (%s); it is one of the places with a green arrow, before its steps, once Josefa's Vizum opens it (%s, shut before: %s)" % [far, others, walled, level_floor, shop, shut_first])
	var was: Vector2 = g.player.p
	g.player.p = d.client_spot
	await _frames(4)
	var short: float = await _walk_at(d.clerk_spot, 2.5)
	g.player.p = was
	_check(short > 1.0, "nobody but who serves goes behind its counter (you stop %.1f m from that place)" % short)
	var mq = a.get("maniqui")                       # the mannequin at its door (maniqui.gd)
	if mq == null:
		_check(false, "a mannequin stands at its door")
		return
	var mq_when: Array = [g.weekday, g.clock]            # (a Monday at midday, as its own mode: in the full run it is still the
	g.weekday = 0                                       # title's hour, and the shop's own clock would shut it again)
	g.set_time(12.0)
	a.set_open(true)                                # (out while the shop is open)
	await _frames(3)                                # (props.gd takes it in on its first tick)
	var look0: Dictionary = mq.outfit(0)
	var same: bool = str(mq.outfit(0)) == str(look0)
	var differ := 0
	for dd in range(1, 8):
		differ += 1 if str(mq.outfit(dd)) != str(look0) else 0
	var gap: float = mq.p.distance_to(a.door)
	var w: Vector2i = mq.whites()
	var home: Transform3D = mq.transform
	var stood: bool = mq._props != null and mq.standing()
	g.props.punch(mq.p, -a._na)
	await _frames(2)
	var knocked: bool = not mq.freeze
	g.props.mend(true)
	await _frames(2)
	var back: bool = mq.standing() and mq.transform.origin.distance_to(home.origin) < 0.01
	_check(stood and knocked and back and same and differ >= 6 and gap > 1.2 and gap < 3.5 and w.x >= 3 and w.y == 0,
		"a mannequin stands at its door (%.1f m from the arrow), white with no face (%d white pieces, %d of a face), in other clothes and hat each day (%d of 7 days differ, the same day the same: %s); a punch knocks it over (%s, %s) and it is back the next day (%s)" % [gap, w.x, w.y, differ, same, stood, knocked, back])
	a.set_open(false)                               # the shop shut: taken in, nothing to bump into, no punch reaches it
	var taken_in: bool = mq.away and not mq.visible and mq.collision_layer == 0      # (no frames waited: the shop's own clock would open it again)
	g.props.punch(mq.p, -a._na)
	var untouched: bool = mq.freeze and mq.away
	a.set_open(true)                                # open again: out again
	var out_again: bool = mq.standing() and mq.visible and mq.collision_layer == 16
	g.weekday = mq_when[0]
	g.set_time(mq_when[1])
	a.set_open(a.open_at(g.weekday, g.clock))
	_check(taken_in and untouched and out_again,
		"it is out only while the shop is open: shut, taken in and out of reach (%s, a punch does nothing: %s); open, out again (%s)" % [taken_in, untouched, out_again])
	var hidden := false                             # its hidden saffron (the user, 23 Nov 2026: "Ponlo también"), in a bin of the island
	var fl = null
	for f in g.flowers:
		if String(f.get("id", "")) == "maxiprecio" and bool(f.get("hidden", false)) and (f["p"] as Vector2).distance_to(d.saffron_spot) < 0.01:
			hidden = true
			fl = f
	var reach := 99.0
	if fl != null:
		var was_gone = fl.get("gone", false)
		fl["gone"] = true                               # (walking up to it must not take it: the test is not to have it)
		var was2: Vector2 = g.player.p
		g.player.p = d.INSIDE + Vector2(1.6, 8.2)
		await _frames(4)
		reach = await _walk_at(d.saffron_spot, 3.0)
		g.player.p = was2
		fl["gone"] = was_gone
	_check(hidden and reach < 1.2, "a saffron flower is hidden in a bin of socks of the island in the middle of its inside (%s), and you get to it (%.2f m from it)" % [hidden, reach])

## The cemetery (cementerio.gd; the user, 25 Nov 2026: "Vamos a poner las con el cementerio"), in the zone of zonas.gd
## past the map's north end: built, within its zone; its wall stops you all round; you go in on foot through the open
## arch of the gatehouse (no car fits) and not through the shut one; the graves are solid and the aisles between them
## and its walks are clear; no tree on the road and no plot on a walk.
func _cementerio_checks() -> void:
	var cm = g.world.cementerio
	_check(cm != null and cm.graves > 3000 and cm.plots.size() >= 50,
		"the cemetery is built: %d graves in %d plots" % [cm.graves if cm != null else 0, cm.plots.size() if cm != null else 0])
	if cm == null:
		return
	var zs = g.get("zonas")
	var inside: bool = zs != null
	for c in [cm.NW, cm.NE, cm.SE, cm.SW]:
		if zs != null and not zs.in_zone(c):
			inside = false
	var space := get_tree().root.get_world_3d().direct_space_state
	var hit_near := func(a: Vector2, b: Vector2, up: float, near: Vector2, within: float) -> bool:
		var y := MapData.height(a) + up
		var hit := space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(a.x, y, a.y), Vector3(b.x, y, b.y), 1))
		return not hit.is_empty() and Vector2(hit.position.x, hit.position.z).distance_to(near) < within
	var free_at := func(p: Vector2, up: float, r: float) -> bool:
		var q := PhysicsShapeQueryParameters3D.new()
		var ball := SphereShape3D.new()
		ball.radius = r
		q.shape = ball
		q.collision_mask = 1
		q.transform = Transform3D(Basis.IDENTITY, Vector3(p.x, MapData.height(p) + up, p.y))
		return space.intersect_shape(q, 1).is_empty()
	var walls := 0
	for w in [[Vector2(75.0, -3.0), Vector2(75.0, 3.0), Vector2(75.0, 0.0)], [Vector2(75.0, cm.L_W + 3.0), Vector2(75.0, cm.L_W - 3.0), Vector2(75.0, cm.L_W)],
			[Vector2(cm.L_N + 3.0, 125.5), Vector2(cm.L_N - 3.0, 125.5), Vector2(cm.L_N, 125.5)], [Vector2(-3.0, 30.0), Vector2(3.0, 30.0), Vector2(0.0, 30.0)]]:
		if hit_near.call(cm.map_at(w[0].x, w[0].y), cm.map_at(w[1].x, w[1].y), 1.2, cm.map_at(w[2].x, w[2].y), 0.8):
			walls += 1
	_check(inside and walls == 4, "it stands in the zone of the cemetery (%s), and its wall stops you on all four sides (%d of 4)" % [inside, walls])
	var way_in := true
	for u in [-2.0, 0.0, 2.0, 4.75, 7.5, 9.5, 11.0]:
		if not free_at.call(cm.map_at(u, cm.HALL_N + cm.MID + cm.ARCH), 1.0, 0.3):
			way_in = false
	var shut: bool = hit_near.call(cm.map_at(-2.0, cm.HALL_N + cm.MID - cm.ARCH), cm.map_at(4.0, cm.HALL_N + cm.MID - cm.ARCH), 1.0, cm.map_at(0.0, cm.HALL_N + cm.MID - cm.ARCH), 0.6)
	_check(way_in and shut and cm.PASS_W < 1.6,
		"you go in on foot through the open arch of the gatehouse and its passage (%s), %.1f m wide: no car goes through; the other arch is shut (%s)" % [way_in, cm.PASS_W, shut])
	var aisles := 0
	var tried := 0
	var solid_graves := 0
	for pr in cm.pair_rows:
		var mu: float = (pr[0] + pr[1]) / 2.0
		if not free_at.call(cm.map_at(mu, (pr[2] + pr[3]) / 2.0), 0.5, 0.3):
			solid_graves += 1
		for pr2 in cm.pair_rows:
			if absf(pr2[0] - pr[0]) < 0.01 and absf(pr2[2] - pr[3] - cm.AISLE) < 0.01 and tried < 40:
				tried += 1
				if free_at.call(cm.map_at(mu, (pr[3] + pr2[2]) / 2.0), 0.5, 0.4):      # (the player's body is 0.38 round)
					aisles += 1
	var walks := 0
	var walk_pts: Array = []
	for u in [12.0, 20.0, 30.0, 40.0, 50.0, 60.0, 70.0, 105.0, 125.0, 145.0]:
		walk_pts.append(Vector2(u, (cm.CROSS_WALK[0] + cm.CROSS_WALK[1]) / 2.0))
	for v in [47.0, 63.0, 100.0, 108.0, 120.0]:                  # (the broad walk, west of its pantheons; and among them)
		walk_pts.append(Vector2(77.8, v))
	walk_pts.append(Vector2(88.0, 80.0))
	walk_pts.append(Vector2(95.5, 80.0))
	for q in walk_pts:
		if free_at.call(cm.map_at(q.x, q.y), 1.0, 0.35):
			walks += 1
	_check(solid_graves == cm.pair_rows.size() and tried > 10 and aisles == tried and walks == walk_pts.size(),
		"its graves are solid (%d of %d pairs of rows), the aisles between them clear (%d of %d), and its walks (%d of %d spots)" % [solid_graves, cm.pair_rows.size(), aisles, tried, walks, walk_pts.size()])
	var bad_plots := 0
	for pl in cm.plots:
		var on_cross: bool = pl[3] > cm.CROSS_WALK[0] and pl[2] < cm.CROSS_WALK[1]
		var on_avenue: bool = pl[1] > cm.AVENUE[0] and pl[0] < cm.AVENUE[1] and pl[3] > 44.0 and pl[2] < 125.0
		var out_wall: bool = pl[0] < cm.WALL_T or pl[1] > cm.L_N - cm.WALL_T or pl[2] < cm.WALL_T or pl[3] > cm.L_W - cm.WALL_T
		if on_cross or on_avenue or out_wall:
			bad_plots += 1
	var z: Dictionary = zs.gate_of("cementerio", "zone")["zone"] if zs != null else {}
	var on_road := 0
	if not z.is_empty():
		var a: Vector2 = z["road_from"]
		var d: Vector2 = ((z["road_to"] as Vector2) - a).normalized()
		for t in cm.trees_put:
			var tp := Vector2(t[0], t[1])
			if absf((tp - a).cross(d)) < float(z["road_hw"]) + 0.6:
				on_road += 1
	var park: bool = free_at.call(cm.map_at(-4.0, 70.0), 1.3, 1.0) and free_at.call(cm.map_at(-4.0, 100.0), 1.3, 1.0)      # (a ball as big as a car, clear of the ground)
	_check(bad_plots == 0 and on_road == 0 and park,
		"no plot of graves on a walk or past the wall (%d), no tree on the road (%d of %d), and room to park before the gatehouse (%s)" % [bad_plots, on_road, cm.trees_put.size(), park])
	var ph0: String = g.phase                                      # the player's own legs: through the open arch, and down an aisle in the far corner
	var pp0: Vector2 = g.player.p
	g.phase = "free"
	var v_pass: float = cm.HALL_N + cm.MID + cm.ARCH
	g.player.p = cm.map_at(-4.0, v_pass)
	await _frames(3)
	var walked_in: bool = await _cem_walk(cm.map_at(cm.HALL_D + 2.0, v_pass), 60 * 14)
	var corner: Array = []
	for pr in cm.pair_rows:
		if pr[0] > 138.0 and pr[2] > 145.0 and corner.is_empty():
			for pr2 in cm.pair_rows:
				if absf(pr2[0] - pr[0]) < 0.01 and absf(pr2[2] - pr[3] - cm.AISLE) < 0.01:
					corner = [pr, pr2]
	var walked_aisle := false
	if not corner.is_empty():
		var va: float = (corner[0][3] + corner[1][2]) / 2.0
		g.player.p = cm.map_at(corner[0][0] - 0.9, va)
		await _frames(3)
		walked_aisle = await _cem_walk(cm.map_at(corner[0][1] + 0.6, va), 60 * 14)
	g.player.p = pp0
	g.phase = ph0
	await _frames(2)
	_check(walked_in and walked_aisle,
		"walking (the player's own body, %.2f m across): in through the open arch to the walk of cypresses (%s), and down an aisle between graves in the far corner (%s)" % [0.76, walked_in, walked_aisle])
	var saf := 0                                                  # its two hidden saffrons (the user: «Bien, ponlo en los dos»)
	var reach := 0
	for sf in cm.saffron:
		for f in g.flowers:
			if f.get("id") == sf[0] and bool(f.get("hidden", false)) and (f["p"] as Vector2).distance_to(sf[1]) < 0.01:
				saf += 1
		var room := false
		for k in range(24):
			for rr in [0.7, 0.9, 1.1]:
				var q: Vector2 = (sf[1] as Vector2) + Vector2(cos(k * TAU / 24.0), sin(k * TAU / 24.0)) * rr
				if free_at.call(q, 1.0, 0.38):
					room = true
		if room:
			reach += 1
	_check(cm.saffron.size() == 2 and saf == 2 and reach == 2,
		"its two hidden saffrons, in a grave's vase and at the cypress's foot, are in the game as hidden ones (%d of %d), each with room to stand by it and take it (%d)" % [saf, cm.saffron.size(), reach])
	var zs2 = g.get("zonas")                                       # the night's hush: only the wind
	var pp1: Vector2 = g.player.p
	var ph1: String = g.phase
	g.phase = "free"
	var m0: String = g.moment
	g.player.p = cm.map_at(40.0, 86.0)
	g.moment = "night"
	var hush_night: bool = zs2 != null and zs2.hush()
	g.moment = "noon"
	var hush_day: bool = zs2 != null and zs2.hush()
	g.moment = "night"
	g.player.p = pp1 if not zs2.in_zone(pp1) else Vector2(0.0, 0.0)
	var hush_town: bool = zs2 != null and zs2.hush()
	g.moment = m0
	g.player.p = pp1
	g.phase = ph1
	var winds := 0
	for w in zs2.WIND:
		if ResourceLoader.exists(w) and load(w) is AudioStream:
			winds += 1
	_check(hush_night and not hush_day and not hush_town and winds == 3,
		"at night in the cemetery no music on foot and no crickets nor dogs, only the wind now and then (%s); not by day (%s) nor in the town (%s); its three gusts there (%d)" % [hush_night, not hush_day, not hush_town, winds])
	var c0: float = g.clock                                        # (and the game's music does as it says: none there at night, the lofi in the town)
	var pp2: Vector2 = g.player.p
	var ph2: String = g.phase
	var tg2: Dictionary = zs2.gate_of("cementerio", "town")
	g.phase = "free"
	g.player.p = cm.map_at(40.0, 86.0)
	g.set_time(23.5)
	await _frames(20)
	var quiet_there: bool = Ambience.current() == ""
	g.player.p = (tg2["p"] as Vector2) - (tg2["out"] as Vector2) * 14.0
	await _frames(20)
	var lofi_town: String = Ambience.current()
	g.set_time(c0)
	g.player.p = pp2
	g.phase = ph2
	await _frames(3)
	_check(quiet_there and (lofi_town == "lofi" or g.in_car != null),
		"and so it is: at night on foot in the cemetery the music stops (%s), back in the town the lofi plays again (%s)" % [quiet_there, lofi_town])

## (the cemetery's test) walks the player by the game's own legs to `to`, aiming at it every frame; true if there
func _cem_walk(to: Vector2, most: int) -> bool:
	for held in ["forward", "back", "left", "right", "run", "handbrake"]:
		Input.action_release(held)
	var d0: Vector2 = to - g.player.p
	g.cam_yaw = atan2(d0.x, d0.y)
	g.player.h = g.cam_yaw
	Input.action_press("forward")
	var steps := 0
	while g.player.p.distance_to(to) > 0.45 and steps < most:
		var d: Vector2 = to - g.player.p
		g.cam_yaw = atan2(d.x, d.y)
		await get_tree().physics_frame
		steps += 1
	Input.action_release("forward")
	await _frames(2)
	return g.player.p.distance_to(to) < 0.6

## The zone change (zonas.gd; the user, 25 Nov 2026: "como en el borderlands 2 ... que te acerques al cambio de zona y
## que un botón te transporte a la siguiente", "A pie y en coche"): before the gate on the old road the button takes you
## to the cemetery's zone and back, on foot and in a car; the car lands on the zone's ground and stays on it; the zone's
## walls and the gate's curtain stop you; not with the police after you; and in the Modo Chavisca too.
## The retouches after the eight (the user, 25 Nov 2026): «R.I.P.» or «D.E.P.» cut in half the graves, and the white
## nave «Recoveco», a garage as the town's: its shutter, its bay, the horn, mended and painted and charged. (It is not
## one of game.gd's `garages` nor of props.gd's repair points -- those are on the map -- so _garage_bay_checks does not
## drive into it: this does, the same way.)
func _recoveco_checks() -> void:
	var zs = g.get("zonas")
	var cm = g.world.get("cementerio")
	var af = zs.afueras.get("cementerio") if zs != null else null
	if cm == null or af == null or af.taller == null:
		_check(false, "the retouches round the cemetery: not built")
		return
	var n_w: int = int(cm.words)
	var n_g: int = int(cm.graves)
	var n_rip: int = int(cm.words_rip)
	var n_up: int = int(cm.words_upright)
	var drawn := 0
	var flat_ok := true
	# (how each word stands or lies is asked of the script: with no window, as in the full run, the engine gives every
	# instance of a MultiMesh back unturned, and this passed without looking. With a window the engine is asked too)
	var lp_drawn: bool = DisplayServer.get_name() != "headless"
	var lp_lost := 0
	var lp_flat := 0
	for mi in cm.get_children():
		if not (mi is MultiMeshInstance3D):
			continue
		var nm := String(mi.name)
		if not (nm.begins_with("tumbas_rip_") or nm.begins_with("tumbas_dep_")):
			continue
		var wmm: MultiMesh = (mi as MultiMeshInstance3D).multimesh
		drawn += wmm.instance_count
		var lp_xf: Array = (mi as Node).get_meta("xf", [])
		if lp_xf.size() != wmm.instance_count:
			lp_lost += wmm.instance_count
			continue
		for i in range(wmm.instance_count):
			var lp_t: Transform3D = lp_xf[i]
			var wb: Basis = lp_t.basis
			if absf(wb.z.y) > 0.01 and absf(wb.z.y - 1.0) > 0.01:      # (each stands on a stone's face, or lies on a slab)
				flat_ok = false
			if absf(wb.z.y) > 0.5:
				lp_flat += 1
			if lp_drawn:
				var lp_e: Transform3D = wmm.get_instance_transform(i)
				if lp_e.origin.distance_to(lp_t.origin) > 0.01 or absf(lp_e.basis.z.y - wb.z.y) > 0.001:
					lp_lost += 1
	var share: float = float(n_w) / maxf(1.0, float(n_g))
	_check(absf(share - 0.5) < 0.04 and drawn == n_w and flat_ok and lp_lost == 0 and lp_flat == n_w - n_up and float(n_rip) > float(n_w) * 0.4 and float(n_rip) < float(n_w) * 0.6 and n_up > 0 and n_up < n_w,
		"«R.I.P.» or «D.E.P.» cut in %d of the %d graves (%.0f %%), %d the one and %d the other; %d in an upright stone and %d in the slab; all of them drawn (%d: %d lying and the rest upright, %d not as the script has them, %s)" % [
			n_w, n_g, share * 100.0, n_rip, n_w - n_rip, n_up, n_w - n_up, drawn, lp_flat, lp_lost,
			"the engine asked too" if lp_drawn else "the engine not asked, with no window"])
	var gar = af.taller
	var labels: Array = []
	for l in (af as Node).find_children("*", "Label3D", true, false):
		labels.append((l as Label3D).text)
	var named: bool = labels.count("RECOVECO") == 1 and ("TALLER OFICIAL" in labels) and ("CHAPA Y PINTURA" in labels)
	var apart: bool = not g.garages.has(gar) and not g.props.repairs.any(func(r): return r.get("garage") == gar)
	var zone_ok: bool = zs.in_zone(gar.spot) and zs.in_zone(gar.apron) and zs.in_zone(gar.mouth - gar.out * float(gar.d))
	if g.in_car == null:
		g._enter_car(g.paca_car)
	var c = g.in_car
	var c_home: Vector2 = c.p
	var c_head: float = c.h
	var money0: int = g.money
	g.police.heat = 0.0
	g.police.chasing = false
	g.phase = "free"
	c.repair()
	c.place(gar.mouth + gar.out * 33.0 + gar.right * 50.0, 0.0)      # (on the old road, 60 m off)
	await _frames(90)
	var shut: bool = gar.open <= 0.0 and not gar._gate.disabled
	c.place(gar.apron, atan2(-gar.out.x, -gar.out.y))
	await _frames(110)
	var up: bool = gar.open >= 1.0 and gar._gate.disabled
	g._crash(c, 12.0)
	g.money = 60
	await _frames(10)
	var not_yet: bool = not g.at_garage
	for i in range(600):                         # drive in, gently, and stop in the middle of the bay
		var inn: float = -(c.p - gar.mouth).dot(gar.out)
		if inn >= float(gar.d) * 0.5:
			break
		if c.vel.length() < 3.0:
			Input.action_press("forward")
		else:
			Input.action_release("forward")
		await get_tree().physics_frame
	Input.action_release("forward")
	Input.action_press("handbrake")
	await _frames(50)
	Input.action_release("handbrake")
	var price: int = g.repair_price(c)
	await _frames(20)
	var said: String = g.hud.prompt.text
	var offered: bool = gar.holds(c.p, c.spec["len"]) and g.at_garage and said.contains("%d €" % price)
	var paint0: int = c.paint
	g._horn_cool = 0.0
	g.honk()
	await _frames(30)
	var held: bool = g.mending != null and c.hp < c.spec["hp"] and g.money == 60 and g.cam_fixed != null
	await _frames(50)
	var down: bool = gar.open <= 0.0 and not gar._gate.disabled
	if shots:
		await _shot("garage_recoveco_shut")
	await _frames(200)
	var done: bool = g.mending == null and c.hp == c.spec["hp"] and g.money == 60 - price and g.cam_fixed == null and c.paint != paint0
	await _frames(70)
	var out_again: bool = gar.open >= 1.0 and gar._gate.disabled and not g.at_garage      # (and nothing more is offered till it goes out)
	_check(named and apart and zone_ok and shut and up and not_yet and offered and held and down and done and out_again,
		"the nave is «Recoveco», a garage as the town's: its name and its trade on it %s, none of the map's garages %s, all of it in the zone %s; its shutter down with nobody about %s, up when a car comes %s; in its bay the price and the horn %s (%s); honk and it comes down %s %s, mended, painted and charged %d € %s; up again and no more asked %s" % [
			named, apart, zone_ok, shut, up, offered, said, held, down, price, done, out_again])
	g.money = money0
	c.set_speed(Vector2.ZERO)
	c.place(c_home, c_head)
	await _frames(10)

func _zonas_checks() -> void:
	var zs = g.get("zonas")
	_check(zs != null and zs.gate_of("cementerio", "town") != null and zs.gate_of("cementerio", "zone") != null,
		"the zone change is there: a gate on the old road at the map's north end, and another in the cemetery's zone")
	if zs == null or zs.gate_of("cementerio", "town") == null:
		return
	var tg: Dictionary = zs.gate_of("cementerio", "town")
	var zg: Dictionary = zs.gate_of("cementerio", "zone")
	var words: Array = []
	for gate in [tg, zg]:
		for l in (gate["node"] as Node).find_children("*", "Label3D", true, false):
			words.append((l as Label3D).text)
	_check(words.count("CEMENTERIO") == 2 and words.count("NÚCLEO URBANO") == 2 and not ("MADRIDEJOS" in words),
		"the boards: CEMENTERIO on the town's gate and NÚCLEO URBANO on the zone's, to come back (%s)" % [words])
	var zz: Dictionary = zg["zone"]                                # its land: dry plants and the odd tree, as the town's (the user: «El suelo está muy plano y vacío»)
	var cmz = g.world.get("cementerio")
	var off_p: Array = cmz.keep_off(false, 0.4) if cmz != null else []
	var off_t: Array = cmz.keep_off(true, 3.9) if cmz != null else []
	var plants := 0
	var bad_p := 0
	var in_c := 0
	var holder: Node = zs.get_node_or_null("zona_cementerio_matas")
	# (where each plant is, is asked of the script: with no window, as in the full run, the engine gives every instance
	# of a MultiMesh back at its node's own place. With a window the engine is asked too, that it draws them there)
	var zp_drawn: bool = DisplayServer.get_name() != "headless"
	var zp_lost := 0
	if holder != null:
		for mi in holder.get_children():
			var mm: MultiMesh = (mi as MultiMeshInstance3D).multimesh
			var zp_ps: PackedVector2Array = (mi as Node).get_meta("ps", PackedVector2Array())
			if zp_ps.size() != mm.instance_count:
				zp_lost += mm.instance_count
				continue
			for i in range(mm.instance_count):
				var q: Vector2 = zp_ps[i]
				if zp_drawn:
					var o: Vector3 = (mi as Node3D).position + mm.get_instance_transform(i).origin
					if Vector2(o.x, o.z).distance_to(q) > 0.02:
						zp_lost += 1
				plants += 1
				if q.distance_to(zz["centre"]) < float(zz["radius"]):
					in_c += 1
				if zs._road_gap(zz, q) < 0.5 or zs._in_any(q, off_p) or q.y > MapData.zmin or q.distance_to(zg["p"]) < 8.9:
					bad_p += 1
	var bad_t := 0
	var far_t := 0
	for t in zs.scrub_trees:
		var q: Vector2 = Vector2(float(t[0]), float(t[1]))
		if q.distance_to(zz["centre"]) > 700.0:
			far_t += 1
		if zs._road_gap(zz, q) < 4.9 or zs._in_any(q, off_t) or q.y > MapData.zmin or q.distance_to(zg["p"]) < 14.9:
			bad_t += 1
	var keys := {}
	for t in g.world.tree_info:
		var tp: Vector2 = t["p"]
		keys[Vector2i(roundi(tp.x * 10.0), roundi(tp.y * 10.0))] = true
	var t_in := 0
	for st in zs.scrub_trees:
		if keys.has(Vector2i(roundi(float(st[0]) * 10.0), roundi(float(st[1]) * 10.0))):
			t_in += 1
	_check(plants > 3000 and plants == zs.scrub_n and in_c > plants / 4 and in_c < plants and zs.scrub_trees.size() > 100 and far_t > 0 and t_in == zs.scrub_trees.size() and bad_p == 0 and bad_t == 0 and zp_lost == 0,
		"its land has dry plants as the town's (%d, %d inside its circle, the rest past it so its edge is not seen) and loose trees (%d, %d of them far off, all in the world's: solid and felled like the town's), and none on its road, by its gates, on the map or on the cemetery's own (%d plants and %d trees out of place; %d not where the script has them, %s)" % [plants, in_c, zs.scrub_trees.size(), far_t, bad_p, bad_t, zp_lost,
			"the engine asked too" if zp_drawn else "the engine not asked, with no window"])
	# the A-4 by it, where the old road ends (autovia.gd; the user: «hacia el norte/oeste podríamos ver la autovía A4
	# uniéndose a la carretera, con .PNG de coches y camiones viajando»), and the town far off (lejanias.gd: «mirando
	# hacia el sur se podría ver un .PNG del pueblo»)
	var av = zs.autovias.get("cementerio")
	var a4: bool = av != null and av.traffic_on
	var a4_say := "not built"
	if av != null:
		var jn: Vector2 = zz["road_to"]
		var ent: PackedVector2Array = av.lines["entrada"]
		var sal: PackedVector2Array = av.lines["salida"]
		var sb: PackedVector2Array = av.lines["sb"]
		var joined: bool = ent[0].distance_to(jn) < 0.5 and sal[sal.size() - 1].distance_to(jn) < 0.5
		var zc4: Vector2 = zz["centre"]
		var near_sb := Vector2.ZERO
		var best := 1e9
		for i in range(sb.size() - 1):
			var q: Vector2 = Geometry2D.get_closest_point_to_segment(zc4, sb[i], sb[i + 1])
			if q.distance_to(zc4) < best:
				best = q.distance_to(zc4)
				near_sb = q
		var from4: Vector2 = zc4 + (near_sb - zc4).normalized() * (best - 30.0)
		var space4 := get_tree().root.get_world_3d().direct_space_state
		var hit4 := space4.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(from4.x, MapData.height(from4) + 1.0, from4.y), Vector3(near_sb.x, MapData.height(near_sb) + 1.0, near_sb.y), 1))
		var fenced: bool = not hit4.is_empty() and Vector2(hit4.position.x, hit4.position.z).distance_to(near_sb) > 6.0
		var on_it: bool = float(av.gap(near_sb)) < 0.0 and float(av.gap(zc4)) > 20.0 and best < float(zz["radius"])
		var cam4: Camera3D = g.cam
		var keep4: Vector3 = cam4.position
		cam4.position = Vector3(zc4.x, MapData.height(zc4) + 2.0, zc4.y)
		av.tick(0.0)
		var lj = zs.lejos[0] if zs.lejos.size() > 0 else null
		if lj != null:
			lj.tick(0.0)
		var seen_zone: bool = av.visible and (lj == null or lj.visible)
		var lanes_ok := true
		for k in range(40):                                        # (20 s of it)
			av.tick(0.5)
		var n4: int = av.cars_on()
		var lorries4 := 0
		for ln in av._lanes:
			var cars4: Array = ln["cars"]
			var total4: float = (ln["len"] as PackedFloat32Array)[(ln["len"] as PackedFloat32Array).size() - 1]
			for i in range(cars4.size()):
				var c4: Dictionary = cars4[i]
				var lorry4: bool = bool(av.KINDS[int(c4["row"])][2])
				lorries4 += 1 if lorry4 else 0
				if float(c4["s"]) < 0.0 or float(c4["s"]) > total4 or float(c4["v"]) < 10.0 or float(c4["v"]) > 40.0 or (lorry4 and not bool(ln["lorries"])):
					lanes_ok = false
				if i + 1 < cars4.size() and float((cars4[i + 1] as Dictionary)["s"]) - float(c4["s"]) < 6.0:
					lanes_ok = false
		cam4.position = Vector3(0.0, MapData.height(Vector2.ZERO) + 2.0, 0.0)          # (from the town: not there)
		av.tick(0.0)
		if lj != null:
			lj.tick(0.0)
		var hid_town: bool = not av.visible and (lj == null or not lj.visible)
		cam4.position = keep4
		a4 = a4 and joined and fenced and on_it and seen_zone and hid_town and lanes_ok and n4 >= 12 and lorries4 > 0 and lj != null and lj.built
		a4_say = "joined to the old road's end %s, fenced off %s (%.0f m from the zone's middle), seen from the zone %s and not from the town %s, %d on it (%d lorries) and none out of its lane %s, the town's picture %s" % [joined, fenced, best, seen_zone, hid_town, n4, lorries4, lanes_ok, (lj != null and lj.built)]
	_check(a4, "the A-4 runs by the zone with its slip roads to where the old road ends, behind its fence; seen only from in the zone, cars and lorries going along it at its speeds, and the town far off round the horizon (%s)" % a4_say)
	# the solar plant across the road (planta_solar.gd; the user, 25 Nov 2026: «En frente del cementerio hay una planta
	# solar. Estaría bien añadirla también»): its 28 trackers follow the sun, nobody gets in, its drive is clear
	var sol = zs.solares.get("cementerio")
	var sol_ok: bool = sol != null
	var sol_say := "not built"
	if sol != null:
		var keep_h: float = g.clock
		g.set_time(12.0)
		sol.track(true)
		var sun_at: Vector3 = (g.sun as DirectionalLight3D).global_basis.z
		var noon: float = (sol.normal as Vector3).dot(sun_at)
		g.set_time(9.0)
		sol.track(true)
		var east: float = (sol.normal as Vector3).x
		g.set_time(18.5)
		sol.track(true)
		var west: float = (sol.normal as Vector3).x
		g.set_time(1.0)
		sol.track(true)
		var stow: float = (sol.normal as Vector3).y
		g.set_time(keep_h)
		sol.track(true)
		var gm: Vector2 = ((sol.GATE_S as Vector2) + (sol.GATE_N as Vector2)) / 2.0
		var out_s: Vector2 = gm + Vector2(8.0, 0.0)
		var in_s: Vector2 = gm - Vector2(8.0, 0.0)
		var sp_s := get_tree().root.get_world_3d().direct_space_state
		var hit_s := sp_s.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(out_s.x, MapData.height(out_s) + 1.0, out_s.y), Vector3(in_s.x, MapData.height(in_s) + 1.0, in_s.y), 1))
		var gate_shut: bool = not hit_s.is_empty() and Vector2(hit_s.position.x, hit_s.position.z).distance_to(gm) < 1.0
		var pads: Array = sol.keep_off(false, 0.0)
		var yard_s: Array = sol.keep_off(true, 0.0)
		var bad_sp := 0
		var in_yard := 0
		if holder != null:
			for mi in holder.get_children():
				var zp_ps2: PackedVector2Array = (mi as Node).get_meta("ps", PackedVector2Array())      # (the script's own record, as above)
				for q2: Vector2 in zp_ps2:
					if zs._in_any(q2, pads):
						bad_sp += 1
					if zs._in_any(q2, yard_s):
						in_yard += 1
		var bad_st := 0
		for t in zs.scrub_trees:
			if zs._in_any(Vector2(float(t[0]), float(t[1])), yard_s):
				bad_st += 1
		var row_clear := true
		for t in g.world.tree_info:
			if (t["p"] as Vector2).distance_to(sol.DRIVE) < 4.0:
				row_clear = false
		sol_ok = int(sol.trackers) == 28 and int(sol.fence_solids) > 10 and noon > 0.97 and east > 0.3 and west < -0.3 and stow > 0.95 and gate_shut and bad_sp == 0 and bad_st == 0 and in_yard > 20 and row_clear
		sol_say = "%d trackers, square to the sun at noon %s (%.3f), turned east in the morning and west in the evening %s, laid flat at night %s; %d pieces of its fence solid and its gate shut %s; %d dry plants in its yard, none on its drive or at a tracker's foot %s, no loose tree in it %s, none of the road's row in its drive %s" % [
			int(sol.trackers), noon > 0.97, noon, east > 0.3 and west < -0.3, stow > 0.95, int(sol.fence_solids), gate_shut, in_yard, bad_sp == 0, bad_st == 0, row_clear]
	_check(sol_ok, "the solar plant stands across the road from the cemetery: %s" % sol_say)
	# the eight things added after the review (the user, 25 Nov 2026: «Haz las 8. Y el cartel "Planta Industrial
	# Agrosolar"»; and of the candles, «cambiaría lamparillas por velas, que son las que se suelen poner»)
	var o8_cm = g.world.cementerio
	var o8_af = zs.afueras.get("cementerio")
	var o8_av = zs.autovias.get("cementerio")
	var o8_ok := false
	var o8_say := "not built"
	if sol != null and o8_cm != null and o8_af != null and o8_av != null:
		var o8_zone: Dictionary = zs.gate_of("cementerio", "zone")["zone"]
		var o8_c: Vector2 = o8_zone["centre"]
		var o8_sign: bool = String(sol.SIGN[0]) == "PLANTA INDUSTRIAL" and String(sol.SIGN[1]) == "AGROSOLAR"
		var o8_saf: bool = (sol.saffron as Array).size() == 1
		var o8_spot: Vector2 = sol.saffron[0][1] if o8_saf else Vector2.ZERO
		var o8_listed := false
		for o8_fl in g.flowers:
			if String(o8_fl.get("id", "")) == String(sol.SAFFRON_ID) and bool(o8_fl.get("hidden", false)):
				o8_listed = true
		var o8_reach: bool = o8_saf and o8_spot.distance_to(o8_c) < float(o8_zone["radius"]) - 2.0 and not zs._in_any(o8_spot, sol.keep_off(true, 0.0)) and not zs._in_any(o8_spot, sol.keep_off(false, 0.0))
		var o8_keep: float = g.clock
		g.set_time(23.0)
		await _frames(3)
		o8_cm._wait = 0.0
		o8_cm.tick(1.0)
		var o8_lit: bool = o8_cm._glow_mi != null and bool(o8_cm._glow_mi.visible)
		var o8_gate: Vector2 = o8_cm.gate_in
		var o8_hum_night: float = o8_av.hum_level(o8_gate, float(g.sky_fx.night))
		g.set_time(12.0)
		await _frames(3)
		o8_cm._wait = 0.0
		o8_cm.tick(1.0)
		var o8_unlit: bool = o8_cm._glow_mi != null and not bool(o8_cm._glow_mi.visible)
		var o8_hum_day: float = o8_av.hum_level(o8_gate, float(g.sky_fx.night))
		var o8_hum_far: float = o8_av.hum_level(sol.GATE_S, float(g.sky_fx.night))
		var o8_hum_near: float = o8_av.hum_level(o8_cm.map_at(float(o8_cm.L_N) + 12.0, 80.0), float(g.sky_fx.night))      # (behind the cemetery's east wall, by the A-4's fence)
		g.set_time(o8_keep)
		var o8_al: Vector2 = ((o8_af.NAVE_N as Vector2) - (o8_af.NAVE_S as Vector2)).normalized()
		var o8_o := Vector2(-o8_al.y, o8_al.x)
		var o8_bay: Vector2 = o8_af.bay
		var o8_fp: Vector2 = o8_bay + o8_o * (float(o8_af.BAY_D) / 2.0)
		var o8_space := get_tree().root.get_world_3d().direct_space_state
		var o8_e: Vector2 = o8_fp + o8_o * 15.0
		var o8_w: Vector2 = o8_fp - o8_o * 15.0
		var o8_gy: float = MapData.height(o8_fp)
		var o8_hi := o8_space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(o8_e.x, o8_gy + 6.5, o8_e.y), Vector3(o8_w.x, o8_gy + 6.5, o8_w.y), 1))
		var o8_lo := o8_space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(o8_e.x, o8_gy + 1.5, o8_e.y), Vector3(o8_w.x, o8_gy + 1.5, o8_w.y), 1))
		var o8_front: bool = not o8_hi.is_empty() and Vector2(o8_hi.position.x, o8_hi.position.z).distance_to(o8_fp) < 1.0
		var o8_deep: bool = not o8_lo.is_empty() and Vector2(o8_lo.position.x, o8_lo.position.z).distance_to(o8_fp) > float(o8_af.BAY_D) - 1.5
		var o8_q := PhysicsShapeQueryParameters3D.new()
		var o8_ball := SphereShape3D.new()
		o8_ball.radius = 0.38
		o8_q.shape = o8_ball
		o8_q.collision_mask = 1
		o8_q.transform = Transform3D(Basis.IDENTITY, Vector3(o8_bay.x, MapData.height(o8_bay) + 1.0, o8_bay.y))
		var o8_hall: bool = o8_space.intersect_shape(o8_q, 1).is_empty()
		var o8_road := false
		var o8_wall := false
		var o8_ex: Array = g.hud.minimap.extras
		for o8_x in o8_ex:
			for o8_pt in (o8_x[1] as PackedVector2Array):
				if int(o8_x[0]) == 0 and o8_pt.distance_to(o8_gate) < 45.0:
					o8_road = true
				if int(o8_x[0]) == 3 and o8_pt.distance_to(o8_cm.NW) < 1.0:
					o8_wall = true
		var o8_trees := 0
		for o8_t in g.world.tree_info:
			var o8_tp: Vector2 = o8_t["p"]
			var o8_nt: float = (o8_tp - (o8_af.NAVE_S as Vector2)).dot(o8_al)
			var o8_no: float = (o8_tp - (o8_af.NAVE_S as Vector2)).dot(o8_o)
			if o8_nt > -12.0 and o8_nt < 61.0 and o8_no > -float(o8_af.DEEP_N) and o8_no < 24.0:
				o8_trees += 1
		o8_ok = (o8_sign and o8_saf and o8_listed and o8_reach and int(o8_cm.candles) > 150 and float(o8_cm.candles) < float(o8_cm.graves) / 4.0 and o8_lit and o8_unlit
			and o8_hum_day > -30.0 and o8_hum_day >= o8_hum_far and o8_hum_near > o8_hum_day + 6.0 and o8_hum_night < o8_hum_day - 12.0 and o8_hum_night > -55.0 and int(o8_cm.whitewashed) > 20 and int(o8_af.signs) == 3
			and o8_front and o8_deep and o8_hall and int(o8_af.nave_solids) == 5 and o8_trees == 0 and int(sol.farm_rows) > 50 and o8_road and o8_wall)
		o8_say = "the plant's board reads its name %s; a hidden saffron by its gate, listed %s and reached %s; %d graves of %d with candles, aglow at night %s and not by day %s; the A-4 hums at the cemetery's gate by day (%.0f dB; %.0f behind its east wall, by the A-4) and much lower at night (%.0f); %d trunks of the road's row whitewashed; %d blue boards; the white nave's front solid %s, its open hall %s deep and free to stand in %s, no tree in its yard %s; %d rows of fixed panels far off; the zone's road %s and the cemetery's wall %s on the plan (%d things)" % [
			o8_sign, o8_listed, o8_reach, int(o8_cm.candles), int(o8_cm.graves), o8_lit, o8_unlit, o8_hum_day, o8_hum_near, o8_hum_night, int(o8_cm.whitewashed), int(o8_af.signs),
			o8_front, o8_deep, o8_hall, o8_trees == 0, int(sol.farm_rows), o8_road, o8_wall, o8_ex.size()]
	_check(o8_ok, "the eight things added round the cemetery: %s" % o8_say)
	await _recoveco_checks()
	var was_chav: bool = g.chavisca
	if g.in_car != null:
		g.in_car.set_speed(Vector2.ZERO)
		g._exit_car()
		await _frames(3)
	g.police.heat = 0.0
	g.police.chasing = false
	g._door_cool = 0.0
	g.phase = "free"
	var before := func(gate: Dictionary, d: float) -> void:
		g.player.p = (gate["p"] as Vector2) - (gate["out"] as Vector2) * d
		g.player.h = zs._heading(gate["out"])
		g.player.sync()
	# on foot, there and back
	before.call(tg, 3.0)
	await _frames(4)
	var offered: bool = zs.here() == tg and zs.prompt() != ""
	var went: bool = zs.go()
	await _frames(40)
	var there: bool = zs.in_zone(g.player.p) and g.player.p.distance_to(zg["p"]) < 14.0
	var warned: bool = g.limite.warning or g.limite.hunting
	g._door_cool = 0.0
	before.call(zg, 3.0)
	await _frames(4)
	var offered2: bool = zs.here() == zg
	var back: bool = zs.go()
	await _frames(10)
	var home: bool = not zs.in_zone(g.player.p) and g.player.p.distance_to(tg["p"]) < 14.0
	_check(offered and went and there and not warned and offered2 and back and home,
		"on foot: before the gate the button offers the cemetery (%s) and takes you to its zone (%s, %s), where the map's edge does not count you out of town (%s); and back to the town by the other gate (%s, %s, %s)" % [offered, went, there, not warned, offered2, back, home])
	# in a car: the car goes too, and lands on the zone's ground
	g._door_cool = 0.0
	var car = CarS.new()
	g.add_child(car)
	var start: Vector2 = (tg["p"] as Vector2) - (tg["out"] as Vector2) * 6.0
	car.setup("panda", 0, start, zs._heading(tg["out"]))
	await _frames(10)
	g._enter_car(car)
	await _frames(10)
	car.set_speed(Vector2.ZERO)
	await _frames(60)
	var rest0: float = car.global_position.y - MapData.height(Vector2(car.global_position.x, car.global_position.z))      # (how it sits on the town's road)
	var car_offer: bool = zs.here() == tg and zs.prompt() != ""
	var car_went: bool = zs.go()
	await _frames(70)
	var cp: Vector2 = Vector2(car.global_position.x, car.global_position.z)
	var sink: float = car.global_position.y - MapData.height(cp)
	var car_there: bool = zs.in_zone(cp) and cp.distance_to(zg["p"]) < 16.0 and g.in_car == car
	_check(car_offer and car_went and car_there and absf(sink - rest0) < 0.12,
		"in a car: stopped before the gate the button offers the cemetery (%s) and takes you car and all (%s, in its zone: %s), and the car stands on the zone's ground as on the town's road (%.2f m over it after two seconds; %.2f in the town)" % [car_offer, car_went, car_there, sink, rest0])
	# the police after you: no
	g._door_cool = 0.0
	car.set_speed(Vector2.ZERO)
	car.place((zg["p"] as Vector2) - (zg["out"] as Vector2) * 6.0, zs._heading(zg["out"]))
	await _frames(6)
	g.police.heat = 40.0
	var refused: bool = zs.here() != null and not zs.go()
	g.police.heat = 0.0
	g.police.chasing = false
	var nots: Array = []                                          # (and the other states with a clock: Sistemas, 25 Nov)
	g.police.bust_t = 2.0
	nots.append(zs._blocked() == "t_zona_pasma")
	g.police.bust_t = 0.0
	var fnt = g.comida.faint
	g.comida.faint = {"t": 0.0, "walked": 0.0, "fall": -1.0, "dir": Vector2.ZERO}
	nots.append(zs._blocked() == "t_zona_no")
	g.comida.faint = fnt
	var sd0 = g.side
	var st0: String = g.sabotaje.stage
	g.side = {"id": "trabajo", "who": "paca", "stage": "fetch", "t": 0.0}
	nots.append(zs._blocked() == "t_zona_no")
	g.side = {"id": "luis", "who": "luis", "stage": "follow", "t": 0.0}
	g.sabotaje.stage = "follow"
	nots.append(zs._blocked() == "t_zona_no")
	g.sabotaje.stage = "retry"
	nots.append(zs._blocked() == "")
	g.side = {"id": "tomasa", "who": "tomasa", "stage": "fetch", "t": 0.0}
	nots.append(zs._blocked() == "")
	g.sabotaje.stage = st0
	g.side = sd0
	refused = refused and not (false in nots)
	# the Modo Chavisca: yes
	g.chavisca = true
	g._door_cool = 0.0
	await _frames(3)
	var chav: bool = zs.go()
	await _frames(20)
	g.chavisca = was_chav
	var cp2: Vector2 = Vector2(car.global_position.x, car.global_position.z)
	var chav_home: bool = chav and not zs.in_zone(cp2)
	# the walls: the zone's, and the gates' curtains
	var space := get_tree().root.get_world_3d().direct_space_state
	var zc: Vector2 = zg["zone"]["centre"]                       # (the zone's circle: the user, 25 Nov, "un círculo invisible con centro en el cementerio")
	var zr: float = zg["zone"]["radius"]
	var walled := 0
	for k in range(16):                                           # (from just inside it, out through it, all round; the road's two ways out among them)
		var th := TAU * (k + 0.37) / 16.0
		var o := Vector2(cos(th), sin(th))
		var a: Vector2 = zc + o * (zr - 4.0)
		var b: Vector2 = zc + o * (zr + 6.0)
		var wy: float = MapData.height(a) + 1.0
		if not space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(a.x, wy, a.y), Vector3(b.x, wy, b.y), 1)).is_empty():
			walled += 1
	var rd: Dictionary = zg["zone"]
	var rdir: Vector2 = ((rd["road_to"] as Vector2) - (rd["road_from"] as Vector2)).normalized()
	for t in [-1.0, 1.0]:                                         # (along the road itself, both ways)
		var ro: Vector2 = rd["road_from"]
		var off: float = absf((zc - ro).cross(rdir))              # (where the road crosses the circle, this way)
		var along: float = (zc - ro).dot(rdir) + t * (sqrt(maxf(zr * zr - off * off, 0.0)) - 4.0)
		var a: Vector2 = ro + rdir * along
		var b: Vector2 = ro + rdir * (along + t * 10.0)
		var wy: float = MapData.height(a) + 1.0
		if not space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(a.x, wy, a.y), Vector3(b.x, wy, b.y), 1)).is_empty():
			walled += 1
	var gate_d: float = (zg["p"] as Vector2).distance_to(zc)
	var past_gate: bool = zr - gate_d > 8.0 and zr - gate_d < 25.0    # ("poco más lejos que las puertas de zona")
	var shut := 0
	for gate in [tg, zg]:
		var a: Vector2 = (gate["p"] as Vector2) - (gate["out"] as Vector2) * 3.0
		var b: Vector2 = (gate["p"] as Vector2) + (gate["out"] as Vector2) * 3.0
		var y: float = MapData.height(gate["p"]) + 1.0
		var hit := space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(a.x, y, a.y), Vector3(b.x, y, b.y), 1))
		if not hit.is_empty() and Vector2(hit.position.x, hit.position.z).distance_to(gate["p"]) < 0.6:
			shut += 1
	_check(refused and chav_home and walled == 18 and past_gate and shut == 2,
		"not with the police after you, nor being taken in, fainting, on a job or following the lorry for Don Luis, but yes on an errand with no clock (%s %s); in the Modo Chavisca, yes (%s); the zone's circle is walled all round and on the road both ways (%d of 18), a little past its gate (%.0f m from its middle, the circle %.0f) and neither gate lets you through without the button (%d of 2)" % [refused, nots, chav_home, walled, gate_d, zr, shut])
	g._exit_car()
	await _frames(3)
	car.queue_free()

## The roundabout at the north entrance (rotonda_norte.gd): its island on the ring of the map and within its lane, near
## where the real one is; its floor where you walk (the kerb, the brick band rising to the middle, the lawn); its gate,
## its board and its jar solid; a blue sign looking at each street that comes into it.
func _rotonda_norte_checks() -> void:
	var rn = g.world.get("rotonda_norte")
	_check(rn != null and rn.pieces > 150 and rn.decks >= 20, "the roundabout at the north entrance is built by hand (%d pieces, %d decks)" % [rn.pieces if rn != null else 0, rn.decks if rn != null else 0])
	if rn == null:
		return
	var far := 0.0
	for q in rn.things:
		far = maxf(far, (q as Vector2).distance_to(rn.mid))
	var lane: float = rn.ring_r - rn.ring_hw
	var off_real: float = (rn.mid as Vector2).distance_to(rn.REAL)
	_check(rn.R <= lane + 0.1 and far < rn.R - 0.2 and off_real < 1.5 and rn.signs == 3,
		"its kerb (%.2f m) keeps out of the ring's lane (%.2f m), what stands on it is within it (the farthest %.1f m out), the map's ring is where the real island is (%.1f m off) and a blue sign looks at %d of its streets (none at the one from the east, as Street View has it)" % [rn.R, lane, far, off_real, rn.signs])
	var lawn: Vector2 = rn.mid + Vector2(0.5, 2.5)
	var band: Vector2 = rn.mid + Vector2(-(rn.LAWN_R + rn.WHITE_W + 0.6), 0.0)
	var out: Vector2 = rn.mid + Vector2(rn.ring_r, 0.0)
	var on_lawn: float = MapData.foot(lawn) - MapData.height(lawn)
	var on_band: float = MapData.foot(band) - MapData.height(band)
	var off: float = MapData.foot(out) - MapData.height(out)
	var space := get_tree().root.get_world_3d().direct_space_state
	var ray := func(a: Vector2, b: Vector2, h: float) -> bool:
		return not space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(a.x, MapData.height(a) + h, a.y), Vector3(b.x, MapData.height(b) + h, b.y), 1)).is_empty()
	var lk: Vector2 = rn._look
	var stops: bool = ray.call(out, rn.mid, 0.07) and ray.call(rn.gate_mid + lk * 1.2, rn.gate_mid - lk * 1.2, rn.LAWN + 1.5)
	stops = stops and ray.call(rn.board_mid + lk * 0.8, rn.board_mid - lk * 0.8, rn.LAWN + 0.7) and ray.call(rn.jar_mid + Vector2(1.2, 0.0), rn.jar_mid - Vector2(1.2, 0.0), rn.LAWN + 0.5)
	_check(absf(on_lawn - rn.LAWN) < 0.015 and on_band > rn.KERB and on_band < rn.BAND_IN and absf(off) < 0.001 and stops,
		("" if stops else "(NOT SOLID) ") + "on foot you stand on its lawn (%.2f m up), on its brick band (%.2f) and on the road out of it (%.2f); its kerb, its gate, its board and its jar stop you" % [on_lawn, on_band, off])
	# its hidden saffron, inside the jar (the user, 24 Nov 2026: «Dentro de la boca de la tinaja»)
	var hidden := false
	for f in g.flowers:
		if String(f.get("id", "")) == "rotonda_norte" and bool(f.get("hidden", false)) and (f["p"] as Vector2).distance_to(rn.saffron_spot) < 0.01:
			hidden = true
	var jx: Transform3D = rn.jar_xf
	var gl: Vector3 = jx.affine_inverse() * (rn.saffron_glow as Vector3)          # (in the jar's frame: z up its axis)
	var round_it: float = Vector2(gl.x, gl.y).length() + 0.725 * rn.SAFFRON_K      # (how far from the axis its glow reaches)
	var inside: bool = round_it < 0.42 and gl.z > -0.3 and gl.z < 0.45
	var up2 := Vector2(jx.basis.z.x, jx.basis.z.z).normalized()
	var stand: Vector2 = rn.jar_mid + up2 * 1.2                                    # (on the lawn before its mouth)
	var q := PhysicsShapeQueryParameters3D.new()
	var ball := SphereShape3D.new()
	ball.radius = 0.3
	q.shape = ball
	q.collision_mask = 1
	q.transform = Transform3D(Basis.IDENTITY, Vector3(stand.x, MapData.foot(stand) + 0.6, stand.y))
	var free: bool = space.intersect_shape(q, 1).is_empty()
	var reach: float = stand.distance_to(rn.saffron_spot)
	_check(hidden and inside and free and reach < 1.2,
		"a saffron flower is hidden inside the jar, just in from its mouth (%s): its glow reaches %.2f m from the jar's axis, %.2f m up it from its belly, within its hollow (%s); you take it standing before the mouth (%.2f m from it, room to stand: %s)" % [hidden, round_it, gl.z, inside, reach, free])

## The two signs at the north entrance by the old road (entrada.gd): the whitewashed wall with Don Quixote and the
## twinning sign, where Street View puts them, off the road, solid, in the ground, the Quixote within the wall, seen
## from the road by who comes from the north, no dry plants through them.
func _entrada_checks() -> void:
	var e = g.world.get("entrada")
	if e == null:
		print("  (no signs at the north entrance on this map yet: their checks skipped)")
		return
	var c = e.cartel
	_check(c != null and e.pieces > 60 and e.sheet > 0 and c.pieces > 5,
		"the signs at the north entrance are built by hand: the welcome wall (%d pieces, the steel Quixote in %d) and the twinning sign (%d pieces)" % [e.pieces, e.sheet, (c.pieces if c != null else 0)])
	if c == null:
		return
	var mid: Vector2 = e.spot(e.WIDE / 2.0, 0.0)
	var out3: Vector3 = e.transform.basis.z
	var face := fposmod(rad_to_deg(atan2(out3.x, -out3.z)), 360.0)
	var sout: Vector3 = c.transform.basis.z
	var sface := fposmod(rad_to_deg(atan2(sout.x, -sout.z)), 360.0)
	var sp := Vector2(c.position.x, c.position.z)
	_check(mid.distance_to(e.WALL) < 0.05 and absf(face - e.FACE) < 1.0 and sp.distance_to(e.SIGN) < 0.05 and absf(sface - e.SIGN_FACE) < 1.0,
		"they stand where the Street View cameras put them, the wall's face looking %.0f degrees and the sign's %.0f (to who comes from the north)" % [face, sface])
	var worst := 1e9
	for p: Vector2 in e.yard + c.yard:
		var r: Dictionary = MapData.nearest_road(p, true)
		worst = minf(worst, p.distance_to(r["p"]) - float(r["seg"].hw))
	var road := String(MapData.nearest_road(mid, true)["seg"].road["n"])
	_check(worst > 2.0 and road.contains("Madrid"), "they stand off the road, on the bare ground beside the %s (the nearest foot %.1f m from its edge)" % [road, worst])
	var space := get_tree().root.get_world_3d().direct_space_state
	var stops := 0
	var tries := 0
	for x in [0.6, e.WIDE / 2.0, e.WIDE - 0.6]:
		var a: Vector2 = e.spot(x, 2.0)
		var b: Vector2 = e.spot(x, -1.0)
		var y: float = e.level + 1.2
		tries += 1
		if not space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(a.x, y, a.y), Vector3(b.x, y, b.y), 1)).is_empty():
			stops += 1
	for k in [-1.0, 1.0]:
		var a: Vector2 = c.spot(k * c.POSTS - 0.8 * k, -0.055)
		var b: Vector2 = c.spot(k * c.POSTS + 0.8 * k, -0.055)
		var y: float = c.level + 1.0
		tries += 1
		if not space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(a.x, y, a.y), Vector3(b.x, y, b.y), 1)).is_empty():
			stops += 1
	_check(stops == tries, "the wall and the sign's two posts stop you (%d of %d)" % [stops, tries])
	var sunk := true
	var corners: Array = []
	for x in [-0.07, e.WIDE + 0.07]:
		for z in [0.07, -e.THICK - 0.07]:
			var gp: float = e.ground(x, z)
			corners.append("%.2f" % gp)
			if gp < e.SINK + 0.05 or gp > e.PLINTH - 0.1:
				sunk = false
	for k in [-1.0, 1.0]:
		var gp: float = c.ground(k * c.POSTS, -0.055)
		corners.append("%.2f" % gp)
		if gp < -0.45 or gp > 0.5:
			sunk = false
	_check(sunk, "the wall's plinth and the sign's posts go into the ground at every corner, the plinth showing above it (the ground there, from their own floors: %s)" % ", ".join(corners))
	var data = JSON.parse_string(FileAccess.get_file_as_string("res://data/quijote.json"))
	var lo := Vector2(1e9, 1e9)
	var hi := Vector2(-1e9, -1e9)
	for p in data["outline"]:
		lo = lo.min(Vector2(p[0], p[1]))
		hi = hi.max(Vector2(p[0], p[1]))
	var inside: bool = lo.x > 0.1 and hi.x < e.WIDE - 0.1 and absf(lo.y - e.PLINTH) < 0.1 and hi.y < e._top((lo.x + hi.x) / 2.0) + 0.3
	_check(inside and e.lance_tip.y > e.top_at + 0.3 and e.lance_tip.y < e.top_at + 1.0,
		"Don Quixote stands on the plinth within the wall's face (%.2f to %.2f m along it, %.2f to %.2f m up), his lance's point %.2f m over its top" % [lo.x, hi.x, lo.y, hi.y, e.lance_tip.y - e.top_at])
	var eye := Vector2(277.0, -1700.0)
	var e3 := Vector3(eye.x, MapData.height(eye) + 1.4, eye.y)
	var wall_mid: Vector2 = e.spot(e.WIDE / 2.0, 0.0)
	var into: Vector2 = e.spot(e.WIDE / 2.0, -0.3)
	var hit := space.intersect_ray(PhysicsRayQueryParameters3D.create(e3, Vector3(into.x, e.level + 1.6, into.y), 1))
	var seen: bool = not hit.is_empty() and Vector2(hit.position.x, hit.position.z).distance_to(wall_mid) < 1.0
	if not seen:
		print("  (the ray from the road met %s)" % (str(hit.position) if not hit.is_empty() else "nothing"))
	var faces: bool = Vector2(out3.x, out3.z).dot((eye - mid).normalized()) > 0.5 and Vector2(sout.x, sout.z).dot((eye - sp).normalized()) > 0.5
	_check(seen and faces, "from the road, coming from the north, nothing hides the wall (%s) and both faces look at you (%s)" % [seen, faces])
	var mj = g.world.get("matojos")
	if mj != null and mj.ready_done:
		var between: float = mj._ground_ok(mid.lerp(sp, 0.5))
		_check(mj._ground_ok(mid) == 0.0 and mj._ground_ok(sp) == 0.0, "no dry plants grow through the wall or the sign (on the field between them: %.1f)" % between)
	var hidden := false
	for f in g.flowers:
		if String(f.get("id", "")) == "entrada" and bool(f.get("hidden", false)) and (f["p"] as Vector2).distance_to(e.saffron_spot) < 0.01:
			hidden = true
	var fl: Vector2 = e.saffron_spot
	var fy: float = MapData.height(fl) + 0.4
	var to_it := space.intersect_ray(PhysicsRayQueryParameters3D.create(e3, Vector3(fl.x, fy, fl.y), 1))
	var unseen: bool = not to_it.is_empty() and Vector2(to_it.position.x, to_it.position.z).distance_to(fl) > 0.3
	var field: Vector2 = e.spot(e.SAFFRON.x, -e.THICK - 3.0)
	var open: bool = space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(field.x, fy, field.y), Vector3(fl.x, fy, fl.y), 1)).is_empty()
	var off_wall: bool = e.SAFFRON.y < -e.THICK - 0.07 - 0.3
	_check(hidden and unseen and open and off_wall,
		"a saffron flower is hidden at the wall's back foot (%s): the wall hides it from who comes from the north (%s), and it is reached from the field behind (%s, clear of the wall %s)" % [hidden, unseen, open, off_wall])

## The optician "Óptica Corsa" of the Calle del Salvador (optica.gd, optica_dentro.gd): built on its house of the map,
## its front stops you, its roof closes, its hours (the real ones: Monday to Friday 10-14 and 18-21, Saturday mornings,
## Sundays shut), its states, its set far off and closed, the walk in by the green arrow, its counter, its mirror, the
## room where she tests your eyes.
func _optica_checks() -> void:
	var a = g.world.get("optica")
	if a == null:
		print("  (no Óptica Corsa on this map yet: its checks skipped)")
		return
	var d = a.get("dentro")
	_check(d != null and a.pieces > 300 and a.openings >= 8 and d.pieces + d.props > 150 and d.glasses >= 150,
		"the optician Óptica Corsa is built by hand (%d pieces, %d windows and doors), with its inside (%d pieces, %d pairs of glasses)" % [a.pieces, a.openings, ((d.pieces + d.props) if d != null else 0), (d.glasses if d != null else 0)])
	if d == null:
		return
	var calles = load("res://scripts/casas_calles.gd")
	var handed: bool = calles.HOUSES.has(a.HOUSE) and (calles.HOUSES[a.HOUSE] as Array).size() == 1 and String(calles.HOUSES[a.HOUSE][0]) == "obra"
	var space := get_tree().root.get_world_3d().direct_space_state
	var e: Vector2 = a.RING[a.FRONT]
	var w: Vector2 = a.RING[a.FRONT + 1]
	var spots: Array = [a.front_spot, a.door, w.lerp(e, 0.15) + a._nf * 2.0, w.lerp(e, 0.85) + a._nf * 2.0]
	var stops := 0
	for p: Vector2 in spots:
		var to: Vector2 = p - a._nf * 4.0
		var y := MapData.height(p) + 1.2
		if not space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(p.x, y, p.y), Vector3(to.x, y, to.y), 1)).is_empty():
			stops += 1
	var street := String(MapData.nearest_road(a.front_spot)["seg"].road["n"])
	var roofed: bool = a.roof_pieces >= 2 and absf(a.roof_area - a.roof_outline) < 0.05 * a.roof_outline and a.ridge_top > a.TOP + 1.0
	_check(handed and stops == spots.size() and street.contains("Salvador") and roofed,
		"it stands on its house of the map, handed over as [\"obra\"] (%s); its front stops you (%d of %d); it gives on to %s; its roof covers it all (%d pieces, %.1f of %.1f m2, %.1f m up)" % [handed, stops, spots.size(), street, a.roof_pieces, a.roof_area, a.roof_outline, a.ridge_top])
	var good := true
	for on in [true, false]:
		a.set_open(on)
		if a._open.visible != on or a._shut.visible == on or d.open != on:
			good = false
	a.set_open(a.open_at(g.weekday, g.clock))
	var rule: bool = a.open_at(0, 10.0) and a.open_at(0, 13.9) and not a.open_at(0, 9.9) and not a.open_at(0, 14.0) and not a.open_at(0, 17.9) \
		and a.open_at(0, 18.0) and a.open_at(0, 20.9) and not a.open_at(0, 21.0) and a.open_at(4, 19.0) and a.open_at(5, 10.0) and a.open_at(5, 13.9) \
		and not a.open_at(5, 14.0) and not a.open_at(5, 19.0) and not a.open_at(6, 12.0) and not a.open_at(6, 19.0)
	_check(good and rule, "it keeps its hours (the real ones: Monday to Friday 10:00-14:00 and 18:00-21:00, Saturdays 10:00-14:00, Sundays shut): open, the way in clear; shut, the shutter down (%s, %s)" % [good, rule])
	var far: float = (MapData.nearest_road(d.INSIDE, true)["p"] as Vector2).distance_to(d.INSIDE)
	var from := Vector3(d.in_spawn.x, d.level + 1.0, d.in_spawn.y)
	var walled := true
	for to in [Vector3(5, 0, 0), Vector3(-5, 0, 0), Vector3(0, 0, 10), Vector3(0, 0, -4), Vector3(0, 5, 0)]:
		if space.intersect_ray(PhysicsRayQueryParameters3D.create(from, from + to, 1)).is_empty():
			walled = false
	var level_floor: bool = absf(MapData.foot(d.in_spawn) - d.level) < 0.01 and absf(MapData.foot(d.client_spot) - d.level) < 0.01
	var others := true
	for other in g.entradas.shops():
		if other != d and other.get("INSIDE") != null and (other.INSIDE as Vector2).distance_to(d.INSIDE) < 150.0:
			others = false
	var had: bool = g.stats.has("vizum")             # (the clothes, accessories and glasses shops are shut to you until Josefa's Vizum: Sistemas's tiendas_ropa.gd)
	var was_vizum = g.stats.get("vizum")
	g.stats["vizum"] = 1
	var shop: bool = g.entradas.is_shop(d)
	if had:
		g.stats["vizum"] = was_vizum
	else:
		g.stats.erase("vizum")
	_check(far > 200.0 and walled and level_floor and others and d.door_out.distance_to(a.door) < 2.0 and shop,
		"its inside is a set of its own far from the town (%.0f m from any street, no other set near: %s), closed all round (%s), its floor level (%s); it is one of the places with a green arrow, before its door (%s)" % [far, others, walled, level_floor, shop])
	var was: Vector2 = g.player.p
	g.player.p = d.client_spot
	await _frames(4)
	var short: float = await _walk_at(d.clerk_spot, 2.5)
	g.player.p = d.INSIDE + Vector2(1.15, 5.8)
	await _frames(4)
	var into: float = await _walk_at(d.INSIDE + Vector2(1.15, 7.4), 3.0)
	g.player.p = was
	var o3 := Vector3(d.probador_spot.x, d.level + 1.2, d.probador_spot.y)
	var ahead := Vector3(sin(d.probador_h), 0.0, cos(d.probador_h))
	var cam_at := o3 + ahead * 3.6 + Vector3(ahead.z, 0.0, -ahead.x) * 1.1
	var room: bool = space.intersect_ray(PhysicsRayQueryParameters3D.create(o3 + ahead * 0.4, cam_at, 1)).is_empty()
	var cam_in: bool = absf(cam_at.x - d.INSIDE.x) < d.HALF - 0.3 and cam_at.z > d.INSIDE.y + 0.3
	var eye := Vector3(d.chair_spot.x + 0.45, d.level + 1.15, d.chair_spot.y)
	var chart := Vector3(d.INSIDE.x + d.HALF - 0.15, d.level + 1.6, d.chair_spot.y)
	var sees: bool = space.intersect_ray(PhysicsRayQueryParameters3D.create(eye, chart, 1)).is_empty()
	_check(short > 0.7 and room and cam_in and into < 0.5 and sees,
		"nobody but who serves goes behind its counter (you stop %.1f m from that place); from its mirror you see the shop (%s, the camera's spot inside it: %s); you walk into the room behind the partition (%.1f m short), and from its chair the eye chart is in view (%s)" % [short, room, cam_in, into, sees])
	# the user's "Visto bueno, y c" (23 Nov 2026): the saffron behind the eye chart, in the slit between its box and the wall
	var hidden := false
	var fl = null
	for f in g.flowers:
		if String(f.get("id", "")) == "optica" and bool(f.get("hidden", false)) and (f["p"] as Vector2).distance_to(d.saffron_spot) < 0.01:
			hidden = true
			fl = f
	var reach := 99.0
	if fl != null:
		var was_gone = fl.get("gone", false)
		fl["gone"] = true                               # (walking up to it must not take it: the test is not to have it)
		var was2: Vector2 = g.player.p
		g.player.p = d.INSIDE + Vector2(1.15, 7.2)
		await _frames(4)
		reach = await _walk_at(d.saffron_spot, 3.0)
		g.player.p = was2
		fl["gone"] = was_gone
	_check(hidden and reach < 1.2, "a saffron flower is hidden behind the eye chart of the room where she tests your eyes (%s), and you get to it (%.2f m from it)" % [hidden, reach])

## The accessories shop "Tetoqa" of the corner of Santa Ana and the Cristo (tetoqa.gd, tetoqa_dentro.gd): built on its
## house of the map, its fronts stop you, its roof closes, its hours (made up: two spells on weekdays, Saturday
## mornings, Sundays shut), its states, its set far off and closed, the walk in by the green arrow, its fitting room,
## the mannequin at its door in hats and trinkets.
func _tetoqa_checks() -> void:
	var a = g.world.get("tetoqa")
	if a == null:
		print("  (no Tetoqa on this map yet: its checks skipped)")
		return
	var d = a.get("dentro")
	_check(d != null and a.pieces > 400 and a.openings >= 16 and a.balconies >= 10 and d.pieces + d.props > 150,
		"the accessories shop Tetoqa is built by hand (%d pieces, %d windows and doors, %d balconies), with its inside (%d)" % [a.pieces, a.openings, a.balconies, ((d.pieces + d.props) if d != null else 0)])
	if d == null:
		return
	var calles = load("res://scripts/casas_calles.gd")
	var handed: bool = calles.HOUSES.has(a.HOUSE) and (calles.HOUSES[a.HOUSE] as Array).size() == 1 and String(calles.HOUSES[a.HOUSE][0]) == "obra"
	var space := get_tree().root.get_world_3d().direct_space_state
	var stops := 0
	var rays: Array = [[a.sa_spot, a._ns], [a.door, a._nc], [a.cr_spot, a._ne]]
	for q in rays:
		var p: Vector2 = q[0]
		var e: Vector2 = p - (q[1] as Vector2) * 4.0
		var y := MapData.height(p) + 1.2
		if not space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(p.x, y, p.y), Vector3(e.x, y, e.y), 1)).is_empty():
			stops += 1
	var streets: Array = []
	for q in [a.sa_spot, a.cr_spot]:
		streets.append(String(MapData.nearest_road(q)["seg"].road["n"]))
	var named: bool = String(streets[0]).contains("Santa Ana") and String(streets[1]).contains("Cristo")
	var roofed: bool = a.roof_pieces >= 4 and absf(a.roof_area - a.roof_outline) < 0.05 * a.roof_outline and a.ridge_top > a.TOP + 1.0
	_check(handed and stops == rays.size() and named and roofed,
		"it stands on its house of the map, handed over as [\"obra\"] (%s); its fronts stop you (%d of %d); it gives on to %s; its hipped roof covers it all (%d pieces, %.1f of %.1f m2, %.1f m up)" % [handed, stops, rays.size(), ", ".join(streets), a.roof_pieces, a.roof_area, a.roof_outline, a.ridge_top])
	var good := true
	for on in [true, false]:
		a.set_open(on)
		if a._open.visible != on or a._shut.visible == on or d.open != on:
			good = false
	a.set_open(a.open_at(g.weekday, g.clock))
	var rule: bool = a.open_at(0, 10.0) and a.open_at(0, 13.4) and not a.open_at(0, 9.9) and not a.open_at(0, 13.5) and not a.open_at(0, 17.4) \
		and a.open_at(0, 17.5) and a.open_at(0, 20.4) and not a.open_at(0, 20.5) and a.open_at(4, 18.0) and a.open_at(5, 10.0) and a.open_at(5, 13.9) \
		and not a.open_at(5, 14.0) and not a.open_at(5, 18.0) and not a.open_at(6, 12.0) and not a.open_at(6, 18.0)
	_check(good and rule, "it keeps its hours (made up: Monday to Friday 10:00-13:30 and 17:30-20:30, Saturdays 10:00-14:00, Sundays shut): open, the shutter up; shut, the shutter down (%s, %s)" % [good, rule])
	var far: float = (MapData.nearest_road(d.INSIDE, true)["p"] as Vector2).distance_to(d.INSIDE)
	var from := Vector3(d.in_spawn.x, d.level + 1.0, d.in_spawn.y)
	var walled := true
	for to in [Vector3(5, 0, 0), Vector3(-5, 0, 0), Vector3(0, 0, 10), Vector3(0, 0, -4), Vector3(0, 5, 0)]:
		if space.intersect_ray(PhysicsRayQueryParameters3D.create(from, from + to, 1)).is_empty():
			walled = false
	var level_floor: bool = absf(MapData.foot(d.in_spawn) - d.level) < 0.01 and absf(MapData.foot(d.client_spot) - d.level) < 0.01
	var others := true
	for other in g.entradas.shops():
		if other != d and other.get("INSIDE") != null and (other.INSIDE as Vector2).distance_to(d.INSIDE) < 150.0:
			others = false
	var had: bool = g.stats.has("vizum")             # (the clothes and accessories shops are shut to you until Josefa's Vizum: Sistemas's tiendas_ropa.gd)
	var was_vizum = g.stats.get("vizum")
	g.stats["vizum"] = 1
	var shop: bool = g.entradas.is_shop(d)
	if had:
		g.stats["vizum"] = was_vizum
	else:
		g.stats.erase("vizum")
	_check(far > 200.0 and walled and level_floor and others and d.door_out.distance_to(a.door) < 2.0 and shop,
		"its inside is a set of its own far from the town (%.0f m from any street, no other set near: %s), closed all round (%s), its floor level (%s); it is one of the places with a green arrow, before the chamfer's door (%s)" % [far, others, walled, level_floor, shop])
	var was: Vector2 = g.player.p
	g.player.p = d.client_spot
	await _frames(4)
	var short: float = await _walk_at(d.clerk_spot, 2.5)
	g.player.p = was
	var o3 := Vector3(d.probador_spot.x, d.level + 1.2, d.probador_spot.y)
	var ahead := Vector3(sin(d.probador_h), 0.0, cos(d.probador_h))
	var cam_at := o3 + ahead * 3.6 + Vector3(ahead.z, 0.0, -ahead.x) * 1.1
	var room: bool = space.intersect_ray(PhysicsRayQueryParameters3D.create(o3 + ahead * 0.4, cam_at, 1)).is_empty()
	var cam_in: bool = absf(cam_at.x - d.INSIDE.x) < d.HALF - 0.3 and cam_at.z > d.INSIDE.y + 0.3
	_check(short > 1.0 and room and cam_in, "nobody but who serves goes behind its counter (you stop %.1f m from that place); from its fitting room you see the shop (%s, the camera's spot inside it: %s)" % [short, room, cam_in])
	var mq = a.get("maniqui")                       # the mannequin at its door (maniqui.gd, in hats and trinkets)
	if mq == null:
		_check(false, "a mannequin stands at its door")
		return
	var mq_when: Array = [g.weekday, g.clock]            # (a Monday at midday, as its own mode: in the full run it is still the
	g.weekday = 0                                       # title's hour, and the shop's own clock would shut it again)
	g.set_time(12.0)
	a.set_open(true)                                # (out while the shop is open)
	await _frames(3)                                # (props.gd takes it in on its first tick)
	var look0: Dictionary = mq.outfit(0)
	var same: bool = str(mq.outfit(0)) == str(look0)
	var differ := 0
	var hats := 0
	var trinkets := 0
	var specs := 0
	for dd in range(0, 8):
		var o: Dictionary = mq.outfit(dd)
		differ += 1 if dd > 0 and str(o) != str(look0) else 0
		hats += 1 if String(o.get("hat", "")) != "" else 0
		trinkets += (1 if int(o.get("earrings", 0)) > 0 else 0) + (1 if int(o.get("pendant", 0)) > 0 else 0)
		specs += 1 if int(o.get("glasses", 0)) > 0 else 0      # (none: glasses are the opticians', the user, 23 Nov 2026)
	var gap: float = mq.p.distance_to(a.door)
	var w: Vector2i = mq.whites()
	var home: Transform3D = mq.transform
	var stood: bool = mq._props != null and mq.standing()
	g.props.punch(mq.p, -a._ns)
	await _frames(2)
	var knocked: bool = not mq.freeze
	g.props.mend(true)
	await _frames(2)
	var back: bool = mq.standing() and mq.transform.origin.distance_to(home.origin) < 0.01
	_check(stood and knocked and back and same and differ >= 6 and hats == 8 and trinkets >= 10 and specs == 0 and gap > 1.2 and gap < 3.5 and w.x >= 3 and w.y == 0,
		"a mannequin stands at its door (%.1f m from the arrow), white with no face (%d white pieces, %d of a face), in other clothes each day (%d of 7 days differ, the same day the same: %s), a hat every day (%d of 8) and trinkets (%d of 16: earrings, necklaces), no glasses (%d: those are the opticians'); a punch knocks it over (%s, %s) and it is back the next day (%s)" % [gap, w.x, w.y, differ, same, hats, trinkets, specs, stood, knocked, back])
	a.set_open(false)                               # the shop shut: taken in (no frames waited: the shop's own clock would open it again)
	var taken_in: bool = mq.away and not mq.visible and mq.collision_layer == 0
	g.props.punch(mq.p, -a._ns)
	var untouched: bool = mq.freeze and mq.away
	a.set_open(true)
	var out_again: bool = mq.standing() and mq.visible and mq.collision_layer == 16
	g.weekday = mq_when[0]
	g.set_time(mq_when[1])
	a.set_open(a.open_at(g.weekday, g.clock))
	_check(taken_in and untouched and out_again,
		"it is out only while the shop is open: shut, taken in and out of reach (%s, a punch does nothing: %s); open, out again (%s)" % [taken_in, untouched, out_again])
	# the user's yes to the three proposals (23 Nov 2026, "Si a las tres recomendaciones"): the saffron in its hat box,
	# the mannequins behind the Cristo's glass, the light before the chamfer
	var hidden := false
	var fl = null
	for f in g.flowers:
		if String(f.get("id", "")) == "tetoqa" and bool(f.get("hidden", false)) and (f["p"] as Vector2).distance_to(d.saffron_spot) < 0.01:
			hidden = true
			fl = f
	var reach := 99.0
	if fl != null:
		var was_gone = fl.get("gone", false)
		fl["gone"] = true                               # (walking up to it must not take it: the test is not to have it)
		var was2: Vector2 = g.player.p
		g.player.p = d.INSIDE + Vector2(1.6, d.D - 2.2)
		await _frames(4)
		reach = await _walk_at(d.saffron_spot, 3.0)
		g.player.p = was2
		fl["gone"] = was_gone
	_check(hidden and reach < 1.2, "a saffron flower is hidden in a hat box of the bench at the back of its inside (%s), and you get to it (%.2f m from it)" % [hidden, reach])
	var dms: Array = a.get("dummies") if a.get("dummies") != null else []
	var ring := PackedVector2Array(a._ring())
	var within := 0
	var still := 0
	var white := 0
	var looks := {}
	for dm in dms:
		within += 1 if Geometry2D.is_point_in_polygon(dm.p, ring) else 0
		still += 1 if dm.window and dm.collision_layer == 0 and dm._props == null and dm.freeze else 0
		var wv: Vector2i = dm.whites()
		white += 1 if wv.x >= 3 and wv.y == 0 else 0
		looks[str(dm.outfit(0))] = true
	a.set_open(false)                               # (no frames waited: the shop's own clock would open it again)
	var kept: bool = dms.all(func(x): return x.visible)
	a.set_open(a.open_at(g.weekday, g.clock))
	_check(dms.size() == 4 and within == 4 and still == 4 and white == 4 and looks.size() == 4 and kept,
		"four mannequins stand behind the Cristo's glass (%d, inside its walls: %d), out of reach (%d), white with no face (%d), each dressed its own way (%d), there shut or open (%s)" % [dms.size(), within, still, white, looks.size(), kept])
	var sm = a.get("semaforo")                      # the light before the chamfer (semaforo_ambar.gd)
	if sm == null:
		_check(false, "a traffic light stands before the chamfer")
		return
	await _frames(3)
	var edge: float = MapData.road_edge_dist(sm.p)
	var off_door: float = sm.p.distance_to(a.door)
	var adopted: bool = sm._props != null and sm.standing()
	var flips := 0
	var last: bool = sm.lit
	for i in range(100):
		await get_tree().process_frame
		if sm.lit != last:
			flips += 1
			last = sm.lit
	var amber_only: bool = (sm._lenses["rojo"] as StandardMaterial3D).emission_energy_multiplier == 0.0 and (sm._lenses["verde"] as StandardMaterial3D).emission_energy_multiplier == 0.0
	sm.set_light("rojo")
	var red: bool = (sm._lenses["rojo"] as StandardMaterial3D).emission_energy_multiplier > 0.0 and (sm._lenses["ambar"] as StandardMaterial3D).emission_energy_multiplier == 0.0
	sm.set_light("blink")
	var spot: Transform3D = sm.transform
	g.props.punch(sm.p, -a._nc)
	await _frames(3)
	var felled: bool = not sm.freeze
	var dark := true
	for c in sm.COLOURS:
		if (sm._lenses[c] as StandardMaterial3D).emission_energy_multiplier > 0.0:
			dark = false
	g.props.mend(true)
	await _frames(3)
	var up_again: bool = sm.standing() and sm.transform.origin.distance_to(spot.origin) < 0.01
	_check(edge > 0.1 and edge < 1.2 and off_door > 0.8 and adopted and flips >= 1 and amber_only and red and felled and dark and up_again,
		"a traffic light stands before the chamfer, on the pavement by the kerb (%.2f m from the road), clear of the door (%.1f m), as street furniture (%s); its amber blinks (%d changes, the rest dark: %s), it shows what it is told (red: %s); a punch knocks it over (%s), dark (%s), and it is back the next day (%s)" % [edge, off_door, adopted, flips, amber_only, red, felled, dark, up_again])

## The Plaza de Jesús Requejo (requejo.gd): the Red Cross's block (its name in the game: requejo.gd's NAME) and the park
## behind it, built by hand on its house of the map: the block of flats, its two wings, the mural, the barriers of the
## square, the park's trees and benches, and the transformer hut on the corner (Texturas's requejo_1, handed over too);
## its fronts stop you, its roof closes, nothing of it stands in a street.
## why the town might be standing still (a failing check's message): what stops game._physics_process early
func _why_still() -> String:
	return "phase %s, paused %s, map %s, tree paused %s, time scale %.2f, in car %s, indoors %s" % [g.phase, g.paused, g.map_open,
		get_tree().paused, Engine.time_scale, g.in_car != null, g.indoors]

func _requejo_checks() -> void:
	var a = g.world.get("requejo")
	if a == null:
		print("  (no Plaza de Jesús Requejo on this map yet: its checks skipped)")
		return
	_check(a.pieces > 600 and a.openings >= 40 and a.barriers >= 4 and a.trees >= 7 and a.benches == 4,
		"the Plaza de Jesús Requejo is built by hand (%d pieces, %d windows and doors; %d barriers, %d trees, %d benches)" % [a.pieces, a.openings, a.barriers, a.trees, a.benches])
	var calles = load("res://scripts/casas_calles.gd")
	var handed: bool = calles.HOUSES.has(a.HOUSE) and (calles.HOUSES[a.HOUSE] as Array).size() == 1 and String(calles.HOUSES[a.HOUSE][0]) == "obra"
	var hut: bool = calles.HOUSES.has(a.HUT) and String(calles.HOUSES[a.HUT][0]) == "obra" and a.hut_pieces > 80
	var space := get_tree().root.get_world_3d().direct_space_state
	var n_office: Vector2 = a._outward(a.F, a.G)
	var n_park: Vector2 = a._outward(a.G, a.S)
	var n_east: Vector2 = a._outward(a.S, a.C)
	var rays: Array = [[a.door, a._nn], [a.office, n_office], [a.park, n_park], [a._along(a.S, a.C, 7.0) + n_east * 1.4, n_east],
		[a._along(a.C, a.B, 4.5) + a._ne * 1.4, a._ne], [a._along(a.A, a.F, 4.6) + a._nw * 1.4, a._nw],
		[a._along(a.H_NE, a.H_NW, 1.0) + a._outward(a.H_NE, a.H_NW) * 1.4, a._outward(a.H_NE, a.H_NW)]]
	var stops := 0
	for q in rays:
		var p: Vector2 = q[0]
		var e: Vector2 = p - (q[1] as Vector2) * 4.0
		var y := MapData.height(p) + 1.2
		if not space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(p.x, y, p.y), Vector3(e.x, y, e.y), 1)).is_empty():
			stops += 1
	var streets: Array = []
	for q in [a.door, a.office, a.park]:
		streets.append(String(MapData.nearest_road(q)["seg"].road["n"]))
	var roofed: bool = a.roof_pieces >= 4 and absf(a.roof_area - a.roof_outline) < 0.05 * a.roof_outline and a.ridge_top > a.TOP + 1.0
	_check(handed and hut and stops == rays.size() and String(streets[2]).contains("Vi") and roofed,
		"it stands on its house of the map, handed over as [\"obra\"] (%s), the transformer hut on the corner handed over too and built (%s); its fronts stop you (%d of %d); it gives on to %s; its hipped roof covers the block (%d pieces, %.1f of %.1f m2, %.1f m up)" % [handed, hut, stops, rays.size(), ", ".join(streets), a.roof_pieces, a.roof_area, a.roof_outline, a.ridge_top])
	var nearest := 1000.0
	for q in a.yard:
		nearest = minf(nearest, MapData.road_edge_dist(q))
	_check(a.yard.size() >= 20 and nearest >= 0.2, "nothing of it stands in a street: of %d barriers, trees, benches and signs the nearest to the asphalt is %.1f m off" % [a.yard.size(), nearest])
	var hidden := false
	for f in g.flowers:
		if String(f.get("id", "")) == "requejo" and bool(f.get("hidden", false)) and (f["p"] as Vector2).distance_to(a.saffron_spot) < 0.01:
			hidden = true
	_check(hidden and a.saffron_spot.distance_to(Vector2(-426.3, 210.2)) < 0.8 and MapData.road_edge_dist(a.saffron_spot) > 2.0,
		"its hidden saffron grows at the foot of the whitewashed tamarisk in the park (%.1f m from its trunk), counted with the hidden ones (%s)" % [a.saffron_spot.distance_to(Vector2(-426.3, 210.2)), hidden])

## The shoe shop "Pisacastaña" of the corner of the Arcos and the Calle Argentina (pisacastana.gd,
## pisacastana_dentro.gd): built on its house of the map, shoes in its windows, its fronts stop you, its roof closes, its
## hours (the real shop's: two spells on weekdays, Saturday mornings, Sundays shut), its states, its set far off and
## closed, the walk in by the green arrow, where you try shoes on, the mannequin at its door with its stand of shoes.
func _pisacastana_checks() -> void:
	var a = g.world.get("pisacastana")
	if a == null:
		print("  (no Pisacastaña on this map yet: its checks skipped)")
		return
	var d = a.get("dentro")
	_check(d != null and a.pieces > 300 and a.openings >= 30 and a.balconies >= 3 and a.pairs >= 40 and d.pieces + d.props > 60 and d.pairs >= 150,
		"the shoe shop Pisacastaña is built by hand (%d pieces, %d windows and doors, %d loggias), shoes in its windows (%d pairs), with its inside (%d, %d pairs)" % [a.pieces, a.openings, a.balconies, a.pairs, ((d.pieces + d.props) if d != null else 0), (d.pairs if d != null else 0)])
	if d == null:
		return
	var calles = load("res://scripts/casas_calles.gd")
	var handed: bool = calles.HOUSES.has(a.HOUSE) and (calles.HOUSES[a.HOUSE] as Array).size() == 1 and String(calles.HOUSES[a.HOUSE][0]) == "obra"
	var space := get_tree().root.get_world_3d().direct_space_state
	var stops := 0
	var rays: Array = [[a.ar_spot, a._na], [a.door, a._na], [a.ac_spot, a._nw]]
	for q in rays:
		var p: Vector2 = q[0]
		var e: Vector2 = p - (q[1] as Vector2) * 4.0
		var y := MapData.height(p) + 1.2
		if not space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(p.x, y, p.y), Vector3(e.x, y, e.y), 1)).is_empty():
			stops += 1
	var streets: Array = []
	for q in [a.ar_spot, a.ac_spot]:
		streets.append(String(MapData.nearest_road(q)["seg"].road["n"]))
	var named: bool = String(streets[0]).contains("Argentina") and String(streets[1]).contains("Arcos")
	var roofed: bool = a.roof_pieces >= 4 and absf(a.roof_area - a.roof_outline) < 0.05 * a.roof_outline and a.ridge_top > a.TOP + 1.0
	_check(handed and stops == rays.size() and named and roofed,
		"it stands on its house of the map, handed over as [\"obra\"] (%s); its fronts stop you (%d of %d); it gives on to %s; its hipped roof covers it all (%d pieces, %.1f of %.1f m2, %.1f m up)" % [handed, stops, rays.size(), ", ".join(streets), a.roof_pieces, a.roof_area, a.roof_outline, a.ridge_top])
	var good := true
	for on in [true, false]:
		a.set_open(on)
		if a._open.visible != on or a._shut.visible == on or d.open != on:
			good = false
	a.set_open(a.open_at(g.weekday, g.clock))
	var rule: bool = a.open_at(0, 10.0) and a.open_at(0, 13.4) and not a.open_at(0, 9.9) and not a.open_at(0, 13.5) and not a.open_at(0, 16.9) \
		and a.open_at(0, 17.0) and a.open_at(0, 19.9) and not a.open_at(0, 20.0) and a.open_at(4, 18.0) and not a.open_at(5, 10.4) and a.open_at(5, 10.5) \
		and a.open_at(5, 13.9) and not a.open_at(5, 14.0) and not a.open_at(5, 18.0) and not a.open_at(6, 12.0) and not a.open_at(6, 18.0)
	_check(good and rule, "it keeps its hours (the real shop's: Monday to Friday 10:00-13:30 and 17:00-20:00, Saturdays 10:30-14:00, Sundays shut): open, the shutter up; shut, the shutter down (%s, %s)" % [good, rule])
	var far: float = (MapData.nearest_road(d.INSIDE, true)["p"] as Vector2).distance_to(d.INSIDE)
	var from := Vector3(d.in_spawn.x, d.level + 1.0, d.in_spawn.y)
	var walled := true
	for to in [Vector3(7, 0, 0), Vector3(-5, 0, 0), Vector3(0, 0, 10), Vector3(0, 0, -4), Vector3(0, 5, 0)]:
		if space.intersect_ray(PhysicsRayQueryParameters3D.create(from, from + to, 1)).is_empty():
			walled = false
	var level_floor: bool = absf(MapData.foot(d.in_spawn) - d.level) < 0.01 and absf(MapData.foot(d.client_spot) - d.level) < 0.01
	var others := true
	for other in g.entradas.shops():
		if other != d and other.get("INSIDE") != null and (other.INSIDE as Vector2).distance_to(d.INSIDE) < 150.0:
			others = false
	var had: bool = g.stats.has("vizum")             # (the clothes, accessories and shoe shops are shut to you until Josefa's Vizum: Sistemas's tiendas_ropa.gd)
	var was_vizum = g.stats.get("vizum")
	g.stats["vizum"] = 1
	var shop: bool = g.entradas.is_shop(d)
	if had:
		g.stats["vizum"] = was_vizum
	else:
		g.stats.erase("vizum")
	_check(far > 200.0 and walled and level_floor and others and d.door_out.distance_to(a.door) < 2.0 and shop,
		"its inside is a set of its own far from the town (%.0f m from any street, no other set near: %s), closed all round (%s), its floor level (%s); it is one of the places with a green arrow, before its door on the Calle Argentina (%s)" % [far, others, walled, level_floor, shop])
	var was: Vector2 = g.player.p
	g.player.p = d.client_spot
	await _frames(4)
	var short: float = await _walk_at(d.clerk_spot, 2.5)
	g.player.p = was
	var o3 := Vector3(d.probador_spot.x, d.level + 1.2, d.probador_spot.y)
	var ahead := Vector3(sin(d.probador_h), 0.0, cos(d.probador_h))
	var cam_at := o3 + ahead * 3.6 + Vector3(ahead.z, 0.0, -ahead.x) * 1.1
	var room: bool = space.intersect_ray(PhysicsRayQueryParameters3D.create(o3 + ahead * 0.4, cam_at, 1)).is_empty()
	var cam_in: bool = absf(cam_at.x - d.INSIDE.x) < d.HALF - 0.3 and cam_at.z > d.INSIDE.y + 0.3
	_check(short > 1.0 and room and cam_in, "nobody but who serves goes behind its counter (you stop %.1f m from that place); from where you try shoes on you see the shop (%s, the camera's spot inside it: %s)" % [short, room, cam_in])
	var mq = a.get("maniqui")                       # the mannequin at its door (maniqui.gd, in showy shoes, a stand of the day's pair by it)
	if mq == null:
		_check(false, "a mannequin stands at its door")
		return
	var mq_when: Array = [g.weekday, g.clock]            # (a Monday at midday, as its own mode: in the full run it is still the
	g.weekday = 0                                       # title's hour, and the shop's own clock would shut it again)
	g.set_time(12.0)
	a.set_open(true)                                # (out while the shop is open)
	await _frames(3)                                # (props.gd takes it in on its first tick)
	var look0: Dictionary = mq.outfit(0)
	var same: bool = str(mq.outfit(0)) == str(look0)
	var differ := 0
	var showy := 0
	for dd in range(0, 8):
		var o: Dictionary = mq.outfit(dd)
		differ += 1 if dd > 0 and str(o) != str(look0) else 0
		showy += 1 if int(o.get("shoe_type", -1)) in mq.SHOWY_SHOES and o.has("stand_shoes") else 0
	var stand: bool = mq.get("_stand") != null and (mq._stand as Node3D).get_child_count() >= 8
	var gap: float = mq.p.distance_to(a.door)
	var w: Vector2i = mq.whites()
	var home: Transform3D = mq.transform
	var stood: bool = mq._props != null and mq.standing()
	g.props.punch(mq.p, -a._na)
	await _frames(2)
	var knocked: bool = not mq.freeze
	g.props.mend(true)
	await _frames(2)
	var back: bool = mq.standing() and mq.transform.origin.distance_to(home.origin) < 0.01
	_check(stood and knocked and back and same and differ >= 6 and showy == 8 and stand and gap > 1.0 and gap < 3.5 and w.x >= 3 and w.y == 0,
		"a mannequin stands at its door (%.1f m from the arrow), white with no face (%d white pieces, %d of a face), in other clothes each day (%d of 7 days differ, the same day the same: %s), in showy shoes with a stand of the day's pair by it (%d of 8 days, the stand: %s); a punch knocks it over (%s, %s) and it is back the next day (%s)" % [gap, w.x, w.y, differ, same, showy, stand, stood, knocked, back])
	a.set_open(false)                               # the shop shut: taken in (no frames waited: the shop's own clock would open it again)
	var taken_in: bool = mq.away and not mq.visible and mq.collision_layer == 0
	g.props.punch(mq.p, -a._na)
	var untouched: bool = mq.freeze and mq.away
	a.set_open(true)
	var out_again: bool = mq.standing() and mq.visible and mq.collision_layer == 16
	g.weekday = mq_when[0]
	g.set_time(mq_when[1])
	a.set_open(a.open_at(g.weekday, g.clock))
	_check(taken_in and untouched and out_again,
		"it is out only while the shop is open: shut, taken in and out of reach (%s, a punch does nothing: %s); open, out again (%s)" % [taken_in, untouched, out_again])
	# the user's yes (23 Nov 2026, "Azafrán en caja de zapatos"): the saffron in the open shoe box by the bench
	var hidden := false
	var fl = null
	for f in g.flowers:
		if String(f.get("id", "")) == "pisacastana" and bool(f.get("hidden", false)) and (f["p"] as Vector2).distance_to(d.saffron_spot) < 0.01:
			hidden = true
			fl = f
	var reach := 99.0
	if fl != null:
		var was_gone = fl.get("gone", false)
		fl["gone"] = true                               # (walking up to it must not take it: the test is not to have it)
		var was2: Vector2 = g.player.p
		g.player.p = d.INSIDE + Vector2(2.7, 6.2)
		await _frames(4)
		reach = await _walk_at(d.saffron_spot, 3.0)
		g.player.p = was2
		fl["gone"] = was_gone
	_check(hidden and reach < 1.2, "a saffron flower is hidden in an open shoe box on the floor by the bench of its inside (%s), and you get to it (%.2f m from it)" % [hidden, reach])

## The roast chicken shop "Javi" of the Calle de los Arcos (asador.gd, asador_dentro.gd): built on its house of the
## map, its hours, its states, its set far off and closed, the walk in by the green arrow and out again, its saffron.
func _asador_checks() -> void:
	var a = g.world.get("asador")
	var d = a.get("dentro") if a != null else null
	_check(a != null and d != null and a.pieces > 150 and d.pieces + d.props > 150, "the roast chicken shop Javi is built by hand (%d pieces), with its inside (%d)" % [(a.pieces if a != null else 0), ((d.pieces + d.props) if d != null else 0)])
	if a == null or d == null:
		return
	var drawn := 0
	var found := 0
	for casa in g.world.casas:
		if casa.id == a.HOUSE:
			drawn += casa.get_child_count()
			found += 1
	var space := get_tree().root.get_world_3d().direct_space_state
	var p: Vector2 = a.spot(3.0, 3.0)
	var q: Vector2 = a.spot(3.0, -3.0)
	var stops: bool = not space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(p.x, a.level + 1.2, p.y), Vector3(q.x, a.level + 1.2, q.y), 1)).is_empty()
	var street: String = String(MapData.nearest_road(a.door)["seg"].road["n"])
	var calles = load("res://scripts/casas_calles.gd")
	var handed: bool = calles.HOUSES.has(a.HOUSE) and (calles.HOUSES[a.HOUSE] as Array).size() == 1 and String(calles.HOUSES[a.HOUSE][0]) == "obra"
	_check(drawn == 0 and handed and stops and street.contains("Arcos"),
		"it stands on its house of the map, which the houses' own script no longer draws (handed over as [\"obra\"]: %s; %d found, %d pieces of it drawn); its front stops you (%s); it gives on to the %s" % [handed, found, drawn, stops, street])
	var good := true
	for on in [true, false]:
		a.set_open(on)
		if a._open.visible != on or a._shut.visible == on or d.open != on:
			good = false
	a.set_open(a.open_at(g.weekday, g.clock))
	var rule: bool = a.open_at(1, 7.0) and a.open_at(1, 15.9) and not a.open_at(1, 6.9) and not a.open_at(1, 16.0) and a.open_at(6, 7.0) and a.open_at(6, 15.9) and not a.open_at(6, 6.9) and not a.open_at(6, 16.0)
	for other in [0, 2, 3, 4, 5]:
		if a.open_at(other, 12.0):
			rule = false
	_check(good and rule, "it keeps the hours the user gave (Tuesdays and Sundays from seven to four, shut the other days): open, the grille folded and the door in; shut, the grille across (%s, %s)" % [good, rule])
	var far: float = (MapData.nearest_road(d.INSIDE, true)["p"] as Vector2).distance_to(d.INSIDE)
	var from := Vector3(d.in_spawn.x, d.level + 1.0, d.in_spawn.y)
	var walled := true
	for to in [Vector3(6, 0, 0), Vector3(-6, 0, 0), Vector3(0, 0, 9), Vector3(0, 0, -5), Vector3(0, 6, 0)]:
		if space.intersect_ray(PhysicsRayQueryParameters3D.create(from, from + to, 1)).is_empty():
			walled = false
	var level_floor: bool = absf(MapData.foot(d.in_spawn) - d.level) < 0.01 and absf(MapData.foot(d.client_spot) - d.level) < 0.01
	var behind: bool = d.javi_spot.y > d.INSIDE.y + d.COUNTER + d.COUNTER_D and d.client_spot.y < d.INSIDE.y + d.COUNTER
	var hidden := false
	for f in g.flowers:
		if String(f.get("id", "")) == "asador" and bool(f.get("hidden", false)) and (f["p"] as Vector2).distance_to(d.saffron_spot) < 0.01:
			hidden = true
	_check(far > 200.0 and walled and level_floor and d.door_out.distance_to(a.door) < 2.0 and g.entradas.is_shop(d) and behind and hidden,
		"its inside is a set of its own far from the town (%.0f m from any street), closed all round (%s), its floor level (%s); it is one of the places with a green arrow (%s); Javi's place is behind the counter and yours before it (%s); a saffron flower is hidden in it (%s)" % [far, walled, level_floor, g.entradas.is_shop(d), behind, hidden])
	# the counter stops you: from before it you do not get behind
	var was: Vector2 = g.player.p
	g.player.p = d.client_spot
	await _frames(4)
	var short: float = await _walk_at(d.javi_spot, 2.5)
	_check(short > 1.0, "nobody but Javi goes behind the counter (you stop %.1f m from his place)" % short)
	g.player.p = was

## The Travesía del Clavel (travesia.gd): built, its street a footpath of its own, the walk raised over the ground, walked
## from San Rafael up its three ramps, along it and down the stairs to the Clavel, its walls in the way, its saffron.
func _travesia_checks() -> void:
	var tv = g.world.get("travesia")
	var road_ok := false
	for r in MapData.roads:
		if int(r.get("paved", 0)) == 5 and int(r["k"]) == 2:
			road_ok = true
	_check(tv != null and tv.pieces > 300 and tv.outlines.size() >= 8 and road_ok, "the Travesía del Clavel is built by hand (%d pieces, %d outlines) and its street is a footpath of its own (%s)" % [(tv.pieces if tv != null else 0), (tv.outlines.size() if tv != null else 0), road_ok])
	if tv == null:
		return
	var over: float = MapData.foot(tv.mid_spot) - MapData.height(tv.mid_spot)
	var at_foot: float = absf(MapData.foot(tv.ramp_foot) - MapData.height(tv.ramp_foot))
	var at_top: float = MapData.foot(tv.ramp_top) - MapData.height(tv.ramp_top)
	_check(over > 0.7 and over < 1.6 and at_foot < 0.01 and at_top > 1.0, "the walk is raised over the ground (%.2f m in its middle, %.2f where the ramps end) and the pavement of San Rafael is not (%.2f)" % [over, at_top, at_foot])
	var was: Vector2 = g.player.p
	g.player.p = tv.ramp_foot
	await _frames(5)
	var worst := 0.0
	for q in [[1.1, 0.8, 3.0], [1.1, 6.2, 4.0], [2.55, 6.2, 3.0], [2.55, 0.8, 4.0], [4.0, 0.8, 3.0], [4.0, 6.2, 4.0], [6.2, 6.2, 3.0], [30.0, 3.6, 9.0]]:
		var left: float = await _walk_at(tv.spot(q[0], -q[1]), q[2])
		worst = maxf(worst, left)
	var up: float = g.player.global_position.y - MapData.height(g.player.p)
	for q in [[tv.top_s - 4.0, 5.8, 9.0], [tv.top_s - 0.3, 5.8, 3.0], [tv.FOOT_N + 1.2, 5.8, 4.0]]:
		var left2: float = await _walk_at(tv.spot(q[0], -q[1]), q[2])
		worst = maxf(worst, left2)
	var down: float = absf(g.player.global_position.y - MapData.height(g.player.p))
	_check(worst < 0.6 and up > 0.7 and down < 0.25, "you walk up the three ramps from San Rafael, along the walk and down the stairs to the Clavel (never more than %.1f m short; %.2f m up in the middle, %.2f at the end)" % [worst, up, down])
