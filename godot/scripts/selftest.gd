	g.player.p = g.kebab.spot(11.3, -14.2)
	await _frames(5)
	g.talk_to(luis)
	_check(g.dlg != null and g.dlg["lines"] == Loc.t("luis_mision"), "and Don Luis, whose line of missions this opens, tells you about his")
