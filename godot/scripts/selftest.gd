	g._fight_done(true)
	g._fight_done(true)
	_check(g.pc == 12, "a minigame 1, the first time you win it each day")
	g.day_n += 1
	g._fight_done(false)
	g._fight_done(true)
	_check(g.pc == 13, "(lost: nothing; won again the next day: one more)")
