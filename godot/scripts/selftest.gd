	_check(g.pc == 16, "and a side mission 3, straight on to the slate now")
	g._save(g.save_si)
	var kept = g._load_slot(g.slot)
	_check(kept != null and int(kept.get("pc", -1)) == 16 and kept["stats"].has("pc_on") and kept["stats"].has("puente") and kept["stats"].has("menu_done"), "all of it is saved with the game")
	g.traffic._spawn_t = 2.0
	g.set_target(null, false)

## --- the roast ham riot (motin.gd) ---
## walks up to the crowd, sits through the scene and lets the fight run out at once: for tests that only need the
## ham. Returns false if there was no riot to go through.
func _riot_through() -> bool:
	var M = g.motin
	g.player.p = M.centre() - M.along() * 30.0
	var n := 0
	while M.stage == "" and n < 120:
		await get_tree().physics_frame
		n += 1
	if M.stage != "wait":
		return false
	g.player.p = M.centre() - M.along() * 9.0
	n = 0
	while M.stage != "fight" and n < 60 * 30:
		await get_tree().physics_frame
		n += 1
		if g.dlg != null:
			await _skip_dialog(false)
	if M.stage != "fight":
		return false
	M.t = 0.2
	n = 0
	while M.stage == "fight" and n < 120:
		await get_tree().physics_frame
		n += 1
	await _skip_dialog(false)
	await _frames(5)
	return M.stage == ""

## The whole of it. Begins with Josefa's errand on offer (the phone mission done, restaurants not yet known).
func _riot_button(button: InputEvent, pressed: bool) -> void:
	button.set("pressed", pressed)
	get_viewport().push_input(button, true)
	Input.flush_buffered_events()

## Place a real shoulder camera with a facade behind it, using street collision in the playable area.
func _riot_facade() -> bool:
	var m = g.motin
	var street: Vector2 = m.centre()
	var eye := MapData.at(street, 1.6)
	var door: Vector2 = (g.named["henry"].p - street).normalized()
	for i in range(24):
		var wall := door.rotated(i * TAU / 24.0)
		var ray := PhysicsRayQueryParameters3D.create(eye, eye + Vector3(wall.x, 0, wall.y) * m.RING, 1)
		var hit: Dictionary = g.get_world_3d().direct_space_state.intersect_ray(ray)
		if hit.is_empty() or absf(hit.normal.y) > 0.2 or eye.distance_to(hit.position) < 2.6:
			continue
		var normal := Vector2(hit.normal.x, hit.normal.z).normalized()
		g.player.p = Vector2(hit.position.x, hit.position.z) + normal * 2.6
		g.cam_yaw = atan2(normal.x, normal.y)
		g.player.h = g.cam_yaw
		g.player.sync()
		for step in range(50):
			g._update_camera(1.0 / 60.0, g.player.p, 0, 0)
		ray.from = MapData.at(g.player.p, 1.6)
		ray.to = g.cam.position
		return g.get_world_3d().direct_space_state.intersect_ray(ray).is_empty()
	return false

func _riot_gestures(pictures: bool) -> void:
	var m = g.motin
	var p: Vector2 = g.player.p
	var heading: float = g.player.h
	var yaw: float = g.cam_yaw
	var old_touch := Touch.on
	var old_pad := Controls.pad
	g.hud.toast_slot.visible = false
	var clear := _riot_facade()
	if pictures:
		await _shot("motin_fachada")
	_check(clear, "a facade behind the shoulder camera does not cut off the player")
	_check(m.crowd.all(func(f): return f.n.vis.visible or not f.bar.visible), "an occluding neighbour hidden by the lens leaves no floating health bar")
	# one of them between the camera and you: seen through, not hidden (the user, 21 Nov 2026)
	var who = m.crowd[0].n if not m.crowd.is_empty() else null
	if who != null:
		var eye2 := Vector2(g.cam.global_position.x, g.cam.global_position.z)
		var mid: Vector2 = eye2.lerp(g.player.p, 0.5)
		var was_np: Vector2 = who.p
		who.p = mid
		who.sync()
		for step in range(3):
			g._update_camera(1.0 / 60.0, g.player.p, 0, 0)
		var meshes: Array = who.get_meta("ghost_meshes", [])
		var ghost: bool = who.vis.visible and not meshes.is_empty() and meshes.all(func(mm): return not is_instance_valid(mm) or absf((mm as GeometryInstance3D).transparency - g.GHOST) < 0.01)
		if pictures:
			await _shot("motin_transparente")
		who.p = was_np
		who.sync()
		for step in range(3):
			g._update_camera(1.0 / 60.0, g.player.p, 0, 0)
		var back: bool = meshes.all(func(mm): return not is_instance_valid(mm) or (mm as GeometryInstance3D).transparency == 0.0)
		_check(ghost and back, "a neighbour between the riot's camera and you is seen through, not hidden, and solid again once out of the way")
	g.player.p = p
	g.player.h = heading
	g.player.sync()
	g.cam_yaw = yaw
	var front := Vector2(sin(heading), cos(heading))
	var side := Vector2(front.y, -front.x)
	var fighters: Array = m._standing()
	var places := []
	for f in fighters:
		places.append(f.n.p)
		f.n.p = p + front * 5.0 + side * (places.size() - 5)
		f.hp = 100
	var mouse := InputEventMouseButton.new()
	mouse.button_index = MOUSE_BUTTON_LEFT
	var pad := Controls._pad(JOY_BUTTON_X)
	_riot_button(mouse, true)
	m._advance_swing(0.10)
	_check(m.swing_phase == "hold" and m._bat.visible, "the original bat winds up immediately on click")
	_riot_button(mouse, false)
	m._advance_swing(0.299)
	_check(m.swing_phase == "tap" and m.blows == 0, "a short tap has no contact before 0.40 seconds from press")
	# Move them *after* release, turn the camera independently of the avatar.
	g.cam_yaw = heading + 0.52
	fighters[3].n.p = p + front * 1.5
	fighters[2].n.p = p + front * 1.1
	fighters[1].n.p = p - front * 0.5
	fighters[0].n.p = p - front * 0.8
	m._advance_swing(0.001)
	_check(m.score == 10 and fighters[2].hp == 75 and fighters[1].hp == 75 and fighters[0].hp == 100 and fighters[3].hp == 100, "tap finds the two nearest at contact, including the close exception, excluding the rear sector")
	m._advance_swing(0.299)
	_riot_button(mouse, true)
	_riot_button(mouse, false)
	_check(m.swing_phase == "recover" and m.blows == 2, "extra edges during recovery do not queue another swing")
	m._advance_swing(0.001)
	_check(m.swing_phase == "", "tap is ready again at 0.70 seconds")
	for f in fighters.slice(0,4):
		f.n.p = p - front * 3
	_riot_button(mouse, true)
	m._advance_swing(0.249)
	_riot_button(mouse, false)
	m._advance_swing(0.151)
	_check(not m.charged and not m.landed and m.score == 10 and m.swing_phase == "recover", "0.249 seconds still selects tap; a miss scores zero")
	m._advance_swing(0.30)
	var group := [Vector2(0.80, 0.65), Vector2(-0.95, 0.92), Vector2(0.12, 1.50), Vector2(0.62, 1.65)]
	for i in range(group.size()):
		fighters[i].n.p = p + front * group[i].y + side * group[i].x
	_riot_button(pad, true)
	m._advance_swing(0.25)
	_check(m.swing_phase == "ready" and g.hud.obj_text.text.contains(Loc.t("motin_ready")), "X held for exactly 0.25 seconds shows charge ready")
	m._advance_swing(1.0)
	_check(m.swing_phase == "ready" and m.blows == 2, "holding charge has no automatic contact")
	if pictures:
		var language := Loc.lang
		Loc.lang = "en"
		g.cam_yaw = heading - 0.38
		m._show()
		for step in range(45):
			g._update_camera(1.0 / 60.0, p, 0, 0)
		await _shot("motin_carga_lista")
		_check(g.hud.obj_text.text.contains("Bat ready!"), "the charged pose is held under the English release cue")
		Loc.lang = language
	_riot_button(pad, false)
	for i in range(group.size()):
		fighters[i].hp = 25 if i == 0 else 100
	m._advance_swing(0.219)
	_check(m.blows == 2 and m.swing_phase == "charged", "release commits charge; no contact at 0.219 seconds")
	m._advance_swing(0.001)
	_check(m.score == 30 and m.kos == 1 and m.blows == 5 and fighters[0].down and fighters[1].hp == 75 and fighters[2].hp == 75 and fighters[3].hp == 100, "charged contact at 0.22 seconds: two blows plus one knockout score twenty")
	_check(g.player._hr.position.z > 0.95 and fighters[1].n.inner.rotation.z > 0.1, "the bat crosses the front in the same step as the struck neighbour recoils")
	if pictures:
		for step in range(45):
			g._update_camera(1.0 / 60.0, p, 0, 0)
		await _shot("motin_contacto_cargado")
		g.cam_yaw = heading - 0.8
		for step in range(45):
			g._update_camera(1.0 / 60.0, p, 0, 0)
		await _shot("motin_giro_grupo")
	m._advance_swing(0.499)
	_check(m.swing_phase == "recover" and m.blows == 5, "charged recovery lasts half a second; each participant scores once")
	m._advance_swing(0.001)
	Touch._show(true)
	Touch._context_tick()
	var hit := Vector2.ZERO
	for b in Touch._buttons:
		if b.action == "punch":
			hit = b.centre
	_box_touch(1, hit, true)
	m._advance_swing(0.25)
	var origin := Vector2(Touch._size().x * 0.53, 180)
	_box_touch(0, origin, true)
	_box_drag(origin + Vector2(35, 0))
	_box_touch(0, origin, false)
	_check(m.swing_phase == "ready" and not Touch.take_look().is_zero_approx(), "a second finger can turn the camera while Golpe holds the charge")
	for i in range(1,4):
		fighters[i].n.p = p + front * (0.8 + i * 0.19) + side * (i - 2) * 0.15
	_box_touch(1, hit, false)
	m._advance_swing(0.22)
	_check(m.charged and m.swing_phase == "recover" and m.blows == 8, "release of the actual touch button delivers one charged sweep")
	m._advance_swing(0.50)
	for i in range(1,4):               # the previous impact shoved them: give the tap two clear targets
		fighters[i].n.p = p + front * (0.8 + i * 0.19) + side * (i - 2) * 0.15
	_box_touch(1, hit, true)
	_box_touch(1, hit, false)
	m._advance_swing(0.40)
	_check(not m.charged and m.blows == 10, "a fast touch delivers a single basic sweep")
	m._advance_swing(0.30)
	Touch._show(false)
	_riot_button(mouse, true)
	m._advance_swing(0.25)
	m.notification(NOTIFICATION_APPLICATION_FOCUS_OUT)
	_riot_button(mouse, false)
	_check(m.swing_phase == "", "losing focus discards the held charge and its later release")
	_riot_button(mouse, true)
	_riot_button(pad, true)
	_riot_button(mouse, false)
	_check(m.swing_phase == "hold" and m._source == "pad%d" % pad.device, "switching devices drops the first gesture, whose release cannot fire the second")
	m._pad_connection(pad.device, false)
	_riot_button(pad, false)
	_check(m.swing_phase == "", "pad disconnection leaves the bat idle")
	_riot_button(mouse, true)
	m._advance_swing(0.1)
	g._open_pause()
	var clock_before_pause: float = m.t
	g.set_physics_process(true)
	await _frames(12)
	g.set_physics_process(false)
	_check(is_equal_approx(m.swing_age, 0.1) and is_equal_approx(m.t, clock_before_pause), "both the charge and the 60-second clock freeze during pause")
	_riot_button(mouse, false)
	g._close_pause()
	_check(m.swing_phase == "", "release in the pause menu discards the unfinished swing")
	_riot_button(mouse, true)
	g._set_map(true)
	_riot_button(mouse, false)
	g._set_map(false)
	_check(m.swing_phase == "", "releasing while the map is open drops the gesture")
	_riot_button(mouse, true)
	_riot_button(mouse, false)
	m._advance_swing(0.39)
	m._floor_you()
	m._advance_swing(0.02)
	_riot_button(mouse, true)
	_riot_button(mouse, false)
	_check(m.swing_phase == "" and m.blows == 10, "a fall cancels pending contact; another press while down cannot start a swing")
	for i in range(fighters.size()):
		fighters[i].n.p = places[i]
	g.cam_yaw = yaw
	Touch._show(old_touch)
	Controls.pad = old_pad
	m._show()

func _motin_checks(pictures := false) -> void:
	var M = g.motin
	var henry = g.named["henry"]
	var josefa = g.named["josefa"]
	if g.in_car != null:
		g.in_car.set_speed(Vector2.ZERO)
		g._exit_car()
	g.traffic.clear()
	g.police.reset()
	g.side = null
	g.phone_call = null
	g.hud.phone(false)
	for key in ["menu_done", "menu_seen", "jamon_day", "jamon_pc", "jamon_best", "jamon_fights", "jamon_wins", "thu", "pc_owed"]:
		g.stats.erase(key)
	g.unlocked.erase("jamon")
	g.stats["pc_on"] = true
	g.pc = 0
	g.money = 0
	g.weekday = 3
	g.set_time(10.0)
	g._refresh_counts()
	if g.si != g._idx("alberto"):
		g.begin_step(g._idx("alberto"))
	g.player.p = M.centre() - M.along() * 30.0
	await _frames(30)
	_check(M.stage == "" and M.crowd.is_empty() and not M.wanted(), "before you have ever been sent for a ham there is nobody outside Henry's, Thursday or not")
	# Josefa's errand: the bat
	if josefa.p.distance_to(M.centre()) < 22.0:  # keep Josefa clear of Henry's trigger radius so talking doesn't start the riot early
		josefa.p = josefa.home
		josefa.sync()
	g.player.p = josefa.p + Vector2(1.2, 0.8)
	await _frames(5)
	g.weekday = 1
	g.talk_to(josefa)
	_check(g.dlg != null and String(g.dlg["lines"][-1]).contains("bate") and String(g.dlg["lines"][-1]).contains("costumbres"), "Josefa sends you for the menu, and \"gives\" you a bat: every town has its customs")
	await _skip_dialog()
	_check(g.side != null and g.side["id"] == "menu" and M.wanted(), "(taken, and it is not even Thursday: the first time is whenever she sends you)")
	g.player.p = M.centre() - M.along() * 30.0
	await _frames(20)
	var gathered := func() -> bool:
		return M.stage == "wait" and M.crowd.size() == M.CROWD and M.crowd.all(func(f): return f["n"].p.distance_to(M.centre()) < 12.0 and f["arm"] == null)
	for _w in range(8):                          # (the last of them may still be on their way: up to 40 frames more, 23 Nov 2026)
		if gathered.call():
			break
		await _frames(5)
	var far_one := 0.0
	var arms_out := 0
	for f in M.crowd:
		far_one = maxf(far_one, f["n"].p.distance_to(M.centre()))
		arms_out += 0 if f["arm"] == null else 1
	_check(gathered.call(), "outside La Cocina de Henry there is a crowd: %d neighbours, all after the same ham (%s, the furthest %.1f m off, %d armed)" % [M.crowd.size(), M.stage, far_one, arms_out])
	if pictures:
		await _view_at(MapData.at(M.centre() - M.along() * 14.0, 4.5), MapData.at(M.centre(), 1.0), "motin_1_gente", 60.0)
	g.player.p = M.centre() - M.along() * 10.0
	await _frames(20)
	_check(M.stage == "cine" and g.cine_lock and g.cam_fixed != null and g.police.muted, "walk up and a scene begins (and Los Pitufos stop counting)")
	if pictures:
		await _frames(8)
		g.phase = "selfshot"
		await _shot("motin_2_plano_general")
		g.phase = "play"
	var n := 0
	while g.dlg == null and n < 60 * 5:
		await get_tree().physics_frame
		n += 1
	_check(g.dlg != null and g.dlg["lines"] == Loc.t("henry_motin") and String(g.dlg["lines"][2]).contains("lo de siempre") and g.hud.dlg_name.text == henry.shown_name(),
		"Henry comes out: too many of you, not enough hams, so it will have to be the usual")
	if pictures:
		g.dlg["shown"] = 999.0
		g.hud.dlg_text.visible_characters = -1
		await _shot("motin_3_henry")
	await _skip_dialog(false)
	await _frames(10)
	if pictures:                                   # (straight away: the first weapon is out for a second)
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("res://shots/motin_4_arma_0.png")
	var armed: int = M.crowd.filter(func(f): return f["arm"] != null).size()
	_check(armed >= 1 and armed <= 3 and g.cam.fov < 40.0, "close shots: the weapons come out, one hand at a time (%d so far, lens at %.0f degrees)" % [armed, g.cam.fov])
	var fel = g.named.get("feliciano")
	_check(fel != null and M.crowd.size() > 1 and M.crowd[1]["n"] == fel and M.crowd[1]["kind"] == "cuchillo" and M.crowd[1]["arm"] != null,
		"Feliciano is in the crowd, always (the user, 17 Nov 2026), and the first to bring his weapon out: the cleaver")
	var shown: Array = M.crowd.filter(func(f): return f["arm"] != null)
	var models: Array = shown.map(func(f): return String(f["arm"].get_child(0).name) if f["arm"].get_child_count() > 0 else "")
	_check(shown.all(func(f): return f["n"].hand_at == M.SHOW_HAND) and models.all(func(nm): return nm in ["bate", "cuchillo", "puno"]),
		"each weapon a free model (%s), held up by the face to be seen (the user, 17 Nov 2026: \"no se entiende lo que hacen\")" % ", ".join(models))
	n = 0
	var tightest := 99.0
	var eyes_shot := false
	var drawn_shot := {0: true}
	while g.dlg == null and n < 60 * 10:
		await get_tree().physics_frame
		n += 1
		tightest = minf(tightest, g.cam.fov)
		var drawn: int = M.crowd.filter(func(f): return f["arm"] != null).size()
		if pictures and M._beat >= 0 and M._beat < M._beats.size() and M._beats[M._beat][0] == "draw" and not drawn_shot.has(drawn - 1):
			drawn_shot[drawn - 1] = true
			await _frames(6)
			await RenderingServer.frame_post_draw          # (straight away: the shot lasts less than _shot waits)
			get_viewport().get_texture().get_image().save_png("res://shots/motin_4_arma_%d.png" % (drawn - 1))
		if pictures and not eyes_shot and g.cam.fov < 10.0:
			eyes_shot = true
			await _shot("motin_5_ojos")
	_check(tightest < 10.0 and M.crowd.filter(func(f): return f["arm"] != null).size() == 3, "then the eyes, closer and quicker, as before a duel")
	_check(g.dlg != null and g.dlg["lines"][0] == Loc.t("henry_motin_ya") and String(g.dlg["lines"][0]).contains("los que queden en pie tendrán jamón"), "\"you know how it goes: whoever is left standing gets roast ham\"")
	await _skip_dialog(false)
	await _frames(20)
	_check(M.raising and M._bat != null and g.player._hr.position.y > 1.5, "and you raise the bat")
	if pictures:
		await _shot("motin_6_bate")
	n = 0
	while M.stage != "fight" and n < 60 * 4:
		await get_tree().physics_frame
		n += 1
	await _frames(10)
	_check(M.stage == "fight" and not g.cine_lock and g.cam_fixed == null and absf(g.cam.fov - 55.0) < 0.1 and g.hud.timer_slot.visible and M.t > 59.0, "the camera comes in over your shoulder and it begins: sixty seconds")
	var behind: Vector3 = g.cam.global_position - g.player.global_position
	var facing := Vector2(sin(g.cam_yaw), cos(g.cam_yaw))
	_check(Vector2(behind.x, behind.z).dot(facing) < -2.0 and Vector2(behind.x, behind.z).dot(facing) > -4.5 and behind.y > 1.5 and behind.y < 2.8, "(%.1f m behind you and %.1f m up)" % [-Vector2(behind.x, behind.z).dot(facing), behind.y])
	_check(M.crowd.all(func(f): return f["arm"] != null and f["hp"] == 100 and f["bar"] != null) and M.crowd.any(func(f): return f.bar.visible) and M._standing().size() >= M.ACTIVE, "everybody armed, everybody with a hundred points over their head")
	g.police.add_heat(50.0)
	_check(g.police.heat == 0.0, "nothing you do here reaches Los Pitufos")
	await _frames(30)
	_check(M.crowd.filter(func(f): return f["target"] is String).size() == M.ON_YOU, "two of them are after you, always")
	if pictures:
		await _frames(120)
		await _shot("motin_7_pelea")
	if OS.get_cmdline_user_args().has("--motin") and OS.get_cmdline_user_args().has("--manual"):
		print("MOTIN manual — pads ", Input.get_connected_joypads(), ", touchscreen ", DisplayServer.is_touchscreen_available())
		var taps := 0
		var sweeps := 0
		var previous := ""
		while M.fighting():
			if M.swing_phase == "recover" and previous != "recover":
				if M.charged:
					sweeps += 1
				else:
					taps += 1
			previous = M.swing_phase
			await get_tree().physics_frame
		print("MOTIN manual — taps ", taps, ", charged ", sweeps, ", blows ", M.blows, ", knockouts ", M.kos, ", score ", M.score)
		_check(taps + sweeps > 0 and M.score == (M.blows - M.kos) * M.HIT + M.kos * M.KO, "native input reached contact and the full round closed with the displayed score")
		await _skip_dialog(false)
		return
	# your bat
	M.floor_t = 0.0                                # (on your feet, and left alone for the moment)
	M.safe_t = 5.0
	g.player.inner.rotation.x = 0.0
	g.set_physics_process(false)
	await _riot_gestures(pictures)
	g.set_physics_process(true)
	# they fight one another too, and more come from the corners
	var total: int = M.crowd.size()
	for f in M._standing().slice(0, 7):
		f["down"] = true
		f["bar"].visible = false
		f["n"].inner.rotation.x = -PI / 2.0
	var low: int = M._standing().size()
	var came0: int = M.came
	n = 0
	var fewest := 99
	while n < 60 * 8:
		await get_tree().physics_frame
		n += 1
		if n > 60 * 5:
			fewest = mini(fewest, M._standing().size())
	_check(low < M.ACTIVE and M.came > came0 and fewest >= M.ACTIVE - 1 and M.crowd.size() > total, "lay enough of them out and more come running from the street corners: never fewer than ten for long (%d came; %d on their feet)" % [M.came - came0, M._standing().size()])
	_check(M.crowd.any(func(f): return not f["down"] and f["hp"] < 100) or M.crowd.filter(func(f): return f["down"]).size() > 8, "and they are hitting one another, not only you")
	# they can floor you, and it only costs you time
	var before: int
	M.floor_t = 0.0
	M.safe_t = 0.0
	M._floor_you()
	g._punch_cool = 0.0
	before = M.score
	g._punch()
	var lain: Vector2 = g.player.p
	Input.action_press("forward")
	await _frames(20)
	_check(M.floored() and M.score == before and g.player.p.distance_to(lain) < 0.6 and absf(g.player.inner.rotation.x) > 0.8, "knocked down, you can neither swing nor walk")
	if pictures:
		await _shot("motin_8_al_suelo")
	await _frames(45)
	Input.action_release("forward")
	_check(not M.floored() and absf(g.player.inner.rotation.x) < 0.01, "and a second and a half later you are up again, with no harm done but the time")
	g.player.p = M.centre() + M.along() * 40.0
	await _frames(5)
	_check(g.player.p.distance_to(M.centre()) <= M.RING + 0.5, "nobody leaves the street until it is over")
	# time
	var final: int = M.score
	var last_tap := InputEventMouseButton.new()
	last_tap.button_index = MOUSE_BUTTON_LEFT
	_riot_button(last_tap, true)
	_riot_button(last_tap, false)
	M._advance_swing(0.39)
	_check(M.swing_phase == "tap", "last tap is committed with ten milliseconds to contact")
	M.t = 0.01
	await _frames(30)
	_check(M.swing_phase == "" and M.score == final, "clock ending on the contact step cancels it")
	_check(M.stage == "after" and g.dlg != null and g.dlg["lines"] == Loc.t("henry_motin_fin") and String(g.dlg["lines"][1]).contains("coger aceituna") and not g.hud.timer_slot.visible,
		"time: Henry stops it and congratulates you on your way with a stick")
	await _skip_dialog(false)
	await _frames(5)
	_check(M.stage == "" and int(g.stats["jamon_best"]) == final and g.unlocked.has("jamon") and g.pc == 1 and not g.police.muted and M._bat == null, "your score is kept (%d), the minigame is in the Agenda, and it is worth 1 Punto Cívico (the first of the day)" % final)
	_check(g.side != null and g.side["stage"] == "bring", "and the ham is yours to carry")
	var purse: int = g.money
	g.player.p = josefa.p + Vector2(1.5, 1.0)
	await _frames(20)
	_check(g.side == null and g.money == purse + 20 and g.pc == 4 and g.dlg != null and String(g.dlg["lines"][1]).contains("jueves"), "taken to Josefa: 20 euros and the 3 Puntos Cívicos of a side mission; and she tells you about Thursdays")
	await _skip_dialog()
	# every Thursday from now on
	g.weekday = 1
	g.player.p = M.centre() - M.along() * 30.0
	await _frames(30)
	_check(M.stage == "" and not M.wanted(), "on any other day the street is quiet")
	g.weekday = 3
	g.day_n += 1
	g.set_time(10.0)
	await _frames(30)
	_check(M.stage == "wait" and M.crowd.size() == M.CROWD, "on Thursdays they are back, ham to fetch or not")
	var went: bool = await _riot_through()
	_check(went and g.side == null and g.pc == 5 and int(g.stats["jamon_fights"]) == 2, "walk up and it is on again, for the score and the Punto Cívico of the day")
	g.player.p = M.centre() - M.along() * 30.0
	await _frames(30)
	_check(M.stage == "" and not M.wanted(), "once a Thursday: after that they have gone home")
	# a Thursday call: no clock, the riot, twenty euros
	g.day_n += 7
	g.stats.erase("thu")
	g._weekly_call()
	var caller: String = g.phone_call["npc"] if g.phone_call != null else ""
	g.interact()
	await _skip_dialog()
	_check(g.side != null and g.side["id"] == "ham" and not g.hud.timer_slot.visible, "the Thursday call has no clock any more")
	went = await _riot_through()
	purse = g.money
	_check(went and g.side != null and g.side["stage"] == "bring" and g.police.muted, "the ham is fought for like any other Thursday's")
	g.player.p = g.named[caller].p + Vector2(1.5, 1.0) if caller != "vip" else g.player.p
	g.indoors = caller == "vip"
	await _frames(20)
	g.indoors = false
	_check(g.side == null and g.money == purse + 20, "and delivered: 20 euros")
	await _skip_dialog()
	# from the Agenda, whenever you like: no Puntos Cívicos
	var pc_was: int = g.pc
	g.weekday = 0
	var home: Vector2 = g.places["home"]["p"]
	g.player.p = home
	await _frames(10)
	g.menu.open("log_games")
	var item: Array = g._menu_page("log_games")["items"].filter(func(it): return it.has("do") and String(it["text"]).contains(Loc.t("mg_jamon")))
	_check(item.size() == 1, "the Agenda's minigames page has it")
	if item.size() == 1:
		item[0]["do"].call()
	await _frames(10)
	_check(M.stage == "cine" and M.agenda and g.player.p.distance_to(M.centre()) < 12.0, "chosen there, it starts there and then, any day of the week")
	n = 0
	while M.stage != "fight" and n < 60 * 30:
		await get_tree().physics_frame
		n += 1
		if g.dlg != null:
			await _skip_dialog(false)
	await _frames(32)
	_check(M.swing_phase == "" and M.blows == 0 and M.score == 0, "the replay starts fresh with no delayed contact from the previous riot")
	M.t = 0.2
	await _frames(30)
	await _skip_dialog(false)
	await _frames(5)
	_check(M.stage == "" and g.pc == pc_was and g.player.p.distance_to(home) < 1.0, "played from the Agenda it gives no Puntos Cívicos, and you are put back where you were")
	var fel2 = g.named.get("feliciano")
	for i in range(10):
		M.tick(1.0, g.player.p)
	_check(fel2 != null and is_instance_valid(fel2) and g.npcs.has(fel2) and not M.has(fel2) and fel2.state != "busy" and fel2.hand_at == null,
		"after the riots Feliciano goes back to his life (not away with the rest of the crowd)")
	g.traffic._spawn_t = 2.0
	g.police.reset()

## The ruta del colesterol (ruta.gd; the user, 17 Nov 2026, through Worldbuilding): walkers in tracksuits along the old
## Madrid–Cádiz road, early and late in the day, keeping to it, with their own lines.
func _ruta_checks(pictures := false) -> void:
	var R = g.ruta
	_check(R != null and R.beat.size() > 10, "the ruta del colesterol: the old Madrid–Cádiz road (%d points)" % (R.beat.size() if R != null else 0))
	var mj = g.world.get("matojos")
	if mj != null and mj.ready_done:
		var ave_n: int = int(mj.avenue_trees)
		_check(ave_n >= 250, "the old Madrid–Cádiz pavements are lined with shade trees where there are no constructions (%d trees in alcorques)" % ave_n)
	if R == null or R.points.is_empty():
		return
	var th: Dictionary = MapData.townhall
	var town := Vector2(th["m"][0], th["m"][1])
	var near: Vector2 = R.points[0]
	for q in R.points:
		if q.distance_to(town) < near.distance_to(town):
			near = q
	var was := [g.clock, g.raining, g.player.p]
	g.raining = false
	g.set_time(8.0)
	g.player.p = g._pavement(near)
	g.player.sync()
	await _frames(20)
	for i in range(40):
		R.tick(1.0)
	var off_road := []
	for p in R.people:
		var n = p["n"]
		var d := 1e9
		for q in R.points:
			d = minf(d, q.distance_to(n.p))
		if d > 40.0:
			off_road.append(d)
	var dogs: int = R.people.filter(func(p): return p["dog"] != null).size()
	_check(R.people.size() >= 8 and R.people.all(func(p): return int(p["n"].look_data["top"]) == 4 and p["n"].lines_key == "ruta_colesterol" and p["n"].walker and not p["n"].beat.is_empty() and p["n"].voice != "kid")
		and off_road.is_empty() and (dogs == 0 or (R._dog_k > 0.05 and R._dog_k < 1.0)),
		"at eight in the morning, walkers come out along it: %d of them, in tracksuits, keeping to the road (%d with a dog, scale %.2f)" % [R.people.size(), dogs, R._dog_k])
	await _frames(300)
	var strayed := 0
	for p in R.people:
		var n = p["n"]
		var d := 1e9
		for q in R.points:
			d = minf(d, q.distance_to(n.p))
		if d > 60.0:
			strayed += 1
	var walker = null
	for p in R.people:
		if walker == null or p["n"].p.distance_to(g.player.p) < walker.p.distance_to(g.player.p):
			walker = p["n"]
	var moved: bool = walker != null and walker.state != "idle"
	_check(strayed == 0, "five seconds on they are still on it (the crowd that is moved about near you leaves them be)")
	if walker != null:
		g.player.p = walker.p + Vector2(1.2, 0.0)
		g.player.sync()
		g.talk_to(walker)
		var said: String = " ".join(g.dlg["lines"]) if g.dlg != null else ""
		var pool: Array = Loc.t("ruta_colesterol")
		var theirs: bool = pool.any(func(dlg): return said.length() > 0 and String(Loc.speaker([dlg], walker.voice.ends_with("_f"))[0][0]).left(10) == said.left(10))
		await _skip_dialog(false)
		_check(theirs, "talked to, a walker says one of their own (ruta_colesterol): «%s…»" % said.left(50))
	if pictures and walker != null:
		var ahead: Vector2 = walker.p + Vector2(sin(walker.h), cos(walker.h)) * 7.0
		await _view_at(MapData.at(ahead, 1.6), MapData.at(walker.p, 1.0), "ruta_colesterol", 50.0)
	g.set_time(13.0)
	for i in range(3):
		R.tick(1.0)
	_check(R.people.all(func(p): return g.sees(p["n"].p)), "at one o'clock they go home, all but whoever you are looking at (%d left)" % R.people.size())
	g.raining = bool(was[1])
	g.set_time(float(was[0]))
	g.player.p = was[2]
	g.player.sync()
	for p in R.people.duplicate():
		R._drop(p)

## Five roaming dogs of three breeds (galgo, mastin, chucho; perros.gd): strolling pavements, pettable with Interact,
## and launched harmlessly by fast cars with quick recovery like NPCs.
## What the town says about the dogs and the vehicles (the user, 25 Nov 2026): the lines are there, a neighbour
## shouts when you hit a dog, the habit becomes gossip, feeding them a whisper, and each make has its first-drive line.
func _perros_frases_checks() -> void:
	var P = g.perros
	var keep: Dictionary = g.stats.duplicate(true)
	var kinds_ok := true
	for k in CarS.SPECS.keys():
		if k != "kokas" and not Loc.TX.has("car_first_" + String(k)):
			kinds_ok = false
	_check(Loc.t("dog_hit").has("¡Cai, cai, cai!") and Loc.t("dog_hit_seen").size() == 4 and Loc.t("dog_pet_seen").size() == 2 and kinds_ok,
		"the dogs' and vehicles' lines are all there (a first-drive line for every make)")
	var free = null
	for n in g.npcs:
		if n.id == "" and n.visible and not n.away and n.state == "idle" and not n.is_barking() and n.voice != "goat":
			free = n
			break
	if free != null:
		P._witness(free.p + Vector2(0.5, 0.0), 3.0, "dog_hit_seen")
	_check(free == null or g.npcs.any(func(n): return n.is_barking() and n.p.distance_to(free.p) < 4.0),
		"a neighbour nearby shouts when you run over a dog")
	g.stats["perros_atropellados"] = 2
	g.stats["chismes"] = []
	g.stats["chismes_pool"] = []
	P._count("perros_atropellados", 3, "perros_atropello")
	var q: Array = g.stats.get("chismes", [])
	var said: Array = g.chismes.said("perros_atropello", free) if free != null else Loc.t("chisme_perros_atropello")
	_check(q.size() == 1 and String(q[0]["id"]) == "perros_atropello" and not said.is_empty(),
		"three dogs run over and the town talks about it (%s)" % [str(q)])
	g.stats["perros_galletas"] = 1
	_check(g.chismes.whispers().has(Loc.t("murmullo_galletas")), "feeding the dogs gets whispered about")
	var src := GDScript.new()
	src.source_code = "extends RefCounted\nvar kind := \"kokas\"\n"
	src.reload()
	var fake = src.new()
	g.stats["conducidos"] = []
	g._first_drive(fake)
	g._first_drive(fake)
	_check(g.stats.get("conducidos", []) == ["z15"], "the first drive of each make has its line, once (the Kokas' Z15 is a Z15)")
	g.stats = keep

func _perros_checks(pictures := false) -> void:
	var P = g.perros
	_check(P != null and P.list.size() == 5, "five roaming dogs are out on the town (%d)" % (P.list.size() if P != null else 0))
	if P == null or P.list.is_empty():
		return
	_perros_frases_checks()
	var breeds := {}
	var ok_scale := true
	var grounded := true
	for d in P.list:
		breeds[String(d["breed"])] = true
		var sc: float = (d["body"] as Node3D).scale.x
		if sc <= 0.02 or sc >= 1.0:
			ok_scale = false
		var dy: float = absf((d["root"] as Node3D).position.y - MapData.foot(d["p"]))
		if dy > 0.05:
			grounded = false
	_check(breeds.has("galgo") and breeds.has("mastin") and breeds.has("chucho") and ok_scale and grounded,
		"all three breeds (galgo, mastin, chucho) spawn at true scale and stand flush on the pavement (%s)" % [", ".join(breeds.keys())])
	var start_pos: Array = []
	for d in P.list:
		start_pos.append(d["p"])
	await _frames(120)
	var moved := 0
	for i in range(P.list.size()):
		if (P.list[i]["p"] as Vector2).distance_to(start_pos[i] as Vector2) > 0.3:
			moved += 1
	_check(moved >= 3, "the dogs stroll along the pavements on their own (%d of %d moved in 2 s)" % [moved, P.list.size()])
	var d0: Dictionary = P.list[0]
	var saved_p: Vector2 = g.player.p
	var saved_clock: float = g.clock
	g.set_time(12.0)
	g.raining = false
	g.player.p = (d0["p"] as Vector2) + Vector2(1.1, 0.0)
	g.player.sync()
	await _frames(3)
	var found = P.near(g.player.p)
	var pets_before: int = P.pet_count
	if found != null:
		P.pet(found)
	await _frames(5)
	_check(found == d0 and P.pet_count == pets_before + 1 and String(d0["state"]) == "pet" and d0["heart"] != null and (d0["heart"] as Sprite3D).visible and Loc.t("p_pet").contains("Acariciar"),
		"approaching a dog lets you pet it (%s -> state %s, heart shown)" % [Loc.t("p_pet"), String(d0["state"])])
	if pictures:
		# Line up one galgo, one mastin and one chucho on a sunlit open stretch of the Plaza / street next to the player
		var by_b := {}
		for d in P.list:
			if not by_b.has(d["breed"]):
				by_b[d["breed"]] = d
		var th: Dictionary = MapData.townhall
		var base_p: Vector2 = g._pavement(Vector2(th["m"][0], th["m"][1]) + Vector2(22.0, 26.0))
		var idx := 0
		for bname in ["galgo", "mastin", "chucho"]:
			if by_b.has(bname):
				var dg: Dictionary = by_b[bname]
				dg["p"] = base_p + Vector2((idx - 1) * 1.5, 0.0)
				dg["h"] = 0.35
				dg["state"] = "idle"
				dg["t"] = 10.0
				dg["y"] = 0.0
				(dg["pivot"] as Node3D).rotation.x = 0.0
				P._play(dg, "Idle", 0.0)
				P._sync(dg)
				idx += 1
		g.player.p = base_p + Vector2(-2.7, -0.3)
		g.player.h = 0.5
		g.player.sync()
		if by_b.has("galgo"):
			P.pet(by_b["galgo"])
		await _frames(2)
		await _view_at(MapData.at(base_p + Vector2(0.4, 4.4), 1.45), MapData.at(base_p + Vector2(-0.3, 0.0), 0.55), "perros_razas", 46.0)
	# Car hit + quick recovery
	var hits_before: int = P.hit_count
	P.hit(d0, Vector2(9.0, 0.0), 7.0, true, 3.0)
	var flew: bool = String(d0["state"]) == "fly" and P.hit_count == hits_before + 1
	var saw_down := false
	var recovered := false
	for _k in range(280):
		await _frames(1)
		if String(d0["state"]) == "down":
			saw_down = true
		if saw_down and (String(d0["state"]) == "flee" or String(d0["state"]) == "walk"):
			recovered = absf((d0["pivot"] as Node3D).rotation.x) < 0.01
			break
	_check(flew and saw_down and recovered, "a fast car sends a dog flying (flew=%s, down=%s) and it hops right back up (recovered=%s)" % [flew, saw_down, recovered])
	# Vet door biscuits (5 € -> 5 units) + hand feeding -> guides player to nearest saffron flower (zero hint text)
	var saved_money: int = g.money
	g.money = 20
	var vspot: Vector2 = P.VET_SPOTS[0]
	g.player.p = vspot + Vector2(-1.1, 0.2)
	g.player.h = atan2(vspot.x - g.player.p.x, vspot.y - g.player.p.y)
	g.player.sync()
	await _frames(4)
	var vet_ok: bool = P.can_buy() and P.buy_prompt().contains("5 €")
	var bought: bool = P.buy()
	var qty_after_buy: int = int(g.stats.get("inv", {}).get(P.BISCUIT_ID, 0))
	_check(vet_ok and bought and g.money == 15 and qty_after_buy == 5,
		"vet door sells 5 Dog Biscuits for 5 € (can_buy=%s, money=%d, qty=%d)" % [vet_ok, g.money, qty_after_buy])
	if pictures:
		await _view_at(MapData.at(vspot + Vector2(-3.6, 2.2), 1.55), MapData.at(vspot, 1.0), "perros_veterinario", 48.0)
	# Feed d0 by hand near a saffron flower and verify eat -> heart -> guide -> wait/look-back -> reach flower
	var fl = P._nearest_saffron(g.player.p)
	var fl_p: Vector2 = fl["p"] if fl != null else (vspot + Vector2(0.0, 20.0))
	g.player.p = g._pavement(fl_p + Vector2(-16.0, 0.0))
	g.player.sync()
	d0["p"] = g.player.p + Vector2(1.5, 0.0)
	d0["state"] = "idle"
	d0["t"] = 5.0
	d0["y"] = 0.0
	(d0["pivot"] as Node3D).rotation.x = 0.0
	P._sync(d0)
	await _frames(3)
	var fed: bool = P.feed(d0)
	var qty_after_feed: int = int(g.stats.get("inv", {}).get(P.BISCUIT_ID, 0))
	var saw_eat := false
	var saw_guide := false
	var saw_lookback := false
	var guide_d0: float = (d0["p"] as Vector2).distance_to(fl_p)
	var shot_feed := false
	for _k in range(360):
		await _frames(1)
		if String(d0["state"]) == "feed" and int(d0["feed_phase"]) == 1:
			saw_eat = true
			if pictures and not shot_feed:
				shot_feed = true
				var mid_f: Vector2 = (g.player.p + (d0["p"] as Vector2)) * 0.5
				await _view_at(MapData.at(mid_f + Vector2(0.4, 3.2), 1.3), MapData.at(mid_f, 0.55), "perros_galleta", 46.0)
		if String(d0["state"]) == "guide":
			saw_guide = true
			if bool(d0["guide_wait"]) or bool(d0["guide_arrived"]):
				saw_lookback = true
				break
	var guide_d1: float = (d0["p"] as Vector2).distance_to(d0["guide_target"] as Vector2) if saw_guide else guide_d0
	_check(fed and qty_after_feed == 4 and saw_eat and saw_guide and saw_lookback and guide_d1 < guide_d0,
		"feeding a biscuit by hand makes the dog eat, rejoice, run toward the nearest saffron and turn back to check on you (qty=%d, eat=%s, guide=%s, lookback=%s, %.1f->%.1fm)" % [qty_after_feed, saw_eat, saw_guide, saw_lookback, guide_d0, guide_d1])
	g.money = saved_money
	if g.inventario != null:
		g.inventario.remove_item(P.BISCUIT_ID, 10)
	g.police.reset()
	g.set_time(saved_clock)
	g.player.p = saved_p
	g.player.sync()

## Z15 rearview mirror & silver rosary (car.gd set_rosary / _step_rosary): spawned only while the player rides in a Z15,
## visible in first-person POV, swinging physically with acceleration & turning, and freed on exit.
func _rosario_checks(pictures := false) -> void:
	var z = g.paca_car
	if z == null or (z.kind != "z15" and z.kind != "kokas"):
		for c in g.cars:
			if c.kind == "z15":
				z = c
				break
	_check(z != null and z._rosary_root == null and z._dash_root == null, "parked Z15 has no rosary or dashboard until the player enters (zero idle cost)")
	if z == null:
		return
	var was_cam: int = g.car_cam
	var was_clock: float = g.clock
	g.set_time(12.0)
	g.raining = false
	g.car_cam = 1
	g._enter_car(z)
	await _frames(10)
	var mirror_ok: bool = DisplayServer.get_name() == "headless" or (z._mirror_vp != null and z._mirror_cam != null)
	var on_enter: bool = z._rosary_root != null and z._rosary_piv != null and z._rosary_drop != null and z._dash_root != null and z._dash_needle != null and z._dash_wheel != null and z._dash_wheel.find_child("WheelHandL", false, false) != null and z._dash_wheel.find_child("WheelHandR", false, false) != null and mirror_ok
	_check(on_enter, "entering a Z15 spawns the live rearview mirror, articulated rosary, and C15 dashboard with speedometer, single-spoke wheel, and gripping hands")
	var needle_0: float = z._dash_needle.rotation.z if z._dash_needle != null else 0.0
	if pictures:
		await _shot("rosario_fp")
		# Glance slightly down-right to inspect the full C15 dashboard, vents, radio, speedometer & single-spoke wheel
		g._fp_pitch = deg_to_rad(-16.0)
		g._fp_yaw = deg_to_rad(-14.0)
		g._look_idle = 0.0
		await _frames(4)
		await _shot("rosario_salpicadero")
		# Glance upper-right to inspect the 4 accumulated Spanish ITV stickers on the Z15 windscreen
		g._fp_pitch = deg_to_rad(10.0)
		g._fp_yaw = deg_to_rad(-34.0)
		g._look_idle = 0.0
		await _frames(4)
		await _shot("rosario_itv")
		g._fp_pitch = 0.0
		g._fp_yaw = 0.0
	# Drive & turn hard via real Input actions to verify the rosary swings, speedometer needle climbs, and single-spoke wheel turns
	var peak_ang := 0.0
	var peak_drop := 0.0
	var peak_needle := 0.0
	var peak_wheel := 0.0
	Input.action_press("forward")
	for k in range(55):
		if k == 15:
			Input.action_press("left")
		await _frames(1)
		peak_ang = maxf(peak_ang, z._ros_ang.length())
		peak_drop = maxf(peak_drop, z._drop_ang.length() + absf(z._drop_yaw))
		peak_needle = maxf(peak_needle, z._dash_needle.rotation.z - needle_0)
		peak_wheel = maxf(peak_wheel, absf(z._dash_wheel.rotation.z))
		if pictures and k == 35:
			g._fp_pitch = deg_to_rad(-11.0)
			g._look_idle = 0.0
			await _frames(2)
			await _shot("rosario_giro")
			g._fp_pitch = 0.0
	Input.action_release("forward")
	Input.action_release("left")
	z.set_speed(Vector2.ZERO)
