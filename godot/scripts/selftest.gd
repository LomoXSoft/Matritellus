	var t: Dictionary = g.props.tags[3]
	g.cam_fixed = [(t["node"] as Node3D).global_position + Vector3((t["n"] as Vector2).x, 0.3, (t["n"] as Vector2).y) * 5.0, (t["node"] as Node3D).global_position]
