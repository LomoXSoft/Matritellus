func _car_idle_checks(pictures := false) -> void:
	var CarS = preload("res://scripts/car.gd")
	var was_clock: float = g.clock
	var was_cam: int = g.car_cam
	var was_touch: bool = Touch.on
	var was_pad: bool = Controls.pad
	var was_play_ui: bool = g.hud.play_ui.visible
	g.hud.play_ui.visible = true
	g.set_time(11.5)
	Touch.on = false
	Controls.pad = false
	Controls.device_changed.emit()
	var spot: Vector2 = g._start["p"]
	var dir: Vector2 = g._start["u"]
	var c = CarS.new()
	g.add_child(c)
	c.setup("cuatrolatas", 0xf2f0e6, spot, atan2(dir.x, dir.y))
	g.car_cam = 1
	g._enter_car(c)
	c.set_speed(Vector2.ZERO)
	await _frames(35)
	var before_ok: bool = g._car_idle_t > 0.2 and not g._car_idle_on and g.hud.speed_slot.modulate.a > 0.9 and not g.hud.car_hints_slot.visible
	_check(before_ok, "before 5 s stationary, idle timer ticks (%.2f s) while HUD stays visible and controls stay hidden" % g._car_idle_t)
	# Cross the 5 s threshold naturally and let the fade settle
	g._car_idle_t = g.CAR_IDLE_SECS - 0.12
	await _frames(55)
	var desk_ok: bool = g._car_idle_on and g.hud.speed_slot.modulate.a < 0.05 and g.hud.map_slot.modulate.a < 0.05 and g.hud.obj_slot.modulate.a < 0.05 \
		and g.hud.car_hints_slot.visible and g.hud.car_hints_box.modulate.a > 0.9 \
		and g.hud._car_hints_row1.get_child_count() == 4 and g.hud._car_hints_row2.get_child_count() == 4
	_check(desk_ok, "after 5 s stationary on desktop, HUD fades out (a=%.2f) and vehicle controls card appears (4+4 controls)" % g.hud.speed_slot.modulate.a)
	if pictures:
		await _shot("car_idle_teclado")
	# Switch to gamepad: card updates live
	Controls.pad = true
	Controls.device_changed.emit()
	await _frames(10)
	var pad_ok: bool = g.hud.car_hints_slot.visible and g.hud._car_hints_row1.get_child_count() == 4 and g.hud._car_hints_row2.get_child_count() == 4
	_check(pad_ok, "switching to gamepad refreshes the vehicle controls card live")
	if pictures:
		await _shot("car_idle_mando")
	# Switch to Android / touch: HUD remains hidden, controls card stays hidden
	Touch.on = true
	await _frames(10)
	var touch_ok: bool = g._car_idle_on and g.hud.speed_slot.modulate.a < 0.05 and not g.hud.car_hints_slot.visible
	_check(touch_ok, "on Android/touch after 5 s stationary, HUD stays hidden and vehicle controls card does NOT appear")
	Touch.on = false
	Controls.pad = false
	Controls.device_changed.emit()
	await _frames(6)
	# Resume driving: HUD returns immediately and controls card hides
	Input.action_press("forward")
	await _frames(25)
	Input.action_release("forward")
	var move_ok: bool = not g._car_idle_on and g.hud.speed_slot.modulate.a > 0.95 and g.hud.map_slot.modulate.a > 0.95 and not g.hud.car_hints_slot.visible
	_check(move_ok, "accelerating resets idle mode immediately and restores the HUD (a=%.2f)" % g.hud.speed_slot.modulate.a)
	c.set_speed(Vector2.ZERO)
	await _frames(10)
	# Also verify exiting while idle restores HUD cleanly
	g._car_idle_t = g.CAR_IDLE_SECS - 0.05
	await _frames(45)
	g._exit_car()
	await _frames(25)
	var exit_ok: bool = not g._car_idle_on and g.hud.map_slot.modulate.a > 0.95 and not g.hud.car_hints_slot.visible
	_check(exit_ok, "exiting the vehicle while idle restores the HUD cleanly")
	Touch.on = was_touch
	Controls.pad = was_pad
	Controls.device_changed.emit()
	g.hud.play_ui.visible = was_play_ui
	g.car_cam = was_cam
	c.queue_free()
	g.set_time(was_clock)

func _mejoras_checks(pictures := false) -> void:
	# 1) Diagonal speed: radial Input.get_vector gives equal magnitude on cardinals & 45-deg diagonals
	var old_pad := Controls.pad
	Controls.pad = true
	Input.action_press("forward", 1.0)
	var v_card := Input.get_vector("left", "right", "back", "forward", 0.25)
	Input.action_release("forward")
	Input.action_press("forward", 0.7071)
	Input.action_press("right", 0.7071)
	var v_diag := Input.get_vector("left", "right", "back", "forward", 0.25)
	Input.action_release("forward")
	Input.action_release("right")
	Controls.pad = old_pad
	_check(is_equal_approx(g.stick_speed(v_card.length()), 9.0) and is_equal_approx(g.stick_speed(v_diag.length()), 9.0),
		"player movement speed is consistent on cardinals (%.1f) and 45-deg diagonals (%.1f)" % [g.stick_speed(v_card.length()), g.stick_speed(v_diag.length())])
	# 2) Ramps: Z15 driving onto Ermita de San Sebastian steps & Plaza ramp climbs/launches instead of stopping dead
	var z15 = g.paca_car
	if z15 != null:
		g._enter_car(z15)
		var ramp_deck = null
		for d in MapData.decks:
			if d.has("ramp") and float(d["top"]) - float(d["low"]) >= 0.45:
				ramp_deck = d
				break
		var launched := false
		if ramp_deck != null:
			var ax: Vector2 = ramp_deck["ax"]
			var o: Vector2 = ramp_deck["o"]
			var start_p: Vector2 = o - ax * (float(ramp_deck["half"]) + 8.0)
			z15.place(start_p, atan2(ax.x, ax.y))
			z15.set_speed(ax * 16.0)
			var max_y: float = z15.global_position.y
			for _k in range(50):
				await get_tree().physics_frame
				max_y = maxf(max_y, z15.global_position.y)
				if z15.airborne() or z15.linear_velocity.y > 2.0 or max_y > float(ramp_deck["top"]) + 0.1:
					launched = true
			z15.set_speed(Vector2.ZERO)
		_check(launched, "driving fast onto a ramp-like structure launches the car airborne")
		# 3) Garage repaint + heat clear
		var old_paint: int = z15.paint
		g.police.heat = 80.0
		g.police.chasing = true
		g._mended(z15, 0)
		_check(z15.paint != old_paint and g.police.heat == 0.0 and not g.police.chasing,
			"garage repaints car (0x%x -> 0x%x) and clears police heat (%.0f)" % [old_paint, z15.paint, g.police.heat])
		g._exit_car()
	# 4) Police & Guardia Civil uniformed drivers
	var pit_look: Dictionary = g.officer_look("pitufo")
	var tri_look: Dictionary = g.officer_look("tricornio")
	_check(int(pit_look.get("shirt", 0)) == 0x2456b8 and String(pit_look.get("hat", "")) == "cap" and String(tri_look.get("hat", "")) == "tricorn" and int(tri_look.get("shirt", 0)) == 0x3f6b45,
		"Pitufos wear blue uniform + cap, Tricornios clone Ramirez with tricorn")
	# 5) Split hit phrases (bat-only, car-only, shared, including ¡Ostia!)
	var has_ostia := false
	for k in ["hit_both", "hit_car", "hit_bat"]:
		for l in Loc.TX[k]["es"]:
			if String(l).contains("Ostia"):
				has_ostia = true
	_check(Loc.TX.has("hit_bat") and Loc.TX.has("hit_car") and Loc.TX.has("hit_both") and has_ostia,
		"hit phrases are split into bat-only (%d), car-only (%d) and shared (%d) including ¡Ostia!" % [Loc.TX["hit_bat"]["es"].size(), Loc.TX["hit_car"]["es"].size(), Loc.TX["hit_both"]["es"].size()])
	# 6) Big map mission select / deselect (hiding green arrow)
	g.phase = "play"
	g.set_target(g.places["home"]["p"], true)
	await _frames(4)
	var arrow_on: bool = g.arrow.visible
	g._set_map(true)
	await _frames(6)
	if pictures:
		await _shot("mejora_mapa")
	g.select_mission("none")
	g._set_map(false)
	await _frames(4)
	var arrow_off: bool = not g.arrow.visible and not g.beacon.visible and MapData.route_pts.is_empty()
	g.select_mission("auto")
	await _frames(4)
	var arrow_back: bool = g.arrow.visible
	_check(arrow_on and arrow_off and arrow_back, "from big map, deselecting mission removes green arrow (%s -> %s -> %s)" % [arrow_on, arrow_off, arrow_back])
	g.phase = "free"
	g.set_target(null, false)
	# 7) 3D floating spinning glowing pickups
	var base_p: Vector2 = g.places["home"]["p"]
	g.player.p = base_p + Vector2(0.0, -4.5)
	g.player.h = 0.0
	g.player.sync()
	var got := [false]
	g.pickups.spawn("bate", base_p + Vector2(-1.6, 0.0), {"tag": "t_bat", "on_take": func(): got[0] = true})
	g.pickups.spawn("spray", base_p + Vector2(0.0, 0.0), {"tag": "t_spray"})
	g.pickups.spawn("carteles", base_p + Vector2(1.6, 0.0), {"tag": "t_post"})
	g.cam_fixed = [MapData.at(base_p + Vector2(0.0, -4.8), 2.1), MapData.at(base_p, 1.0)]
	await _frames(20)
	if pictures:
		await _shot("mejora_pickups")
	g.cam_fixed = null
	g.player.p = base_p + Vector2(-1.6, 0.0)
	g.player.sync()
	await _frames(10)
	_check(got[0] and g.pickups.items.size() == 2, "3D floating spinning glowing pickups spawn and collect cleanly (collected=%s, left=%d)" % [got[0], g.pickups.items.size()])
	g.pickups.clear()
	# 8) Animal Crossing Inventory (2 tabs: Objetos + Objetos clave non-droppable)
	g.saffron = 3
	g.stats["menu_done"] = true
	g.stats["chiki_tags"] = 1
	g.inventario.add_item("kebab", 2)
	g.inventario.show_bag()
	g.inventario.tab = 0
	g.inventario.sel = 0
	g.inventario._refresh()
	await _frames(6)
	if pictures:
		await _shot("mejora_inv_obj")
	var dropped_ok: bool = g.inventario.drop_selected()
	g.inventario.tab = 1
	g.inventario.sel = 0
	g.inventario._refresh()
	await _frames(6)
	if pictures:
		await _shot("mejora_inv_key")
	var key_locked: bool = not g.inventario.drop_selected() and g.inventario.key_items().size() >= 4
	g.inventario.close()
	_check(dropped_ok and g.saffron == 2 and key_locked, "Animal Crossing inventory: Objetos drops/uses (%s, saffron=%d), Objetos clave cannot be dropped/sold (%s)" % [dropped_ok, g.saffron, key_locked])
	# 9) Quit confirmation & Main Menu Quit
	var main_has_quit: bool = g._menu_page("main")["items"].any(func(it): return it["text"] == Loc.t("m_quit"))
	var qc: Dictionary = g._menu_page("quit_confirm")
	_check(main_has_quit and qc["sub"] == "¿Tás seguro? Mía que se estaba poniendo divertío.", "main menu has Quit and pause Quit asks '¿Tás seguro? Mía que se estaba poniendo divertío.'")

## Verification of the 5 new improvements (20 Nov 2026):
##   1) 3 driving camera modes (3rd person, 1st person with head hidden above shoulders, GTA strategic cinematic jumping on >5s or far)
##   2) Tomasa Malvora + interior of los chinos del Arroyuelo + infinitive shopkeeper + spinning 6 € tobacco pack
##   3) 5 % smokers in non-kid population (0 % kids)
##   4) Developer option to hide/show HUD via ºª (keyboard) or Select (gamepad)
##   5) Slow-motion + cinematic camera while airborne in a car
func _mejoras2_checks(pictures := false) -> void:
	g.phase = "free"
	g.set_target(null, false)
	g.weekday = 0
	g.set_time(12.0)
	await _frames(6)

	# 1) Three driving camera modes (3rd person, 1st person POV with head hidden, GTA cinematic)
	var car = g.paca_car
	var r: Dictionary = MapData.nearest_road(g.places["home"]["p"], true)
	var u: Vector2 = r["u"]
	car.place(r["p"], atan2(u.x, u.y))
	g._enter_car(car)
	g.set_car_cam(0)
	await _frames(8)
	var head0: Node3D = car._rider_nodes[0].find_child("head", true, false) as Node3D
	var fp_head_visible_0: bool = head0 != null and head0.visible
	# Switch to 1st person
	g.cycle_car_cam()
	await _frames(8)
	var fp_head_hidden_1: bool = head0 != null and not head0.visible
	var fp_near_ok: bool = g.cam.near <= 0.06
	var fp_inside_car: bool = g.cam.global_position.distance_to(car.global_position) < 2.2
	if pictures:
		await _shot("mejora2_cam_fp")
	_check(g.car_cam == 1 and fp_head_visible_0 and fp_head_hidden_1 and fp_near_ok and fp_inside_car,
		"driving 1st-person POV hides driver head (%s -> %s), sits inside cabin (dist=%.2f m, near=%.2f)" % [fp_head_visible_0, fp_head_hidden_1, g.cam.global_position.distance_to(car.global_position), g.cam.near])
	# Switch to GTA cinematic
	g.cycle_car_cam()
	await _frames(10)
	var cine_p1: Vector3 = g._cine_pos
	var cine_head_back: bool = head0 != null and head0.visible
	if pictures:
		await _shot("mejora2_cam_cine")
	# Force >= 5 s elapsed -> must jump to next strategic point
	g._cine_t = g.CINE_MIN_TIME + 0.1
	await _frames(4)
	var cine_p2: Vector3 = g._cine_pos
	# Move car far away (> CINE_MAX_DIST) -> must also jump
	car.place(r["p"] + u * 55.0, atan2(u.x, u.y))
	await _frames(4)
	var cine_p3: Vector3 = g._cine_pos
	_check(g.car_cam == 2 and cine_head_back and cine_p1.distance_to(cine_p2) > 2.0 and cine_p2.distance_to(cine_p3) > 2.0,
		"GTA cinematic camera restores head (%s) and jumps on >=5s (%.1f m) and when car gets far (%.1f m)" % [cine_head_back, cine_p1.distance_to(cine_p2), cine_p2.distance_to(cine_p3)])
	# Back to 3rd person
	g.cycle_car_cam()
	await _frames(4)

	# 2) Airborne car slow-motion + cinematic camera
	car.place(r["p"], atan2(u.x, u.y))
	await _frames(4)
	car.global_position.y += 2.6
	car.linear_velocity = Vector3(u.x * 16.0, 5.5, u.y * 16.0)
	car.air_time = 0.28
	car._ramp_cool = 0.5
	var saw_slow := false
	var min_scale := 1.0
	for _i in range(28):
		await _frames(1)
		if g.air_cine:
			saw_slow = true
		min_scale = minf(min_scale, Engine.time_scale)
		if saw_slow and min_scale < 0.65 and pictures:
			await _shot("mejora2_air_slowmo")
			pictures = false # avoid retaking every frame; restored below
	pictures = shots or OS.get_cmdline_user_args().has("--window")
	# Land cleanly and confirm time_scale returns to 1.0
	car.place(r["p"], atan2(u.x, u.y))
	car.linear_velocity = Vector3.ZERO
	car.air_time = 0.0
	for _i in range(45):
		await _frames(1)
	_check(saw_slow and min_scale < 0.65 and not g.air_cine and absf(Engine.time_scale - 1.0) < 0.05,
		"airborne car activates slow-mo + cinematic camera (min_scale=%.2f) and restores 1.00 on landing (now=%.2f, air_cine=%s)" % [min_scale, Engine.time_scale, g.air_cine])
	g._exit_car()
	await _frames(4)

	# 3) Tomasa Malvora + Los chinos del Arroyuelo interior + infinitive shopkeeper + spinning 6 EUR tobacco
	var ch = g.world.chinos
	var T = g.tomasa
	_check(ch != null and ch.get("tienda") != null and T != null and T.n != null and T.keeper != null,
		"los chinos del Arroyuelo has an interior (chinos_dentro), Tomasa Malvora, and El chino shopkeeper")
	if ch != null and ch.tienda != null and T != null:
		# Closed at 03:00 on Monday -> Tomasa away
		g.weekday = 0
		g.set_time(3.0)
		ch.set_open(ch.open_at(0, 3.0))
		T._sync_presence(true)
		var away_closed: bool = T.n.away and not ch.tienda.open
		# Open at 12:00 on Monday -> Tomasa near los chinos
		g.set_time(12.0)
		ch.set_open(ch.open_at(0, 12.0))
		T._sync_presence(true)
		var here_open: bool = not T.n.away and ch.tienda.open and T.n.p.distance_to(ch.door) < 25.0
		_check(away_closed and here_open, "Tomasa walks near los chinos only while open (away_at_3=%s, present_at_12=%s)" % [away_closed, here_open])
		# Talk to Tomasa -> decline ("No") -> she gets angry & trust drops
		g.money = 50
		g.folk.add("tomasa", 10)
		var tr_before: int = g.folk.trust("tomasa")
		g.player.p = T.n.p + Vector2(1.2, 0.0)
		g.player.sync()
		g.talk_to(T.n)
		while g.dlg != null:
			g.dialog_advance()
			await _frames(1)
		var has_yes_no: bool = g._ask != null and (g._ask["options"] as Array).size() == 2
		if has_yes_no:
			g._ask_pick(1) # No
		var no_line: String = String(g.dlg["lines"][0]) if g.dlg != null else ""
		while g.dlg != null:
			g.dialog_advance()
			await _frames(1)
		var tr_after_no: int = g.folk.trust("tomasa")
		_check(has_yes_no and tr_after_no < tr_before and no_line != "",
			"saying No to Tomasa angers her and drops trust (%d -> %d)" % [tr_before, tr_after_no])
		# Talk again -> accept ("Sí")
		g.talk_to(T.n)
		while g.dlg != null:
			g.dialog_advance()
			await _frames(1)
		g._ask_pick(0) # Yes
		while g.dlg != null:
			g.dialog_advance()
			await _frames(1)
		var accepted_ok: bool = T.stage() == "buy" and g.side != null and g.side["id"] == "tomasa"
		# Enter los chinos del Arroyuelo by pressing Action on the green arrow
		var at_door: Vector2 = g.entradas.spot(ch.tienda, false)
		g.player.p = at_door
		g.player.sync()
		g._door_cool = 0.0
		await _frames(4)
		g.interact()
		await _frames(8)
		var entered_chinos: bool = g.indoors and g.inside_of == ch.tienda
		# Talk to El chino -> infinitive verbs warning not to steal
		g.talk_to(T.keeper)
		var chino_text := " ".join(g.dlg["lines"]) if g.dlg != null else ""
		while g.dlg != null:
			g.dialog_advance()
			await _frames(1)
		var chino_ok: bool = chino_text.to_lower().contains("robar") and (chino_text.to_lower().contains("mirar") or chino_text.to_lower().contains("vigilar"))
		# Walk up to spinning tobacco pack in aisle -> verify Comprar prompt (6 €)
		g.player.p = ch.tienda.tobacco_spot + Vector2(0.0, -1.25)
		g.player.h = 0.0
		g.player.sync()
		await _frames(10)
		var can_buy_ok: bool = T.can_buy() and g.hud.prompt.text.contains("Comprar") and g.hud.prompt.text.contains("6")
		if pictures:
			await _shot("mejora2_chinos_tabaco")
		var money_before: int = g.money
		g.interact()
		await _frames(6)
		var bought_ok: bool = g.money == money_before - 6 and T.has_tobacco() and g.inventario.key_items().any(func(it): return it["id"] == "tabaco")
		# Leave shop & deliver to Tomasa
		g.player.p = g.entradas.spot(ch.tienda, true)
		g.player.sync()
		g._door_cool = 0.0
		await _frames(4)
		g.interact()
		await _frames(6)
		g.player.p = T.n.p + Vector2(1.2, 0.0)
		g.player.sync()
		g.talk_to(T.n)
		var done_text := " ".join(g.dlg["lines"]) if g.dlg != null else ""
		var stay_from: Vector2 = T.n.p
		await _frames(240)                       # (her lines on screen a while: she used to walk off on her round meanwhile)
		var stayed: float = T.n.p.distance_to(stay_from)
		while g.dlg != null:
			g.dialog_advance()
			await _frames(1)
		await _frames(240)                       # (and with her question open)
		stayed = maxf(stayed, T.n.p.distance_to(stay_from))
		_check(stayed < 0.3, "her errand done, Tomasa stays with you for her talk and the smoke (moved %.2f m in 8 s)" % stayed)
		var finished_ok: bool = T.done() and g.side == null and done_text.to_lower().contains("hijos") and done_text.to_lower().contains("controlo") and bool(T.n.look_data.get("smoke", false))
		_check(accepted_ok and entered_chinos and chino_ok and can_buy_ok and bought_ok and finished_ok,
			"Tomasa tobacco errand works end-to-end (accept=%s, chinos=%s, chino_inf=%s, buy_prompt=%s, bought=%s, done=%s)" % [accepted_ok, entered_chinos, chino_ok, can_buy_ok, bought_ok, finished_ok])
		# the pitillo (the user, 21 Nov 2026): she asks you to have one with her; either answer, you smoke it, six hours
		# go by with the camera at the sky, and she gives you three
		var offered: bool = g._ask != null and (g._ask["options"] as Array).size() == 2
		if offered:
			g._ask_pick(1)                       # "No, que yo no fumo": you smoke it all the same
		var no_text := " ".join(g.dlg["lines"]) if g.dlg != null else ""
		while g.dlg != null:
			g.dialog_advance()
			await _frames(1)
		var h0: float = g.clock
		var smoking: bool = g.phase == "smoke"
		var looked_up := false
		var shot_sky := false
		for _w in range(900):
			if g.phase != "smoke":
				break
			looked_up = looked_up or (g.cam.global_transform.basis.z.y < -0.5)
			if pictures and _w == 0:
				await _shot("pitillo_tomasa")
			if pictures and not shot_sky and g.fumar._t > g.fumar.UP + 2.5:
				shot_sky = true
				await _shot("pitillo_cielo")
			await _frames(1)
		var passed: float = fposmod(g.clock - h0, 24.0)
		var pack_text := " ".join(g.dlg["lines"]) if g.dlg != null else ""
		while g.dlg != null:
			g.dialog_advance()
			await _frames(1)
		var three: bool = g.fumar.charges() == 3 and g.inventario.key_items().any(func(it): return it["id"] == "pitillo" and int(it["qty"]) == 3 and bool(it.get("usable", false)))
		_check(offered and no_text.contains("cincuenta") and smoking and looked_up and absf(passed - 6.0) < 0.1 and three and pack_text.contains("pitillos") and (g.phase == "play" or g.phase == "free"),
			"done the first time, Tomasa makes you smoke one with her (no: %s), six hours go by looking at the sky (%.2f h, up %s), and you keep three pitillos (%s)" % [no_text.left(40), passed, looked_up, three])
		# more at the chinos: a pack of three on the tobacco shelf
		g.set_time(12.0)
		ch.set_open(ch.open_at(g.weekday, 12.0))
		g.player.p = g.entradas.spot(ch.tienda, false)
		g.player.sync()
		g._door_cool = 0.0
		await _frames(4)
		g.interact()
		await _frames(8)
		g.player.p = ch.tienda.tobacco_spot + Vector2(0.0, -1.25)
		g.player.sync()
		await _frames(10)
		var pit_prompt: bool = T.can_buy() and g.hud.prompt.text.contains("pitillos")
		var m0: int = g.money
		g.interact()
		await _frames(6)
		_check(g.indoors and pit_prompt and g.money == m0 - T.PRICE and g.fumar.charges() == 6, "the chinos sells pitillos, three for %d € (prompt %s, %d left)" % [T.PRICE, pit_prompt, g.fumar.charges()])
		g.player.p = g.entradas.spot(ch.tienda, true)
		g.player.sync()
		g._door_cool = 0.0
		await _frames(4)
		g.interact()
		await _frames(8)
		# and one from the backpack, out in the street
		g.inventario.show_bag()
		g.inventario.tab = 1
		var at := -1
		var keys: Array = g.inventario.key_items()
		for i in range(keys.size()):
			if keys[i]["id"] == "pitillo":
				at = i
		g.inventario.sel = maxi(0, at)
		g.inventario._refresh()
		var h1: float = g.clock
		var used: bool = at >= 0 and g.inventario.use_selected()
		var went: bool = g.phase == "smoke" and not g.inventario.open
		for _w in range(900):
			if g.phase != "smoke":
				break
			await _frames(1)
		_check(used and went and absf(fposmod(g.clock - h1, 24.0) - 6.0) < 0.1 and g.fumar.charges() == 5 and not g.indoors,
			"from the backpack (Objetos clave → Usar) a pitillo makes six hours go by: %s, %d left" % [g.clock_text(), g.fumar.charges()])

	# 4) 5 % smokers in non-kid population (0 % kids) + visual cigarette on face
	var adult_smokes := 0
	for _k in range(1000):
		var lk: Dictionary = g._neighbour_look(["adult_m", "adult_f", "old_m", "old_f"][_k % 4])
		if bool(lk.get("smoke", false)):
			adult_smokes += 1
	var kid_smokes := 0
	for _k in range(400):
		if bool(g._neighbour_look("kid").get("smoke", false)):
			kid_smokes += 1
	var smoker = g.spawn_neighbour(g.places["home"]["p"] + Vector2(0.0, 2.5), true, {"shirt": 0x3b5fa8, "hair": 0x2a1c14, "smoke": true, "voice_i": 0})
	smoker.h = PI
	smoker.sync()
	var has_cig: bool = smoker.find_child("cigarette", true, false) != null
	if pictures:
		g.cam_fixed = [MapData.at(smoker.p + Vector2(0.35, -1.65), 1.55), MapData.at(smoker.p, 1.32)]
		g.cam_pos = g.cam_fixed[0]
		g.cam_look = g.cam_fixed[1]
		await _frames(12)
		await _shot("mejora2_fumador")
		g.cam_fixed = null
	smoker.queue_free()
	g.npcs.erase(smoker)
	_check(adult_smokes >= 25 and adult_smokes <= 85 and kid_smokes == 0 and has_cig,
		"~5%% of non-kid population smokes (%d/1000), 0 kids (%d/400), cigarette 3D attached (%s)" % [adult_smokes, kid_smokes, has_cig])

	# 5) Developer HUD hide/show option (ºª on keyboard / Select on gamepad)
	var prev_dev: bool = bool(Settings.data.get("dev", false))
	Settings.data["dev"] = true
	var dev_has_hud: bool = g._menu_page("dev")["items"].any(func(it): return it["text"] == Loc.t("dev_hud"))
	g.dev_hud_key = false
	g._dev_hud_key() # turn ON
	var k_ev := InputEventKey.new()
	k_ev.physical_keycode = KEY_QUOTELEFT
	k_ev.pressed = true
	g._unhandled_input(k_ev)
	await _frames(3)
	var hid_by_key: bool = g.hud_hidden and not g.hud.play_ui.visible
	var pad_ev := InputEventJoypadButton.new()
	pad_ev.button_index = JOY_BUTTON_BACK
	pad_ev.pressed = true
	g._unhandled_input(pad_ev)
	await _frames(3)
	var shown_by_select: bool = not g.hud_hidden and g.hud.play_ui.visible
	g._dev_hud_key() # turn OFF
	var select_free_off: bool = not g._is_hud_toggle_event(pad_ev)
	Settings.data["dev"] = prev_dev
	_check(dev_has_hud and hid_by_key and shown_by_select and select_free_off,
		"developer HUD toggle works with ºª key (%s) and Select button (%s), restores cleanly when off (%s)" % [hid_by_key, shown_by_select, select_free_off])

## The rounds of the neighbours with a name of their own (rondas.gd; the user, 17 Nov 2026): with no mission for you, the
## old go to church, the grown-ups to the bars, the children to the parks, by the clock; wanted, back to their spot.
func _rondas_checks() -> void:
	var R = g.rondas
	var near := func(n, kind: String) -> bool:
		return (R.zones.get(kind, []) as Array).any(func(q): return n.p.distance_to(q) < 12.0)
	var was := [g.phase, g.weekday, g.clock, g.player.p, g._protest_over, g.side]
	var graves: Array = R.zones.get("cementerio", [])      # (no visits to the cemetery here: by the day's own chance Tía Paca
	R.zones["cementerio"] = []                              # would be there and not at church; they have their own check, luto)
	g.phase = "free"
	g.side = null                                 # (a job left open by an earlier check keeps its neighbour where it is)
	g.player.p = Vector2(1500.0, 1500.0)              # (far out in the fields: nobody in the town sees anybody come or go)
	g.player.sync()
	await _frames(10)
	var paca = g.named["paca"]
	var maruja = g.named["maruja"]
	var kevin = g.named["kevin"]
	var alberto = g.named["alberto"]
	g.marcas._list = []
	g._protest_over = false
	g.weekday = 0
	g.set_time(10.0)
	R._at.clear()
	R.tick(99.0)
	var at_base := func(n, id: String) -> bool:       # (sent home: within 25 m nobody is moved, they walk there, n.home)
		return n.p.distance_to(R.base[id][0]) < 1.0 or (n.home.distance_to(R.base[id][0]) < 0.1 and n.p.distance_to(R.base[id][0]) < 25.0)
	var morning: bool = near.call(paca, "church") and near.call(maruja, "square") and at_base.call(kevin, "kevin") and at_base.call(alberto, "alberto")
	var off := ""                                 # (who is not where the morning sends them)
	off += "" if near.call(paca, "church") else " paca"
	off += "" if near.call(maruja, "square") else " maruja"
	off += "" if at_base.call(kevin, "kevin") else " kevin %.1f" % kevin.p.distance_to(R.base["kevin"][0])
	off += "" if at_base.call(alberto, "alberto") else " alberto %.1f" % alberto.p.distance_to(R.base["alberto"][0])
	if off != "":
		off += " (the camera %.0f m from you)" % Vector2(g.cam.global_position.x, g.cam.global_position.z).distance_to(g.player.p)
	g.set_time(14.0)
	for k in ["paca", "maruja"]:
		if R._at.has(k):
			R._at[k]["until"] = 0.0
	R.tick(99.0)
