	g.side = null
	g.phase = "free"
	g.menu.close()
	if g.in_car != null:
		g.in_car.set_speed(Vector2.ZERO)
		g._exit_car()
	P.assign(mine)
	var trust0: int = g.folk.trust("chiki")
	g.player.p = chiki.p + Vector2(1.2, 0.6)
	await _frames(5)
	g.talk_to(chiki)
	var scene := false
